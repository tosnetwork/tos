{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TOS Slice 6 Timer Manifest Extension",
  "type": "object",
  "required": ["slice6"],
  "additionalProperties": true,
  "properties": {
    "slice6": {
      "type": "object",
      "required": ["timers"],
      "additionalProperties": false,
      "properties": {
        "timers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "max_scheduled_entries",
              "max_body_bits",
              "max_body_refs",
              "max_future_horizon_blocks",
              "max_cell_depth"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "max_scheduled_entries": {
                "type": "integer",
                "minimum": 1
              },
              "max_body_bits": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1023
              },
              "max_body_refs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "max_future_horizon_blocks": {
                "type": "integer",
                "minimum": 1
              },
              "max_cell_depth": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1023
              }
            }
          }
        }
      }
    }
  }
}
