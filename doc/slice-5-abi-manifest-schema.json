{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doc/slice-5-abi-manifest-schema.json",
  "title": "TOS Slice 5 FunC<->Tol ABI manifest",
  "type": "object",
  "required": [
    "version",
    "schema",
    "contract",
    "language",
    "stage",
    "messages",
    "get_methods",
    "cell_types",
    "errors",
    "wire_compatibility_exceptions"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "schema": {
      "type": "string",
      "const": "slice-5-abi-manifest"
    },
    "contract": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "language": {
      "type": "string",
      "enum": [
        "tol",
        "func",
        "mixed"
      ]
    },
    "stage": {
      "type": "string"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "direction",
          "opcode",
          "query_id",
          "query_id_presence",
          "body_encoding",
          "signature_algorithm",
          "signing_input",
          "fields",
          "fixtures"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "direction": {
            "type": "string",
            "enum": [
              "internal_in",
              "internal_out",
              "external_in",
              "external_out"
            ]
          },
          "opcode": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^0x[0-9a-fA-F]{8}$"
          },
          "query_id": {
            "type": "string",
            "enum": [
              "required_after_opcode",
              "optional",
              "absent",
              "custom_external"
            ]
          },
          "query_id_presence": {
            "type": "string",
            "enum": [
              "not_applicable",
              "flag_bit_before_query_id",
              "flag_bit_after_opcode",
              "length_prefixed",
              "custom_external"
            ]
          },
          "body_encoding": {
            "type": "string",
            "enum": [
              "tol_auto_struct",
              "manual_cell",
              "raw_slice",
              "tlb_reference"
            ]
          },
          "signature_algorithm": {
            "type": "string",
            "enum": [
              "none",
              "ed25519"
            ]
          },
          "signing_input": {
            "type": "string",
            "enum": [
              "none",
              "cell_hash",
              "raw_bits"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/field"
            }
          },
          "fixtures": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/fixture"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "opcode": {
                  "type": "null"
                }
              },
              "required": [
                "opcode"
              ]
            },
            "then": {
              "properties": {
                "body_encoding": {
                  "not": {
                    "const": "tol_auto_struct"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "query_id": {
                  "const": "optional"
                }
              },
              "required": [
                "query_id"
              ]
            },
            "then": {
              "properties": {
                "query_id_presence": {
                  "enum": [
                    "flag_bit_before_query_id",
                    "flag_bit_after_opcode",
                    "length_prefixed",
                    "custom_external"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "query_id": {
                  "enum": [
                    "required_after_opcode",
                    "absent"
                  ]
                }
              },
              "required": [
                "query_id"
              ]
            },
            "then": {
              "properties": {
                "query_id_presence": {
                  "const": "not_applicable"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "query_id": {
                  "const": "custom_external"
                }
              },
              "required": [
                "query_id"
              ]
            },
            "then": {
              "properties": {
                "query_id_presence": {
                  "const": "custom_external"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "body_encoding": {
                  "enum": [
                    "manual_cell",
                    "raw_slice"
                  ]
                }
              },
              "required": [
                "body_encoding"
              ]
            },
            "then": {
              "properties": {
                "fixtures": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "signature_algorithm": {
                  "const": "none"
                }
              },
              "required": [
                "signature_algorithm"
              ]
            },
            "then": {
              "properties": {
                "signing_input": {
                  "const": "none"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "signature_algorithm": {
                  "const": "ed25519"
                }
              },
              "required": [
                "signature_algorithm"
              ]
            },
            "then": {
              "properties": {
                "signing_input": {
                  "enum": [
                    "cell_hash",
                    "raw_bits"
                  ]
                },
                "fixtures": {
                  "minItems": 1
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "get_methods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "method_id",
          "id_source",
          "arguments",
          "returns"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "method_id": {
            "type": "integer",
            "minimum": 1
          },
          "id_source": {
            "type": "string",
            "enum": [
              "explicit",
              "auto_derived"
            ]
          },
          "arguments": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/stack_item"
            }
          },
          "returns": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/stack_item"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "cell_types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "encoding",
          "fields",
          "fixtures"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "encoding": {
            "type": "string",
            "enum": [
              "tol_auto_struct",
              "manual_builder",
              "tlb_reference",
              "raw_suffix"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/field"
            }
          },
          "fixtures": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/fixture"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "encoding": {
                  "enum": [
                    "manual_builder",
                    "raw_suffix"
                  ]
                }
              },
              "required": [
                "encoding"
              ]
            },
            "then": {
              "properties": {
                "fixtures": {
                  "minItems": 1
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "code",
          "class"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "code": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          },
          "class": {
            "type": "string",
            "enum": [
              "Ok",
              "Transient",
              "Permanent",
              "Authorization",
              "Protocol",
              "BackPressure",
              "ApplicationSpecific"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "wire_compatibility_exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "exception",
          "reason"
        ],
        "properties": {
          "exception": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": [
        "name",
        "type",
        "bits",
        "refs"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "type": {
          "$ref": "#/$defs/abi_type"
        },
        "bits": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "refs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "caller_controlled": {
          "type": "boolean",
          "description": "For inbound message fields, true means the value is supplied by the caller-controlled message body and must not be treated as authenticated context."
        }
      },
      "additionalProperties": false
    },
    "stack_item": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/abi_type"
        }
      },
      "additionalProperties": false
    },
    "fixture": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "path"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "func",
            "tol",
            "cross_language",
            "golden_cell"
          ]
        },
        "path": {
          "type": "string"
        },
        "wire_reuse_of": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      },
      "additionalProperties": false
    },
    "abi_type": {
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "int",
            "bool",
            "coins",
            "address",
            "any_address",
            "cell",
            "slice",
            "builder",
            "dict",
            "uint256",
            "remaining_bits_and_refs"
          ]
        },
        {
          "pattern": "^(uint|int)([1-9]|[1-9][0-9]{1,2}|10[01][0-9]|102[0-3])$"
        },
        {
          "pattern": "^custom:[A-Za-z_][A-Za-z0-9_]*$"
        }
      ]
    }
  },
  "additionalProperties": false
}
