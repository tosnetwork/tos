{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doc/slice-3-replay-fixture-schema.json",
  "title": "TOS Slice 3 deterministic replay fixture",
  "type": "object",
  "required": [
    "version",
    "schema",
    "fixture_id",
    "contract",
    "source_baseline",
    "runner",
    "cases"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "schema": {
      "type": "string",
      "const": "slice-3-replay-fixture"
    },
    "fixture_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "contract": {
      "type": "object",
      "required": [
        "name",
        "tol_file",
        "compiled_boc",
        "storage_builder"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "tol_file": {
          "type": "string"
        },
        "compiled_boc": {
          "type": "string"
        },
        "storage_builder": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "source_baseline": {
      "type": "string"
    },
    "runner": {
      "type": "object",
      "required": [
        "emulator_filter",
        "tol_tester_patterns"
      ],
      "properties": {
        "emulator_filter": {
          "type": "string"
        },
        "tol_tester_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "initial_c4",
          "inbound",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "emulator-replay",
              "deterministic-negative-generator"
            ]
          },
          "initial_c4": {
            "type": "object",
            "required": [
              "builder",
              "expect_unchanged"
            ],
            "properties": {
              "builder": {
                "type": "string"
              },
              "expect_unchanged": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "inbound": {
            "type": "object",
            "required": [
              "body"
            ],
            "properties": {
              "body": {
                "type": "object",
                "required": [
                  "builder"
                ],
                "properties": {
                  "builder": {
                    "type": "string"
                  },
                  "opcode_hex": {
                    "type": "string"
                  },
                  "query_id": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "generator": {
                    "type": "object",
                    "required": [
                      "name",
                      "seed",
                      "count"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "seed": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "expected": {
            "type": "object",
            "required": [
              "exit_code",
              "actions",
              "max_gas_used"
            ],
            "properties": {
              "exit_code": {
                "type": "integer"
              },
              "actions": {
                "type": "integer",
                "minimum": 0
              },
              "max_gas_used": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
