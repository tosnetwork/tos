{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doc/slice-4-behaviour-manifest-schema.json",
  "title": "TOS Slice 4 behaviour manifest",
  "type": "object",
  "required": [
    "version",
    "schema",
    "behaviour",
    "stage",
    "mode",
    "callbacks",
    "messages",
    "states",
    "postponement",
    "errors",
    "wire_compatibility_exceptions"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "schema": {
      "type": "string",
      "const": "slice-4-behaviour-manifest"
    },
    "behaviour": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "stage": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "warning",
        "error"
      ]
    },
    "callbacks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "receive",
              "receive_external",
              "get",
              "helper"
            ]
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "opcode",
          "query_id"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "opcode": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{8}$"
          },
          "query_id": {
            "type": "string",
            "enum": [
              "required",
              "optional",
              "absent"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "postponement": {
      "type": "object",
      "required": [
        "enabled",
        "queue_field",
        "deferrable",
        "budgets"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "queue_field": {
          "type": [
            "string",
            "null"
          ]
        },
        "deferrable": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "message",
              "from_states",
              "until_states"
            ],
            "properties": {
              "message": {
                "type": "string"
              },
              "from_states": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "until_states": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "budgets": {
          "type": "object",
          "required": [
            "max_items",
            "max_body_bits",
            "max_body_refs",
            "max_total_body_bits",
            "max_total_body_refs",
            "max_age_seconds",
            "max_drain_items"
          ],
          "properties": {
            "max_items": {
              "type": "integer",
              "minimum": 0
            },
            "max_body_bits": {
              "type": "integer",
              "minimum": 0
            },
            "max_body_refs": {
              "type": "integer",
              "minimum": 0
            },
            "max_total_body_bits": {
              "type": "integer",
              "minimum": 0
            },
            "max_total_body_refs": {
              "type": "integer",
              "minimum": 0
            },
            "max_age_seconds": {
              "type": "integer",
              "minimum": 0
            },
            "max_drain_items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "code",
          "class"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "class": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "wire_compatibility_exceptions": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
