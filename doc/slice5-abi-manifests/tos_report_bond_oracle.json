  "wire_compatibility_exceptions": [
    {
      "exception": "BondOracleStartRound, BondOracleSubmitReport, and BondOracleFinalize have no `now` wire field",
      "reason": "All three message types intentionally omit a `now` field. blockchain.now() is the authoritative timestamp for all time checks. FunC reimplementations must use the NOW opcode."
    },
    {
      "exception": "BondOracleSubmitReport has no `reporterKey` wire field",
      "reason": "Reporter identity is derived exclusively from in.senderAddress via bondOracleResolveKey(). FunC reimplementations must perform the same address-to-key lookup and must not trust a wire reporterKey field."
    },
    {
      "exception": "Bond amounts stored as uint64 (nanoTON) not coins",
      "reason": "map<uint256, coins> validity is undocumented; uint64 (nanoTON) is used instead. Maximum representable bond is ~18,446 TON. Internal storage detail; not ABI-visible."
    }
