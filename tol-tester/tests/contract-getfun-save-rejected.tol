struct ContractGetFunSaveRejectedStorage {}

struct (0x000000a4) ContractGetFunSaveRejectedPing {
    queryId: uint64;
}

contract ContractGetFunSaveRejected {
    storage: ContractGetFunSaveRejectedStorage

    receive(msg: ContractGetFunSaveRejectedPing) {
        msg.queryId;
    }

    // §3.5: a get fun body must be side-effect-free; `save(...)` is forbidden
    get fun mutateAndReturn(): int {
        save(ContractGetFunSaveRejectedStorage {});
        return 0;
    }
}

