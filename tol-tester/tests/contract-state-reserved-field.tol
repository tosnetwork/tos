struct ContractStateReservedFieldStorage {
    __state: uint8;
}

struct (0x00000045) ContractStateReservedFieldPing {
    queryId: uint64;
}

contract ContractStateReservedField {
    storage: ContractStateReservedFieldStorage
    states: Open
    @initial state Open

    receive(msg: ContractStateReservedFieldPing) on Open {
        keep_state;
    }
}

