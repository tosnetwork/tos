struct ContractMinimalStorage {}

struct (0x00000015) ContractMinimalPing {
    queryId: uint64;
    amount: uint32;
}

@method_id(101)
fun dummy(): int {
    return 0;
}

contract ContractMinimal {
    storage: ContractMinimalStorage

    receive(msg: ContractMinimalPing) {
        msg.amount;
    }
}

