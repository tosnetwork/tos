fun test_revocation_storage_full_rejected(): int {
    var reg = capRegistry(1);
    reg.revokeHandle(capGrant().handleId(), 50);
    try {
        reg.revokeHandle(slice6CapabilityGrant(capIssuer(), capTarget(), capGrantee(), null, 0x43415002, capConstraints(0x43415002), 10, 100, 8, 2).handleId(), 50);
    } catch (code) {
        return code;
    }
    return 0;
}

