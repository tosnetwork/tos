@method_id(712)
fun test_signature_bound_zero_signature_fails(): int {
    val constraints = capConstraints();
    val grant = slice6CapabilityGrant(capIssuer(), capTarget(), null, 0x123456, 0x43415001, constraints, 10, 100, 7, 2);
    return grant.signatureBoundValid(constraints, capCtxDefault(), zeroSignature()) ? 1 : 0;
}

