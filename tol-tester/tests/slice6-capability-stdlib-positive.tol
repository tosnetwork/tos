@method_id(723)
fun test_argument_bound_rejected(): int {
    var constraints = capConstraints();
    constraints.setArgumentBound(7, slice6CapabilityArgumentBound(10, 20));
    val grant = slice6CapabilityGrant(capIssuer(), capTarget(), capGrantee(), null, 0x43415001, constraints, 10, 100, 8, 2);
    var reg = slice6CapabilityRegistry(4, 2, 2);
    reg.registerGrant(grant);
    var ctx = capCtxDefault();
    ctx.setArgumentValue(7, 21);
    try {
        reg.requireCapability(grant, constraints, ctx, true, false);
    } catch (code) {
        return code;
    }
    return 0;
}

@method_id(724)
fun test_argument_bound_success(): int {
    var constraints = capConstraints();
    constraints.setArgumentBound(7, slice6CapabilityArgumentBound(10, 20));
    val grant = slice6CapabilityGrant(capIssuer(), capTarget(), capGrantee(), null, 0x43415001, constraints, 10, 100, 8, 2);
    var reg = slice6CapabilityRegistry(4, 2, 2);
    reg.registerGrant(grant);
    var ctx = capCtxDefault();
    ctx.setArgumentValue(7, 20);
    reg.requireCapability(grant, constraints, ctx, true, false);
    return 1;
}

@method_id(725)
fun test_pubkey_bound_signature_path_checks_signature(): int {
    val constraints = capConstraints();
    val grant = slice6CapabilityGrant(capIssuer(), capTarget(), null, 0x123456, 0x43415001, constraints, 10, 100, 7, 2);
    var reg = slice6CapabilityRegistry(4, 2, 2);
    reg.registerGrant(grant);
    try {
        reg.requireCapabilityWithSignature(grant, constraints, capCtxDefault(), zeroSignature(), true, false);
    } catch (code) {
        return code;
    }
    return 0;
}

@method_id(726)
fun test_argument_bound_count_cap_rejected(): int {
    var constraints = capConstraints();
    constraints.setArgumentBound(0, slice6CapabilityArgumentBound(0, 10));
    constraints.setArgumentBound(1, slice6CapabilityArgumentBound(0, 10));
    constraints.setArgumentBound(2, slice6CapabilityArgumentBound(0, 10));
    constraints.setArgumentBound(3, slice6CapabilityArgumentBound(0, 10));
    constraints.setArgumentBound(4, slice6CapabilityArgumentBound(0, 10));
    constraints.setArgumentBound(5, slice6CapabilityArgumentBound(0, 10));
    constraints.setArgumentBound(6, slice6CapabilityArgumentBound(0, 10));
    constraints.setArgumentBound(7, slice6CapabilityArgumentBound(0, 10));
    constraints.setArgumentBound(8, slice6CapabilityArgumentBound(0, 10));
    constraints.setArgumentBound(9, slice6CapabilityArgumentBound(0, 10));
    constraints.setArgumentBound(10, slice6CapabilityArgumentBound(0, 10));
    constraints.setArgumentBound(11, slice6CapabilityArgumentBound(0, 10));
    constraints.setArgumentBound(12, slice6CapabilityArgumentBound(0, 10));
    constraints.setArgumentBound(13, slice6CapabilityArgumentBound(0, 10));
    constraints.setArgumentBound(14, slice6CapabilityArgumentBound(0, 10));
    constraints.setArgumentBound(15, slice6CapabilityArgumentBound(0, 10));
    try {
        constraints.setArgumentBound(16, slice6CapabilityArgumentBound(0, 10));
    } catch (code) {
        return code;
    }
    return 0;
}

@method_id(727)
fun test_argument_bound_replacement_does_not_increment_count(): int {
    var constraints = capConstraints();
    constraints.setArgumentBound(7, slice6CapabilityArgumentBound(0, 10));
    constraints.setArgumentBound(7, slice6CapabilityArgumentBound(2, 8));
    return constraints.argumentBoundCount;
}

