@method_id(715)
fun test_consumed_nonce_storage_full_rejected(): int {
    var reg = capRegistry(2, 2, 1, 64);
    reg.requireCapability(capGrant(), capConstraints(), capCtxDefault(), true, true);
    val secondGrant = slice6CapabilityGrant(capIssuer(), capTarget(), capGrantee(), null, 0x43415001, capConstraints(), 10, 100, 8, 2);
    reg.registerGrant(secondGrant);
    try {
        reg.requireCapability(secondGrant, capConstraints(), capCtxDefault(), true, true);
    } catch (code) {
        return code;
    }
    return 0;
}

@method_id(716)
fun test_revocation_zero_is_permanent(): int {
    var reg = capRegistry();
    reg.revokeHandle(capGrant().handleId(), 0);
    assert(reg.isHandleRevoked(capGrant().handleId(), 1000000)) throw 7161;
    try {
        reg.requireCapability(capGrant(), capConstraints(), capCtxDefault(), true, false);
    } catch (code) {
        return code;
    }
    return 0;
}

@method_id(717)
fun test_revocation_cannot_be_shortened(): int {
    var reg = capRegistry();
    val handle = capGrant().handleId();
    reg.revokeHandle(handle, 100);
    reg.revokeHandle(handle, 10);
    assert(reg.isHandleRevoked(handle, 50)) throw 7171;
    return reg.isHandleRevoked(handle, 100) ? 0 : 1;
}

