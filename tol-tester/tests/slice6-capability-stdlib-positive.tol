import "@stdlib/capability"

fun capIssuer(): address {
    return address("0:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
}

fun capTarget(): address {
    return address("0:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb");
}

fun capOtherTarget(): address {
    return address("0:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc");
}

fun capGrantee(): address {
    return address("0:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd");
}

fun capOtherSender(): address {
    return address("0:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee");
}

fun capCounterparty(): address {
    return address("0:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff");
}

fun capConstraints(selector: uint32 = 0x43415001): Slice6CapabilityConstraintsV1 {
    return slice6CapabilityConstraints(selector, 1000, 10, 100, 1, capCounterparty(), 0, 0x1234, 0);
}

fun capGrant(selector: uint32 = 0x43415001): Slice6CapabilityGrantV1 {
    return slice6CapabilityGrant(capIssuer(), capTarget(), capGrantee(), null, selector, capConstraints(selector), 10, 100, 7, 2);
}

fun capCtx(
    sender: address,
    target: address,
    selector: uint32,
    valueCoins: coins,
    now: uint64
): Slice6CapabilityUseContext {
    return slice6CapabilityUseContext(sender, target, selector, valueCoins, capCounterparty(), now, 0);
}

fun capCtxDefault(): Slice6CapabilityUseContext {
    return capCtx(capGrantee(), capTarget(), 0x43415001, 100, 20);
}

fun capRegistry(
    maxRevoked: uint16 = 2,
    maxEpochs: uint16 = 2,
    maxConsumedNonces: uint16 = 64,
    maxTrackedUses: uint16 = 64
): Slice6CapabilityRegistry {
    var reg = slice6CapabilityRegistry(4, maxRevoked, maxEpochs, maxConsumedNonces, maxTrackedUses);
    reg.registerGrant(capGrant());
    return reg;
}

fun zeroSignature(): cell {
    return beginCell().storeUint(0, 256).storeUint(0, 256).endCell();
}

fun main(): int {
    return 0;
}

@method_id(701)
fun test_constraints_hash_stable_and_selector_covered(): int {
    val a = capConstraints();
    val b = capConstraints();
    val c = capConstraints(0x43415002);
    assert(a.constraintsHash() == b.constraintsHash()) throw 7011;
    assert(a.constraintsHash() != c.constraintsHash()) throw 7012;
    return a.tag;
}

@method_id(702)
fun test_sender_bound_capability_success(): int {
    var reg = capRegistry();
    reg.requireCapability(capGrant(), capConstraints(), capCtxDefault());
    return 1;
}

@method_id(703)
fun test_sender_bound_wrong_sender_rejected(): int {
    var reg = capRegistry();
    try {
        reg.requireCapability(capGrant(), capConstraints(), capCtx(capOtherSender(), capTarget(), 0x43415001, 100, 20));
    } catch (code) {
        return code;
    }
    return 0;
}

