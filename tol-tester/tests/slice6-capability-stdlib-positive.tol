@method_id(717)
fun test_revocation_cannot_be_shortened(): int {
    var reg = capRegistry();
    val handle = capGrant().handleId();
    reg.revokeHandle(handle, 100);
    reg.revokeHandle(handle, 10);
    assert(reg.isHandleRevoked(handle, 50)) throw 7171;
    return reg.isHandleRevoked(handle, 100) ? 0 : 1;
}

