@method_id(658)
fun test_cancel_scheduled_helper(): int {
    val action = sendAfterBlocks(timeBudget(), timeTarget(), timeBody(), 100, 10, 20, 1000, 0, timeCancel(), timeDeadLetter());
    var entry = slice6ScheduledEntry(0xabc, action, 130);
    val result = cancelScheduled(mutate entry, timeCancel());
    assert(entry.canceled) throw 6581;
    return result;
}

@method_id(659)
fun test_cancel_scheduled_helper_rejects_wrong_caller(): int {
    val action = sendAfterBlocks(timeBudget(), timeTarget(), timeBody(), 100, 10, 20, 1000, 0, timeCancel(), timeDeadLetter());
    var entry = slice6ScheduledEntry(0xabc, action, 130);
    val result = cancelScheduled(mutate entry, timeDeadLetter());
    assert(entry.pending) throw 6591;
    return result;
}

@method_id(660)
fun test_wall_clock_budget_accepts_seconds_boundary(): int {
    wallClockBudget().requireDurationWithinBudget(1000);
    return wallClockBudget().maxFutureHorizonSeconds as int;
}

@method_id(661)
fun test_wall_clock_budget_rejects_seconds_horizon(): int {
    try {
        wallClockBudget().requireDurationWithinBudget(1001);
    } catch (code) {
        return code;
    }
    return 0;
}

@method_id(662)
fun test_wall_clock_budget_rejects_disabled(): int {
    try {
