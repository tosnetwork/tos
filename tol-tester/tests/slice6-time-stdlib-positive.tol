import "@stdlib/time"
import "@stdlib/schedule"

fun timeTarget(): address {
    return address("0:1212121212121212121212121212121212121212121212121212121212121212");
}

fun timeCancel(): address {
    return address("0:3434343434343434343434343434343434343434343434343434343434343434");
}

fun timeDeadLetter(): address {
    return address("0:5656565656565656565656565656565656565656565656565656565656565656");
}

fun timeBody(bits: uint16 = 32): cell {
    if (bits == 64) {
        return beginCell().storeUint(1, 32).storeUint(2, 32).endCell();
    }
    return beginCell().storeUint(1, 32).endCell();
}

fun timeBudget(
    maxBodyBits: uint32 = 128,
    maxFutureHorizonBlocks: uint32 = 100,
    enabled: bool = true
): Slice6TimerBudget {
    return slice6TimerBudget(4, maxBodyBits, 1, maxFutureHorizonBlocks, 1023, enabled);
}

fun wallClockBudget(maxFutureHorizonSeconds: uint32 = 1000, enabled: bool = true): Slice6WallClockBudget {
    return slice6WallClockBudget(maxFutureHorizonSeconds, enabled);
}

fun main(): int {
    return 0;
}

@method_id(651)
fun test_send_at_mc_seqno_shape(): int {
    val action = sendAtMcSeqno(timeBudget(), timeTarget(), timeBody(), 100, 110, 20, 1000, 0, timeCancel(), timeDeadLetter());
    assert(action.notBeforeMcSeqno == 110) throw 6511;
    assert(action.deliverByMcSeqno() == 130) throw 6512;
    return action.expireAfterBlocks;
}

@method_id(652)
fun test_send_after_blocks_uses_trusted_current_seqno(): int {
    val callerControlledNow = 0;
    val trustedCurrent = 100;
    val action = sendAfterBlocks(timeBudget(), timeTarget(), timeBody(), trustedCurrent, 10, 20, 1000, 0, timeCancel(), timeDeadLetter());
    assert(callerControlledNow == 0) throw 6521;
    assert(action.notBeforeMcSeqno == 110) throw 6522;
    return action.notBeforeMcSeqno;
}

@method_id(653)
fun test_send_after_zero_delay_allowed(): int {
    val action = sendAfterBlocks(timeBudget(), timeTarget(), timeBody(), 100, 0, 20, 1000, 0, timeCancel(), null);
    return action.notBeforeMcSeqno;
}

@method_id(654)
fun test_timer_budget_rejects_disabled(): int {
    try {
        sendAtMcSeqno(timeBudget(128, 100, false), timeTarget(), timeBody(), 100, 110, 20, 1000, 0, timeCancel(), null);
    } catch (code) {
        return code;
    }
    return 0;
}

