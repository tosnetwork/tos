struct ContractMultiStorage {}

struct (0x00000015) ContractMultiPing {
    queryId: uint64;
    amount: uint32;
}

struct (0x00000016) ContractMultiPong {
    queryId: uint64;
    amount: uint32;
}

@method_id(101)
fun dummy(): int {
    return 0;
}

contract ContractMulti {
    storage: ContractMultiStorage

    receive(msg: ContractMultiPing) {
        msg.amount;
    }

    receive(msg: ContractMultiPong) {
        msg.amount;
    }
}

