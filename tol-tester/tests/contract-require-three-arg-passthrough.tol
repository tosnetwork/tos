// Slice 2 Stage 6 (doc/tos-language-syntax-policy.md §3.7) — explicit-code
// escape hatch. The 3-argument `require(cond, ErrorClass.X, customCode)`
// passes through unchanged: the rewrite pass leaves the explicit code
// alone and records the site in the debug manifest as `explicit_code=...`.
// Verifies that 0xdead = 57005 still appears unmodified in the throw site.

import "@stdlib/common"

struct ContractRequireThreeArgStorage {
    expectedSeqno: uint32;
}

struct (0x726E0002) ContractRequireThreeArgPing {
    queryId: uint64;
    seqno: uint32;
}

@method_id(101)
fun dummy(): int {
    return 0;
}

contract ContractRequireThreeArg {
    storage: ContractRequireThreeArgStorage

    receive(msg: ContractRequireThreeArgPing) {
        // Explicit code 0xdead = 57005; the pass MUST NOT auto-renumber this site.
        require(msg.seqno == storage.expectedSeqno, ErrorClass.Authorization, 0xdead);
    }
}

/**
@testcase | 101 | | 0

@fif_codegen
"""
  // require_site_table
