struct ContractOnBracedArgStorage {
    always: uint32;
    @on(Secret) secret: uint32;
}

struct (0x0000009b) ContractOnBracedArgPing {
    queryId: uint64;
}

struct (0x0000009e) ContractOnBracedArgOpenSecret {
    queryId: uint64;
}

struct ContractOnBracedArgBox {
    value: uint32;
}

fun consumeBracedArg(x: uint32): uint32 {
    return x;
}

contract ContractOnBracedArg {
    storage: ContractOnBracedArgStorage
    states: Open, Secret
    @initial state Open
    @unknown_throw(0xffff);

    receive(msg: ContractOnBracedArgOpenSecret) on Open {
        become Secret;
    }

    receive(msg: ContractOnBracedArgPing) on Open {
        consumeBracedArg((ContractOnBracedArgBox { value: storage.secret }).value);
        keep_state;
    }
}

/**
@compilation_should_fail
@stderr storage field `secret` is annotated `@on(Secret)`
 */
