// Slice 2 Stage 4 (https://github.com/tosnetwork/doc/blob/main/tos-blockchain/tos-language-syntax-policy.md §3.2 v3): the `@unknown_throw(N)`
// contract-level annotation is mutually exclusive with declaring a `receive(msg: UnknownOpcode)`
// catch-all receiver — the contract must pick exactly one unknown-opcode handler. Declaring
// both is a compile error.

struct ContractUnknownConflictingStorage {
    counter: uint32;
}

struct (0x00000001) ContractUnknownConflictingPing {
    queryId: uint64;
}

contract ContractUnknownConflicting {
    storage: ContractUnknownConflictingStorage
    @unknown_throw(0xffff);

    receive(msg: ContractUnknownConflictingPing) {
        msg.queryId;
    }

    receive(msg: UnknownOpcode) {
        msg.remainingBitsCount();
    }
}

/**
@compilation_should_fail
@stderr declares both `@unknown_throw` and `receive(msg: UnknownOpcode)`
@stderr https://github.com/tosnetwork/doc/blob/main/tos-blockchain/tos-language-syntax-policy.md §3.2
 */
