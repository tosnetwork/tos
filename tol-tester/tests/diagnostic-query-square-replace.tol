// Conditional reads and replacement slices do not identify a correlation field.
import "@stdlib/common"
struct (0x40005001) Ack { queryId: uint64; amount: uint64; }
fun onInternalMessage(in: InMessage) {
    var body = in.body;
    body.loadUint(32);
    var other = in.body;
    var tag = 0;
    [body, tag] = [other, 1];
    val amount = body.loadUint(64);
    createMessage({bounce: false, dest: in.senderAddress, value: 0,
        body: Ack { queryId: 0, amount: amount as uint64 }}).send(SEND_MODE_REGULAR);
}
