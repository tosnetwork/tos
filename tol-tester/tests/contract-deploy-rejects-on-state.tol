// Slice 2 Stage 4 (https://github.com/tosnetwork/doc/blob/main/tos-blockchain/tos-language-syntax-policy.md §3.6): `@deploy` cannot combine with
// `on <State>`. Deployment has exactly one authoritative initial state, so an explicit `on`
// clause on the deploy receiver is meaningless and must be rejected at parse time.

struct ContractDeployOnStateStorage {
    total: uint32;
}

struct (0x00000001) ContractDeployOnStateDeploy {
    queryId: uint64;
}

struct (0x00000031) ContractDeployOnStatePing {
    queryId: uint64;
}

contract ContractDeployOnState {
    storage: ContractDeployOnStateStorage
    states: Open
    @initial state Open

    @deploy
    receive(msg: ContractDeployOnStateDeploy) on Open {
        save(ContractDeployOnStateStorage { total: 0 });
    }

    receive(msg: ContractDeployOnStatePing) on Open {
        keep_state;
    }
}

/**
@compilation_should_fail
@stderr `@deploy` cannot combine with `on <State>`
@stderr https://github.com/tosnetwork/doc/blob/main/tos-blockchain/tos-language-syntax-policy.md §3.6
 */
