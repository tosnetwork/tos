struct ContractStateInvalidBecomeStorage {
    total: uint32;
}

struct (0x00000043) ContractStateInvalidBecomePing {
    queryId: uint64;
}

contract ContractStateInvalidBecome {
    storage: ContractStateInvalidBecomeStorage
    states: Open
    @initial state Open

    receive(msg: ContractStateInvalidBecomePing) on Open {
        become Closed;
    }
}

