struct (0x01) AskToTransfer {
    tokenAmount: coins
    another: uint8
}

struct (0x02) TransferNotificationForRecipient {
    tokenAmount: coins
    another: uint8
}

type AllowedMessageToVault =
    | AskToTransfer
    | TransferNotificationForRecipient

@inline
fun AllowedMessageToVault.getTokenAmount(self, delta: coins) {
    return match (self) {
        AskToTransfer => self.tokenAmount + delta,
        TransferNotificationForRecipient => self.tokenAmount + delta,
    }
}

fun main() {
    var m = lazy AllowedMessageToVault.fromSlice(createEmptySlice());
    match (m) {
        AskToTransfer => {
            return m.getTokenAmount(123);
        }
        TransferNotificationForRecipient => {
            return m.getTokenAmount(456);
        }
    }
}

