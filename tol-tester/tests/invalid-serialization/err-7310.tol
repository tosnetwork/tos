struct (0x01) AskToTransfer {
    tokenAmount: coins
    another: uint8
}

struct (0x02) TransferNotificationForRecipient {
    tokenAmount: coins
    another: uint8
}

type AllowedMessageToVault =
    | AskToTransfer
    | TransferNotificationForRecipient

@inline
fun AllowedMessageToVault.setTokenAmount(mutate self, newValue: coins) {
    match (self) {
        AskToTransfer => {
            self.tokenAmount = newValue;
        }
        TransferNotificationForRecipient => {
            self.tokenAmount = newValue;
        }
    }
}

fun main() {
    var m = lazy AllowedMessageToVault.fromSlice(createEmptySlice());
    match (m) {
        AskToTransfer => {
            return m.setTokenAmount(123);
        }
        TransferNotificationForRecipient => {
            return m.setTokenAmount(456);
        }
    }
}

/**
@compilation_should_fail
@stderr `lazy` will not work here, because variable `m` changes its type inside `match`
 */
