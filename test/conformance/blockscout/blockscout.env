# ----------------------------------------------------------------------
# Blockscout backend env (Phase P-6, TOS workchain).
#
# Adapted from upstream docker-compose/envs/common-blockscout.env.
# Only the values that differ from upstream defaults (or are
# load-bearing for the TOS run) are kept here; everything else inherits
# blockscout's compiled-in defaults.
#
# CHAIN_ID is the TOS workchain id 0x544f53 = 5525331 in decimal.
# ----------------------------------------------------------------------

# --- RPC wiring -------------------------------------------------------
# host.docker.internal is mapped to the docker bridge gateway in
# docker-compose.yml; tos-rpc-forwarder listens on 18011 and forwards
# to the validator's loopback 8011.
#
# Blockscout 9.0.2 syncs against TOS validator-engine directly (no shim)
# as of the spec-compliant error envelope + JSON-RPC 2.0 batch dispatch
# fixes ("fix(json-rpc-server): emit spec-compliant error envelope"
# + "feat(json-rpc-server): JSON-RPC 2.0 batch request support"). Older
# binaries still need normalize-proxy:9545 — keep that path live in
# normalize-proxy.py + docker-compose.yml as a backstop.
ETHEREUM_JSONRPC_VARIANT=geth
ETHEREUM_JSONRPC_TRANSPORT=http
ETHEREUM_JSONRPC_HTTP_URL=http://host.docker.internal:18011/
ETHEREUM_JSONRPC_TRACE_URL=http://host.docker.internal:18011/
ETHEREUM_JSONRPC_ETH_CALL_URL=http://host.docker.internal:18011/
# WS not exposed yet by TOS RPC; leave unset so Blockscout polls.
# Block-receipts call Blockscout uses (eth_getBlockReceipts) is supported
# by TOS — no need to disable archive balances.
ETHEREUM_JSONRPC_DISABLE_ARCHIVE_BALANCES=false
ETHEREUM_JSONRPC_GETH_TRACE_BY_BLOCK=false
ETHEREUM_JSONRPC_GETH_ALLOW_EMPTY_TRACES=true
ETHEREUM_JSONRPC_DEBUG_TRACE_TRANSACTION_TIMEOUT=10s

# --- Chain identity ----------------------------------------------------
CHAIN_ID=5525331
COIN_NAME=TOS
COIN=TOS
NETWORK=TOS
SUBNETWORK=TOS workchain (testnet)
LOGO=/images/blockscout_logo.svg
BLOCK_TRANSFORMER=base
# Geth-style fee market; matches what TOS reports via eth_feeHistory.
EIP_1559_ELASTICITY_MULTIPLIER=2

# --- Database / cache --------------------------------------------------
DATABASE_URL=postgresql://blockscout:blockscout_local_dev@db:5432/blockscout
ECTO_USE_SSL=false
POOL_SIZE=40
POOL_SIZE_API=10
ACCOUNT_REDIS_URL=redis://redis-db:6379

# --- App ---------------------------------------------------------------
PORT=4000
SECRET_KEY_BASE=tos-blockscout-local-dev-secret-key-base-replace-in-production-xxx
HEART_BEAT_TIMEOUT=30
DISABLE_FILE_LOGGING=false
DISABLE_MARKET=true
DISABLE_INDEXER=false
DISABLE_REALTIME_INDEXER=false
DISABLE_CATCHUP_INDEXER=false
DISABLE_WEBAPP=true
ADMIN_PANEL_ENABLED=false
RE_CAPTCHA_DISABLED=true
API_RATE_LIMIT_DISABLED=true

# --- Disable heavy / external-dependency fetchers ---------------------
# These hit external services (CoinGecko, IPFS, Beacon nodes, NFT CDN)
# or do heavy retracing of internal txs. Off for the local sync run.
INDEXER_DISABLE_INTERNAL_TRANSACTIONS_FETCHER=true
INDEXER_DISABLE_TOKEN_INSTANCE_REALTIME_FETCHER=true
INDEXER_DISABLE_TOKEN_INSTANCE_RETRY_FETCHER=true
INDEXER_DISABLE_TOKEN_INSTANCE_SANITIZE_FETCHER=true
INDEXER_DISABLE_TOKEN_INSTANCE_REFETCH_FETCHER=true
INDEXER_DISABLE_TOKEN_INSTANCE_ERC_1155_SANITIZE_FETCHER=true
INDEXER_DISABLE_TOKEN_INSTANCE_ERC_721_SANITIZE_FETCHER=true
INDEXER_DISABLE_BEACON_BLOB_FETCHER=true
INDEXER_DISABLE_BEACON_DEPOSIT_FETCHER=true
INDEXER_DISABLE_BEACON_DEPOSIT_STATUS_FETCHER=true
INDEXER_DISABLE_PENDING_TRANSACTIONS_FETCHER=false
INDEXER_DISABLE_BLOCK_REWARD_FETCHER=true
INDEXER_DISABLE_WITHDRAWALS_FETCHER=true
NFT_MEDIA_HANDLER_ENABLED=false

# Skip optional microservices we are not running (sc-verifier,
# visualizer, sig-provider, account abstraction, BENS, etc.).
MICROSERVICE_SC_VERIFIER_ENABLED=false
MICROSERVICE_VISUALIZE_SOL2UML_ENABLED=false
MICROSERVICE_SIG_PROVIDER_ENABLED=false
MICROSERVICE_ACCOUNT_ABSTRACTION_ENABLED=false

# --- Account / auth ----------------------------------------------------
ACCOUNT_ENABLED=false
# ACCOUNT_CLOAK_KEY must be base64 (Blockscout calls Base.decode64!/2 on it).
# Base64 of literal "tos-blockscout-local-dev-cloak-key-not-for-prod-padding".
ACCOUNT_CLOAK_KEY=dG9zLWJsb2Nrc2NvdXQtbG9jYWwtZGV2LWNsb2FrLWtleS1ub3QtZm9yLXByb2QtcGFkZGluZw==
