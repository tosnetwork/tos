# Minimal image for the JSON-RPC normalising proxy that sits between
# Blockscout and the TOS validator. See normalize-proxy.py for what it
# does and why. Stdlib-only Python keeps the image tiny.
FROM python:3.12-slim

WORKDIR /app
COPY normalize-proxy.py /app/normalize-proxy.py

EXPOSE 9545
ENTRYPOINT ["python3", "-u", "/app/normalize-proxy.py"]
CMD ["--listen", "0.0.0.0:9545", "--upstream", "http://host.docker.internal:18011"]
