# =============================================================================
# Dockerfile.proxy — Hive client image (proxy mode only)
# =============================================================================
#
# Slim image that runs tos-rpc-proxy.py to forward Hive's JSON-RPC traffic to
# an existing TOS validator (e.g. the live testnet on the host).  Builds in
# seconds and exercises the Hive harness end-to-end without re-implementing a
# single-node TOS bootstrap inside the container.
#
# Build:
#   docker build -f test/conformance/hive/Dockerfile.proxy \
#                -t tos/validator-hive:proxy \
#                test/conformance/hive/clients/tos/
#
# Run (standalone, against the live testnet on the host):
#   docker run --rm -p 8545:8545 \
#       -e TOS_PROXY_UPSTREAM=host.docker.internal:8011 \
#       --add-host=host.docker.internal:host-gateway \
#       tos/validator-hive:proxy
#
# Then `curl localhost:8545 -d '{"jsonrpc":"2.0","method":"eth_chainId",...}'`
# returns whatever the upstream TOS RPC returns.
# =============================================================================

FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        ca-certificates \
        jq \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Entrypoint shim + helpers.
COPY tos.cmd               /usr/local/bin/tos.cmd
COPY tos-rpc-proxy.py      /usr/local/bin/tos-rpc-proxy.py
COPY chain-rlp-replay.py   /usr/local/bin/tos-chain-rlp-replay
COPY mapper.jq             /etc/tos/mapper.jq
COPY genesis.tmpl.json     /etc/tos/genesis.tmpl.json
RUN chmod +x /usr/local/bin/tos.cmd \
             /usr/local/bin/tos-rpc-proxy.py \
             /usr/local/bin/tos-chain-rlp-replay

WORKDIR /data
ENV TOS_DATA=/data \
    TOS_JSONRPC_BIND=0.0.0.0:8545

EXPOSE 8545

ENTRYPOINT ["/usr/local/bin/tos.cmd"]
