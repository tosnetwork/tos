{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conformance/harness/net-v1",
  "title": "net harness: the network wire layer (ADNL, keys, overlay, FEC, RLDP2)",
  "$defs": {
    "context": {
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "public_key",
            "private_key",
            "sign",
            "verify",
            "encrypt",
            "decrypt",
            "shared_secret",
            "adnl_id",
            "adnl_address_list",
            "adnl_message",
            "adnl_packet",
            "adnl_datagram",
            "adnl_channel",
            "preauth_source",
            "preauth_gate",
            "overlay_id",
            "overlay_node",
            "overlay_certificate",
            "overlay_member_certificate",
            "overlay_member_flags",
            "overlay_privacy_rules",
            "overlay_broadcast",
            "fec_type",
            "fec_encode",
            "fec_decode",
            "rldp2_fec_helper",
            "rldp2_budget",
            "rldp2_receive",
            "rldp2_send"
          ],
          "description": "operation; each op requires its own subset of the fields below (runner/harnesses/net.py OP_REQUIRED, OP_OPTIONAL)"
        },
        "address": {
          "type": "object",
          "required": [
            "ip",
            "port"
          ],
          "additionalProperties": false,
          "properties": {
            "ip": {
              "type": "string",
              "maxLength": 64,
              "description": "numeric IPv4 or IPv6 address"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "address_list": {
          "$ref": "../common-v1.schema.json#/$defs/hex",
          "description": "a boxed adnl.addressList"
        },
        "algorithm": {
          "enum": [
            "raptorq",
            "online",
            "round_robin"
          ]
        },
        "authorized_keys": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "required": [
              "key",
              "max_size"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "32 bytes, lowercase hex"
              },
              "max_size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            }
          }
        },
        "broadcast": {
          "type": "object",
          "required": [
            "data",
            "flags",
            "fec"
          ],
          "additionalProperties": false,
          "properties": {
            "data": {
              "$ref": "../common-v1.schema.json#/$defs/hex"
            },
            "flags": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "fec": {
              "type": "boolean"
            }
          },
          "description": "overlay_broadcast: the broadcast member 0 sends (send_broadcast_ex, or send_broadcast_fec_ex when fec)"
        },
        "budget": {
          "type": "object",
          "required": [
            "max_decoders",
            "max_bytes"
          ],
          "additionalProperties": false,
          "properties": {
            "max_decoders": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "description": "unsigned 64-bit decimal"
            },
            "max_bytes": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "description": "unsigned 64-bit decimal"
            }
          }
        },
        "certificate": {
          "$ref": "../common-v1.schema.json#/$defs/hex",
          "description": "a boxed overlay.Certificate or overlay.MemberCertificate"
        },
        "ciphertext": {
          "$ref": "../common-v1.schema.json#/$defs/hex"
        },
        "contents": {
          "$ref": "../common-v1.schema.json#/$defs/hex",
          "description": "a boxed adnl.packetContents"
        },
        "data": {
          "$ref": "../common-v1.schema.json#/$defs/hex"
        },
        "data_size": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "description": "unsigned 64-bit decimal"
            }
          ],
          "description": "rldp2_budget: decimal; otherwise an integer"
        },
        "datagram": {
          "$ref": "../common-v1.schema.json#/$defs/hex",
          "description": "a UDP payload: 32-byte destination (local id or channel id), then the ciphertext"
        },
        "default_mtu": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "description": "unsigned 64-bit decimal"
        },
        "events": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "admit"
                ],
                "additionalProperties": false,
                "properties": {
                  "admit": {
                    "type": "object",
                    "required": [
                      "ip",
                      "port"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "ip": {
                        "type": "string",
                        "maxLength": 64,
                        "description": "numeric IPv4 or IPv6 address"
                      },
                      "port": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "release"
                ],
                "additionalProperties": false,
                "properties": {
                  "release": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "index of the admit event whose ticket is released"
                  }
                }
              }
            ]
          }
        },
        "fec_type": {
          "$ref": "../common-v1.schema.json#/$defs/hex",
          "description": "a boxed fec.Type as a peer announces it"
        },
        "flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "32 bytes, lowercase hex"
        },
        "inbound": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "src",
              "dst",
              "message"
            ],
            "additionalProperties": false,
            "properties": {
              "src": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "32 bytes, lowercase hex"
              },
              "dst": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "message": {
                "$ref": "../common-v1.schema.json#/$defs/hex",
                "description": "the ADNL custom message (overlay.message prefix and object)"
              }
            }
          },
          "description": "overlay_broadcast: messages handed to a member's overlay manager as from an ADNL id"
        },
        "is_any_sender": {
          "type": "boolean"
        },
        "is_fec": {
          "type": "boolean"
        },
        "issued_to": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "32 bytes, lowercase hex"
        },
        "local": {
          "type": "object",
          "required": [
            "burst",
            "period",
            "in_flight_limit"
          ],
          "additionalProperties": false,
          "properties": {
            "burst": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "period": {
              "type": "number",
              "minimum": 60,
              "maximum": 1000000000.0,
              "description": "seconds per token; long enough that no token refills while one context runs"
            },
            "in_flight_limit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        },
        "local_channel_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "the local channel's Ed25519 private key"
        },
        "local_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "32 bytes, lowercase hex"
        },
        "max_sources": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "max_unauth_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "members": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "$ref": "../common-v1.schema.json#/$defs/hex",
            "description": "a boxed Ed25519 PrivateKey"
          },
          "description": "overlay_broadcast: the members of a fixed-member overlay, each run in-process; member 0 sends"
        },
        "message": {
          "$ref": "../common-v1.schema.json#/$defs/hex",
          "description": "bytes signed or verified; for adnl_message a boxed adnl.Message"
        },
        "mode": {
          "enum": [
            "simple",
            "fec",
            "twostep",
            "plumtree"
          ],
          "description": "overlay_broadcast: which broadcast kind the members' options enable"
        },
        "name": {
          "$ref": "../common-v1.schema.json#/$defs/hex",
          "description": "the overlay name an OverlayIdFull is built from"
        },
        "node": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "32 bytes, lowercase hex"
            },
            {
              "$ref": "../common-v1.schema.json#/$defs/hex"
            }
          ],
          "description": "overlay_node: a boxed overlay.node; overlay_member_certificate: the ADNL short id the certificate is for"
        },
        "now": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "original_sender": {
          "type": "boolean"
        },
        "overlay_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "32 bytes, lowercase hex"
        },
        "packets": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "../common-v1.schema.json#/$defs/hex"
          },
          "description": "raw RLDP2 datagrams, fed in order"
        },
        "peer_channel_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "the peer's channel public key, as adnl.message.createChannel carries it"
        },
        "peer_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "32 bytes, lowercase hex"
        },
        "plumtree_enabled": {
          "type": "boolean"
        },
        "private_key": {
          "$ref": "../common-v1.schema.json#/$defs/hex",
          "description": "a TL PrivateKey (boxed): the local node's own key"
        },
        "process": {
          "type": "object",
          "required": [
            "burst",
            "period",
            "in_flight_limit"
          ],
          "additionalProperties": false,
          "properties": {
            "burst": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "period": {
              "type": "number",
              "minimum": 60,
              "maximum": 1000000000.0,
              "description": "seconds per token; long enough that no token refills while one context runs"
            },
            "in_flight_limit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        },
        "public_key": {
          "$ref": "../common-v1.schema.json#/$defs/hex",
          "description": "a TL PublicKey (boxed), as received from a peer"
        },
        "received_symbols_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "regenerate": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777215
          }
        },
        "requests": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": [
              "transfer_id",
              "max_size"
            ],
            "additionalProperties": false,
            "properties": {
              "transfer_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "32 bytes, lowercase hex"
              },
              "max_size": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$",
                "description": "unsigned 64-bit decimal"
              }
            }
          }
        },
        "send": {
          "$ref": "../common-v1.schema.json#/$defs/hex",
          "description": "a boxed adnl.packetContents the channel encrypts and sends"
        },
        "signature": {
          "$ref": "../common-v1.schema.json#/$defs/hex"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "source": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "32 bytes, lowercase hex"
            },
            {
              "type": "object",
              "required": [
                "burst",
                "period",
                "in_flight_limit"
              ],
              "additionalProperties": false,
              "properties": {
                "burst": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                },
                "period": {
                  "type": "number",
                  "minimum": 60,
                  "maximum": 1000000000.0,
                  "description": "seconds per token; long enough that no token refills while one context runs"
                },
                "in_flight_limit": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                }
              }
            }
          ],
          "description": "preauth_gate: the per-source rate; overlay_privacy_rules: the broadcast source key hash"
        },
        "symbol_ids": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777215
          }
        },
        "symbol_size": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "description": "unsigned 64-bit decimal"
            }
          ],
          "description": "rldp2_budget: decimal; otherwise an integer"
        },
        "symbols": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "required": [
              "id",
              "data"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "data": {
                "$ref": "../common-v1.schema.json#/$defs/hex"
              }
            }
          }
        },
        "symbols_count": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "description": "unsigned 64-bit decimal"
            }
          ],
          "description": "rldp2_budget: decimal; otherwise an integer"
        },
        "text": {
          "type": "string",
          "maxLength": 256,
          "description": "an ADNL id in its 55-character text form"
        },
        "transfer_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "32 bytes, lowercase hex"
        },
        "unix_time": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      }
    },
    "effects": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "outcome",
            "adnl_id_text",
            "key_type",
            "serialized",
            "serialized_size",
            "short_id"
          ],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "const": "public_key"
            },
            "adnl_id_text": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "key_type": {
              "enum": [
                "ed25519",
                "aes",
                "unenc",
                "overlay",
                "unknown"
              ]
            },
            "serialized": {
              "$ref": "../common-v1.schema.json#/$defs/hex"
            },
            "serialized_size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "short_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "32 bytes, lowercase hex"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "outcome",
            "key_type",
            "public_key",
            "short_id"
          ],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "const": "private_key"
            },
            "key_type": {
              "enum": [
                "ed25519",
                "aes",
                "unenc",
                "overlay",
                "unknown"
              ]
            },
            "public_key": {
              "$ref": "../common-v1.schema.json#/$defs/hex"
            },
            "short_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "32 bytes, lowercase hex"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "outcome",
            "signature"
          ],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "const": "signature"
            },
            "signature": {
              "$ref": "../common-v1.schema.json#/$defs/hex"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "outcome"
          ],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "const": "verified"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "outcome",
            "ciphertext"
          ],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "const": "ciphertext"
            },
            "ciphertext": {
              "$ref": "../common-v1.schema.json#/$defs/hex"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "outcome",
            "plaintext"
          ],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "const": "plaintext"
            },
            "plaintext": {
              "$ref": "../common-v1.schema.json#/$defs/hex"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "outcome",
            "secret"
          ],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "const": "secret"
            },
            "secret": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "32 bytes, lowercase hex"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "outcome",
            "id",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "const": "adnl_id"
            },
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "32 bytes, lowercase hex"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "outcome",
            "address_list"
          ],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "const": "address_list"
            },
            "address_list": {
              "type": "object",
              "description": "version, reinit_date, priority, expire_at, empty, public_only, has_reverse, addresses (each TL hex), quic, serialized_size, canonical"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "outcome",
            "canonical",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "const": "message"
            },
            "canonical": {
              "oneOf": [
                {
                  "$ref": "../common-v1.schema.json#/$defs/hex"
                },
                {
                  "type": "null"
                }
              ]
            },
            "message": {
              "type": "object",
              "description": "type and size (the node's size accounting), and the fields of that type"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "outcome",
            "packet"
          ],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "const": "packet"
            },
            "packet": {
              "type": "object",
              "description": "the fields AdnlPacket extracted, to_sign, canonical re-serialization and signature_check"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "outcome",
            "from_short",
            "packet"
          ],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "const": "received"
            },
            "from_short": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "32 bytes, lowercase hex"
            },
            "packet": {
              "type": "object",
              "description": "the fields AdnlPacket extracted, to_sign, canonical re-serialization and signature_check"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "outcome",
            "in_id",
            "out_id",
            "received",
            "sent"
          ],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "const": "channel"
            },
            "in_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "32 bytes, lowercase hex"
            },
            "out_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "32 bytes, lowercase hex"
            },
            "received": {
              "oneOf": [
                {
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "description": "{\"packet\": ...} or {\"reason\": <class>}, or null"
            },
            "sent": {
              "oneOf": [
                {
                  "$ref": "../common-v1.schema.json#/$defs/hex"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "outcome",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "const": "source"
            },
            "source": {
              "type": "object",
              "description": "{ip, port} of the pre-authentication source key"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "outcome",
            "held",
            "results",
            "sources"
          ],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "const": "gate"
            },
            "held": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "results": {
