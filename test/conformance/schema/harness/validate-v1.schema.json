{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conformance/harness/validate-v1",
  "title": "validate harness: the node's block-candidate validation (ValidateQuery) of one candidate, offline",
  "$defs": {
    "block_id": {
      "type": "object",
      "required": ["workchain", "shard", "seqno", "root_hash", "file_hash"],
      "additionalProperties": false,
      "properties": {
        "workchain": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "shard": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "seqno": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "root_hash": {"$ref": "../common-v1.schema.json#/$defs/hash"},
        "file_hash": {"$ref": "../common-v1.schema.json#/$defs/hash"}
      }
    },
    "context": {
      "type": "object",
      "required": ["block_id", "block", "created_by", "prev", "min_masterchain", "top_masterchain", "validator_set_from", "states"],
      "additionalProperties": false,
      "properties": {
        "block_id": {"$ref": "#/$defs/block_id", "description": "BlockCandidate id; its file hash is checked against the bytes of block"},
        "block": {"$ref": "../common-v1.schema.json#/$defs/boc", "description": "The candidate block, exactly as received"},
        "collated_data": {"$ref": "../common-v1.schema.json#/$defs/boc", "description": "Collated data (a BOC with any number of roots: TopBlockDescrSet, ConsensusExtraData); absent means none"},
        "created_by": {"$ref": "../common-v1.schema.json#/$defs/hash", "description": "BlockCandidate producer"},
        "prev": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/block_id"}, "description": "ValidateParams prev"},
        "min_masterchain": {"$ref": "#/$defs/block_id", "description": "ValidateParams min_masterchain_block_id"},
        "top_masterchain": {"$ref": "#/$defs/block_id", "description": "The block whose state answers get_top_masterchain_state_block"},
        "validator_set_from": {"$ref": "#/$defs/block_id", "description": "Masterchain state the validator group's set is computed from, as the validator manager does"},
        "skip_shard_signatures": {"type": "boolean", "description": "ValidateParams is_fake: signatures of shard top descriptions are not checked (they are not archived)"},
        "states": {"type": "array", "maxItems": 32, "description": "Every state the validator manager serves: a state, or a Merkle proof of it holding the cells the validation reads",
          "items": {"type": "object", "required": ["block", "state"], "additionalProperties": false,
            "properties": {"block": {"$ref": "#/$defs/block_id"}, "state": {"$ref": "../common-v1.schema.json#/$defs/boc"}}}}
      }
    },
    "effects": {
      "oneOf": [
        {"type": "object", "required": ["outcome", "ok_from_utime_ms"], "additionalProperties": false,
         "properties": {
           "outcome": {"const": "accepted"},
           "ok_from_utime_ms": {"type": "integer", "minimum": 0, "description": "CandidateAccept ok_from_utime, in milliseconds"}
         }},
        {"type": "object", "required": ["outcome", "reason"], "additionalProperties": false,
         "properties": {
           "outcome": {"const": "rejected"},
           "reason": {"$ref": "#/$defs/reason"}
         }},
        {"type": "object", "required": ["outcome", "reason"], "additionalProperties": false, "description": "The validation stopped without a verdict (a fatal error, e.g. an input the manager does not have)",
         "properties": {
           "outcome": {"const": "error"},
           "reason": {"$ref": "#/$defs/reason"}
         }}
      ]
    },
    "reason": {"enum": ["input_unavailable", "candidate_id_mismatch", "shard_mismatch", "prev_block_mismatch", "creator_mismatch", "validator_set_mismatch", "prev_state_mismatch", "new_state_mismatch", "limit_exceeded", "utime_lt_invalid", "value_flow_invalid", "account_update_invalid", "transaction_invalid", "message_invalid", "pruned_input", "unclassified"]}
  }
}
