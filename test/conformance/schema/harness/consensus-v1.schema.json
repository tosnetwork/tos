          "enum": [
            "quorum",
            "weight_total",
            "protocol_version",
            "session",
            "validator_set",
            "vote",
            "finality",
            "decode_proof",
            "proof_link",
            "key_block_context"
          ],
          "description": "operation; each op requires its own subset of the fields below (runner/harnesses/consensus.py OP_REQUIRED)"
        },
        "total_weight": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "description": "unsigned 64-bit decimal"
        },
        "signed_weight": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "description": "unsigned 64-bit decimal"
        },
        "weights": {
          "type": "array",
          "maxItems": 4096,
