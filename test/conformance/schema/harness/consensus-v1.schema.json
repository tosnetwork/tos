                "type": "object",
                "required": [
                  "ed25519",
                  "weight",
                  "adnl"
                ],
                "additionalProperties": false,
                "properties": {
                  "ed25519": {
                    "$ref": "../common-v1.schema.json#/$defs/hash"
                  },
                  "weight": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,19})$",
                    "description": "unsigned 64-bit decimal"
                  },
                  "adnl": {
                    "$ref": "../common-v1.schema.json#/$defs/hash"
                  }
                }
              }
