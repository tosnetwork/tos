{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conformance/common-v1",
  "title": "Shared conformance value types",
  "$defs": {
    "boc": {
      "description": "A bag of cells with one root: inline base64 (standard alphabet), or a reference to the family's <family>.blobs.json by the SHA-256 of the BOC bytes. The runner inlines references before a context reaches a target.",
      "oneOf": [
        {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$"},
        {"type": "object", "required": ["blob"], "additionalProperties": false, "properties": {"blob": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
      ]
    },
    "hash": {"type": "string", "description": "Cell representation hash, uppercase hex as printed by the C++ node", "pattern": "^[0-9A-F]{64}$"},
    "hex": {"type": "string", "description": "Raw bytes, lowercase hex", "pattern": "^(?:[0-9a-f]{2})*$"},
    "stack_item": {
      "description": "Input stack value. int values are decimal strings so 257-bit integers survive JSON.",
      "oneOf": [
        {"type": "object", "required": ["type"], "additionalProperties": false, "properties": {"type": {"const": "null"}}},
        {"type": "object", "required": ["type"], "additionalProperties": false, "properties": {"type": {"const": "nan"}}},
        {"type": "object", "required": ["type", "value"], "additionalProperties": false, "properties": {"type": {"const": "int"}, "value": {"type": "string", "pattern": "^-?[0-9]{1,80}$"}}},
        {"type": "object", "required": ["type", "boc"], "additionalProperties": false, "properties": {"type": {"enum": ["cell", "slice"]}, "boc": {"$ref": "#/$defs/boc"}}},
        {"type": "object", "required": ["type", "items"], "additionalProperties": false, "properties": {"type": {"const": "tuple"}, "items": {"type": "array", "maxItems": 255, "items": {"$ref": "#/$defs/stack_item"}}}}
      ]
    },
    "stack_text": {"type": "array", "description": "Final stack bottom first, canonical text per value (README)", "items": {"type": "string"}}
  }
}
