;; Sends the outbound message stored in its data, then fails the action phase
;; with a reservation no account can cover. The first action succeeds; the
;; second makes the whole phase fail with "not enough funds" (37).
() recv_internal(int balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
  if (in_msg_body.slice_empty?()) {
    return ();
  }
  slice ds = get_data().begin_parse();
  send_raw_message(ds~load_ref(), 0);
  raw_reserve(1000000000000000000000, 0);
}
