import "@stdlib/token"

struct TokenAuthorTrialStorage {
    totalSupply: coins;
    adminAddress: any_address;
    content: cell;
    tokenWalletCode: cell;
}

struct (TOKEN_OP_MINT) TokenAuthorTrialMint {
    queryId: uint64;
    toAddress: any_address;
    amount: coins;
    masterMsg: cell;
}

fun scaffoldPatternId(): int {
    return tokenPatternManifestHeader().patternId;
}

contract TokenAuthorTrial {
    storage: TokenAuthorTrialStorage
    @unknown_throw(65535);

    @disclaim_query_id
    receive(msg: TokenAuthorTrialMint) {
        require(tokenSameInternalAndAnyAddressBits(in.senderAddress, storage.adminAddress),
                ErrorClass.Authorization, TOKEN_MINTER_FUNC_THROW_ADMIN_REQUIRED);
        msg.masterMsg;
        save(storage);
    }
}
