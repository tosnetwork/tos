// DexPriceOracle — production-intent TOS/USDC spot price oracle.
// Backed by @stdlib/oracle with a fixed-at-deploy reporter set and 2-of-N quorum.
// Reporters submit price observations; the contract auto-finalizes when quorum is met.
tol 1.3

import "@stdlib/oracle"

// Opcode namespace: 0x44584f xx (ASCII "DSO\xx")
const DEX_PRICE_ORACLE_OP_START_ROUND: uint32  = 0x44584f01
const DEX_PRICE_ORACLE_OP_PRICE_REPORT: uint32 = 0x44584f02

// Pair IDs. Only TOS/USDC is served by this deploy.
const DEX_PRICE_ORACLE_PAIR_TOS_USDC: uint32 = 1

// Error codes. Base 0x0f00 (3840); all >= 1024 per Slice 5 policy.
const DEX_PRICE_ORACLE_THROW_WRONG_PAIR: int      = 0x0f01  // 3841
const DEX_PRICE_ORACLE_THROW_NO_ACTIVE_ROUND: int = 0x0f02  // 3842
const DEX_PRICE_ORACLE_THROW_UNAUTHORIZED_REPORTER_ADDRESS: int = 0x0f03  // 3843

struct DexPriceOracleReporterAddresses {
    reporter1: address
    reporter2: address
    reporter3: address
}

struct DexPriceOracleStorage {
    config: Cell<Slice5OracleConfig>
    oracleState: Cell<Slice5OracleState>
    reporterAddresses: Cell<DexPriceOracleReporterAddresses>
    pairId: uint32
}

struct (DEX_PRICE_ORACLE_OP_START_ROUND) DexPriceStartRound {
    queryId: uint64
    roundId: uint64
    pairId: uint32
    now: uint32
}

struct (DEX_PRICE_ORACLE_OP_PRICE_REPORT) DexPriceReport {
    queryId: uint64
    roundId: uint64
    pairId: uint32
    // Wire-compatibility field only. Receive handlers derive reporter identity
    // from in.senderAddress and never trust this caller-controlled value.
    reporterKey: uint256
    priceNano: uint64
    // Wire-compatibility field only. Receive handlers use blockchain.now().
    now: uint32
}

fun dexPriceOracleResolveReporterKey(
    sender: address,
    reporter1: address,
    reporter2: address,
    reporter3: address
): uint256 {
    if (sender == reporter1) { return 1; }
    if (sender == reporter2) { return 2; }
    if (sender == reporter3) { return 3; }
    throw DEX_PRICE_ORACLE_THROW_UNAUTHORIZED_REPORTER_ADDRESS;
}

contract DexPriceOracle {
    storage: DexPriceOracleStorage
    @unknown_throw(0xffff);

    // Round starts are restricted by Slice5OracleConfig.roundStarter.
    @disclaim_query_id
    receive(msg: DexPriceStartRound) {
        if (msg.pairId != storage.pairId) {
            throw DEX_PRICE_ORACLE_THROW_WRONG_PAIR;
        }
        val config = lazy Slice5OracleConfig.fromCell(storage.config);
        var state = lazy Slice5OracleState.fromCell(storage.oracleState);
        slice5OracleStartRound(mutate state, config, msg.roundId, blockchain.now() as uint32, in.senderAddress);
        save(DexPriceOracleStorage {
            config: storage.config,
            oracleState: state.toCell(),
            reporterAddresses: storage.reporterAddresses,
            pairId: storage.pairId,
        });
    }

    // Authorized reporters submit price observations. Auto-finalizes when quorum is reached.
    @disclaim_query_id
    receive(msg: DexPriceReport) {
        if (msg.pairId != storage.pairId) {
            throw DEX_PRICE_ORACLE_THROW_WRONG_PAIR;
        }
        val config = lazy Slice5OracleConfig.fromCell(storage.config);
        var state = lazy Slice5OracleState.fromCell(storage.oracleState);
        if (state.current == null) {
            throw DEX_PRICE_ORACLE_THROW_NO_ACTIVE_ROUND;
        }
        var round = lazy Slice5OracleRound.fromCell(state.current!);
        val addrs = lazy DexPriceOracleReporterAddresses.fromCell(storage.reporterAddresses);
        val reporterKey = dexPriceOracleResolveReporterKey(
            in.senderAddress, addrs.reporter1, addrs.reporter2, addrs.reporter3
        );
        val now = blockchain.now() as uint32;
        val wireReport = Slice5OracleReport {
            queryId: msg.queryId,
            roundId: msg.roundId,
            reporterKey,
            value: msg.priceNano,
            now,
        };
        round.addTrustedReport(state.reporterSet, config, wireReport, reporterKey, now);
        if (round.reportCount >= config.quorum && !round.finalized) {
            val wireFinalize = Slice5OracleFinalize {
                queryId: msg.queryId,
                roundId: msg.roundId,
                now,
            };
            round.finalizeTrusted(config, wireFinalize, now);
        }
        state.current = round.toCell();
        save(DexPriceOracleStorage {
            config: storage.config,
            oracleState: state.toCell(),
            reporterAddresses: storage.reporterAddresses,
            pairId: storage.pairId,
        });
    }

    // Returns the latest finalized price in nanoUSDC per TOS. Returns 0 if no round is finalized.
    @method_id(0x1d00)
    get fun getLatestPrice(): uint64 {
        val state = lazy Slice5OracleState.fromCell(storage.oracleState);
        if (state.current == null) {
            return 0;
        }
        val round = lazy Slice5OracleRound.fromCell(state.current!);
        if (!round.finalized) {
            return 0;
        }
        return round.medianValue!;
    }

    // Returns the last started roundId (monotonically increasing, 0 before first round).
    @method_id(0x1d01)
    get fun getLastRoundId(): uint64 {
        val state = lazy Slice5OracleState.fromCell(storage.oracleState);
        return state.lastRoundId;
    }
}
