(slice, (int, int, int)) load_fees(slice s) inline {
    var fees = (s~load_coins(), s~load_coins(), s~load_uint(14));
    return (s, fees);
}

builder store_fees(builder b, (int, int, int) fees) inline {
    (int flat_reward, int network_fee, int factor) = fees;
    throw_if(391, factor > 10000);
    ;; Every accepted swap pays a fixed 0.1 receipt out of the bridge balance
    ;; (see create_swap_from_tos). The network fee must cover that receipt plus
    ;; headroom for forwarding costs, or every swap would drain the bridge by
    ;; the shortfall. Rejecting such a configuration here means no vote can
    ;; ever install a fee schedule that makes swaps lossy for the bridge.
    throw_unless(392, network_fee >= 110000000); ;; 0.1 receipt + 0.01 headroom
    return b.store_coins(flat_reward).store_coins(network_fee).store_uint(factor, 14);
}

(int, int, slice, (int, int, int)) load_data() inline_ref {
    var ds = get_data().begin_parse();
    return (ds~load_uint(8), ds~load_coins(), ds~load_msg_addr(), ds~load_fees());
}

() save_data(int state_flags, int total_locked, slice collector_address, fees) impure inline_ref {
    var st = begin_cell().store_uint(state_flags, 8) ;; 0 - TOS->EVM transfers enabled; 1 - TOS->EVM transfers disabled
            .store_coins(total_locked)
            .store_slice(collector_address)
            .store_fees(fees)
            .end_cell();
    set_data(st);
}

int calculate_fee(int msg_value, fees) impure {
    (int flat_reward, int network_fee, int factor) = fees;
    int remain = msg_value - flat_reward - network_fee;
    throw_unless(400, remain > 0);
    int percent_fee = remain * factor / 10000;
    return flat_reward + network_fee + percent_fee;
}

;; create swap to external chain to destination address
() create_swap_from_tos(int destination_address, int amount, slice s_addr, int query_id, int is_text) impure {
    (int state_flags, int total_locked, slice collector_address, var fees) = load_data();
    throw_if(339, state_flags & 1);
    ;; A zero destination is unspendable on the external chain: wrapped coins
    ;; minted to it are burned forever while the native coins stay locked.
    throw_unless(307, destination_address != 0);
    int fee = calculate_fee(amount, fees);
    amount -= fee;
    throw_unless(306, amount > 0);
    total_locked += amount;
    emit_log_simple(0xc0470ccf, begin_cell().store_uint(destination_address, 160).store_uint(amount, 64).end_cell().begin_parse());
    save_data(state_flags, total_locked, collector_address, fees);
    ;; The 0.1 receipt below is paid from the bridge balance (mode 3). It is
    ;; funded by the fee retained above: store_fees guarantees
    ;; network_fee >= 110000000, and calculate_fee charges at least
    ;; network_fee, so every accepted swap leaves the bridge with more than
    ;; the receipt costs and the balance backing total_locked never shrinks.
    if(is_text) {
        return send_text_receipt_message(s_addr, 100000000, 3);
    } else {
        return send_receipt_message(s_addr, 0x10000 + 3, query_id, 0, 100000000, 3);
    }
}

() process_comment_api_request (slice in_msg, int msg_value, slice s_addr) impure {
    if (in_msg.slice_empty?() & (in_msg.slice_refs() == 1)) {
        cell _cont = in_msg~load_ref();
        in_msg = _cont.begin_parse();
    }
    int command = in_msg~load_uint(56);
    throw_unless(328, command == 32500882701840163); ;; "swapTo#" other commands are unsupported
    int destination_address = in_msg~load_text_hex_number(20);
    in_msg.end_parse();
    return create_swap_from_tos(destination_address, msg_value, s_addr, 0, true);
}

() execute_voting (slice s_addr, slice voting_data, int bridge_address) impure {
    (int state_flags, int total_locked, slice collector_address, var fees) = load_data();

    int operation = voting_data~load_uint(8);
    if (operation == 0) { ;; swap

        (int ext_chain_hash,
                int internal_index,
                int wc,
                int addr_hash,
                int swap_amount) = (voting_data~load_uint(256),
                voting_data~load_int(16),
                voting_data~load_int(8),
                voting_data~load_uint(256),
                voting_data~load_uint(64));
        int fee = calculate_fee(swap_amount, fees);
        total_locked -= swap_amount;
        throw_unless(315, total_locked >= 0);
        swap_amount -= fee;


        var msg = begin_cell()
                .store_uint(0x10, 6) ;; non-bounceable
                .store_uint(4, 3).store_int(wc, 8).store_uint(addr_hash, 256)
                .store_coins(swap_amount)
                .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
                .store_uint(ext_chain_hash, 256)
                .store_uint(internal_index, 16);
        send_raw_message(msg.end_cell(), 0);

    } elseif (operation == 3) { ;; update state flags

        state_flags = voting_data~load_uint(8);

    } elseif (operation == 4) { ;; migrate

        ;; Move the locked funds to the bridge address currently named by the
        ;; network configuration. The message is bounceable and carries exactly
        ;; total_locked (mode 1: fees are paid on top, from the bridge's own
        ;; balance). The receiving bridge credits its total_locked in its 0xf00d
        ;; branch; if the destination rejects the message, the bounce handler in
        ;; recv_internal re-credits the returned value here, so a failed migrate
        ;; leaves the funds locked instead of stranding them as sweepable
        ;; balance. A destination that accepts the message but does not
        ;; implement 0xf00d still keeps the coins, so pointing the configuration
        ;; at a wrong contract remains an oracle-quorum responsibility.
        var msg = begin_cell()
                .store_uint(0x18, 6) ;; bounceable
                .store_uint(4, 3).store_int(-1, 8).store_uint(bridge_address, 256)
                .store_coins(total_locked)
                .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
                .store_uint(0xf00d, 32); ;; new bridge contract should recognize this opcode
        send_raw_message(msg.end_cell(), 1);
        ;; The funds are no longer backed by this contract's balance. Zeroing the
        ;; counter keeps the invariant balance >= total_locked and stops a later
        ;; reward sweep (operation 5) from reserving coins that already left.
        total_locked = 0;

    } elseif (operation == 5) { ;; get reward

        ;; reserve total_locked + 100 TOS for storage fees
        raw_reserve(total_locked + 100000000000, 2);
        var msg = begin_cell()
                .store_uint(0x18, 6) ;; bounceable
                .store_slice(s_addr)
                .store_coins(0)
                .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1);
        send_raw_message(msg.end_cell(), 128); ;; send all the remainings

    } elseif (operation == 6) { ;; change fees

        fees = voting_data~load_fees();

    } elseif (operation == 7) { ;; change collector

        collector_address = voting_data~load_msg_addr();

    }

    save_data(state_flags, total_locked, collector_address, fees);
}

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    var cs = in_msg_cell.begin_parse();
    var flags = cs~load_uint(4);  ;; int_msg_info$0 ihr_disabled:Bool bounce:Bool bounced:Bool
    if (flags & 1) {
        ;; Bounced messages are ignored, with one exception: a bounced migration
        ;; transfer. When the migrate operation's 0xf00d message is rejected by
        ;; its destination, the value comes back here and must be locked again —
        ;; otherwise it would sit in the plain balance where a reward sweep
        ;; (operation 5) could move it to the collector. Crediting msg_value is
        ;; safe from any source: the balance and total_locked rise by the same
        ;; amount, so the coins are genuinely locked. (The returned value is the
        ;; sent amount net of forwarding fees, which only lowers total_locked
        ;; relative to the balance, never above it.)
        if (in_msg.slice_bits() >= 64) {
            in_msg~load_uint(32); ;; bounce marker 0xffffffff
            if (in_msg~load_uint(32) == 0xf00d) {
                (int state_flags, int total_locked, slice collector_address, var fees) = load_data();
                total_locked += msg_value;
                save_data(state_flags, total_locked, collector_address, fees);
            }
        }
        return ();
    }
    slice s_addr = cs~load_msg_addr();
    throw_if(299, in_msg.slice_empty?()); ;; inbound message has empty body

    int op = in_msg~load_uint(32);
    if (op == 0xf00d) {
        ;; Migration credit sent by a previous bridge instance (migrate
        ;; operation). The attached value becomes locked liquidity backing swaps
        ;; that were recorded before the migration. Accepting it from any sender
        ;; is safe: the balance and total_locked rise by the same amount, so
        ;; nothing becomes spendable that was not paid in, and no other handler
        ;; keys off this opcode. Without this branch the migrated funds would
        ;; land as plain balance — sweepable by a reward vote — while the new
        ;; bridge's total_locked stayed zero and every release failed.
        (int state_flags, int total_locked, slice collector_address, var fees) = load_data();
        total_locked += msg_value;
        save_data(state_flags, total_locked, collector_address, fees);
        return ();
    }
    (int bridge_address, int oracles_address, _) = get_bridge_config();
    (int wc, int addr) = parse_std_addr(s_addr);
    var is_oracles = (wc == -1) & (oracles_address == addr);

    if (op == 4) {
        throw_unless(305, is_oracles);
        return execute_voting(s_addr, in_msg, bridge_address);
    }
    throw_if(306, is_oracles); ;; don't allow to create swaps from oracles multisig
    if (op == 0) {
        return process_comment_api_request(in_msg, msg_value, s_addr);
    }
    int query_id = in_msg~load_uint(64);
    if (op == 3) {
        int destination_address = in_msg~load_uint(160);
        return create_swap_from_tos(destination_address, msg_value, s_addr, query_id, false);
    }
}

;; get methods

_ get_bridge_data() method_id {
    (int state_flags, int total_locked, slice collector_address_slice, var fees) = load_data();
    (int flat_reward, int network_fee, int factor) = fees;
    (int wc, int addr) = parse_std_addr(collector_address_slice);
    return (state_flags, total_locked, wc, addr, flat_reward, network_fee, factor, 10000);
}
