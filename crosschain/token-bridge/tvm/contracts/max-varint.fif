#!/usr/bin/env fift -s
"TosUtil.fif" include

// 0 tos - 4 bit

<b 0 Tomi, bbits .s

// 1 nanotomi - 12 bit

<b 1 Tomi, bbits .s

// 1 tos - 36 bit

<b 1000000000 Tomi, bbits .s

// 5 tos - 44 bit

<b 5000000000 Tomi, bbits .s

// 10 tos - 44 bit

<b 10000000000 Tomi, bbits .s

// 5B tos - 68 bit (decimals 9)

<b 5000000000000000000 Tomi, bbits .s

// 120M ether - 92 bit (decimals 18)

<b 120000000000000000000000000 Tomi, bbits .s

// 1 trillion BUSD - 108 bits (decimals 18)

<b 1000000000000000000000000000000 Tomi, bbits .s

// max Varuint 16 value - 2^120 -1 - 124 bit

<b 1 120 << 1 - Tomi, bbits .s

// overflow error

<b 1 120 << Tomi, bbits .s