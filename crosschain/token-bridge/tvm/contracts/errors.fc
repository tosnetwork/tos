;; global errors
const int error::inbound_message_has_empty_body = 200;
const int error::unknown_op = 0xffff;
const int error::unknown_execute_voting_op = 211;

;; data errors
const int error::incorrect_voting_data = 320;
const int error::decimals_out_of_range = 330;

;; wrong sender errors
const int error::oracles_sender = 400;
const int error::oracles_not_sender = 401;
const int error::minter_not_sender = 402;
const int error::bridge_not_sender = 403;
const int error::owner_not_sender = 404;
const int error::operation_suspended = 704;

;; token wallet errors
const int error::unauthorized_transfer = 705;
const int error::not_enough_funds = 706;
const int error::unauthorized_incoming_transfer = 707;
const int error::malformed_forward_payload = 708;
const int error::not_enough_tos = 709;
const int error::burn_fee_not_matched = 710;
;; A reported transfer names a destination that is not a canonical address on
;; the basechain: addr_std, no anycast, workchain 0.
const int error::not_canonical_destination = 711;
;; A reported transfer reuses a query id whose refusal is still recorded.
const int error::refusal_pending = 712;
;; A reported transfer's body to the recipient's wallet, forward payload
;; included, has more than REPORTED_BODY_CELLS cells.
const int error::payload_too_large = 713;
;; A reported transfer while the wallet holds REFUSALS_LIMIT recorded refusals.
const int error::refusals_full = 714;
;; An internal_transfer_reported that does not itself pay for R_GAS_LIMIT.
const int error::reported_underfunded = 715;

;; token minter errors
const int error::discovery_fee_not_matched = 75;

;; token bridge errors
const int error::wrong_external_chain_id = 410;
const int error::wrong_sender_workchain = 413;
const int error::mint_fee_not_matched = 407;
const int error::mint_fee_less_forward = 399;
;; Codes 390, 391 and 393 to 395 were declared for an earlier completion
;; design and 398 for a swap forward amount the vote no longer carries;
;; nothing threw them, and they are removed and left unassigned (NOTICE.md
;; item 14). 392 was never a token-bridge code.
;; A burn names a destination on the counterparty chain. The zero address is
;; not one: the ERC-20 transfer that would release the tokens there fails, and
;; by then the tokens on this side are already destroyed. Refusing here is the
;; last point at which the user still has them.
const int error::zero_destination = 397;
;; A mint whose fee nobody paid. pay_swap records the payment and this is the
;; check that spends it, so the multisig never mints out of its own balance.
const int error::swap_not_paid = 396;
;; A wallet balance never exceeds the wrapped token's supply bound, 2^120 - 1.
const int error::supply_bound = 389;

const int error::no_bridge_config = 666;