;; Generated from the pinned TON token bridge params.fc.
;; TOS masterchain ConfigParam 82 selects EVM chain 137.
const int CONFIG_PARAM_ID = 82;
const int MY_CHAIN_ID = 137;
const int LOG_BURN = 0xc0470ccf;
const int LOG_SWAP_PAID = 0xc0550ccf;
const int LOG_MINT_ON_MINTER = 0xc0660ccf;
const int LOG_BURN_ON_MINTER = 0xc0770ccf;

const int WORKCHAIN = 0;

() force_chain(slice addr) impure {
  (int wc, _) = parse_std_addr(addr);
  throw_unless(333, wc == WORKCHAIN);
}
