if (ANDROID AND NOT DEFINED TOS_ANDROID_THIRD_PARTY_DIR)
  if (DEFINED ENV{ANDROID_NDK_ROOT})
    set(TOS_ANDROID_NDK_ROOT "$ENV{ANDROID_NDK_ROOT}")
  elseif (ANDROID_NDK)
    set(TOS_ANDROID_NDK_ROOT "${ANDROID_NDK}")
  elseif (CMAKE_ANDROID_NDK)
    set(TOS_ANDROID_NDK_ROOT "${CMAKE_ANDROID_NDK}")
  else()
    message(FATAL_ERROR "ANDROID_NDK_ROOT is not set (and ANDROID_NDK/CMAKE_ANDROID_NDK not provided).")
  endif()

  if (DEFINED ANDROID_ABI)
    set(TOS_ANDROID_ABI "${ANDROID_ABI}")
  elseif (DEFINED CMAKE_ANDROID_ARCH_ABI)
    set(TOS_ANDROID_ABI "${CMAKE_ANDROID_ARCH_ABI}")
  else()
    message(FATAL_ERROR "ANDROID_ABI is not set; pass -DANDROID_ABI or use Android toolchain.")
  endif()

  set(TOS_ANDROID_THIRD_PARTY_DIR "${CMAKE_CURRENT_BINARY_DIR}/android/third_party")

  if (TOS_ANDROID_ABI STREQUAL "armeabi-v7a")
    set(TOS_ANDROID_ARCH "arm")
    set(TOS_ANDROID_ARCH_DIR "armv7")
    set(TOS_ANDROID_SODIUM_DIR "libsodium-android-armv7-a")
    set(TOS_ANDROID_OPENSSL_DIR "arm")
    set(TOS_ANDROID_HOST "arm-linux-androideabi")
    set(TOS_ANDROID_CLANG_PREFIX "armv7a-linux-androideabi")
  elseif (TOS_ANDROID_ABI STREQUAL "arm64-v8a")
    set(TOS_ANDROID_ARCH "arm64")
    set(TOS_ANDROID_ARCH_DIR "armv8")
    set(TOS_ANDROID_SODIUM_DIR "libsodium-android-armv8-a")
    set(TOS_ANDROID_OPENSSL_DIR "arm64")
    set(TOS_ANDROID_HOST "aarch64-linux-android")
    set(TOS_ANDROID_CLANG_PREFIX "aarch64-linux-android")
  elseif (TOS_ANDROID_ABI STREQUAL "x86")
    set(TOS_ANDROID_ARCH "x86")
    set(TOS_ANDROID_ARCH_DIR "i686")
    set(TOS_ANDROID_SODIUM_DIR "libsodium-android-i686")
    set(TOS_ANDROID_OPENSSL_DIR "x86")
    set(TOS_ANDROID_HOST "i686-linux-android")
    set(TOS_ANDROID_CLANG_PREFIX "i686-linux-android")
  elseif (TOS_ANDROID_ABI STREQUAL "x86_64")
    set(TOS_ANDROID_ARCH "x86_64")
    set(TOS_ANDROID_ARCH_DIR "x86-64")
    set(TOS_ANDROID_SODIUM_DIR "libsodium-android-westmere")
    set(TOS_ANDROID_OPENSSL_DIR "x86_64")
    set(TOS_ANDROID_HOST "x86_64-linux-android")
    set(TOS_ANDROID_CLANG_PREFIX "x86_64-linux-android")
  else()
    message(FATAL_ERROR "Unsupported ANDROID_ABI: ${TOS_ANDROID_ABI}")
  endif()

  if (CMAKE_ANDROID_API)
    set(TOS_ANDROID_API "${CMAKE_ANDROID_API}")
  elseif (ANDROID_PLATFORM)
    string(REGEX REPLACE "android-" "" TOS_ANDROID_API "${ANDROID_PLATFORM}")
  elseif (ANDROID_NATIVE_API_LEVEL)
    set(TOS_ANDROID_API "${ANDROID_NATIVE_API_LEVEL}")
  else()
    set(TOS_ANDROID_API "21")
  endif()

  set(TOS_ANDROID_NDK_PREBUILT_DIR "${TOS_ANDROID_NDK_ROOT}/toolchains/llvm/prebuilt")
  set(TOS_ANDROID_NDK_BIN "")
  set(TOS_ANDROID_HOST_TAG "")
  set(_tos_host_arch "")
  if (CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
    set(_tos_host_arch "arm64")
  elseif (CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64)$")
    set(_tos_host_arch "x86_64")
  elseif (CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^i.86$")
    set(_tos_host_arch "x86")
  endif()

  set(_tos_host_tag_candidates "")
  if (WIN32)
    list(APPEND _tos_host_tag_candidates "windows-x86_64" "windows")
  elseif (APPLE)
    if (_tos_host_arch STREQUAL "arm64")
      list(APPEND _tos_host_tag_candidates "darwin-arm64" "darwin-x86_64")
    else()
      list(APPEND _tos_host_tag_candidates "darwin-x86_64" "darwin-arm64")
    endif()
  else()
    if (_tos_host_arch STREQUAL "arm64")
      list(APPEND _tos_host_tag_candidates "linux-arm64" "linux-aarch64" "linux-x86_64")
    else()
      list(APPEND _tos_host_tag_candidates "linux-x86_64")
    endif()
  endif()

  foreach(_tos_host_tag IN LISTS _tos_host_tag_candidates)
    if (EXISTS "${TOS_ANDROID_NDK_PREBUILT_DIR}/${_tos_host_tag}/bin")
      set(TOS_ANDROID_NDK_BIN "${TOS_ANDROID_NDK_PREBUILT_DIR}/${_tos_host_tag}/bin")
      set(TOS_ANDROID_HOST_TAG "${_tos_host_tag}")
      break()
    endif()
  endforeach()

  if (TOS_ANDROID_NDK_BIN STREQUAL "")
    file(GLOB _tos_ndk_bins "${TOS_ANDROID_NDK_PREBUILT_DIR}/*/bin")
    list(LENGTH _tos_ndk_bins _tos_ndk_bins_len)
    if (_tos_ndk_bins_len GREATER 0)
      list(GET _tos_ndk_bins 0 TOS_ANDROID_NDK_BIN)
      get_filename_component(_tos_host_tag_dir "${TOS_ANDROID_NDK_BIN}" DIRECTORY)
      get_filename_component(TOS_ANDROID_HOST_TAG "${_tos_host_tag_dir}" NAME)
    endif()
  endif()

  if (TOS_ANDROID_NDK_BIN STREQUAL "")
    message(FATAL_ERROR "Android NDK bin path not found under ${TOS_ANDROID_NDK_PREBUILT_DIR}.")
  endif()

  set(TOS_ANDROID_CC "${TOS_ANDROID_NDK_BIN}/${TOS_ANDROID_CLANG_PREFIX}${TOS_ANDROID_API}-clang")
  if (NOT EXISTS "${TOS_ANDROID_CC}")
    file(GLOB TOS_ANDROID_CLANG_CANDIDATES
      "${TOS_ANDROID_NDK_BIN}/${TOS_ANDROID_CLANG_PREFIX}[0-9]*-clang")
    set(TOS_ANDROID_CLANG_MAX "")
    foreach(TOS_ANDROID_CLANG_CANDIDATE IN LISTS TOS_ANDROID_CLANG_CANDIDATES)
      get_filename_component(TOS_ANDROID_CLANG_FILE "${TOS_ANDROID_CLANG_CANDIDATE}" NAME)
      string(REGEX REPLACE "^${TOS_ANDROID_CLANG_PREFIX}([0-9]+)-clang$" "\\1"
        TOS_ANDROID_CLANG_VER "${TOS_ANDROID_CLANG_FILE}")
      if (TOS_ANDROID_CLANG_VER MATCHES "^[0-9]+$")
        if (TOS_ANDROID_CLANG_MAX STREQUAL "" OR TOS_ANDROID_CLANG_VER GREATER TOS_ANDROID_CLANG_MAX)
          set(TOS_ANDROID_CLANG_MAX "${TOS_ANDROID_CLANG_VER}")
        endif()
      endif()
    endforeach()
    if (TOS_ANDROID_CLANG_MAX STREQUAL "")
      message(FATAL_ERROR "No NDK clang found for ${TOS_ANDROID_CLANG_PREFIX} under ${TOS_ANDROID_NDK_BIN}.")
    endif()
    message(STATUS "Requested Android API ${TOS_ANDROID_API} not available for ${TOS_ANDROID_ABI}; falling back to ${TOS_ANDROID_CLANG_MAX}.")
    set(TOS_ANDROID_API "${TOS_ANDROID_CLANG_MAX}")
    set(TOS_ANDROID_CC "${TOS_ANDROID_NDK_BIN}/${TOS_ANDROID_CLANG_PREFIX}${TOS_ANDROID_API}-clang")
  endif()

  set(TOS_ANDROID_CC "${TOS_ANDROID_NDK_BIN}/${TOS_ANDROID_CLANG_PREFIX}${TOS_ANDROID_API}-clang")
  set(TOS_ANDROID_CXX "${TOS_ANDROID_NDK_BIN}/${TOS_ANDROID_CLANG_PREFIX}${TOS_ANDROID_API}-clang++")
  set(TOS_ANDROID_AR "${TOS_ANDROID_NDK_BIN}/llvm-ar")
  set(TOS_ANDROID_RANLIB "${TOS_ANDROID_NDK_BIN}/llvm-ranlib")
  set(TOS_ANDROID_NM "${TOS_ANDROID_NDK_BIN}/llvm-nm")

  message(STATUS "Android third_party dir: ${TOS_ANDROID_THIRD_PARTY_DIR} (ABI=${TOS_ANDROID_ABI}, API=${TOS_ANDROID_API})")
endif()
