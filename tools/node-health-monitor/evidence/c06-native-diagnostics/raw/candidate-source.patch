+        Mapping {
+            socket_path: parent.join("diagnostic.sock"),
+            node_id: "node_a".into(),
+            native_pid: std::process::id() as i32,
+            native_uid: unsafe { libc::getuid() },
+            native_gid: unsafe { libc::getgid() },
