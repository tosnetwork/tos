{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "partial"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "maxItems": 32
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/anchor"
      },
      "maxItems": 32
    }
  },
  "required": [
    "schema_version",
    "status",
    "sources",
    "anchors"
  ],
  "additionalProperties": false,
  "$defs": {
    "anchor": {
      "oneOf": [
        {
          "$ref": "#/$defs/block"
        },
        {
          "$ref": "#/$defs/consensus"
        },
        {
          "$ref": "#/$defs/storage_ack"
        }
      ]
    },
    "block": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "block"
        },
        "network_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scope_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "workchain": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "shard": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "format": "uint64"
        },
        "seqno": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "root_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "file_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "point": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "kind",
        "network_id",
        "scope_id",
        "workchain",
        "shard",
        "seqno",
        "root_hash",
        "file_hash",
        "point"
      ],
      "additionalProperties": false
    },
    "consensus": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "consensus"
        },
        "network_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scope_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "candidate_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "kind",
        "network_id",
        "scope_id",
        "session_id",
        "slot",
        "candidate_id",
        "phase"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 96
          },
          "maxItems": 64
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256
          },
          "maxItems": 32
        },
        "sampling_policy": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "status",
        "missing_fields",
        "gaps",
        "sampling_policy"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "diagnostic_fixture"
        },
        "record_type": {
          "const": 1
        },
        "payload": {
          "type": "string",
          "pattern": "^[0-9a-f]{4}$"
        }
      },
      "required": [
        "kind",
        "record_type",
        "payload"
      ],
      "additionalProperties": false
    },
    "host_cgroup": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "host_cgroup"
        },
        "memory_current_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "format": "uint64"
        },
        "memory_max_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "format": "uint64"
        },
        "cpu_usage_usec": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "format": "uint64"
        },
        "cpu_quota_usec": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "format": "uint64"
        },
        "cpu_period_usec": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "format": "uint64"
        },
        "oom_events": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "format": "uint64"
        }
      },
      "required": [
        "kind",
        "memory_current_bytes",
        "memory_max_bytes",
        "cpu_usage_usec",
        "cpu_quota_usec",
        "cpu_period_usec",
        "oom_events"
      ],
      "additionalProperties": false
    },
    "native": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "native"
        },
        "generation": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "format": "uint64"
        },
        "openmetrics_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2097152
        }
      },
      "required": [
        "kind",
        "generation",
        "openmetrics_hash",
        "bytes"
      ],
      "additionalProperties": false
    },
    "native_core": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "native_core"
        },
        "generation": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "format": "uint64"
        },
        "network_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "openmetrics_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2097152
        },
        "pq_sign": {
          "anyOf": [
            {
              "$ref": "#/$defs/pq_snapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "pq_verify": {
          "anyOf": [
            {
              "$ref": "#/$defs/pq_snapshot"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "generation",
        "network_id",
        "openmetrics_hash",
        "bytes",
        "pq_sign",
        "pq_verify"
      ],
      "additionalProperties": false
    },
    "payload": {
      "oneOf": [
        {
          "$ref": "#/$defs/process"
        },
        {
          "$ref": "#/$defs/host_cgroup"
        },
        {
          "$ref": "#/$defs/native"
        },
        {
          "$ref": "#/$defs/native_core"
        },
        {
          "$ref": "#/$defs/unavailable"
        },
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "$ref": "#/$defs/diagnostic"
        },
        {
          "$ref": "#/$defs/block"
        },
        {
          "$ref": "#/$defs/consensus"
        },
        {
          "$ref": "#/$defs/storage_ack"
        }
      ]
    },
    "pq_snapshot": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "failed": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "format": "uint64"
        },
        "succeeded": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "format": "uint64"
        }
      },
      "required": [
        "complete",
        "failed",
        "succeeded"
      ],
      "additionalProperties": false
    },
    "process": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "process"
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "rss_bytes": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "format": "uint64"
            },
            {
              "type": "null"
            }
          ]
        },
        "anon_bytes": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "format": "uint64"
            },
            {
              "type": "null"
            }
          ]
        },
        "file_bytes": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "format": "uint64"
            },
            {
              "type": "null"
            }
          ]
        },
        "swap_bytes": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "format": "uint64"
            },
            {
              "type": "null"
            }
          ]
        },
        "cpu_user_ticks": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "format": "uint64"
            },
            {
              "type": "null"
            }
          ]
        },
        "cpu_system_ticks": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "format": "uint64"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "pid",
        "rss_bytes",
        "anon_bytes",
        "file_bytes",
        "swap_bytes",
        "cpu_user_ticks",
        "cpu_system_ticks"
      ],
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "properties": {
        "instrumentation_complete": {
          "type": "boolean"
        },
        "producer_dropped": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "format": "uint64"
        },
        "relay_dropped": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "format": "uint64"
        },
        "parse_errors": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "format": "uint64"
        },
        "shed_reason": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 96
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "instrumentation_complete",
        "producer_dropped",
        "relay_dropped",
        "parse_errors",
        "shed_reason"
      ],
      "additionalProperties": false
    },
    "scalar": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "scalar"
        },
        "metric_id": {
          "type": "string",
          "maxLength": 96
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string",
          "maxLength": 32
        }
      },
      "required": [
        "kind",
        "metric_id",
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "node_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "scope_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "process_epoch": {
          "type": "string",
          "maxLength": 128
        },
        "source_epoch": {
          "type": "string",
          "maxLength": 128
        },
        "source_version": {
          "type": "string",
          "maxLength": 96
        },
        "generation": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "format": "uint64"
        },
        "availability": {
          "type": "string",
          "enum": [
            "available",
            "disabled",
            "unsupported",
            "unauthorized",
            "error",
            "unknown"
          ]
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "last_success_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "received_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "source_age_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "clock_quality": {
          "type": "string",
          "enum": [
            "valid",
            "uncertain",
            "invalid"
          ]
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "payload": {
          "$ref": "#/$defs/payload"
        },
        "quality": {
          "$ref": "#/$defs/quality"
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "node_id",
        "scope_id",
        "process_epoch",
        "source_epoch",
        "source_version",
        "generation",
        "availability",
        "observed_at",
        "last_success_at",
        "received_at",
        "source_age_ms",
        "clock_quality",
        "coverage",
        "content_hash",
        "payload",
        "quality"
      ],
      "additionalProperties": false
    },
    "storage_ack": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "storage_ack"
        },
        "operation": {
          "type": "string",
          "maxLength": 64
        },
        "logical_reference": {
          "type": "string",
          "maxLength": 160
        },
        "contract_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "source_epoch": {
          "type": "string",
          "maxLength": 128
        },
        "completion_sequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "format": "uint64"
        },
        "durability": {
          "type": "string",
          "enum": [
            "commit_acknowledged",
            "restart_verified_in_test",
            "unknown"
          ]
        }
      },
      "required": [
        "kind",
        "operation",
        "logical_reference",
        "contract_id",
        "source_epoch",
        "completion_sequence",
        "durability"
      ],
      "additionalProperties": false
    },
    "unavailable": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "unavailable"
        },
        "reason": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
