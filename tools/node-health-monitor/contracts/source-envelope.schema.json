              "type": "string",
              "format": "date-time",
              "pattern": "Z$",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "source_age_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "clock_quality": {
          "type": "string",
          "enum": [
            "valid",
            "uncertain",
            "invalid"
          ]
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "payload": {
          "$ref": "#/$defs/payload"
        },
        "quality": {
          "$ref": "#/$defs/quality"
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "node_id",
        "scope_id",
        "process_epoch",
        "source_epoch",
        "source_version",
        "generation",
        "availability",
        "observed_at",
        "last_success_at",
        "received_at",
        "source_age_ms",
        "clock_quality",
        "coverage",
        "content_hash",
        "payload",
        "quality"
      ],
      "additionalProperties": false
    },
    "storage_ack": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "storage_ack"
        },
        "operation": {
          "type": "string",
          "maxLength": 64
        },
        "logical_reference": {
          "type": "string",
          "maxLength": 160
        },
        "contract_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "source_epoch": {
          "type": "string",
          "maxLength": 128
        },
        "completion_sequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "format": "uint64"
        },
        "durability": {
          "type": "string",
          "enum": [
            "commit_acknowledged",
            "restart_verified_in_test",
            "unknown"
          ]
        }
      },
      "required": [
        "kind",
        "operation",
        "logical_reference",
        "contract_id",
        "source_epoch",
        "completion_sequence",
        "durability"
      ],
      "additionalProperties": false
    },
    "unavailable": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "unavailable"
        },
        "reason": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
