{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "node_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true
    },
    "scope_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "start": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40
    },
    "end": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "journal",
          "consensus_trace",
          "rocksdb",
          "rpc_probe",
          "collector",
          "operator_change"
        ]
      },
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "error",
          "warning",
          "consensus_stage",
          "storage_sample",
          "lifecycle",
          "data_gap"
        ]
      },
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 160
    },
    "contains": {
      "type": "string",
      "maxLength": 128
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "cursor": {
      "type": "string",
      "maxLength": 2048
    }
  },
  "required": [
    "run_id",
    "node_ids",
    "scope_id",
    "start",
    "end",
    "sources",
    "kinds",
    "correlation_id",
    "contains",
    "limit",
    "cursor"
  ],
  "$defs": {}
}
