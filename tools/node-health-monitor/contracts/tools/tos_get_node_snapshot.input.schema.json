{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "as_of": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40
    },
    "max_age_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 180
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "process",
          "host",
          "chain",
          "consensus",
          "network",
          "storage",
          "index",
          "gpu",
          "telemetry",
          "deployment"
        ]
      },
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true
    }
  },
  "required": [
    "run_id",
    "node_id",
    "as_of",
    "max_age_seconds",
    "components"
  ],
  "$defs": {}
}
