{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "node_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true
    },
    "start": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40
    },
    "end": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "deploy",
          "restart",
          "config",
          "maintenance",
          "load_test",
          "resource_limit"
        ]
      },
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "cursor": {
      "type": "string",
      "maxLength": 2048
    }
  },
  "required": [
    "run_id",
    "node_ids",
    "start",
    "end",
    "kinds",
    "limit",
    "cursor"
  ],
  "$defs": {}
}
