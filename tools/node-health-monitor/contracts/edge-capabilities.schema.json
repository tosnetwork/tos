{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "node_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "catalog_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "value": {
            "$ref": "#/$defs/capability"
          }
        },
        "required": [
          "name",
          "value"
        ],
        "additionalProperties": false
      },
      "maxItems": 32
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "disabled",
              "unsupported",
              "unauthorized",
              "error",
              "unknown"
            ]
          }
        },
        "required": [
          "source_id",
          "status"
        ],
        "additionalProperties": false
      },
      "maxItems": 32
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "catalog_digest",
    "capabilities",
    "sources"
  ],
  "additionalProperties": false,
  "$defs": {
    "capability": {
      "type": "object",
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "contract_valid": {
          "type": "boolean"
        },
        "performance_gate": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        }
      },
      "required": [
        "supported",
        "enabled",
        "contract_valid",
        "performance_gate"
      ],
      "additionalProperties": false
    }
  }
}
