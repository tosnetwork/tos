{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "endpoint_id": {"$ref": "#/$defs/alias"},
    "source_epoch": {"$ref": "#/$defs/epoch"},
    "generation": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$", "format": "uint64", "maxLength": 20},
    "network_id": {"$ref": "#/$defs/hash"},
    "genesis": {"$ref": "#/$defs/hash"},
    "observed_at": {"anyOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]},
    "source_age_ms": {"anyOf": [{"$ref": "#/$defs/uint64"}, {"type": "null"}]},
    "clock_quality": {"enum": ["valid", "unknown"]},
    "coverage": {"enum": ["complete", "partial", "unknown"]},
    "rows": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/row"}}
  },
  "required": ["schema_version", "endpoint_id", "source_epoch", "generation", "network_id", "genesis", "observed_at", "source_age_ms", "clock_quality", "coverage", "rows"],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64},
    "alias": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$", "maxLength": 64},
    "epoch": {"type": "string", "pattern": "^[!-~]{1,128}$", "maxLength": 128},
    "uint64": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$", "format": "uint64", "maxLength": 20},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$", "format": "date-time", "maxLength": 40},
    "row": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "target_id": {"$ref": "#/$defs/alias"},
        "observed_at": {"anyOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]},
        "source_age_ms": {"anyOf": [{"$ref": "#/$defs/uint64"}, {"type": "null"}]},
        "anchor": {"anyOf": [{"$ref": "#/$defs/block"}, {"$ref": "#/$defs/consensus"}, {"type": "null"}]},
        "network_observation": {"enum": ["observed", "not_observed_in_window", "unavailable"]},
        "reported_certificate_membership": {"enum": ["included", "not_in_this_certificate", "not_checked", "unavailable"]},
        "reported_proof": {"enum": ["not_checked", "reported_valid", "unavailable"]},
        "private_vote_visibility": {"enum": ["observed", "not_observed_in_window", "unavailable"]},
        "coverage": {"enum": ["complete", "partial", "unknown"]},
        "missing_fields": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"enum": ["anchor", "certificate", "clock", "private_vote", "proof", "role"]}}
      },
      "required": ["target_id", "observed_at", "source_age_ms", "anchor", "network_observation", "reported_certificate_membership", "reported_proof", "private_vote_visibility", "coverage", "missing_fields"]
    },
    "block": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "kind": {"const": "block"}, "network_id": {"$ref": "#/$defs/hash"}, "genesis": {"$ref": "#/$defs/hash"},
        "scope_id": {"$ref": "#/$defs/alias"}, "workchain": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "shard": {"$ref": "#/$defs/uint64"}, "seqno": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "root_hash": {"$ref": "#/$defs/hash"}, "file_hash": {"$ref": "#/$defs/hash"},
        "point": {"enum": ["reported_finalized", "reported_applied"]}
      },
      "required": ["kind", "network_id", "genesis", "scope_id", "workchain", "shard", "seqno", "root_hash", "file_hash", "point"]
    },
    "consensus": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "kind": {"const": "consensus"}, "network_id": {"$ref": "#/$defs/hash"}, "genesis": {"$ref": "#/$defs/hash"},
        "scope_id": {"$ref": "#/$defs/alias"}, "workchain": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "shard": {"$ref": "#/$defs/uint64"}, "session_id": {"$ref": "#/$defs/hash"},
        "slot": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "candidate_id": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "phase": {"enum": ["reported_candidate", "reported_vote"]}
      },
      "required": ["kind", "network_id", "genesis", "scope_id", "workchain", "shard", "session_id", "slot", "candidate_id", "phase"]
    }
  }
}
