[Unit]
Description=C09 bounded private QueryService functional sample
After=nhm-local-query.service
OnFailure=nhm-c09-functional-alert.service

[Service]
Type=oneshot
WorkingDirectory=%h/nhm-supervision/c09-local/runtime/functional
UMask=0077
NoNewPrivileges=yes
Environment=PYTHONDONTWRITEBYTECODE=1
TimeoutStartSec=35s
ExecStartPre=/usr/bin/sha256sum --check --status %h/nhm-supervision/c09-local/runtime/functional/SCRIPT.sha256
ExecStart=/usr/bin/python3 %h/nhm-supervision/c09-local/runtime/functional/sample-query-functional.py \
  --control-socket %t/nhm-local-query/control.sock \
  --mcp-socket %t/nhm-local-query/mcp.sock \
  --operator-token-file %h/nhm-supervision/c09-local/runtime/config/query-operator.token \
  --service-token-file %h/nhm-supervision/c09-local/runtime/config/query-service.token \
  --m-db %h/nhm-supervision/c09-local/runtime/evidence/evidence.db \
  --q-ledger %h/nhm-supervision/c09-local/runtime/query/query-ledger.db \
  --log-file %h/nhm-supervision/c09-local/runtime/functional/samples.private.jsonl \
  --review-file %h/nhm-supervision/c09-local/runtime/functional/review.private.json \
  --query-unit nhm-local-query.service \
  --expected-query-sha256 e37f9c4353bb80f5ae8acd3a941d7eeb21b5f116a448448adb79588fb94cf8ee \
  --baseline-file %h/nhm-supervision/c09-local/runtime/functional/baseline.private.json \
  --expected-baseline-sha256 25c0458888a275bcf9568bc1fc53d914e9d5a3901932b0840444d99a3ea3382f \
  --first-pass-not-after-utc 2026-09-30T06:55:00Z \
  --not-after-utc 2026-10-03T07:10:00Z
