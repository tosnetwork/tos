[Unit]
Description=Stop C09 functional sampler at proposed aligned window end

[Service]
Type=oneshot
WorkingDirectory=%h/nhm-supervision/c09-local/runtime/functional
UMask=0077
NoNewPrivileges=yes
Environment=PYTHONDONTWRITEBYTECODE=1
TimeoutStartSec=15s
ExecStartPre=/usr/bin/sha256sum --check --status %h/nhm-supervision/c09-local/runtime/functional/SCRIPT.sha256
ExecStart=/usr/bin/systemctl --user stop nhm-c09-functional.timer nhm-c09-functional.service
ExecStartPost=/usr/bin/python3 %h/nhm-supervision/c09-local/runtime/functional/write-c09-functional-stop-receipt.py --runtime-dir %h/nhm-supervision/c09-local/runtime/functional --q-ledger %h/nhm-supervision/c09-local/runtime/query/query-ledger.db --baseline-file %h/nhm-supervision/c09-local/runtime/functional/baseline.private.json --expected-baseline-sha256 25c0458888a275bcf9568bc1fc53d914e9d5a3901932b0840444d99a3ea3382f --first-pass-not-after-utc 2026-09-30T06:55:00Z --window-end-utc 2026-10-03T07:10:00Z
