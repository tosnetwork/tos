[Unit]
Description=Validator health judgement with one bounded local Codex (AURA bridge) explanation
After=nhm-local-manager.service

[Service]
Type=oneshot
CPUQuota=200%
MemoryMax=2147483648
TasksMax=512
NoNewPrivileges=yes
UMask=0077
TimeoutStartSec=360s
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/nhm-c07-contract-venv/bin/python %h/tos/.claude/worktrees/cc-nhm/tools/node-health-monitor/scripts/judge-validator-health.py --network-id de50a3116ac539afb99e1ddfea7d56213a2636bc6c5ee9f730efa509b8e667e0 --manager-state-url http://127.0.0.1:19490/v1/manager/state --manager-read-token-file %h/nhm-supervision/c09-local/runtime/config/manager-read.token --evidence-db %h/nhm-supervision/c09-local/runtime/evidence/evidence.db --nodes-file %h/nhm-supervision/c09-local/runtime/config/judge-nodes.json --provider codex --codex-bin %h/tos-aura-codex/target/debug/aura --codex-home %h/.local/state/nhm-cc-aura/codex-home --codex-workdir %h/.local/state/nhm-cc-aura/work --codex-thread-file %h/.local/state/nhm-cc-aura/validator.thread --diagnosis-schema %h/tos/.claude/worktrees/cc-nhm/tools/node-health-monitor/contracts/diagnosis.schema.json --model-timeout 300 --journal %h/.local/state/nhm-cc-judge/model-verdicts.jsonl
SuccessExitStatus=0 3
