FROM rust:1.99.1-slim@sha256:7eab7ce19273ce785e0ca7578bdf7bc1fcbae621775a8197379a04c9f6e03cd5 AS builder

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev

COPY tosctl/src/ /workspace/tosctl/src/
COPY tl/generate/scheme/lite_api.tl tl/generate/scheme/tos_api.tl tl/generate/scheme/toslib_api.tl /workspace/tl/generate/scheme/
COPY crypto/smartcont/prediction-market-v1.boc.base64 /workspace/crypto/smartcont/
WORKDIR /workspace/tosctl/src

RUN cargo build --release --package nodectl --locked

FROM debian:stable-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /workspace/tosctl/src/target/release/nodectl /usr/local/bin/

WORKDIR /nodectl

