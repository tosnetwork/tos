# uno/test/golden/public-inputs-v1.hex
#
# Consensus-binding golden fixture for Plonky3 public-input byte encoding
# per §4.3 step 4 of doc/uno-workchain.md (decision #5, §16).
#
# Each record is a (transfer_hex, pubinput_hex) pair. `transfer_hex` is a
# fixture-internal linear dump of the Transfer struct fields that the
# public-input builder consumes (u8 scheme_id || u32 LE chain_id || u64 LE
# expiry_block || u64 LE fee || u8 spend_count || u8 output_count || 32 B
# anchor || per-spend (32 B nullifier || 32 B rk) || per-output (32 B cm ||
# 32 B epk || u16 LE filter_tag)). This is NOT the §4.1 BoC wire format —
# `encode_transfer()` currently only handles the 1-spend/1-output shape, and
# the consensus property under test is exclusively the public-input byte
# encoding, which is a pure function of these fields. Both the C++ encoder
# (`uno_workchain::build_plonky3_public_inputs`, implemented in
# `uno/core/transaction.cpp`) and the Rust encoder (pending; see
# `uno/plonky3-ffi/tests/public_input_fixture.rs`) MUST reproduce the
# recorded `pubinput_hex` byte-for-byte.
#
# Encoding rules (decision #5 / §4.3 step 4):
#   - Each Goldilocks element serialized as 8 B little-endian u64.
#   - `scheme_id`/`chain_id`/`filter_tag`: zero-extended to u64.
#   - `expiry_block`/`fee`: assert `x < p_Goldilocks`; serialize as u64 LE.
#   - 256-bit inputs (anchor, nullifier, rk, cm, epk): split into 4 × u64 LE
#     chunks; each chunk reduced mod `p_Goldilocks = 2^64 - 2^32 + 1`; the
#     canonical reduced form is written back in the same byte slots (LE).
#
# Total `pubinput_hex` byte length: `64 + 64·spend_count + 72·output_count`.
#
# Record format:
#   # <comment>
#   transfer_hex: <hex>
#   pubinput_hex: <hex>
#   (blank line separates records)
#
# Comments start with `#`. Whitespace at end of line is ignored. Lines
# beginning with `transfer_hex:` or `pubinput_hex:` are the consensus
# anchors — any byte drift breaks the fixture.

# ---------------------------------------------------------------------------
# fixture 1: 1-spend / 2-output, scheme_id=0x01, testnet chain_id ("UNOT")
#   expiry_block = 100_000
#   fee          = 65_000
#   pubinput length = 64 + 64 + 144 = 272 bytes
# ---------------------------------------------------------------------------
transfer_hex: 
pubinput_hex: 

# ---------------------------------------------------------------------------
# fixture 2: 4-spend / 4-output worst case, scheme_id=0x01, mainnet chain_id ("UNOM")
#   expiry_block = 0x1000
#   fee          = 0x7D00
#   pubinput length = 64 + 256 + 288 = 608 bytes
# ---------------------------------------------------------------------------
transfer_hex: 
pubinput_hex: 
