// Multisig with one contract per proposal ("order").
//
// A single-contract multisig keeps every open proposal and every approval in
// its own storage, which grows with the number of proposals and lets one
// busy period make every later call more expensive. Here the parent contract
// only allocates a sequence number and deploys an order contract at an
// address derived from (order code, parent, seqno). Approvals accumulate in
// that order; when the threshold is reached the order sends one execute
// message to the parent.
//
// The parent trusts an execute message only if
//   * it comes from the address derived for the claimed seqno,
//   * the order was approved under the signer set the parent has *now*
//     (orders opened before a signer change cannot execute afterwards),
//   * the approvals reach the parent's *current* threshold, and
//   * the order has not expired.
// [multisigOrderRequireExecute] checks all four. Orders also refuse approvals
// after expiry, so an expired order can never fire. Expiry is always judged
// against `blockchain.now()`, never a time supplied by a message.
//
// Proposals may come from a signer or from a separate proposer set: proposers
// can open orders but never approve them ([multisigOrderRequireProposer]).
//
// Whoever opens an order prepays everything the order needs to reach
// execution, so it cannot be stranded half-way for lack of funds:
//   1. the parent's compute phase handling the proposal,
//   2. forwarding the init message (with the action and the signer set),
//   3. the order's initialisation,
//   4. the order's storage for its whole lifetime,
//   5. the order's compute phase on the approval that fires it,
//   6. forwarding the execute message back (with the action),
//   7. the parent's compute phase executing it.
// Gas units and fixed message/state overheads are measured per build in a
// [MultisigOrderFeeProfile]; the action and signer sizes are counted at run
// time and every component is priced from the live fee configuration.
tol 1.3

import "@stdlib/tvm-dicts"
import "@stdlib/gas-payments"

const MULTISIG_ORDER_THROW_INVALID_CONFIG = 0x1a01
const MULTISIG_ORDER_THROW_INVALID_SEQNO = 0x1a02
const MULTISIG_ORDER_THROW_UNKNOWN_SIGNER = 0x1a03
const MULTISIG_ORDER_THROW_ALREADY_APPROVED = 0x1a04
const MULTISIG_ORDER_THROW_ALREADY_EXECUTED = 0x1a05
const MULTISIG_ORDER_THROW_EXPIRED = 0x1a06
const MULTISIG_ORDER_THROW_UNAUTHORIZED_EXECUTE = 0x1a07
const MULTISIG_ORDER_THROW_STALE_SIGNERS = 0x1a08
const MULTISIG_ORDER_THROW_INSUFFICIENT_APPROVALS = 0x1a09
const MULTISIG_ORDER_THROW_UNAUTHORIZED_PROPOSER = 0x1a0a
const MULTISIG_ORDER_THROW_INVALID_PROFILE = 0x1a0b
const MULTISIG_ORDER_THROW_ORDER_TOO_LARGE = 0x1a0c
const MULTISIG_ORDER_THROW_INSUFFICIENT_VALUE = 0x1a0d
const MULTISIG_ORDER_THROW_NOT_RECLAIMABLE = 0x1a12

const MULTISIG_ORDER_OP_INIT: uint32 = 0x16b7a4fb
const MULTISIG_ORDER_OP_APPROVE: uint32 = 0x9c205aee
const MULTISIG_ORDER_OP_EXECUTE: uint32 = 0xe71e90bc

/// Signers are indexed 0..255; the approval set is a 256-bit mask.
const MULTISIG_ORDER_SIGNER_INDEX_BITS = 8
const MULTISIG_ORDER_MAX_SIGNERS = 255
/// Pass as the requested seqno to take the parent's next one.
const MULTISIG_ORDER_NEXT_SEQNO = 0xffffffffffffffff
/// Size limits for the run-time size count. A full 255-signer dictionary has
/// at most 509 cells.
const MULTISIG_ORDER_MAX_SIGNER_CELLS = 512
const MULTISIG_ORDER_MAX_ACTION_CELLS = 1024

struct MultisigOrder {
    parent: address
    seqno: uint64
    threshold: uint8
    /// signer index (uint8) -> signer address
    signers: cell
    approvals: uint256
    approvalCount: uint8
    expiresAt: uint32
    executed: bool
    action: cell
}

struct MultisigOrderExecute {
    seqno: uint64
    expiresAt: uint32
    approvalCount: uint8
    signersHash: uint256
    action: cell
}

/// The immutable data an order is deployed with; it alone fixes the address.
fun multisigOrderInitData(parent: address, seqno: uint64): cell {
    return beginCell().storeAddress(parent).storeUint(seqno, 64).endCell();
}

fun multisigOrderStateInit(orderCode: cell, parent: address, seqno: uint64): cell {
    return beginCell()
        .storeUint(0, 2)
        .storeMaybeRef(orderCode)
        .storeMaybeRef(multisigOrderInitData(parent, seqno))
        .storeUint(0, 1)
        .endCell();
}

fun multisigOrderAddress(orderCode: cell, parent: address, seqno: uint64): address {
    return address.fromWorkchainAndHash(BASECHAIN, multisigOrderStateInit(orderCode, parent, seqno).hash());
}

/// Returns (seqno to use, parent's next seqno afterwards). The request must
/// be exactly the parent's next seqno or MULTISIG_ORDER_NEXT_SEQNO, so two
/// proposals can never claim the same order address.
fun multisigOrderAllocateSeqno(requested: int, nextSeqno: int): (int, int) {
    if (nextSeqno < 0 || nextSeqno >= MULTISIG_ORDER_NEXT_SEQNO) {
        throw MULTISIG_ORDER_THROW_INVALID_SEQNO;
    }
    if (requested != MULTISIG_ORDER_NEXT_SEQNO && requested != nextSeqno) {
        throw MULTISIG_ORDER_THROW_INVALID_SEQNO;
    }
    return (nextSeqno, nextSeqno + 1);
}

/// Approvals are recorded per index, so an address listed at two indices could
/// approve twice. A signer set therefore lists each signer as a plain addr_std
/// (267 bits, no references), in strictly increasing address order by index:
/// workchain first, then account id. Two equal addresses can never both satisfy
/// that, and checking it needs only the previous entry. Indices may be sparse.
///
/// Checks `signer` against the previous entry's (workchain, account id) and
/// returns its own; `first` is true for the set's lowest index. Throws
/// INVALID_CONFIG.
fun multisigOrderNextSignerKey(signer: slice, previousWorkchain: int, previousId: int, first: bool): (int, int) {
    var s = signer;
    if (s.remainingBitsCount() != 267 || s.remainingRefsCount() != 0) {
        throw MULTISIG_ORDER_THROW_INVALID_CONFIG;
    }
    if (s.loadUint(3) != 4) { // addr_std, no anycast
        throw MULTISIG_ORDER_THROW_INVALID_CONFIG;
    }
    val workchain = s.loadInt(8);
    val id = s.loadUint(256);
    if (!(first || workchain > previousWorkchain || (workchain == previousWorkchain && id > previousId))) {
        throw MULTISIG_ORDER_THROW_INVALID_CONFIG;
    }
    return (workchain, id);
}

/// Number of signers. Throws INVALID_CONFIG if the dictionary is empty, larger
/// than MULTISIG_ORDER_MAX_SIGNERS, or not ordered as
/// [multisigOrderNextSignerKey] requires.
fun multisigOrderSignerCount(signers: cell): int {
    var count = 0;
    var workchain = 0;
    var id = 0;
    var (index, signer, found) = (signers as dict).uDictGetFirst(MULTISIG_ORDER_SIGNER_INDEX_BITS);
    while (found) {
        count += 1;
        if (count > MULTISIG_ORDER_MAX_SIGNERS) {
            throw MULTISIG_ORDER_THROW_INVALID_CONFIG;
        }
        (workchain, id) = multisigOrderNextSignerKey(signer!, workchain, id, count == 1);
        (index, signer, found) = (signers as dict).uDictGetNext(MULTISIG_ORDER_SIGNER_INDEX_BITS, index!);
    }
    if (count == 0) {
        throw MULTISIG_ORDER_THROW_INVALID_CONFIG;
    }
    return count;
}

fun multisigOrderRequireValidThreshold(threshold: int, signerCount: int): void {
    if (threshold <= 0 || threshold > signerCount) {
        throw MULTISIG_ORDER_THROW_INVALID_CONFIG;
    }
}

/// A fresh, unapproved order. Rejects an empty or oversized signer set, a
/// threshold outside 1..signerCount, and an expiry not after the current time.
fun multisigOrderNew(
    parent: address,
    seqno: uint64,
    threshold: int,
    signers: cell,
    expiresAt: int,
    action: cell
): MultisigOrder {
    return multisigOrderNewWithCount(parent, seqno, threshold, signers, multisigOrderSignerCount(signers), expiresAt, action);
}

/// [multisigOrderNew] with the signer count supplied instead of counted, for
/// an order whose init comes only from a parent that already validated the
/// set: counting a 255-signer dictionary costs far more gas than the rest of
/// initialisation. Trusts that the set satisfies [multisigOrderSignerCount];
/// a count alone does not show the addresses are distinct.
fun multisigOrderNewWithCount(
    parent: address,
    seqno: uint64,
    threshold: int,
    signers: cell,
    signerCount: int,
    expiresAt: int,
    action: cell
): MultisigOrder {
    if (signerCount <= 0 || signerCount > MULTISIG_ORDER_MAX_SIGNERS) {
        throw MULTISIG_ORDER_THROW_INVALID_CONFIG;
    }
    multisigOrderRequireValidThreshold(threshold, signerCount);
    if (expiresAt <= blockchain.now()) {
        throw MULTISIG_ORDER_THROW_EXPIRED;
    }
    return MultisigOrder {
        parent,
        seqno,
        threshold,
        signers,
        approvals: 0,
        approvalCount: 0,
        expiresAt,
        executed: false,
        action,
    };
}

/// An order may hand its balance back to the parent once it has expired
/// without executing: no approval can fire it any more, and the funds would
/// otherwise stay stranded in it.
fun MultisigOrder.requireReclaimable(self): void {
    if (self.executed || blockchain.now() <= self.expiresAt) {
        throw MULTISIG_ORDER_THROW_NOT_RECLAIMABLE;
    }
}

/// Index of `signer` in the order's signer set.
fun MultisigOrder.findSigner(self, signer: address): (int, bool) {
    var (index, value, found) = (self.signers as dict).uDictGetFirst(MULTISIG_ORDER_SIGNER_INDEX_BITS);
    while (found) {
        if (value!.bitsEqual(signer as slice)) {
            return (index!, true);
        }
        (index, value, found) = (self.signers as dict).uDictGetNext(MULTISIG_ORDER_SIGNER_INDEX_BITS, index!);
    }
    return (-1, false);
}

/// Records the approval of the signer at `signerIndex`, whose address must be
/// `sender`. Returns true exactly once: on the approval that reaches the
/// threshold, which also marks the order executed. The caller sends
/// [multisigOrderBuildExecuteBody] to the parent when it returns true.
fun MultisigOrder.approve(mutate self, signerIndex: int, sender: address): bool {
    if (self.executed) {
        throw MULTISIG_ORDER_THROW_ALREADY_EXECUTED;
    }
    if (blockchain.now() > self.expiresAt) {
        throw MULTISIG_ORDER_THROW_EXPIRED;
    }
    if (signerIndex < 0 || signerIndex > MULTISIG_ORDER_MAX_SIGNERS) {
        throw MULTISIG_ORDER_THROW_UNKNOWN_SIGNER;
    }
    val (expected, found) = (self.signers as dict).uDictGet(MULTISIG_ORDER_SIGNER_INDEX_BITS, signerIndex);
    if (!found || !expected!.bitsEqual(sender as slice)) {
        throw MULTISIG_ORDER_THROW_UNKNOWN_SIGNER;
    }
    val bit = 1 << signerIndex;
    if ((self.approvals & bit) != 0) {
        throw MULTISIG_ORDER_THROW_ALREADY_APPROVED;
    }
    self.approvals = self.approvals | bit;
    self.approvalCount = self.approvalCount + 1;
    if (self.approvalCount >= self.threshold) {
        self.executed = true;
        return true;
    }
    return false;
}

fun MultisigOrder.executeMessage(self): MultisigOrderExecute {
    return MultisigOrderExecute {
        seqno: self.seqno,
        expiresAt: self.expiresAt,
        approvalCount: self.approvalCount,
        signersHash: self.signers.hash(),
        action: self.action,
    };
}

fun multisigOrderBuildExecuteBody(queryId: uint64, execute: MultisigOrderExecute): cell {
    return beginCell()
        .storeUint(MULTISIG_ORDER_OP_EXECUTE, 32)
        .storeUint(queryId, 64)
        .storeUint(execute.seqno, 64)
        .storeUint(execute.expiresAt, 32)
        .storeUint(execute.approvalCount, 8)
        .storeUint(execute.signersHash, 256)
        .storeRef(execute.action)
        .endCell();
}

/// Parses an execute body (op and query id already consumed).
fun multisigOrderParseExecute(body: slice): MultisigOrderExecute {
    var s = body;
    val execute = MultisigOrderExecute {
        seqno: s.loadUint(64),
        expiresAt: s.loadUint(32),
        approvalCount: s.loadUint(8),
        signersHash: s.loadUint(256),
        action: s.loadRef(),
    };
    s.assertEnd();
    return execute;
}

/// Parent-side admission of an execute message; see the file header for the
/// four conditions.
fun multisigOrderRequireExecute(
    execute: MultisigOrderExecute,
    sender: address,
    orderCode: cell,
    parent: address,
    currentSigners: cell,
    currentThreshold: int
): void {
    if (!sender.bitsEqual(multisigOrderAddress(orderCode, parent, execute.seqno))) {
        throw MULTISIG_ORDER_THROW_UNAUTHORIZED_EXECUTE;
    }
    if (execute.signersHash != currentSigners.hash()) {
        throw MULTISIG_ORDER_THROW_STALE_SIGNERS;
    }
    if (execute.approvalCount < currentThreshold) {
        throw MULTISIG_ORDER_THROW_INSUFFICIENT_APPROVALS;
    }
    if (blockchain.now() > execute.expiresAt) {
        throw MULTISIG_ORDER_THROW_EXPIRED;
    }
}

/// Number of proposers; an empty (null) set is allowed.
fun multisigOrderProposerCount(proposers: dict): int {
    var count = 0;
    var (index, _, found) = proposers.uDictGetFirst(MULTISIG_ORDER_SIGNER_INDEX_BITS);
    while (found) {
        count += 1;
        if (count > MULTISIG_ORDER_MAX_SIGNERS) {
            throw MULTISIG_ORDER_THROW_INVALID_CONFIG;
        }
        (index, _, found) = proposers.uDictGetNext(MULTISIG_ORDER_SIGNER_INDEX_BITS, index!);
    }
    return count;
}

/// Accepts a proposal only from the signer (`isSigner`) or the proposer at
/// `index`, and only if that entry is `sender`.
fun multisigOrderRequireProposer(signers: cell, proposers: dict, isSigner: bool, index: int, sender: address): void {
    if (index < 0 || index > MULTISIG_ORDER_MAX_SIGNERS) {
        throw MULTISIG_ORDER_THROW_UNAUTHORIZED_PROPOSER;
    }
    val set: dict = isSigner ? signers : proposers;
    val (expected, found) = set.uDictGet(MULTISIG_ORDER_SIGNER_INDEX_BITS, index);
    if (!found || !expected!.bitsEqual(sender as slice)) {
        throw MULTISIG_ORDER_THROW_UNAUTHORIZED_PROPOSER;
    }
}

/// Measured, configuration-independent cost inputs of one parent/order build.
/// Overheads exclude the action and the signer set, which are sized at run
/// time. Re-measure whenever either contract changes.
struct MultisigOrderFeeProfile {
    parentNewOrderGas: uint32
    orderInitGas: uint32
    orderExecuteGas: uint32
    parentExecuteGas: uint32
    initMessageBits: uint32
    initMessageCells: uint32
    orderStateBits: uint32
    orderStateCells: uint32
    executeMessageBits: uint32
    executeMessageCells: uint32
    /// Gas the parent spends per action when validating a proposal.
    parentNewOrderGasPerAction: uint32
    /// Gas the parent spends per action when executing an order.
    parentExecuteGasPerAction: uint32
    /// Gas per signer of a set an update action installs (validated at both
    /// proposal and execution).
    parentGasPerUpdatedSigner: uint32
}

fun MultisigOrderFeeProfile.requireValid(self): void {
    if (
        self.parentNewOrderGas == 0 ||
        self.orderInitGas == 0 ||
        self.orderExecuteGas == 0 ||
        self.parentExecuteGas == 0 ||
        self.initMessageBits == 0 ||
        self.initMessageCells == 0 ||
        self.orderStateBits == 0 ||
        self.orderStateCells == 0 ||
        self.executeMessageBits == 0 ||
        self.executeMessageCells == 0 ||
        self.parentNewOrderGasPerAction == 0 ||
        self.parentExecuteGasPerAction == 0 ||
        self.parentGasPerUpdatedSigner == 0
    ) {
        throw MULTISIG_ORDER_THROW_INVALID_PROFILE;
    }
}

/// The seven-component cost for an order whose action and signer set have
/// the given sizes, living `lifetimeSeconds`. The parent's two compute phases
/// grow with the number of actions and with the size of any signer set an
/// update action installs; `extraParentGas` is gas the parent spends beyond
/// the profile, such as counting sizes.
fun MultisigOrderFeeProfile.requiredValueForSizes(
    self,
    actionBits: int,
    actionCells: int,
    signerBits: int,
    signerCells: int,
    actionCount: int,
    updatedSignerCount: int,
    lifetimeSeconds: int,
    extraParentGas: int
): coins {
    self.requireValid();
    if (lifetimeSeconds <= 0) {
        throw MULTISIG_ORDER_THROW_EXPIRED;
    }
    if (actionCount <= 0 || updatedSignerCount < 0) {
        throw MULTISIG_ORDER_THROW_INVALID_CONFIG;
    }
    val signerGas = self.parentGasPerUpdatedSigner * updatedSignerCount;
    val compute = calculateGasFee(
            BASECHAIN,
            self.parentNewOrderGas + self.parentNewOrderGasPerAction * actionCount + signerGas + extraParentGas
        )
        + calculateGasFee(BASECHAIN, self.orderInitGas)
        + calculateGasFee(BASECHAIN, self.orderExecuteGas)
        + calculateGasFee(
            BASECHAIN,
            self.parentExecuteGas + self.parentExecuteGasPerAction * actionCount + signerGas
        );
    val forward = calculateForwardFee(
            BASECHAIN,
            self.initMessageBits + actionBits + signerBits,
            self.initMessageCells + actionCells + signerCells
        )
        + calculateForwardFee(
            BASECHAIN,
            self.executeMessageBits + actionBits,
            self.executeMessageCells + actionCells
        );
    val storage = calculateStorageFee(
        BASECHAIN,
        lifetimeSeconds,
        self.orderStateBits + actionBits + signerBits,
        self.orderStateCells + actionCells + signerCells
    );
    return compute + forward + storage;
}

/// Value a proposal must carry for `action` under `signers`, living
/// `lifetimeSeconds`. `actionCount` and `updatedSignerCount` describe the
/// action, whose format belongs to the parent contract. Counts both sizes now
/// and adds the gas the count took.
fun MultisigOrderFeeProfile.requiredNewOrderValue(
    self,
    signers: cell,
    action: cell,
    actionCount: int,
    updatedSignerCount: int,
    lifetimeSeconds: int
): coins {
    val before = getGasConsumedAtTheMoment();
    val (actionCells, actionBits, _, actionOk) = action.calculateSize(MULTISIG_ORDER_MAX_ACTION_CELLS);
    val (signerCells, signerBits, _, signerOk) = signers.calculateSize(MULTISIG_ORDER_MAX_SIGNER_CELLS);
    val countingGas = getGasConsumedAtTheMoment() - before;
    if (!actionOk || !signerOk) {
        throw MULTISIG_ORDER_THROW_ORDER_TOO_LARGE;
    }
    return self.requiredValueForSizes(
        actionBits!,
        actionCells!,
        signerBits!,
        signerCells!,
        actionCount,
        updatedSignerCount,
        lifetimeSeconds,
        countingGas
    );
}

/// Throws unless `msgValue` covers [MultisigOrderFeeProfile.requiredNewOrderValue].
fun MultisigOrderFeeProfile.requireNewOrderValue(
    self,
    msgValue: coins,
    signers: cell,
    action: cell,
    actionCount: int,
    updatedSignerCount: int,
    lifetimeSeconds: int
): void {
    if (msgValue < self.requiredNewOrderValue(signers, action, actionCount, updatedSignerCount, lifetimeSeconds)) {
        throw MULTISIG_ORDER_THROW_INSUFFICIENT_VALUE;
    }
}
