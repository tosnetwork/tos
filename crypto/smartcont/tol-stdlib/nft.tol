// Slice 3 NFT package foundation. Helpers land in Stage 4.
tol 1.3

import "@stdlib/slice3-common"

const NFT_PATTERN_ERROR_BASE = 0x0500

fun nftPatternManifestHeader(): Slice3PatternManifestHeader {
    return Slice3PatternManifestHeader {
        manifestVersion: SLICE3_PATTERN_MANIFEST_VERSION,
        patternId: SLICE3_PATTERN_NFT,
        publicErrorBase: NFT_PATTERN_ERROR_BASE,
        flags: 0
    };
}
