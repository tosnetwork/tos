// Slice 3 wallet package foundation and wallet-v5-compatible helpers.
tol 1.3

import "@stdlib/slice3-common"
import "@stdlib/exotic-cells"

const WALLET_PATTERN_ERROR_BASE = 0x0600

const WALLET_V5_FUNC_THROW_SIGNATURE_DISABLED = 132
const WALLET_V5_FUNC_THROW_INVALID_SEQNO = 133
const WALLET_V5_FUNC_THROW_INVALID_WALLET_ID = 134
const WALLET_V5_FUNC_THROW_INVALID_SIGNATURE = 135
const WALLET_V5_FUNC_THROW_EXPIRED = 136
const WALLET_V5_FUNC_THROW_EXTERNAL_SEND_MODE = 137
const WALLET_V5_FUNC_THROW_INVALID_MESSAGE_OPERATION = 138
const WALLET_V5_FUNC_THROW_ADD_EXTENSION = 139
const WALLET_V5_FUNC_THROW_REMOVE_EXTENSION = 140
const WALLET_V5_FUNC_THROW_UNSUPPORTED_ACTION = 141
const WALLET_V5_FUNC_THROW_DISABLE_SIGNATURE_WITHOUT_EXTENSIONS = 142
const WALLET_V5_FUNC_THROW_SIGNATURE_MODE_ALREADY_SET = 143
const WALLET_V5_FUNC_THROW_REMOVE_LAST_EXTENSION_SIGNATURE_DISABLED = 144
const WALLET_V5_FUNC_THROW_EXTENSION_WRONG_WORKCHAIN = 145
const WALLET_V5_FUNC_THROW_ONLY_EXTENSION_CAN_CHANGE_SIGNATURE_MODE = 146
const WALLET_V5_FUNC_THROW_INVALID_C5 = 147
const WALLET_V5_FUNC_THROW_INVALID_GLOBAL_ID = 148

const WALLET_V5_SIZE_BOOL = 1
const WALLET_V5_SIZE_SEQNO = 32
const WALLET_V5_SIZE_WALLET_ID = 32
const WALLET_V5_SIZE_PUBLIC_KEY = 256
const WALLET_V5_SIZE_VALID_UNTIL = 32
const WALLET_V5_SIZE_MESSAGE_FLAGS = 4
const WALLET_V5_SIZE_SIGNATURE = 512
const WALLET_V5_SIZE_MESSAGE_OPERATION_PREFIX = 32
const WALLET_V5_SIZE_ADDRESS_HASH = 256
const WALLET_V5_SIZE_QUERY_ID = 64
const WALLET_V5_SIZE_GLOBAL_ID = 32

const WALLET_V5_PREFIX_SIGNED_EXTERNAL: uint32 = 0x7369676e
const WALLET_V5_PREFIX_SIGNED_INTERNAL: uint32 = 0x73696e74
const WALLET_V5_PREFIX_EXTENSION_ACTION: uint32 = 0x6578746e
const WALLET_V5_PREFIX_ACTION_SEND_MSG = 0x0ec3c86d
const WALLET_V5_PREFIX_ADD_EXTENSION = 0x02
const WALLET_V5_PREFIX_REMOVE_EXTENSION = 0x03
const WALLET_V5_PREFIX_SET_SIGNATURE_ALLOWED = 0x04

const WALLET_V5_STDLIB_ERROR_SIGNATURE_DISABLED = 1132
const WALLET_V5_STDLIB_ERROR_INVALID_SEQNO = 1133
const WALLET_V5_STDLIB_ERROR_INVALID_WALLET_ID = 1134
const WALLET_V5_STDLIB_ERROR_INVALID_SIGNATURE = 1135
const WALLET_V5_STDLIB_ERROR_EXPIRED = 1136
const WALLET_V5_STDLIB_ERROR_EXTERNAL_SEND_MODE = 1137
const WALLET_V5_STDLIB_ERROR_INVALID_MESSAGE_OPERATION = 1138
const WALLET_V5_STDLIB_ERROR_ADD_EXTENSION = 1139
const WALLET_V5_STDLIB_ERROR_REMOVE_EXTENSION = 1140
const WALLET_V5_STDLIB_ERROR_UNSUPPORTED_ACTION = 1141
const WALLET_V5_STDLIB_ERROR_DISABLE_SIGNATURE_WITHOUT_EXTENSIONS = 1142
const WALLET_V5_STDLIB_ERROR_SIGNATURE_MODE_ALREADY_SET = 1143
const WALLET_V5_STDLIB_ERROR_REMOVE_LAST_EXTENSION_SIGNATURE_DISABLED = 1144
const WALLET_V5_STDLIB_ERROR_EXTENSION_WRONG_WORKCHAIN = 1145
const WALLET_V5_STDLIB_ERROR_ONLY_EXTENSION_CAN_CHANGE_SIGNATURE_MODE = 1146
const WALLET_V5_STDLIB_ERROR_INVALID_C5 = 1147
const WALLET_V5_STDLIB_ERROR_INVALID_GLOBAL_ID = 1148

struct WalletV5StdlibStorage {
    isSignatureAllowed: bool;
    seqno: uint32;
    walletId: uint32;
    publicKey: uint256;
    extensions: dict;
}

struct WalletV5SignedRequestHeader {
    opcode: uint32;
    globalId: uint32;
    walletId: uint32;
    validUntil: uint32;
    seqno: uint32;
    actions: RemainingBitsAndRefs;
}

fun slice.walletV5EnforceAndRemoveActionSendMsgPrefix(mutate self): self
    asm "x{0ec3c86d} SDBEGINS";

@pure
fun slice.walletV5CountTrailingZeroes(self): int
    asm "SDCNTTRAIL0";

fun walletPatternManifestHeader(): Slice3PatternManifestHeader {
    return Slice3PatternManifestHeader {
        manifestVersion: SLICE3_PATTERN_MANIFEST_VERSION,
        patternId: SLICE3_PATTERN_WALLET,
        publicErrorBase: WALLET_PATTERN_ERROR_BASE,
        flags: 0
    };
}

@pure
fun walletV5PackData(
    isSignatureAllowed: bool,
    seqno: int,
    walletId: int,
    publicKey: int,
    extensions: dict
): cell {
    return beginCell()
        .storeInt(isSignatureAllowed as int, WALLET_V5_SIZE_BOOL)
        .storeUint(seqno, WALLET_V5_SIZE_SEQNO)
        .storeUint(walletId, WALLET_V5_SIZE_WALLET_ID)
        .storeUint(publicKey, WALLET_V5_SIZE_PUBLIC_KEY)
        .storeDict(extensions)
        .endCell();
}

@pure
fun walletV5ErrorForFuncThrow(funcThrow: int, originalOp: uint32, queryId: uint64): Error {
    if (funcThrow == WALLET_V5_FUNC_THROW_SIGNATURE_DISABLED) {
        return slice3Error(queryId, originalOp, ErrorClass.Authorization, WALLET_V5_STDLIB_ERROR_SIGNATURE_DISABLED);
    }
    if (funcThrow == WALLET_V5_FUNC_THROW_INVALID_SEQNO) {
        return slice3Error(queryId, originalOp, ErrorClass.Permanent, WALLET_V5_STDLIB_ERROR_INVALID_SEQNO);
    }
    if (funcThrow == WALLET_V5_FUNC_THROW_INVALID_WALLET_ID) {
        return slice3Error(queryId, originalOp, ErrorClass.Protocol, WALLET_V5_STDLIB_ERROR_INVALID_WALLET_ID);
    }
    if (funcThrow == WALLET_V5_FUNC_THROW_INVALID_SIGNATURE) {
        return slice3Error(queryId, originalOp, ErrorClass.Authorization, WALLET_V5_STDLIB_ERROR_INVALID_SIGNATURE);
    }
    if (funcThrow == WALLET_V5_FUNC_THROW_EXPIRED) {
        return slice3Error(queryId, originalOp, ErrorClass.Permanent, WALLET_V5_STDLIB_ERROR_EXPIRED);
    }
    if (funcThrow == WALLET_V5_FUNC_THROW_EXTERNAL_SEND_MODE) {
        return slice3Error(queryId, originalOp, ErrorClass.Protocol, WALLET_V5_STDLIB_ERROR_EXTERNAL_SEND_MODE);
    }
    if (funcThrow == WALLET_V5_FUNC_THROW_INVALID_MESSAGE_OPERATION) {
        return slice3Error(queryId, originalOp, ErrorClass.Protocol, WALLET_V5_STDLIB_ERROR_INVALID_MESSAGE_OPERATION);
    }
    if (funcThrow == WALLET_V5_FUNC_THROW_ADD_EXTENSION) {
        return slice3Error(queryId, originalOp, ErrorClass.Permanent, WALLET_V5_STDLIB_ERROR_ADD_EXTENSION);
    }
    if (funcThrow == WALLET_V5_FUNC_THROW_REMOVE_EXTENSION) {
        return slice3Error(queryId, originalOp, ErrorClass.Permanent, WALLET_V5_STDLIB_ERROR_REMOVE_EXTENSION);
    }
    if (funcThrow == WALLET_V5_FUNC_THROW_UNSUPPORTED_ACTION) {
        return slice3Error(queryId, originalOp, ErrorClass.Protocol, WALLET_V5_STDLIB_ERROR_UNSUPPORTED_ACTION);
    }
    if (funcThrow == WALLET_V5_FUNC_THROW_DISABLE_SIGNATURE_WITHOUT_EXTENSIONS) {
        return slice3Error(queryId, originalOp, ErrorClass.Permanent, WALLET_V5_STDLIB_ERROR_DISABLE_SIGNATURE_WITHOUT_EXTENSIONS);
    }
    if (funcThrow == WALLET_V5_FUNC_THROW_SIGNATURE_MODE_ALREADY_SET) {
        return slice3Error(queryId, originalOp, ErrorClass.Permanent, WALLET_V5_STDLIB_ERROR_SIGNATURE_MODE_ALREADY_SET);
    }
    if (funcThrow == WALLET_V5_FUNC_THROW_REMOVE_LAST_EXTENSION_SIGNATURE_DISABLED) {
        return slice3Error(queryId, originalOp, ErrorClass.Permanent, WALLET_V5_STDLIB_ERROR_REMOVE_LAST_EXTENSION_SIGNATURE_DISABLED);
    }
    if (funcThrow == WALLET_V5_FUNC_THROW_EXTENSION_WRONG_WORKCHAIN) {
        return slice3Error(queryId, originalOp, ErrorClass.Protocol, WALLET_V5_STDLIB_ERROR_EXTENSION_WRONG_WORKCHAIN);
    }
    if (funcThrow == WALLET_V5_FUNC_THROW_ONLY_EXTENSION_CAN_CHANGE_SIGNATURE_MODE) {
        return slice3Error(queryId, originalOp, ErrorClass.Authorization, WALLET_V5_STDLIB_ERROR_ONLY_EXTENSION_CAN_CHANGE_SIGNATURE_MODE);
    }
    if (funcThrow == WALLET_V5_FUNC_THROW_INVALID_GLOBAL_ID) {
        return slice3Error(queryId, originalOp, ErrorClass.Protocol, WALLET_V5_STDLIB_ERROR_INVALID_GLOBAL_ID);
    }
    return slice3Error(queryId, originalOp, ErrorClass.Protocol, WALLET_V5_STDLIB_ERROR_INVALID_C5);
}

@pure
fun walletV5SplitSignedRequestBody(body: slice): (slice, slice) {
    val signature = body.getLastBits(WALLET_V5_SIZE_SIGNATURE);
    val signedSlice = body.removeLastBits(WALLET_V5_SIZE_SIGNATURE);
    return (signedSlice, signature);
}

@pure
fun walletV5ParseSignedRequestHeader(body: slice): WalletV5SignedRequestHeader {
    val (signedSlice, _) = walletV5SplitSignedRequestBody(body);
    var cs = signedSlice;
    val opcode = cs.loadUint(WALLET_V5_SIZE_MESSAGE_OPERATION_PREFIX);
    val globalId = cs.loadUint(WALLET_V5_SIZE_GLOBAL_ID);
    val walletId = cs.loadUint(WALLET_V5_SIZE_WALLET_ID);
    val validUntil = cs.loadUint(WALLET_V5_SIZE_VALID_UNTIL);
    val seqno = cs.loadUint(WALLET_V5_SIZE_SEQNO);
    return WalletV5SignedRequestHeader {
        opcode,
        globalId,
        walletId,
        validUntil,
        seqno,
        actions: cs,
    };
}

@pure
fun walletV5BuildSignedBodyPrefix(
    opcode: uint32,
    globalId: uint32,
    walletId: uint32,
    validUntil: uint32,
    seqno: uint32,
    actions: RemainingBitsAndRefs
): cell {
    return beginCell()
        .storeUint(opcode, WALLET_V5_SIZE_MESSAGE_OPERATION_PREFIX)
        .storeUint(globalId, WALLET_V5_SIZE_GLOBAL_ID)
        .storeUint(walletId, WALLET_V5_SIZE_WALLET_ID)
        .storeUint(validUntil, WALLET_V5_SIZE_VALID_UNTIL)
        .storeUint(seqno, WALLET_V5_SIZE_SEQNO)
        .storeSlice(actions)
        .endCell();
}

@pure
fun walletV5BuildExtensionActionBody(queryId: uint64, actions: RemainingBitsAndRefs): cell {
    return beginCell()
        .storeUint(WALLET_V5_PREFIX_EXTENSION_ACTION, WALLET_V5_SIZE_MESSAGE_OPERATION_PREFIX)
        .storeUint(queryId, WALLET_V5_SIZE_QUERY_ID)
        .storeSlice(actions)
        .endCell();
}

@pure
fun walletV5BuildActionSendMsg(mode: int, outMsg: cell, next: cell): cell {
    return beginCell()
        .storeUint(WALLET_V5_PREFIX_ACTION_SEND_MSG, WALLET_V5_SIZE_MESSAGE_OPERATION_PREFIX)
        .storeUint(mode, 8)
        .storeRef(next)
        .storeRef(outMsg)
        .endCell();
}

fun walletV5VerifyC5Actions(c5: cell, isExternal: bool): cell {
    var (cs, _) = c5.beginParseSpecial();
    var count = 0;
    while (!cs.isEmpty()) {
        cs.walletV5EnforceAndRemoveActionSendMsgPrefix();
        if (cs.remainingBitsCount() != 8) {
            throw WALLET_V5_FUNC_THROW_INVALID_C5;
        }
        if (cs.remainingRefsCount() != 2) {
            throw WALLET_V5_FUNC_THROW_INVALID_C5;
        }
        if (isExternal && cs.preloadBits(7).walletV5CountTrailingZeroes() > 0) {
            throw WALLET_V5_FUNC_THROW_EXTERNAL_SEND_MODE;
        }
        val (next, _) = cs.preloadRef().beginParseSpecial();
        cs = next;
        count += 1;
    }
    if (count > 255) {
        throw WALLET_V5_FUNC_THROW_INVALID_C5;
    }
    if (cs.remainingRefsCount() != 0) {
        throw WALLET_V5_FUNC_THROW_INVALID_C5;
    }
    return c5;
}
