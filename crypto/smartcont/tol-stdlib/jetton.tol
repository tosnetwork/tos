// Slice 3 Jetton package foundation and wire-compatible helpers.
tol 1.3

import "@stdlib/slice3-common"

const JETTON_PATTERN_ERROR_BASE = 0x0400

const JETTON_OP_MINT: uint32 = 0x00000015
const JETTON_OP_CHANGE_ADMIN: uint32 = 0x00000003
const JETTON_OP_CHANGE_CONTENT: uint32 = 0x00000004
const JETTON_OP_TRANSFER: uint32 = 0x0f8a7ea5
const JETTON_OP_TRANSFER_NOTIFICATION: uint32 = 0x7362d09c
const JETTON_OP_INTERNAL_TRANSFER: uint32 = 0x178d4519
const JETTON_OP_EXCESSES: uint32 = 0xd53276db
const JETTON_OP_BURN: uint32 = 0x595f07bc
const JETTON_OP_BURN_NOTIFICATION: uint32 = 0x7bdd97de

const JETTON_MINTER_FUNC_THROW_ADMIN_REQUIRED = 73
const JETTON_MINTER_FUNC_THROW_BURN_SENDER_NOT_WALLET = 74
const JETTON_MINTER_FUNC_THROW_INVALID_ADMIN = 75
const JETTON_MINTER_FUNC_THROW_INVALID_AMOUNT = 76
const JETTON_FUNC_THROW_UNKNOWN_OPCODE = 0xffff

const JETTON_WALLET_FUNC_THROW_WRONG_WORKCHAIN = 333
const JETTON_WALLET_FUNC_THROW_OWNER_REQUIRED = 705
const JETTON_WALLET_FUNC_THROW_INSUFFICIENT_BALANCE = 706
const JETTON_WALLET_FUNC_THROW_INVALID_SENDER_OR_BURN_VALUE = 707
const JETTON_WALLET_FUNC_THROW_MALFORMED_FORWARD_PAYLOAD = 708
const JETTON_WALLET_FUNC_THROW_INSUFFICIENT_VALUE_OR_BAD_BOUNCE = 709

const JETTON_STDLIB_ERROR_ADMIN_REQUIRED = 1097
const JETTON_STDLIB_ERROR_BURN_SENDER_NOT_WALLET = 1098
const JETTON_STDLIB_ERROR_INVALID_ADMIN = 1099
const JETTON_STDLIB_ERROR_INVALID_AMOUNT = 1100
const JETTON_STDLIB_ERROR_UNKNOWN_OPCODE = 65535

const JETTON_STDLIB_WALLET_ERROR_WRONG_WORKCHAIN = 1333
const JETTON_STDLIB_WALLET_ERROR_OWNER_REQUIRED = 1705
const JETTON_STDLIB_WALLET_ERROR_INSUFFICIENT_BALANCE = 1706
const JETTON_STDLIB_WALLET_ERROR_INVALID_TRANSFER_SENDER = 1707
const JETTON_STDLIB_WALLET_ERROR_MALFORMED_FORWARD_PAYLOAD = 1708
const JETTON_STDLIB_WALLET_ERROR_INSUFFICIENT_TRANSFER_VALUE = 1709
const JETTON_STDLIB_WALLET_ERROR_INSUFFICIENT_BURN_VALUE = 1710
const JETTON_STDLIB_WALLET_ERROR_UNEXPECTED_BOUNCE = 1711
const JETTON_STDLIB_WALLET_ERROR_UNKNOWN_OPCODE = 65535

const JETTON_MIN_TOS_FOR_STORAGE = 10000000
const JETTON_GAS_CONSUMPTION = 10000000

fun jettonPatternManifestHeader(): Slice3PatternManifestHeader {
    return Slice3PatternManifestHeader {
        manifestVersion: SLICE3_PATTERN_MANIFEST_VERSION,
        patternId: SLICE3_PATTERN_JETTON,
        publicErrorBase: JETTON_PATTERN_ERROR_BASE,
        flags: 0
    };
}

@pure
fun jettonCurrentAddress(): address
    asm "MYADDR";

@pure
fun jettonSameInternalAndAnyAddressBits(a: address, b: any_address): bool {
    return (a as slice).bitsEqual(b as slice);
}

fun jettonForceBasechain(addr: any_address): void {
    if (addr.getWorkchain() != BASECHAIN) {
        throw JETTON_WALLET_FUNC_THROW_WRONG_WORKCHAIN;
    }
}

@pure
fun jettonMinterPackWalletData(
    balance: coins,
    ownerAddress: any_address,
    jettonMasterAddress: address,
    jettonWalletCode: cell
): cell {
    return beginCell()
        .storeCoins(balance)
        .storeAddressAny(ownerAddress)
        .storeAddress(jettonMasterAddress)
        .storeRef(jettonWalletCode)
        .endCell();
}

@pure
fun jettonWalletPackData(
    balance: coins,
    ownerAddress: any_address,
    jettonMasterAddress: any_address,
    jettonWalletCode: cell
): cell {
    return beginCell()
        .storeCoins(balance)
        .storeAddressAny(ownerAddress)
        .storeAddressAny(jettonMasterAddress)
        .storeRef(jettonWalletCode)
        .endCell();
}

@pure
fun jettonMinterCalculateWalletStateInit(
    ownerAddress: any_address,
    jettonMasterAddress: address,
    jettonWalletCode: cell
): cell {
    return beginCell()
        .storeUint(0, 2)
        .storeDict(jettonWalletCode)
        .storeDict(jettonMinterPackWalletData(0, ownerAddress, jettonMasterAddress, jettonWalletCode))
        .storeUint(0, 1)
        .endCell();
}

@pure
fun jettonWalletCalculateStateInit(
    ownerAddress: any_address,
    jettonMasterAddress: any_address,
    jettonWalletCode: cell
): cell {
    return beginCell()
        .storeUint(0, 2)
        .storeDict(jettonWalletCode)
        .storeDict(jettonWalletPackData(0, ownerAddress, jettonMasterAddress, jettonWalletCode))
        .storeUint(0, 1)
        .endCell();
}

fun jettonCalculateWalletAddress(stateInit: cell): address {
    return address.fromWorkchainAndHash(BASECHAIN, stateInit.hash());
}

fun jettonMinterCalculateUserWalletAddress(
    ownerAddress: any_address,
    jettonMasterAddress: address,
    jettonWalletCode: cell
): address {
    return jettonCalculateWalletAddress(
        jettonMinterCalculateWalletStateInit(ownerAddress, jettonMasterAddress, jettonWalletCode)
    );
}

fun jettonWalletCalculateUserWalletAddress(
    ownerAddress: any_address,
    jettonMasterAddress: any_address,
    jettonWalletCode: cell
): address {
    return jettonCalculateWalletAddress(
        jettonWalletCalculateStateInit(ownerAddress, jettonMasterAddress, jettonWalletCode)
    );
}

@pure
fun jettonMinterErrorForFuncThrow(funcThrow: int, originalOp: uint32, queryId: uint64): Error {
    if (funcThrow == JETTON_MINTER_FUNC_THROW_ADMIN_REQUIRED) {
        return slice3Error(queryId, originalOp, ErrorClass.Authorization, JETTON_STDLIB_ERROR_ADMIN_REQUIRED);
    }
    if (funcThrow == JETTON_MINTER_FUNC_THROW_BURN_SENDER_NOT_WALLET) {
        return slice3Error(queryId, originalOp, ErrorClass.Authorization, JETTON_STDLIB_ERROR_BURN_SENDER_NOT_WALLET);
    }
    if (funcThrow == JETTON_MINTER_FUNC_THROW_INVALID_ADMIN) {
        return slice3Error(queryId, originalOp, ErrorClass.Protocol, JETTON_STDLIB_ERROR_INVALID_ADMIN);
    }
    if (funcThrow == JETTON_MINTER_FUNC_THROW_INVALID_AMOUNT) {
        return slice3Error(queryId, originalOp, ErrorClass.Permanent, JETTON_STDLIB_ERROR_INVALID_AMOUNT);
    }
    return slice3Error(queryId, originalOp, ErrorClass.Protocol, JETTON_STDLIB_ERROR_UNKNOWN_OPCODE);
}

@pure
fun jettonWalletErrorForFuncThrow(funcThrow: int, originalOp: uint32, queryId: uint64): Error {
    if (funcThrow == JETTON_WALLET_FUNC_THROW_WRONG_WORKCHAIN) {
        return slice3Error(queryId, originalOp, ErrorClass.Protocol, JETTON_STDLIB_WALLET_ERROR_WRONG_WORKCHAIN);
    }
    if (funcThrow == JETTON_WALLET_FUNC_THROW_OWNER_REQUIRED) {
        return slice3Error(queryId, originalOp, ErrorClass.Authorization, JETTON_STDLIB_WALLET_ERROR_OWNER_REQUIRED);
    }
    if (funcThrow == JETTON_WALLET_FUNC_THROW_INSUFFICIENT_BALANCE) {
        return slice3Error(queryId, originalOp, ErrorClass.Permanent, JETTON_STDLIB_WALLET_ERROR_INSUFFICIENT_BALANCE);
    }
    if (funcThrow == JETTON_WALLET_FUNC_THROW_INVALID_SENDER_OR_BURN_VALUE) {
        if (originalOp == JETTON_OP_INTERNAL_TRANSFER) {
            return slice3Error(queryId, originalOp, ErrorClass.Authorization, JETTON_STDLIB_WALLET_ERROR_INVALID_TRANSFER_SENDER);
        }
        return slice3Error(queryId, originalOp, ErrorClass.BackPressure, JETTON_STDLIB_WALLET_ERROR_INSUFFICIENT_BURN_VALUE);
    }
    if (funcThrow == JETTON_WALLET_FUNC_THROW_MALFORMED_FORWARD_PAYLOAD) {
        return slice3Error(queryId, originalOp, ErrorClass.Protocol, JETTON_STDLIB_WALLET_ERROR_MALFORMED_FORWARD_PAYLOAD);
    }
    if (funcThrow == JETTON_WALLET_FUNC_THROW_INSUFFICIENT_VALUE_OR_BAD_BOUNCE) {
        if (originalOp == JETTON_OP_TRANSFER) {
            return slice3Error(queryId, originalOp, ErrorClass.BackPressure, JETTON_STDLIB_WALLET_ERROR_INSUFFICIENT_TRANSFER_VALUE);
        }
        return slice3Error(queryId, originalOp, ErrorClass.Protocol, JETTON_STDLIB_WALLET_ERROR_UNEXPECTED_BOUNCE);
    }
    return slice3Error(queryId, originalOp, ErrorClass.Protocol, JETTON_STDLIB_WALLET_ERROR_UNKNOWN_OPCODE);
}

@pure
fun jettonBuildMinterExcessesMessage(responseAddress: any_address, queryId: uint64): cell {
    return beginCell()
        .storeUint(0x10, 6)
        .storeAddressAny(responseAddress)
        .storeCoins(0)
        .storeUint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .storeUint(JETTON_OP_EXCESSES, 32)
        .storeUint(queryId, 64)
        .endCell();
}

fun jettonMinterMintTokens(
    toAddress: any_address,
    jettonWalletCode: cell,
    amount: coins,
    masterMsg: cell
): void {
    val stateInit = jettonMinterCalculateWalletStateInit(
        toAddress,
        jettonCurrentAddress(),
        jettonWalletCode
    );
    val toWalletAddress = jettonCalculateWalletAddress(stateInit);
    val msg = beginCell()
        .storeUint(0x18, 6)
        .storeAddress(toWalletAddress)
        .storeCoins(amount)
        .storeUint(4 + 2 + 1, 1 + 4 + 4 + 64 + 32 + 1 + 1 + 1)
        .storeRef(stateInit)
        .storeRef(masterMsg)
        .endCell();
    sendRawMessage(msg, SEND_MODE_PAY_FEES_SEPARATELY);
}

@pure
fun jettonBuildInternalTransferMessage(
    toWalletAddress: address,
    stateInit: cell,
    queryId: uint64,
    amount: coins,
    ownerAddress: any_address,
    responseAddress: any_address,
    forwardTosAmount: coins,
    forwardPayload: RemainingBitsAndRefs
): cell {
    val msgBody = beginCell()
        .storeUint(JETTON_OP_INTERNAL_TRANSFER, 32)
        .storeUint(queryId, 64)
        .storeCoins(amount)
        .storeAddressAny(ownerAddress)
        .storeAddressAny(responseAddress)
        .storeCoins(forwardTosAmount)
        .storeSlice(forwardPayload)
        .endCell();
    return beginCell()
        .storeUint(0x18, 6)
        .storeAddress(toWalletAddress)
        .storeCoins(0)
        .storeUint(4 + 2 + 1, 1 + 4 + 4 + 64 + 32 + 1 + 1 + 1)
        .storeRef(stateInit)
        .storeRef(msgBody)
        .endCell();
}

@pure
fun jettonBuildTransferNotificationMessage(
    ownerAddress: any_address,
    value: coins,
    queryId: uint64,
    amount: coins,
    fromAddress: any_address,
    forwardPayload: RemainingBitsAndRefs
): cell {
    val msgBody = beginCell()
        .storeUint(JETTON_OP_TRANSFER_NOTIFICATION, 32)
        .storeUint(queryId, 64)
        .storeCoins(amount)
        .storeAddressAny(fromAddress)
        .storeSlice(forwardPayload)
        .endCell();
    return beginCell()
        .storeUint(0x10, 6)
        .storeAddressAny(ownerAddress)
        .storeCoins(value)
        .storeUint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .storeRef(msgBody)
        .endCell();
}

@pure
fun jettonBuildWalletExcessesMessage(responseAddress: any_address, value: coins, queryId: uint64): cell {
    return beginCell()
        .storeUint(0x10, 6)
        .storeAddressAny(responseAddress)
        .storeCoins(value)
        .storeUint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .storeUint(JETTON_OP_EXCESSES, 32)
        .storeUint(queryId, 64)
        .endCell();
}

@pure
fun jettonBuildBurnNotificationMessage(
    jettonMasterAddress: any_address,
    queryId: uint64,
    amount: coins,
    ownerAddress: any_address,
    responseAddress: any_address
): cell {
    val msgBody = beginCell()
        .storeUint(JETTON_OP_BURN_NOTIFICATION, 32)
        .storeUint(queryId, 64)
        .storeCoins(amount)
        .storeAddressAny(ownerAddress)
        .storeAddressAny(responseAddress)
        .endCell();
    return beginCell()
        .storeUint(0x18, 6)
        .storeAddressAny(jettonMasterAddress)
        .storeCoins(0)
        .storeUint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .storeRef(msgBody)
        .endCell();
}
