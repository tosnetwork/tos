#!/usr/bin/fift -s
"TosUtil.fif" include
"Asm.fif" include
"PQ.fif" include

{ ."usage: " @' $0 type ." <subwallet-id> <timeout-seconds> <public-key-file> <filename-base>" cr
  ."Creates the initial state of a post-quantum high-volume wallet (pq-highload-wallet-code.fc) "
  ."on workchain 0, the only workchain it serves, controlled by the ML-DSA-44 public key in "
  ."<public-key-file>: exactly 1312 raw bytes." cr
  ."The timeout bounds how long a signed request stays valid and how long its query id is "
  ."remembered; it must be 1.." 4194303 . ."seconds, and one hour to one day is the intended range." cr
  ."The state is checked with the wallet's own get_checked_config before it is saved." cr
  ."Saves the StateInit to <filename-base>.init.boc and the address to <filename-base>.addr. "
  ."Deploy the wallet by sending funds to that address in any internal message carrying the "
  ."StateInit. The wallet runs only on a chain at global version 16 or later." cr 1 halt
} : usage
$# 4 <> ' usage if

$1 parse-int =: subwallet-id
$2 parse-int =: timeout
$3 =: key-file
$4 =: file-base
subwallet-id 0 < subwallet-id 32 ufits not or abort"the subwallet id must be a 32-bit unsigned value"
timeout 1 < timeout 4194303 > or abort"the timeout must be 1..4194303 seconds"
key-file file>B =: key
key Blen 1312 <> abort"an ML-DSA-44 public key is exactly 1312 bytes"

// ( B i -- B' )  The i-th 127-byte chunk of B.
{ 127 * B| nip dup Blen 127 min B| drop } : chunk
variable chain-bytes
variable chain-cell
// ( B -- c )  The canonical byte chain: 127 bytes per non-final cell, one continuation
// each, built from the last chunk back.
{ chain-bytes !
  chain-bytes @ Blen 126 + 127 / 1-                                  // ( last )
  dup chain-bytes @ swap chunk <b swap B, b> chain-cell !            // ( last )
  { 1- dup chain-bytes @ swap chunk <b swap B, chain-cell @ ref, b> chain-cell ! } over times
  drop chain-cell @
} : byte-chain

"auto/pq-highload-wallet-code.fif" include =: wallet-code
<b 1312 32 u, key byte-chain ref, b> =: stored-key
<b stored-key ref, subwallet-id 32 u, false 1 i, false 1 i, 0 64 u, timeout 22 u, b> =: data

// Run the wallet's own check on this state: get_checked_config, whose method id FunC
// assigns as (crc16 of the name) | 0x10000. It refuses a key of the wrong shape or a timeout
// out of range, and returns the key id. It needs only c4, so it runs before any address.
104661 wallet-code <s data runvm  // ( key-id exit-code data' )
drop 0<> abort"the wallet refuses this state"
=: key-id
."Key id: " key-id 64 0x. cr

<b b{0011} s, wallet-code ref, data ref, null dict, b>  // StateInit
dup hashu 0 swap 2dup 2constant wallet_addr
."New post-quantum high-volume wallet, subwallet " subwallet-id . ."timeout " timeout . ."seconds" cr
."Address = " 2dup .addr cr
2dup file-base +".addr" save-address-verbose
."Non-bounceable address (for init): " 2dup 7 .Addr cr
."Bounceable address (for later access): " 6 .Addr cr
2 boc+>B file-base +".init.boc" tuck B>file
."(Saved the wallet's StateInit to file " type .")" cr
