;; Complete Quantum receiver candidate. Build with compiled dependency definitions
;; for these functions; never obtain code identities from mutable wallet data.
;; Final module/vault implementations and release acceptance remain required.
int quantumwallet_network();
int quantumwallet_module_hash();
cell quantumwallet_vault_code();
#include "wallet-quantum-auth.fc";
#include "wallet-quantum-fee-identity.fc";
#include "wallet-v5-action-list.fc";

() quantumwallet_successor(cell module, cell metadata, cell vault, int retired) impure inline_ref {
  var (policy, _, _) = quantumid_module(module, quantumwallet_module_hash(), cell_hash(module),
      auth_global_id(), quantumwallet_network());
  if (policy == 1) {
    throw_if(auth_policy::retired, retired & 2);
    auth_policy_require_primary(quantumwallet_network(), 1);
  }
  quantumpair_validate(vault, cell_hash(quantumwallet_vault_code()), cell_hash(vault),
      auth_global_id(), quantumwallet_network(), my_address(), quantumpair_address(cell_hash(module)), metadata);
}

() recv_external(slice body) impure { throw(auth::legacy_disabled); }

() recv_internal(int balance, int value, cell full, slice body) impure {
  slice message = full.begin_parse();
  if (message~load_uint(4) & 1) { return (); }
  slice sender = message~load_msg_addr();
  quantumpair_basechain(my_address());
  var (seqno, id, key, mode, retired, epoch, primary, rescue, module, fee) =
      quantumstate_load(get_data(), quantumwallet_module_hash(), auth_global_id(), quantumwallet_network());
  ;; Empty transfers are deposits only; any nonempty body must be exact AUTH v2.
  if (body.slice_empty?()) { return (); }
  var (policy, _, _) = quantumid_module(module, quantumwallet_module_hash(), cell_hash(module),
      auth_global_id(), quantumwallet_network());
  cell vault = quantumpair_init(quantumwallet_vault_code(), auth_global_id(), quantumwallet_network(),
      my_address(), quantumpair_address(cell_hash(module)), fee);
  var (role, kind, payload) = quantum_validate_request(mode, cell_hash(module), quantumwallet_network(),
      1, policy, retired, epoch, primary, rescue, cell_hash(vault), sender, body);
  slice ps = payload.begin_parse().skip_bits(32);
  cell actions = null();
  if (kind == quantum::execute) {
    actions = verify_auth_actions(ps~load_ref());
    ps.end_parse();
  } elseif (kind == quantum::lock) {
    throw_unless(quantum::bad_payload, ps~load_uint(8) == 1);
    ps.end_parse();
    retired |= 2;
  } elseif (kind == quantum::configure) {
    int next_mode = ps~load_uint(2);
    cell replacement = ps~load_maybe_ref();
    ps.end_parse();
    throw_unless(auth::bad_mode, next_mode == 2);
    ifnot (cell_null?(replacement)) {
      slice fs = quantumid_ordinary(replacement);
      cell next_fee = fs~load_ref();
      cell next_vault = fs~load_ref();
      fs.end_parse();
      quantumwallet_successor(module, next_fee, next_vault, retired);
      fee = next_fee;
    }
    mode = next_mode;
  } else {
    ;; Entire signed witnesses replace the tuple atomically. POP/readiness runs
    ;; separately; this does not claim another account's live balance or keys.
    cell next_module = ps~load_ref();
    cell next_fee = ps~load_ref();
    cell next_vault = ps~load_ref();
    ps.end_parse();
    quantumwallet_successor(next_module, next_fee, next_vault, retired);
    module = next_module;
    fee = next_fee;
    mode = 2;
  }
  (epoch, primary, rescue, seqno) = quantum_advance_counters(role, kind, epoch, primary, rescue, seqno);
  set_data(quantumstate_store(seqno, id, key, mode, retired, epoch, primary, rescue, module, fee));
  ifnot (cell_null?(actions)) { set_c5_actions(actions); }
}

int is_signature_allowed() method_id { return 0; }
int seqno() method_id { return get_data().begin_parse().skip_bits(1).preload_uint(32); }
int get_subwallet_id() method_id { return get_data().begin_parse().skip_bits(33).preload_uint(32); }
int get_public_key() method_id { return get_data().begin_parse().skip_bits(65).preload_uint(256); }
cell get_extensions() method_id { return null(); }
(int, int, int, int, int, int, int, int) get_auth_state() method_id {
  var (_, _, _, mode, retired, epoch, primary, rescue, module, fee) =
      quantumstate_load(get_data(), quantumwallet_module_hash(), auth_global_id(), quantumwallet_network());
  var (policy, _, _) = quantumid_module(module, quantumwallet_module_hash(), cell_hash(module),
      auth_global_id(), quantumwallet_network());
  cell vault = quantumpair_init(quantumwallet_vault_code(), auth_global_id(), quantumwallet_network(),
      my_address(), quantumpair_address(cell_hash(module)), fee);
  return (mode, epoch, primary, rescue, cell_hash(module), retired, policy, cell_hash(vault));
}
