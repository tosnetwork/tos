;; Configuration smart contract.
;;
;; Validator authority here is post-quantum and comes from the current validator set.
;; There is no administrator: nothing in this contract can be changed by one key, and no
;; message from outside the chain can change anything at all.
#include "pq.fc";
#include "pq-bytes.fc";
#include "pq-validator.fc";
#include "pq-launch-limits.fc";

int validator_set_counts_fit?(cell vset, int max_validators, int max_main_validators,
                              int min_validators) inline_ref {
  if (cell_null?(vset)) {
    return true;
  }
  slice cs = vset.begin_parse();
  if (cs.slice_bits() < 104) {
    return false;
  }
  if (cs~load_uint(8) != 0x12) {
    return false;
  }
  cs~skip_bits(64);
  int total = cs~load_uint(16);
  int main = cs~load_uint(16);
  return (total <= max_validators) & (main <= max_main_validators)
      & (total >= min_validators) & (main > 0) & (main <= total);
}

int valid_validator_limits?(cell cfg_dict, cell value) inline_ref {
  if (cell_null?(value)) {
    return false;
  }
  slice cs = value.begin_parse();
  if ((cs.slice_bits() != 48) | (cs.slice_refs() != 0)) {
    return false;
  }
  int max_validators = cs~load_uint(16);
  int max_main_validators = cs~load_uint(16);
  int min_validators = cs~load_uint(16);
  if ((min_validators < 1) | (max_main_validators < min_validators)
      | (max_validators < max_main_validators)
      | (max_validators > pq_launch::max_total_validators)
      | (max_main_validators > pq_launch::max_masterchain_committee)) {
    return false;
  }
  return validator_set_counts_fit?(cfg_dict.idict_get_ref(32, 34), max_validators, max_main_validators, min_validators)
      & validator_set_counts_fit?(cfg_dict.idict_get_ref(32, 35), max_validators, max_main_validators, min_validators)
      & validator_set_counts_fit?(cfg_dict.idict_get_ref(32, 36), max_validators, max_main_validators, min_validators)
      & validator_set_counts_fit?(cfg_dict.idict_get_ref(32, 37), max_validators, max_main_validators, min_validators);
}

int valid_catchain_limits?(cell value) inline_ref {
  if (cell_null?(value)) {
    return false;
  }
  slice cs = value.begin_parse();
  int bits = cs.slice_bits();
  if ((bits < 8) | (cs.slice_refs() != 0)) {
    return false;
  }
  int tag = cs~load_uint(8);
  if ((tag == 0xc1) & (bits == 136)) {
    cs~skip_bits(96);
  } elseif ((tag == 0xc2) & (bits == 144)) {
    if (cs~load_uint(7) != 0) {
      return false;
    }
    cs~load_uint(1);
    cs~skip_bits(96);
  } else {
    return false;
  }
  int shard_validators_num = cs~load_uint(32);
  cs.end_parse();
  return (shard_validators_num >= 1)
      & (shard_validators_num <= pq_launch::max_shard_committee);
}

int valid_live_validator_set_limits?(cell cfg_dict, cell value) inline_ref {
  cell limits_cell = cfg_dict.idict_get_ref(32, 16);
  if (cell_null?(limits_cell)) {
    return false;
  }
  slice limits = limits_cell.begin_parse();
  if ((limits.slice_bits() != 48) | (limits.slice_refs() != 0)) {
    return false;
  }
  int max_validators = limits~load_uint(16);
  int max_main_validators = limits~load_uint(16);
  int min_validators = limits~load_uint(16);
  limits.end_parse();
  return validator_set_counts_fit?(value, min(max_validators, pq_launch::max_total_validators),
                                   min(max_main_validators, pq_launch::max_masterchain_committee),
                                   max(min_validators, 1));
}

() set_conf_param(int index, cell value) impure {
  var cs = get_data().begin_parse();
  var cfg_dict = cs~load_ref();
  cfg_dict~idict_set_ref(32, index, value);
  set_data(begin_cell().store_ref(cfg_dict).store_slice(cs).end_cell());
}

;; cfg_dict:^Cell vote_dict:(HashmapE 256 ConfigProposalStatus)
;;
;; There is no stored key and no sequence number: both existed to authorise messages
;; arriving from outside the chain, and no such message is accepted any more.
(cell, cell) load_data() inline {
  var cs = get_data().begin_parse();
  var res = (cs~load_ref(), cs~load_dict());
  cs.end_parse();
  return res;
}

() store_data(cfg_dict, vote_dict) impure inline {
  set_data(begin_cell()
    .store_ref(cfg_dict)
    .store_dict(vote_dict)
  .end_cell());
}

;; (min_tot_rounds, max_tot_rounds, min_wins, max_losses, min_store_sec, max_store_sec, bit_price, cell_price)
_ parse_vote_config(cell c) inline {
  var cs = c.begin_parse();
  throw_unless(44, cs~load_uint(8) == 0x36);
  var res = (cs~load_uint(8), cs~load_uint(8), cs~load_uint(8), cs~load_uint(8), cs~load_uint(32), cs~load_uint(32), cs~load_uint(32), cs~load_uint(32));
  cs.end_parse();
  return res;
}

;; cfg_vote_setup#91 normal_params:^ConfigProposalSetup critical_params:^ConfigProposalSetup = ConfigVotingSetup;
_ get_vote_config_internal(int critical?, cell cparam11) inline_ref {
  var cs = cparam11.begin_parse();
  throw_unless(44, cs~load_uint(8) == 0x91);
  if (critical?) {
    cs~load_ref();
  }
  return parse_vote_config(cs.preload_ref());
}

_ get_vote_config(int critical?) inline {
  return get_vote_config_internal(critical?, config_param(11));
}

;; Every rule the node applies to a validator set, applied here before the set can
;; become ConfigParam 36.
;;
;; The contract installs what the election produced, and the node refuses to start from
;; a set it cannot read. If the two disagree the chain installs a set that halts it, so
;; this is not a convenience check: it is the same deterministic rule, run first.
;;
;; It throws rather than returning a verdict, and the caller runs it under `try`, so a
;; malformed set produces an explicit refusal to the elector instead of a silent abort.
(int, int) check_validator_set(cell vset) {
  var cs = vset.begin_parse();
  throw_unless(9, cs~load_uint(8) == 0x12);  ;; validators_ext#12 only
  int utime_since = cs~load_uint(32);
  int utime_until = cs~load_uint(32);
  int total = cs~load_uint(16);
  int main = cs~load_uint(16);
  throw_unless(9, main > 0);
  throw_unless(9, total >= main);
  int total_weight = cs~load_uint(64);
  cell list = cs~load_dict();
  cs.end_parse();
  throw_if(9, total_weight == 0);
  ;; The node applies checked_add_validator_weight() with UINT64_MAX/3. Do not
  ;; install a set as ConfigParam 36 that the node will then refuse to load.
  throw_if(9, total_weight > 6148914691236517205);

  ;; The count the header states must be the count the list holds, and both must be
  ;; within what the configuration allows a set to be.
  var limits = config_param(16).begin_parse();
  int max_validators = limits~load_uint(16);
  int max_main_validators = limits~load_uint(16);
  int min_validators = limits~load_uint(16);
  limits.end_parse();
  throw_if(9, total > min(max_validators, pq_launch::max_total_validators));
  throw_if(9, main > min(max_main_validators, pq_launch::max_masterchain_committee));
  throw_if(9, total < max(min_validators, 1));

  ;; Walk every descriptor. Validator, consensus-key and ADNL transport identities
  ;; must each be unique, as in Config::unpack_validator_set().
  cell seen_validators = new_dict();
  cell seen_keys = new_dict();
  cell seen_adnl = new_dict();
  int weight_sum = 0;
  int index = -1;
  int counted = 0;
  do {
    (index, slice descr, int found) = list.udict_get_next?(16, index);
    if (found) {
      throw_if(9, index >= total);
      (int validator_id, _, int key_id, _, int weight, int adnl_addr) = pq::parse_descriptor(descr);
      (_, int duplicate_validator) = seen_validators.udict_get?(256, validator_id);
      throw_if(9, duplicate_validator);
      (_, int duplicate_key) = seen_keys.udict_get?(256, key_id);
      throw_if(9, duplicate_key);
      (_, int duplicate_adnl) = seen_adnl.udict_get?(256, adnl_addr);
      throw_if(9, duplicate_adnl);
      seen_validators~udict_set_builder(256, validator_id, begin_cell());
      seen_keys~udict_set_builder(256, key_id, begin_cell());
      seen_adnl~udict_set_builder(256, adnl_addr, begin_cell());
      weight_sum += weight;
      counted += 1;
    }
  } until (~ found);
  throw_unless(9, counted == total);
  throw_unless(9, weight_sum == total_weight);
  return (utime_since, utime_until);
}

() send_answer(addr, query_id, ans_tag, mode) impure {
  ;; int_msg_info$0 ihr_disabled:Bool bounce:Bool bounced:Bool src:MsgAddress -> 011000
  send_raw_message(begin_cell()
    .store_uint(0x18, 6)
    .store_slice(addr)
    .store_uint(0, 5 + 4 + 4 + 64 + 32 + 1 + 1)
    .store_uint(ans_tag, 32)
    .store_uint(query_id, 64)
  .end_cell(), mode);
}

() send_confirmation(addr, query_id, ans_tag) impure inline {
  return send_answer(addr, query_id, ans_tag, 64);
}

() send_error(addr, query_id, ans_tag) impure inline {
  return send_answer(addr, query_id, ans_tag, 64);
}

;; forward a message to elector smart contract to make it upgrade its code
() change_elector_code(slice cs) impure {
  var dest_addr = config_param(1).begin_parse().preload_uint(256);
  var query_id = now();
  send_raw_message(begin_cell()
   .store_uint(0xc4ff, 17)
   .store_uint(dest_addr, 256)
   .store_tomis(1 << 30)         ;; ~ 1 Tomi (will be returned back)
   .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
   .store_uint(0x4e436f64, 32)   ;; action
   .store_uint(query_id, 64)
   .store_slice(cs)
  .end_cell(), 0);
}

() after_code_upgrade(slice param, cont old_code) impure method_id(1666) {
}

;; ---------------------------------------------------------------------------
;; ConfigParam 47 -- the validator controller codes an account may have been born
;; with. A validator's authority is rooted in its controller account, and what makes
;; that account post-quantum is the code it was deployed with, so this parameter is
;; the list of codes that count.
;;
;; The bound is part of the parameter rather than a note about it: a hashmap carries no
;; cardinality of its own, and an authority registry nobody can see growing is one that
;; grows. Eight is the frozen ceiling.
;; ---------------------------------------------------------------------------

const int config::validator_controller_policy = 47;
const int config::max_controller_codes = 8;

;; The proposal that used to appoint or depose a single administrator. It is named here
;; so it can be refused by name rather than merely happening not to be handled.
const int config::appoint_administrator_param = -999;

;; Installing a parameter goes through here, from the administrator action and from an
;; accepted proposal alike, so the rules about what may be installed live once. A rule
;; each path carries its own copy of is a rule one of them will eventually be missing.
(cell, int) install_param(cell cfg_dict, int param_id, cell param_val) inline_ref;

int valid_controller_policy?(cell value) inline_ref {
  if (cell_null?(value)) {
    ;; Removing the parameter is allowed by this check; admission then fails closed,
    ;; because no code is admitted rather than every code being admitted.
    return true;
  }
  slice cs = value.begin_parse();
  cell codes = cs~load_dict();
  ifnot (cs.slice_empty?()) {
    return false;  ;; trailing data: not this parameter's shape
  }
  int count = 0;
  int key = -1;
  int scanning = true;
  while (scanning) {
    (int next, slice entry, int found) = codes.udict_get_next?(256, key);
    if (found) {
      ifnot (entry.slice_empty?()) {
        return false;  ;; the value is True, which carries nothing
      }
      count += 1;
      if (count > config::max_controller_codes) {
        return false;
      }
      key = next;
    } else {
      scanning = false;
    }
  }
  return true;
}

(cell, int) install_param(cell cfg_dict, int param_id, cell param_val) inline_ref {
  ;; Governance may change what this chain does. It may not vote itself something that
  ;; can then change the chain without it. The proposal is rejected the way any value the
  ;; rules refuse is -- returned unchanged, with nothing installed -- rather than by
  ;; throwing: a throw here would roll back the vote that carried it, leaving the
  ;; proposal pending and every later vote on it aborting.
  if (param_id == config::appoint_administrator_param) {
    return (cfg_dict, false);
  }
  if (param_id == config::validator_controller_policy) {
    ifnot (valid_controller_policy?(param_val)) {
      return (cfg_dict, false);
    }
  }
  if ((param_id == 16) & (~ valid_validator_limits?(cfg_dict, param_val))) {
    return (cfg_dict, false);
  }
  if ((param_id == 28) & (~ valid_catchain_limits?(param_val))) {
    return (cfg_dict, false);
  }
  if ((param_id >= 34) & (param_id <= 37)
      & (~ valid_live_validator_set_limits?(cfg_dict, param_val))) {
    return (cfg_dict, false);
  }
  cfg_dict~idict_set_ref(32, param_id, param_val);
  return (cfg_dict, true);
}

(cell, int, cell) get_current_vset() inline_ref {
  var vset = config_param(34);
  var cs = begin_parse(vset);
  ;; validators_ext#12 utime_since:uint32 utime_until:uint32
  ;; total:(## 16) main:(## 16) { main <= total } { main >= 1 }
  ;; total_weight:uint64
  throw_unless(40, cs~load_uint(8) == 0x12);
  cs~skip_bits(32 + 32 + 16 + 16);
  var (total_weight, dict) = (cs~load_uint(64), cs~load_dict());
  cs.end_parse();
  return (vset, total_weight, dict);
}

;; The validator at an index: who it is, what key speaks for it, and what it weighs.
;;
;; All three come from the set, never from the message being checked, which is what stops
;; a vote naming one validator and being counted for another.
;;
;; The key comes back as the byte chain the verification instruction takes, not as the
;; length-prefixed cell the descriptor stores it in. Handing the instruction the wrapper
;; would make it read a length where it expects a key.
(int, int, cell, int) unpack_validator_descr(slice cs) inline {
  (int validator_id, int algorithm_id, _, cell stored, int weight, _) =
    pq::parse_descriptor(cs);
  (_, cell key_chain) = pq::stored_key(algorithm_id, stored);
  return (validator_id, algorithm_id, key_chain, weight);
}

;; cfg_proposal#f3 param_id:int32 param_value:(Maybe ^Cell) if_hash_equal:(Maybe uint256)
;; c -> (param-id param-cell maybe-hash)
(int, cell, int) parse_config_proposal(cell c) inline_ref {
  var cs = c.begin_parse();
  throw_unless(44, cs~load_int(8) == 0xf3 - 0x100);
  var (id, val, hash) = (cs~load_int(32), cs~load_maybe_ref(), cs~load_int(1));
  if (hash) {
    hash = cs~load_uint(256);
  } else {
    hash = -1;
  }
  cs.end_parse();
  return (id, val, hash);
}

(cell, int, cell) accept_proposal(cell cfg_dict, cell proposal, int critical?) inline_ref {
  var (param_id, param_val, req_hash) = parse_config_proposal(proposal);
  cell cur_val = cfg_dict.idict_get_ref(32, param_id);
  int cur_hash = null?(cur_val) ? 0 : cell_hash(cur_val);
  if ((cur_hash != req_hash) & (req_hash >= 0)) {
    ;; current value has incorrect hash, do not apply changes
    return (cfg_dict, 0, null());
  }
  cell mparams = cfg_dict.idict_get_ref(32, 9);  ;; mandatory parameters
  var (_, found?) = mparams.idict_get?(32, param_id);
  if (found? & param_val.null?()) {
    ;; cannot set a mandatory parameter to (null)
    return (cfg_dict, 0, null());
  }
  cell cparams = cfg_dict.idict_get_ref(32, 10);  ;; critical parameters
  (_, found?) = cparams.idict_get?(32, param_id);
  if (found? < critical?) {
    ;; trying to set a critical parameter after a non-critical voting
    return (cfg_dict, 0, null());
  }
  ;; CHANGE ONE CONFIGURATION PARAMETER (!)
  (cfg_dict, int installed) = install_param(cfg_dict, param_id, param_val);
  ifnot (installed) {
    ;; A value the rules refuse is returned unchanged, the way every other rejected
    ;; proposal is.
    return (cfg_dict, 0, null());
  }
  return (cfg_dict, param_id, param_val);
}

;; What an accepted proposal is allowed to do beyond installing a parameter.
;;
;; A proposal to appoint an administrator never reaches here: `install_param` refuses it,
;; so the proposal is rejected and this is not called for it at all.
cell perform_proposed_action(cell cfg_dict, int param_id, cell param_val) inline_ref {
  if (param_val.null?()) {
    return cfg_dict;
  }
  if (param_id == -1000) {
    ;; upgrade code
    var cs = param_val.begin_parse();
    var new_code = cs~load_ref();
    set_code(new_code);
    var old_code = get_c3();
    set_c3(new_code.begin_parse().bless());
    after_code_upgrade(cs, old_code);
    throw(0);
    return cfg_dict;
  }
  if (param_id == -1001) {
    ;; update elector code
    var cs = param_val.begin_parse();
    change_elector_code(cs);
  }
  return cfg_dict;
}

;; cfg_proposal_status#ce expires:uint32 proposal:^ConfigProposal is_critical:Bool
;;  voters:(HashmapE 16 True) remaining_weight:int64 validator_set_id:uint256
;;  rounds_remaining:uint8 wins:uint8 losses:uint8 = ConfigProposalStatus;
(int, cell, int, cell, int, int, slice) unpack_proposal_status(slice cs) inline_ref {
  throw_unless(44, cs~load_int(8) == 0xce - 0x100);
  return (cs~load_uint(32), cs~load_ref(), cs~load_int(1), cs~load_dict(), cs~load_int(64), cs~load_uint(256), cs);
}

slice update_proposal_status(slice rest, int weight_remaining, int critical?) inline_ref {
  var (min_tot_rounds, max_tot_rounds, min_wins, max_losses, _, _, _, _) = get_vote_config(critical?);
  var (rounds_remaining, wins, losses) = (rest~load_uint(8), rest~load_uint(8), rest~load_uint(8));
  losses -= (weight_remaining >= 0);
  if (losses > max_losses) {
    ;; lost too many times
    return null();
  }
  rounds_remaining -= 1;
  if (rounds_remaining < 0) {
    ;; existed for too many rounds
    return null();
  }
  return begin_cell()
    .store_uint(rounds_remaining, 8)
    .store_uint(wins, 8)
    .store_uint(losses, 8)
  .end_cell().begin_parse();
}

builder begin_pack_proposal_status(int expires, cell proposal, int critical?, cell voters, int weight_remaining, int vset_id) inline {
  return begin_cell()
    .store_int(0xce - 0x100, 8)
    .store_uint(expires, 32)
    .store_ref(proposal)
    .store_int(critical?, 1)
    .store_dict(voters)
    .store_int(weight_remaining, 64)
    .store_uint(vset_id, 256);
}

(cell, cell, int) register_vote(vote_dict, phash, idx, weight) inline_ref {
  var (pstatus, found?) = vote_dict.udict_get?(256, phash);
  ifnot (found?) {
    ;; config proposal not found
    return (vote_dict, null(), -1);
  }
  var (cur_vset, total_weight, _) = get_current_vset();
  int cur_vset_id = cur_vset.cell_hash();
  var (expires, proposal, critical?, voters, weight_remaining, vset_id, rest) = unpack_proposal_status(pstatus);
  if (expires <= now()) {
    ;; config proposal expired, delete and report not found
    vote_dict~udict_delete?(256, phash);
    return (vote_dict, null(), -1);
  }
  if (vset_id != cur_vset_id) {
    ;; config proposal belongs to a previous validator set
    vset_id = cur_vset_id;
    rest = update_proposal_status(rest, weight_remaining, critical?);
    voters = null();
    weight_remaining = muldiv(total_weight, 3, 4);
  }
  if (rest.null?()) {
    ;; discard proposal (existed for too many rounds, or too many losses)
    vote_dict~udict_delete?(256, phash);
    return (vote_dict, null(), -1);
  }
  var (_, found?) = voters.udict_get?(16, idx);
  if (found?) {
    ;; already voted for this proposal, ignore vote
    return (vote_dict, null(), -2);
  }
  ;; register vote
  voters~udict_set_builder(16, idx, begin_cell().store_uint(now(), 32));
  int old_wr = weight_remaining;
  weight_remaining -= weight;
  if ((weight_remaining ^ old_wr) >= 0) {
    ;; not enough votes, or proposal already accepted in this round
    ;; simply update weight_remaining
    vote_dict~udict_set_builder(256, phash, begin_pack_proposal_status(expires, proposal, critical?, voters, weight_remaining, vset_id).store_slice(rest));
    return (vote_dict, null(), 2);
  }
  ;; proposal wins in this round
  var (min_tot_rounds, max_tot_rounds, min_wins, max_losses, _, _, _, _) = get_vote_config(critical?);
  var (rounds_remaining, wins, losses) = (rest~load_uint(8), rest~load_uint(8), rest~load_uint(8));
  wins += 1;
  if (wins >= min_wins) {
    ;; proposal is accepted, remove and process
    vote_dict~udict_delete?(256, phash);
    return (vote_dict, proposal, 6 - critical?);
  }
  ;; update proposal info
  vote_dict~udict_set_builder(256, phash,
    begin_pack_proposal_status(expires, proposal, critical?, voters, weight_remaining, vset_id)
    .store_uint(rounds_remaining, 8)
    .store_uint(wins, 8)
    .store_uint(losses, 8));
  return (vote_dict, null(), 2);
}

int proceed_register_vote(phash, idx, weight) impure inline_ref {
  var (cfg_dict, vote_dict) = load_data();
  (vote_dict, var accepted_proposal, var status) = register_vote(vote_dict, phash, idx, weight);
  store_data(cfg_dict, vote_dict);
  ifnot (accepted_proposal.null?()) {
    var critical? = 6 - status;
    (cfg_dict, var param_id, var param_val) = accept_proposal(cfg_dict, accepted_proposal, critical?);
    store_data(cfg_dict, vote_dict);
    if (param_id) {
      commit();
      cfg_dict = perform_proposed_action(cfg_dict, param_id, param_val);
      store_data(cfg_dict, vote_dict);
    }
  }
  return status;
}

(slice, int) scan_proposal(int phash, slice pstatus) inline_ref {
  var (cur_vset, total_weight, _) = get_current_vset();
  int cur_vset_id = cur_vset.cell_hash();
  var (expires, proposal, critical?, voters, weight_remaining, vset_id, rest) = unpack_proposal_status(pstatus);
  if (expires <= now()) {
    ;; config proposal expired, delete
    return (null(), true);
  }
  if (vset_id == cur_vset_id) {
    ;; config proposal already processed or voted for in this round, change nothing
    return (pstatus, false);
  }
  ;; config proposal belongs to a previous validator set
  vset_id = cur_vset_id;
  rest = update_proposal_status(rest, weight_remaining, critical?);
  voters = null();
  weight_remaining = muldiv(total_weight, 3, 4);
  if (rest.null?()) {
    ;; discard proposal (existed for too many rounds, or too many losses)
    return (null(), true);
  }
  ;; return updated proposal
  return (begin_pack_proposal_status(expires, proposal, critical?, voters, weight_remaining, vset_id).store_slice(rest).end_cell().begin_parse(), true);
}

cell scan_random_proposal(cell vote_dict) inline_ref {
  var (phash, pstatus, found?) = vote_dict.udict_get_nexteq?(256, random());
  ifnot (found?) {
    return vote_dict;
  }
  (pstatus, var changed?) = scan_proposal(phash, pstatus);
  if (changed?) {
    if (pstatus.null?()) {
      vote_dict~udict_delete?(256, phash);
    } else {
      vote_dict~udict_set(256, phash, pstatus);
    }
  }
  return vote_dict;
}

int register_voting_proposal(slice cs, int msg_value) impure inline_ref {
  var (expire_at, proposal, critical?) = (cs~load_uint(32), cs~load_ref(), cs~load_int(1));
  if (expire_at >> 30) {
    expire_at -= now();
  }
  var (param_id, param_val, hash) = parse_config_proposal(proposal);
  if (hash >= 0) {
    cell cur_val = config_param(param_id);
    int cur_hash = null?(cur_val) ? 0 : cell_hash(cur_val);
    if (cur_hash != hash) {
      hash = -0xe2646356;  ;; bad current value
    }
  } else {
    var m_params = config_param(9);
    var (_, found?) = m_params.idict_get?(32, param_id);
    if (found?) {
      hash = -0xcd506e6c;  ;; cannot set mandatory parameter to null
    }
  }
  ;; Note, in config contract currently deployed in mainnet, this limit is 256
  if (param_val.cell_depth() >= 128) {
    hash = -0xc2616456;  ;; bad value
  }
  if (hash < -1) {
    return hash;  ;; return error if any
  }
  ifnot (critical?) {
    var crit_params = config_param(10);
    var (_, found?) = crit_params.idict_get?(32, param_id);
    if (found?) {
      hash = -0xc3726954;  ;; trying to set a critical parameter without critical flag
    }
  }
  if (hash < -1) {
    return hash;
  }
  ;; obtain vote proposal configuration
  var vote_cfg = get_vote_config(critical?);
  var (min_tot_rounds, max_tot_rounds, min_wins, max_losses, min_store_sec, max_store_sec, bit_price, cell_price) = vote_cfg;
  if (expire_at < min_store_sec) {
    return -0xc5787069;   ;; expired
  }
  expire_at = min(expire_at, max_store_sec);
  ;; compute price
  var (_, bits, refs) = compute_data_size(param_val, 1024);
  var pps = bit_price * (bits + 1024) + cell_price * (refs + 2);
  var price = pps * expire_at;
  expire_at += now();
  var (cfg_dict, vote_dict) = load_data();
  int phash = proposal.cell_hash();
  var (pstatus, found?) = vote_dict.udict_get?(256, phash);
  if (found?) {
    ;; proposal already exists; we can only extend it
    var (expires, r_proposal, r_critical?, voters, weight_remaining, vset_id, rest) = unpack_proposal_status(pstatus);
    if (r_critical? != critical?) {
      return -0xc3726955;  ;; cannot upgrade critical parameter to non-critical...
    }
    if (expires >= expire_at) {
      return -0xc16c7245;  ;; proposal already exists
    }
    ;; recompute price
    price = pps * (expire_at - expires + 16384);
    if (msg_value - price < (1 << 30)) {
      return -0xf0617924;   ;; need more money
    }
    ;; update expiration time
    vote_dict~udict_set_builder(256, phash, begin_pack_proposal_status(expire_at, r_proposal, r_critical?, voters, weight_remaining, vset_id).store_slice(rest));
    store_data(cfg_dict, vote_dict);
    return price;
  }
  if (msg_value - price < (1 << 30)) {
    return -0xf0617924;   ;; need more money
  }
  ;; obtain current validator set data
  var (vset, total_weight, _) = get_current_vset();
  int weight_remaining = muldiv(total_weight, 3, 4);
  ;; create new proposal
  vote_dict~udict_set_builder(256, phash,
    begin_pack_proposal_status(expire_at, proposal, critical?, null(), weight_remaining, vset.cell_hash())
    .store_uint(max_tot_rounds, 8).store_uint(0, 16));
  store_data(cfg_dict, vote_dict);
  return price;
}

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
  var cs = in_msg_cell.begin_parse();
  var flags = cs~load_uint(4);  ;; int_msg_info$0 ihr_disabled:Bool bounce:Bool bounced:Bool
  var s_addr = cs~load_msg_addr();
  (int src_wc, int src_addr) = s_addr.parse_std_addr();
  if ((src_wc + 1) | (flags & 1) | in_msg.slice_empty?()) {
    ;; source not in masterchain, or a bounced message, or a simple transfer
    return ();
  }
  int tag = in_msg~load_uint(32);
  int query_id = in_msg~load_uint(64);
  if (tag == 0x4e565354) {
    ;; set next validator set
    var vset = in_msg~load_ref();
    in_msg.end_parse();
    var elector_param = config_param(1);
    var elector_addr = cell_null?(elector_param) ? -1 : elector_param.begin_parse().preload_uint(256);
    var ok = false;
    if (src_addr == elector_addr) {
      ;; message from elector smart contract
      ;; set next validator set
      ;;
      ;; The set is checked in full first. A set that fails is refused with the answer
      ;; the elector understands rather than by aborting this transaction, so the
      ;; election learns it was refused instead of waiting for a confirmation that a
      ;; bounced message will never bring.
      try {
        (var t_since, var t_until) = check_validator_set(vset);
        var t = now();
        ok = (t_since > t) & (t_until > t_since);
      } catch (_, _) {
        ok = false;
      }
    }
    if (ok) {
      set_conf_param(36, vset);
      ;; send confirmation
      return send_confirmation(s_addr, query_id, 0xee764f4b);
    } else {
      return send_error(s_addr, query_id, 0xee764f6f);
    }
  }
  if (tag == 0x6e565052) {
    ;; new voting proposal
    var price = register_voting_proposal(in_msg, msg_value);
    int mode = 64;
    int ans_tag = - price;
    if (price >= 0) {
      ;; ok, debit price
      raw_reserve(price, 4);
      ans_tag = 0xee565052;
      mode = 128;
    }
    return send_answer(s_addr, query_id, ans_tag, mode);
  }
  if (tag == pq::tag::config_vote_op) {
    ;; A validator of the current set votes for a configuration proposal.
    ;;
    ;; Who is voting is read from the set at `idx`, never from the message: the message
    ;; states only which index it claims to be and what it is voting on.
    int idx = in_msg~load_uint(16);
    int phash = in_msg~load_uint(256);
    cell signature = in_msg~load_ref();
    in_msg.end_parse();

    ;; The one expensive step is paid for before it is taken. Anyone may send this
    ;; message, so a verification reached before this gate is one an unauthorised sender
    ;; could make the chain perform for free, as often as it liked.
    throw_unless(47, msg_value >= pq::verification_value(-1));

    (cell vset, int total_weight, cell list) = get_current_vset();
    (slice descr, int present) = list.udict_get?(16, idx);
    throw_unless(41, present);
    (int validator_id, int algorithm_id, cell public_key, int weight) =
      unpack_validator_descr(descr);

    ;; The set the vote is counted against is signed over, so a signature made under an
    ;; earlier set cannot be replayed under this one.
    throw_unless(34, pq_check_mldsa44(
      pq::config_vote_preimage(vset.cell_hash(), validator_id, idx, phash),
      pq::config_vote_context(),
      pq::stored_signature(algorithm_id, signature),
      public_key));

    int res = proceed_register_vote(phash, idx, weight);
    return send_confirmation(s_addr, query_id, res + 0xd6745240);
  }
  ;; if tag is non-zero and its higher bit is zero, throw an exception (the message is an unsupported query)
  ;; to bounce message back to sender
  throw_unless(37, (tag == 0) | (tag & (1 << 31)));
  ;; do nothing for other internal messages
}

;; No message from outside the chain carries authority here.
;;
;; This path used to hold two of them: a vote signed by a validator, and an action signed
;; by an administrator. Both are gone. A validator votes by internal message, which pays
;; for the verification it asks for, and there is no administrator to sign anything.
;;
;; The entry point stays, and refuses. Removing it would leave the contract with no
;; external handler, which is a different behaviour from refusing one, and a node that
;; delivered such a message would find out by other means.
() recv_external(slice in_msg) impure {
  throw(32);
}

() run_ticktock(int is_tock) impure {
  var (cfg_dict, vote_dict) = load_data();
  int kl = 32;
  var next_vset = cfg_dict.idict_get_ref(kl, 36);
  var updated? = false;
  ifnot (next_vset.null?()) {
    ;; check whether we have to set next_vset as the current validator set
    var ds = next_vset.begin_parse();
    if (ds.slice_bits() >= 40) {
      var tag = ds~load_uint(8);
      var since = ds.preload_uint(32);
      if ((since <= now()) & (tag == 0x12)) {
        ;; next validator set becomes active!
        var cur_vset = cfg_dict~idict_set_get_ref(kl, 34, next_vset);  ;; next_vset -> cur_vset
        cfg_dict~idict_set_get_ref(kl, 32, cur_vset);   ;; cur_vset -> prev_vset
        cfg_dict~idict_delete?(kl, 36);             ;; (null) -> next_vset
        updated? = true;
      }
    }
  }
  ifnot (updated?) {
    ;; if nothing has been done so far, scan a random voting proposal instead
    vote_dict = scan_random_proposal(vote_dict);
  }
  ;; save data and return
  return store_data(cfg_dict, vote_dict);
}

int seqno() method_id {
  return get_data().begin_parse().preload_uint(32);
}

_ unpack_proposal(slice pstatus) inline_ref {
  (int expires, cell proposal, int critical?, cell voters, int weight_remaining, int vset_id, slice rest) = unpack_proposal_status(pstatus);
  var voters_list = null();
  var voter_id = (1 << 32);
  do {
    (voter_id, _, var f) = voters.udict_get_prev?(16, voter_id);
    if (f) {
      voters_list = cons(voter_id, voters_list);
    }
  } until (~ f);
  ;; Note there is a bug in config contract currently deployed in mainnet:
  ;; wins and losses are messed up
  var (rounds_remaining, wins, losses) = (rest~load_uint(8), rest~load_uint(8), rest~load_uint(8));
  rest.end_parse();
  var (param_id, param_val, param_hash) = parse_config_proposal(proposal);
  return [expires, critical?, [param_id, param_val, param_hash], vset_id, voters_list, weight_remaining, rounds_remaining, losses, wins];
}

_ get_proposal(int phash) method_id {
  (_, var vote_dict) = load_data();
  var (pstatus, found?) = vote_dict.udict_get?(256, phash);
  ifnot (found?) {
    return null();
  }
  return unpack_proposal(pstatus);
}

_ list_proposals() method_id {
  (_, var vote_dict) = load_data();
  var phash = (1 << 255) + ((1 << 255) - 1);
  var list = null();
  do {
    (phash, var pstatus, var f) = vote_dict.udict_get_prev?(256, phash);
    if (f) {
      list = cons([phash, unpack_proposal(pstatus)], list);
    }
  } until (~ f);
  return list;
}

_ proposal_storage_price(int critical?, int seconds, int bits, int refs) method_id {
  var cfg_dict = get_data().begin_parse().preload_ref();
  var cparam11 = cfg_dict.idict_get_ref(32, 11);
  var (min_tot_rounds, max_tot_rounds, min_wins, max_losses, min_store_sec, max_store_sec, bit_price, cell_price) = get_vote_config_internal(critical?, cparam11);
  if (seconds < min_store_sec) {
    return -1;
  }
  seconds = min(seconds, max_store_sec);
  return (bit_price * (bits + 1024) + cell_price * (refs + 2)) * seconds;
}
