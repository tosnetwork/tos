;; TOS Service Protocol fixed-price stablecoin escrow v1.
;;
;; One finalized escrow account is the canonical Accepted Quote, custody and
;; settlement authority. It supports exactly one stablecoin transfer per
;; terminal transition: full release or full timeout refund.

const int op::release = 0x4e450001;
const int op::refund = 0x4e450002;
const int op::jetton_transfer = 0x0f8a7ea5;
const int op::transfer_notification = 0x7362d09c;
const int op::excesses = 0xd53276db;

const int magic::data = 0x4e455331;          ;; NES1
const int magic::terms = 0x4e455431;         ;; NET1
const int magic::authorization = 0x4e454131; ;; NEA1
const int magic::runtime = 0x4e455231;       ;; NER1
const int magic::route = 0x4e455031;         ;; NEP1
const int magic::quote = 0x4e415131;         ;; NAQ1
const int magic::receipt = 0x4e575231;       ;; NWR1
const int magic::intent = 0x4e534931;        ;; NSI1
const int magic::transport = 0x4e544231;     ;; NTB1
const int magic::dispute = 0x4e445031;       ;; NDP1

const int status::awaiting_funding = 0;
const int status::funded = 1;
const int status::release_pending = 2;
const int status::refund_pending = 3;

const int err::bad_message = 2300;
const int err::bad_state = 2301;
const int err::wrong_wallet = 2302;
const int err::wrong_buyer = 2303;
const int err::wrong_amount = 2304;
const int err::deadline = 2305;
const int err::bad_receipt = 2306;
const int err::bad_signature = 2307;
const int err::bad_confirmation = 2308;

;; Covers both wallet executions plus the escrow confirmation transaction.
const int wallet_transfer_tos = 100000000;

(int, int, int, int, cell, cell, cell, cell) load_escrow() inline {
  slice ds = get_data().begin_parse();
  throw_unless(err::bad_state, ds~load_uint(32) == magic::data);
  throw_unless(err::bad_state, ds~load_uint(16) == 1);
  int status = ds~load_uint(8);
  int quote_hash = ds~load_uint(256);
  int terms_hash = ds~load_uint(256);
  int auth_hash = ds~load_uint(256);
  cell quote = ds~load_ref();
  cell terms = ds~load_ref();
  cell authorization = ds~load_ref();
  cell runtime = ds~load_ref();
  ds.end_parse();
  throw_unless(err::bad_state, (status <= status::refund_pending) &
    (cell_hash(quote) == quote_hash) & (cell_hash(terms) == terms_hash) &
    (cell_hash(authorization) == auth_hash));
  return (status, quote_hash, terms_hash, auth_hash, quote, terms, authorization, runtime);
}

() save_escrow(int status, int quote_hash, int terms_hash, int auth_hash,
    cell quote, cell terms, cell authorization, cell runtime) impure inline {
  set_data(begin_cell().store_uint(magic::data, 32).store_uint(1, 16)
    .store_uint(status, 8).store_uint(quote_hash, 256).store_uint(terms_hash, 256)
    .store_uint(auth_hash, 256).store_ref(quote).store_ref(terms)
    .store_ref(authorization).store_ref(runtime).end_cell());
}

(slice, slice, int, int) parse_terms(cell terms, int expected_hash) inline {
  throw_unless(err::bad_state, cell_hash(terms) == expected_hash);
  slice ts = terms.begin_parse();
  throw_unless(err::bad_state, ts~load_uint(32) == magic::terms);
  throw_unless(err::bad_state, ts~load_uint(16) == 1);
  slice buyer = ts~load_msg_addr();
  slice provider = ts~load_msg_addr();
  int funding_deadline = ts~load_uint(64);
  int refund_at = ts~load_uint(64);
  ts.end_parse();
  throw_unless(err::bad_state, (funding_deadline > 0) & (refund_at > funding_deadline));
  return (buyer, provider, funding_deadline, refund_at);
}

int parse_authorization(cell authorization, int expected_hash) inline {
  throw_unless(err::bad_state, cell_hash(authorization) == expected_hash);
  slice a = authorization.begin_parse();
  throw_unless(err::bad_state, a~load_uint(32) == magic::authorization);
  throw_unless(err::bad_state, a~load_uint(16) == 1);
  int public_key = a~load_uint(256);
  a.end_parse();
  throw_unless(err::bad_state, public_key != 0);
  return public_key;
}

(int, int, int) parse_amount_text(cell text) inline {
  slice s = text.begin_parse();
  throw_unless(err::bad_state, (s.slice_refs() == 0) & ((s.slice_bits() % 8) == 0));
  int bytes = s.slice_bits() / 8;
  throw_unless(err::bad_state, (bytes > 0) & (bytes <= 39));
  int amount = 0;
  int first = 1;
  repeat (bytes) {
    int digit = s~load_uint(8);
    throw_unless(err::bad_state, (digit >= 48) & (digit <= 57));
    throw_unless(err::bad_state, (~ first) | (bytes == 1) | (digit != 48));
    amount = amount * 10 + digit - 48;
    first = 0;
  }
  s.end_parse();
  throw_unless(err::bad_state, (amount > 0) & (amount < (1 << 120)));
  return (amount, bytes, first);
}

(int, int, int, int, int, int, int) parse_quote(cell quote, int expected_hash) inline_ref {
  throw_unless(err::bad_state, cell_hash(quote) == expected_hash);
  slice q = quote.begin_parse();
  throw_unless(err::bad_state, q~load_uint(32) == magic::quote);
  throw_unless(err::bad_state, q~load_uint(16) == 1);
  q~load_ref();
  cell identity = q~load_ref();
  cell economic = q~load_ref();
  cell authority = q~load_ref();
  q.end_parse();

  slice ids = identity.begin_parse();
  ids~load_uint(256);
  int provider_agent = ids~load_uint(256);
  cell version = ids~load_ref();
  ids.end_parse();
  throw_unless(err::bad_state, provider_agent != 0);
  slice version_data = version.begin_parse();
  version_data~skip_bits(256 + 256);
  int transport_hash = version_data~load_uint(256);
  int quote_expiry = version_data~load_uint(64);
  version_data~load_ref();
  version_data.end_parse();
  throw_unless(err::bad_state, quote_expiry > 0);

  slice es = economic.begin_parse();
  int escrow_terms_hash = es~load_uint(256);
  int dispute_hash = es~load_uint(256);
  cell asset = es~load_ref();
  cell amount_text = es~load_ref();
  es.end_parse();
  (int amount, _, _) = parse_amount_text(amount_text);

  slice asset_data = asset.begin_parse();
  throw_unless(err::bad_state, asset_data~load_int(32) == 0);
  int master_account = asset_data~load_uint(256);
  asset_data~load_uint(256);
  int wallet_code_hash = asset_data~load_uint(256);
  int decimals = asset_data~load_uint(8);
  asset_data.end_parse();
  throw_unless(err::bad_state, (master_account != 0) & (wallet_code_hash != 0) &
    (decimals > 0) & (decimals <= 18));

  slice auth = authority.begin_parse();
  int authorization_hash = auth~load_uint(256);
  auth.end_parse();
  throw_unless(err::bad_state, authorization_hash != 0);
  return (amount, provider_agent, escrow_terms_hash, authorization_hash,
    transport_hash, dispute_hash, quote_expiry);
}

(int, int, int, int, cell, cell, cell) parse_runtime(cell runtime) inline {
  slice r = runtime.begin_parse();
  throw_unless(err::bad_state, r~load_uint(32) == magic::runtime);
  throw_unless(err::bad_state, r~load_uint(16) == 1);
  int funded = r~load_uint(128);
  int settled = r~load_uint(128);
  int receipt_hash = r~load_uint(256);
  int pending_query = r~load_uint(64);
  cell route = r~load_ref();
  cell transport = r~load_ref();
  cell dispute = r~load_ref();
  r.end_parse();
  return (funded, settled, receipt_hash, pending_query, route, transport, dispute);
}

cell make_runtime(int funded, int settled, int receipt_hash, int pending_query,
    cell route, cell transport, cell dispute) inline {
  return begin_cell().store_uint(magic::runtime, 32).store_uint(1, 16)
    .store_uint(funded, 128).store_uint(settled, 128).store_uint(receipt_hash, 256)
    .store_uint(pending_query, 64).store_ref(route).store_ref(transport)
    .store_ref(dispute).end_cell();
}

() validate_transport(cell transport, int expected_hash) inline_ref {
  throw_unless(err::bad_state, cell_hash(transport) == expected_hash);
  slice t = transport.begin_parse();
  throw_unless(err::bad_state, t~load_uint(32) == magic::transport);
  throw_unless(err::bad_state, t~load_uint(16) == 1);
  int security_mode = t~load_uint(8);
  int max_request_bytes = t~load_uint(32);
  cell endpoint = t~load_ref();
  t.end_parse();
  slice e = endpoint.begin_parse();
  throw_unless(err::bad_state, (security_mode <= 1) & (max_request_bytes > 0) &
    (max_request_bytes <= 16777216) & (e.slice_refs() == 0) &
    ((e.slice_bits() % 8) == 0) & (e.slice_bits() > 0) & (e.slice_bits() <= 960));
  repeat (e.slice_bits() / 8) {
    int ch = e~load_uint(8);
    throw_unless(err::bad_state, (ch >= 0x21) & (ch <= 0x7e));
  }
  e.end_parse();
}

() validate_dispute(cell dispute, int expected_hash) inline_ref {
  throw_unless(err::bad_state, cell_hash(dispute) == expected_hash);
  slice d = dispute.begin_parse();
  throw_unless(err::bad_state, d~load_uint(32) == magic::dispute);
  throw_unless(err::bad_state, d~load_uint(16) == 1);
  throw_unless(err::bad_state, d~load_uint(8) == 0);
  throw_unless(err::bad_state, d~load_uint(8) == 1);
  throw_unless(err::bad_state, d~load_uint(8) == 1);
  d.end_parse();
}

(slice, cell) parse_route(cell route, int quote_master, int quote_wallet_hash) inline_ref {
  slice r = route.begin_parse();
  throw_unless(err::bad_state, r~load_uint(32) == magic::route);
  throw_unless(err::bad_state, r~load_uint(16) == 1);
  slice master = r~load_msg_addr();
  int wallet_hash = r~load_uint(256);
  cell wallet_code = r~load_ref();
  r.end_parse();
  (int master_wc, int master_account) = master.parse_std_addr();
  throw_unless(err::bad_state, (master_wc == 0) & (master_account == quote_master) &
    (wallet_hash == quote_wallet_hash) & (cell_hash(wallet_code) == wallet_hash));
  return (master, wallet_code);
}

slice wallet_address(slice owner, slice master, cell wallet_code) inline_ref {
  cell wallet_data = begin_cell().store_uint(0, 4).store_coins(0)
    .store_slice(owner).store_slice(master).end_cell();
  cell init = begin_cell().store_uint(0, 2).store_uint(1, 1).store_ref(wallet_code)
    .store_uint(1, 1).store_ref(wallet_data).store_uint(0, 1).end_cell();
  return begin_cell().store_uint(4, 3).store_int(0, 8)
    .store_uint(cell_hash(init), 256).end_cell().begin_parse();
}

() send_stablecoin(slice wallet, slice destination_owner, int amount, int query_id) impure inline_ref {
  cell body = begin_cell().store_uint(op::jetton_transfer, 32).store_uint(query_id, 64)
    .store_coins(amount).store_slice(destination_owner).store_slice(my_address())
    .store_uint(0, 1).store_coins(0).store_uint(0, 1).end_cell();
  cell message = begin_cell().store_uint(0x18, 6).store_slice(wallet)
    .store_tomis(wallet_transfer_tos).store_uint(0, 1 + 4 + 4 + 64 + 32)
    .store_uint(0, 1).store_uint(1, 1).store_ref(body).end_cell();
  send_raw_message(message, 1);
}

(int, int, int) parse_receipt(cell receipt, int expected_quote, int expected_amount,
    int expected_provider) inline_ref {
  slice r = receipt.begin_parse();
  throw_unless(err::bad_receipt, r~load_uint(32) == magic::receipt);
  throw_unless(err::bad_receipt, r~load_uint(16) == 1);
  int completed_at = r~load_uint(64);
  int exit_code = r~load_int(32);
  cell binding = r~load_ref();
  cell outcome = r~load_ref();
  cell evidence = r~load_ref();
  cell economic = r~load_ref();
  r.end_parse();
  throw_unless(err::bad_receipt, (completed_at > 0) & (exit_code == 0));

  slice b = binding.begin_parse();
  throw_unless(err::bad_receipt, b~load_uint(256) == expected_quote);
  throw_unless(err::bad_receipt, b~load_uint(256) != 0);
  throw_unless(err::bad_receipt, b~load_uint(256) != 0);
  b.end_parse();
  slice o = outcome.begin_parse();
  throw_unless(err::bad_receipt, o~load_uint(256) != 0);
  throw_unless(err::bad_receipt, o~load_uint(256) != 0);
  throw_unless(err::bad_receipt, o~load_uint(256) != 0);
  o.end_parse();
  slice e = evidence.begin_parse();
  throw_unless(err::bad_receipt, e~load_uint(256) != 0);
  throw_unless(err::bad_receipt, e~load_uint(256) != 0);
  throw_unless(err::bad_receipt, e~load_uint(256) != 0);
  e.end_parse();
  slice money = economic.begin_parse();
  int charged = money~load_uint(128);
  int provider = money~load_uint(256);
  money.end_parse();
  throw_unless(err::bad_receipt, (charged == expected_amount) &
    (provider == expected_provider));
  return (cell_hash(receipt), charged, completed_at);
}

cell settlement_intent(int query_id, int charged, int quote_hash,
    int receipt_hash) inline {
  return begin_cell().store_uint(magic::intent, 32).store_uint(1, 16)
    .store_uint(query_id, 64).store_uint(charged, 128).store_slice(my_address())
    .store_uint(quote_hash, 256).store_uint(receipt_hash, 256).end_cell();
}

() recv_internal(int msg_value, cell in_msg_full, slice body) impure {
  slice full = in_msg_full.begin_parse();
  int flags = full~load_uint(4);
  slice sender = full~load_msg_addr();
  if (body.slice_empty?()) { return (); }

  (int status, int quote_hash, int terms_hash, int auth_hash, cell quote,
    cell terms, cell authorization, cell runtime) = load_escrow();
  (slice buyer, slice provider, int funding_deadline, int refund_at) =
    parse_terms(terms, terms_hash);
  int public_key = parse_authorization(authorization, auth_hash);
  (int quote_amount, int provider_agent, int quote_terms_hash, int quote_auth_hash,
    int quote_transport_hash, int quote_dispute_hash, int quote_expiry) =
    parse_quote(quote, quote_hash);
  throw_unless(err::bad_state, (quote_terms_hash == terms_hash) & (quote_auth_hash == auth_hash));
  (int funded, int settled, int receipt_hash, int pending_query, cell route,
    cell transport, cell dispute) =
    parse_runtime(runtime);
  validate_transport(transport, quote_transport_hash);
  validate_dispute(dispute, quote_dispute_hash);

  slice quote_asset = quote.begin_parse();
  quote_asset~skip_bits(48); quote_asset~load_ref(); quote_asset~load_ref();
  slice quote_economic = quote_asset~load_ref().begin_parse();
  quote_economic~skip_bits(512);
  slice quote_asset_cell = quote_economic~load_ref().begin_parse();
  quote_asset_cell~load_int(32);
  int quote_master = quote_asset_cell~load_uint(256);
  quote_asset_cell~load_uint(256);
  int quote_wallet_hash = quote_asset_cell~load_uint(256);
  (slice master, cell wallet_code) = parse_route(route, quote_master, quote_wallet_hash);
  slice own_wallet = wallet_address(my_address(), master, wallet_code);

  if (flags & 1) {
    throw_unless(err::bad_confirmation, equal_slice_bits(sender, own_wallet));
    body~skip_bits(32);
    throw_unless(err::bad_confirmation, body~load_uint(32) == op::jetton_transfer);
    int bounced_query = body~load_uint(64);
    throw_unless(err::bad_confirmation, ((status == status::release_pending) |
      (status == status::refund_pending)) & (bounced_query == pending_query));
    save_escrow(status::funded, quote_hash, terms_hash, auth_hash, quote, terms,
      authorization, make_runtime(funded, 0, 0, 0, route, transport, dispute));
    return ();
  }

  int op = body~load_uint(32);
  if (op == op::transfer_notification) {
    throw_unless(err::bad_state, status == status::awaiting_funding);
    throw_unless(err::wrong_wallet, equal_slice_bits(sender, own_wallet));
    int query_id = body~load_uint(64);
    int amount = body~load_coins();
    slice from = body~load_msg_addr();
    throw_unless(err::wrong_buyer, equal_slice_bits(from, buyer));
    throw_unless(err::deadline, (now() <= funding_deadline) & (now() <= quote_expiry));
    throw_unless(err::wrong_amount, amount == quote_amount);
    save_escrow(status::funded, quote_hash, terms_hash, auth_hash, quote, terms,
      authorization, make_runtime(amount, 0, 0, 0, route, transport, dispute));
    return ();
  }

  if (op == op::release) {
    throw_unless(err::bad_state, status == status::funded);
    throw_unless(err::deadline, now() < refund_at);
    int query_id = body~load_uint(64);
    throw_unless(err::bad_message, query_id != 0);
    slice signature = body~load_bits(512);
    cell receipt = body~load_ref();
    body.end_parse();
    (int new_receipt_hash, int charged, int completed_at) = parse_receipt(receipt, quote_hash,
      quote_amount, provider_agent);
    throw_unless(err::bad_receipt, (completed_at <= now()) & (completed_at < refund_at));
    cell intent = settlement_intent(query_id, charged, quote_hash, new_receipt_hash);
    throw_unless(err::bad_signature, check_signature(cell_hash(intent), signature, public_key));
    save_escrow(status::release_pending, quote_hash, terms_hash, auth_hash, quote,
      terms, authorization, make_runtime(funded, charged, new_receipt_hash, query_id,
        route, transport, dispute));
    send_stablecoin(own_wallet, provider, charged, query_id);
    return ();
  }

  if (op == op::refund) {
    throw_unless(err::bad_state, status == status::funded);
    throw_unless(err::deadline, now() >= refund_at);
    int query_id = body~load_uint(64);
    body.end_parse();
    throw_unless(err::bad_message, query_id != 0);
    save_escrow(status::refund_pending, quote_hash, terms_hash, auth_hash, quote,
      terms, authorization, make_runtime(funded, 0, 0, query_id, route, transport, dispute));
    send_stablecoin(own_wallet, buyer, funded, query_id);
    return ();
  }

  if (op == op::excesses) {
    ;; Standard-wallet excesses bind only query_id, not transfer source or
    ;; amount. They are deliberately non-authoritative. A finalized resolver
    ;; proves the wallet transaction chain while this state remains pending.
    return ();
  }
  throw(err::bad_message);
}

(int, int, int, int, int) get_escrow_state() method_id {
  (int status, int quote_hash, int terms_hash, int auth_hash, cell quote,
    cell terms, cell authorization, cell runtime) = load_escrow();
  (int funded, int settled, int receipt_hash, int pending_query, cell route,
    cell transport, cell dispute) =
    parse_runtime(runtime);
  return (status, funded, settled, receipt_hash, pending_query);
}

(cell, cell, cell, cell) get_escrow_cells() method_id {
  (int status, int quote_hash, int terms_hash, int auth_hash, cell quote,
    cell terms, cell authorization, cell runtime) = load_escrow();
  return (quote, terms, authorization, runtime);
}

slice get_escrow_wallet() method_id {
  (int status, int quote_hash, int terms_hash, int auth_hash, cell quote,
    cell terms, cell authorization, cell runtime) = load_escrow();
  (int funded, int settled, int receipt_hash, int pending_query, cell route,
    cell transport, cell dispute) =
    parse_runtime(runtime);
  slice quote_data = quote.begin_parse();
  quote_data~skip_bits(48); quote_data~load_ref(); quote_data~load_ref();
  slice economic = quote_data~load_ref().begin_parse();
  economic~skip_bits(512);
  slice asset = economic~load_ref().begin_parse();
  asset~load_int(32);
  int master_account = asset~load_uint(256);
  asset~load_uint(256);
  int wallet_hash = asset~load_uint(256);
  (slice master, cell wallet_code) = parse_route(route, master_account, wallet_hash);
  return wallet_address(my_address(), master, wallet_code);
}
