#!/usr/bin/create-state -s
"TosUtil.fif" include
"Asm.fif" include
"Lists.fif" include

// =====================================================================
//  CANONICAL MAINNET GENESIS — Native (wc=0) only
// =====================================================================
//
// This is THE default mainnet template. It ships a ConfigParam 12 that
// contains ONLY the Native workchain (wc=0) plus the masterchain (wc=-1),
// and it does NOT include the eTOS PoW givers — the supply is fully
// pre-mined (see the main-wallet line below).
//
// The EVM (wc=1), Uno (wc=2), and JVM (wc=3) registration blocks are
// deliberately absent: those engines are compiled into the same
// `validator-engine` binary but are activated by *configuration*, not by
// the binary. Launching with wc=0 alone lets the Native chain run
// independently while the other three mature; each can be switched on
// later — at any masterchain height — as a `ConfigParam 12` governance
// update that adds its WorkchainDescr (and, for JVM, the companion
// ConfigParam 85). No binary redeploy or validator restart is required,
// since every validator already runs the engine-capable binary.
//
// Everything below the workchain section (masterchain economics, gas,
// fwd prices, consensus params, validators, elector/config smart
// contracts) is byte-identical to the four-chain template, so a later
// EVM/Uno/JVM activation needs no consensus-parameter change.
//
// To build the (NOT launch-ready, unaudited) full four-chain network
// instead, use `gen-zerostate-allchains.fif`. See finding F1 in
// doc/security-audit-native-2026-06.md.
// =====================================================================

def? $1 { @' $1 } { "" } cond constant suffix
{ suffix $+ } : +suffix
256 1<<1- 15 / constant AllOnes

wc_master setworkchain
1 setglobalid   // TOS mainnet global_id
0x544F5301 default-subwallet-id!  // TOS-specific default subwallet id

// Initial state of Workchain 0 (Basic workchain)

0 mkemptyShardState

cr ."initial basechain state is:" cr dup <s csr. cr
dup dup 31 boc+>B dup Bx. cr
dup "basestate0" +suffix +".boc" tuck B>file
."(Initial basechain state saved to file " type .")" cr
Bhashu dup =: basestate0_fhash
."file hash=" dup 64x. space 256 u>B dup B>base64url type cr
"basestate0" +suffix +".fhash" B>file
hashu dup =: basestate0_rhash
."root hash=" dup 64x. space 256 u>B dup B>base64url type cr
"basestate0" +suffix +".rhash" B>file

// root-hash file-hash start-at actual-min-split min-split-depth max-split-depth wc-id
basestate0_rhash basestate0_fhash now 0 4 8 0 add-std-workchain

// ---------------------------------------------------------------------
// EVM (wc=1), Uno (wc=2), and JVM (wc=3) are intentionally NOT registered
// here. See gen-zerostate.fif for their genesis wiring; activate them
// post-launch via a ConfigParam 12 governance update.
// ---------------------------------------------------------------------

config.workchains!

/*
 *
 *  Initial wallets (test)
 *
 */

// Stage 1 wallets

PK'Puasxr0QfFZZnYISRphVse7XHKfW7pZU5SJarVHXvQ+rpzkD rwallet-init-pubkey !
-86400 rwallet-start-at +!

{ swap create-wallet3 } : stage1
{ bl word $>TM bl word parse-pubkey } : parse-amount-pubkey
{ parse-amount-pubkey stage1 } : StA

// test
StA 1001 PuZ8WoEOTgSR8-HopmCIVlOVSL94tNn9zgraiJqMk1SnioEQ

// Stage 2 wallets

{ swap create-wallet0 } : stage2
{ parse-amount-pubkey stage2 } : StB

// test
StB 999. PubMMGvqM08jx_6BibYldMclwjl-D88r7-u0_IEcDXHA30-G

// Lockdowns

{ swap create-wallet3b } : stage3
{ parse-amount-pubkey stage3 } : StC

// SmartContract #1 (Advanced wallet)

// Create new advanced wallet; code adapted from `auto/wallet3-code.fif`
WCode3 // code
<b 0 32 u, 0 32 u,  // subwallet-id=0
   "main-wallet" +suffix +".pk" load-generate-keypair drop
   B,
b> // data
empty_cell // libs
TM$5000000 allocated-balance - // balance: 5 M TOS, fully pre-mined to the main wallet (TON-style)
0 // split_depth
0 // ticktock
AllOnes 1 * // address
6 // mode: create+setaddr
register_smc
dup make_special dup constant smc1_addr
Masterchain over
2dup ."main wallet address = " .addr cr 2dup 6 .Addr cr
"main-wallet" +suffix +".addr" save-address-verbose

// PoW Givers removed — TON-style full pre-mine.  The original TON network
// pre-mined its entire supply to the main wallet at genesis and deployed
// PoW-giver distribution contracts AFTERWARD, funded from that wallet.  TOS
// follows the same model here: the full 5 M supply is pre-mined to the main
// wallet above.  To add a mining distribution later, deploy giver contracts
// post-genesis from the main wallet (see doc/Mining-Design.md).
."Total allocated balance (pre-mine) = " allocated-balance .TM cr

/*
 *
 * SmartContract #4 (elector)
 *
 */
"auto/elector-code.fif" include   // code in separate source file
<b 0 1 1+ 1+ 4 + 32 + u, 0 256 u, b>  // data: dict dict dict tomis uint32 uint256
empty_cell  // libraries
TM$500  // balance: 500 tomis
0 // split_depth
2 // ticktock: tick
AllOnes 3 * // address: -1:333...333
6 // mode: create + setaddr
register_smc
dup make_special dup constant smc4_addr dup constant elector_addr
Masterchain swap
."elector smart contract address = " 2dup .addr cr 2dup 7 .Addr cr
"elector" +suffix +".addr" save-address-verbose

/*
 *
 * Configuration Parameters
 *
 */
// version capabilities (aligned with production: version=13, capabilities=494)
13 capCreateStats capBounceMsgBody or capReportVersion or capShortDequeue or capStoreOutMsgQueueSize or capMsgMetadata or capDeferMessages or config.version!
// ConfigParam 19: global_id (must match setglobalid above)
<b globalid@ 32 i, b> 19 config!
// max-validators max-main-validators min-validators
40 20 7 config.validator_num!  // min_validators=7 (see stake-limit note below)
// min-stake max-stake min-total-stake max-factor
// F2 (liveness-veto hardening vs the 5M supply): the elector caps the top
// validator's effective weight at max_stake_factor x the smallest participant.
// Worst-case concentration is then 3/(N+2): with max_stake_factor=3 and N>=7
// that is <= 1/3, so NO single validator (or single-key whale) can reach the
// 1/3 weight needed to veto the >=2/3 BFT quorum. min_total_stake = 7*min_stake
// forces a full min-validator complement, blocking a thin-set election where
// weight would concentrate. (Was 10K/100K/10K/10.0 — a single min-stake total
// with a 10x factor, which permitted a cheap 1/3 veto.)
TM$10000 TM$100000 TM$70000 sg~3 config.validator_stake_limits!
// elected-for elect-start-before elect-end-before stakes-frozen-for
65536 32768 8192 32768 config.election_params!
// config-addr = -1:5555...5555
AllOnes 5 * constant config_addr
config_addr config.config_smc!
// elector-addr
elector_addr config.elector_smc!

// 1 sg* 100 sg* 1000 sg* 1000000 sg* config.storage_prices!  // old values (too high)
1 500 1000 500000 config.storage_prices!
config.special!

// gas_price gas_limit special_gas_limit gas_credit block_gas_limit freeze_due_limit delete_due_limit flat_gas_limit flat_gas_price
// Basechain gas — sized so the EVM workchain (wc=1) can run with Fusaka EVM
// semantics once it is activated:
//   gas_limit       = 30M   (comfortably above EIP-7825 per-tx cap 2^24 = 16,777,216)
//   block_gas_limit = 60M   (Ethereum Fusaka default, EIP-7935)
// These basechain limits are kept identical to the full-launch zerostate so
// that activating EVM later needs no consensus-parameter change. Keeping them
// below EIP-7825 would force well-formed txs to fail at the compute-phase
// "tx gas limit exceeds block gas limit" check even after passing the
// admission-layer EIP-7825 validation.
26214400 30 *M 30 *M 10000 60 *M TM$0.1 TM$1.0 100 40000 config.gas_prices!
// masterchain gas (aligned with production)
655360000 1 *M 70 *M 10000 2500000 TM$0.1 TM$1.0 100 1000000 config.mc_gas_prices!
// lump_price bit_price cell_price ihr_factor first_frac next_frac
// basechain fwd (aligned with production)
400000 26214400 2621440000 3/2 sg*/ 1/3 sg*/ 1/3 sg*/ config.fwd_prices!
// masterchain fwd (aligned with production)
10000000 655360000 65536000000 3/2 sg*/ 1/3 sg*/ 1/3 sg*/ config.mc_fwd_prices!
// mc-cc-lifetime sh-cc-lifetime sh-val-lifetime sh-val-num mc-shuffle
250 250 1000 5 true config.catchain_params!
// round-candidates next-cand-delay-ms consensus-timeout-ms fast-attempts attempt-duration cc-max-deps max-block-size max-collated-size new-cc-ids
3 2000 16000 3 8 4 2 *Mi 2 *Mi true config.consensus_params!
// ConfigParam 30: Simplex consensus (target_rate=1000ms, slots=4, first_block_timeout=1000ms, max_desync=2)
// target-rate-ms slots-per-leader-window first-block-timeout-ms max-leader-window-desync
400 4 1000 2 make-simplex-params
400 4 1000 2 make-simplex-params
config.new_consensus_params_all!


// masterchain block limits (aligned with production)
128 *Ki 512 *Ki 1 *Mi triple      // bytes: underload soft hard
500000 1000000 2500000 triple     // gas: underload soft hard
1000 5000 10000 triple            // lt: underload soft hard
triple untriple config.mc_block_limits!
// basechain block limits — gas tiers aligned with ConfigParam 21 gas_limit/
// block_gas_limit above so collator block-selection and per-tx gas admission
// agree on the same size envelope. underload=5M, soft=60M (matches EIP-7935
// block cap), hard=120M (2x soft headroom).
256 *Ki 1 *Mi 2 *Mi triple           // bytes: underload soft hard
5000000 60000000 120000000 triple    // gas: underload soft hard
1000 5000 10000 triple               // lt: underload soft hard
triple untriple config.block_limits!

TM$1.7 TM$1 config.block_create_fees!
// smc1_addr config.collector_smc!
// F3: mint authority (ConfigParam 2) is the governance config contract, NOT
// the pre-mine wallet (smc1_addr). Decouples a single founder key from the
// extra-currency mint power.
config_addr config.minter_smc!

// F3: no genesis extra-currency minting. Base TOS is non-inflatable (the
// collator excludes base grams from to_mint), and the previous
// `-17 / 239` to_mint entries were copied TON test values. ConfigParam 7 is
// optional and is intentionally omitted, so genesis mints no extra-currency.

( 0 1 9 10 12 14 15 16 17 18 20 21 22 23 24 25 28 34 ) config.mandatory_params!
( -999 -1000 -1001 0 1 9 10 12 14 15 16 17 32 34 36 ) config.critical_params!

// [ min_tot_rounds max_tot_rounds min_wins max_losses min_store_sec max_store_sec bit_pps cell_pps ]
// first for ordinary proposals, then for critical proposals
_( 2 3 2 2 1000000 10000000 1 500 )
_( 4 7 4 2 5000000 20000000 2 1000 )
config.param_proposals_setup!

// deposit bit_pps cell_pps
TM$100 1 500 config.complaint_prices!

{ file>B { dup Blen } {
    32 B| swap dup ."Validator public key = " Bx. cr
    17 add-validator
  } while drop
} : load-keys-from-file

false =: keys-from-file
keys-from-file
{ "validator-keys" +suffix +".pub" load-keys-from-file
} {
  VPK'xrQTSOn2F9RjLgeHdSS0uIvde4Lv49l+/KXfJe0I7wYatz6e
  B64{8E9AbL8blhRiBUoZt/b/vIo3+iZzglLKiL8MTf0g6Sg=} 256 B>u@
  1 add-adnl-validator
} cond
// newkeypair nip dup ."Validator #1 public key = " Bx. cr
// 17 add-validator
// newkeypair nip dup ."Validator #2 public key = " Bx. cr
// 239 add-validator

3000 =: orig_vset_valid_for  // original validator set valid 3000 seconds
now dup orig_vset_valid_for + 0 config.validators!

/*
 *
 * SmartContract #5 (Configuration smart contract)
 *
 */
"auto/config-code.fif" include   // code in separate source file
<b configdict ref,  // initial configuration
   0 32 u,          // seqno
   "config-master" +suffix +".pk" load-generate-keypair drop
   B,
   dictnew dict,   // vote dict
b> // data
empty_cell  // libraries
TM$500  // balance
0 1 config_addr 6 register_smc  // tock
dup set_config_smc
Masterchain swap
."config smart contract address = " 2dup .addr cr 2dup 7 .Addr cr
"config-master" +suffix +".addr" save-address-verbose
// Other data

/*
 *
 *  Create state
 *
 */

create_state
cr cr ."new state is:" cr dup <s csr. cr
dup 31 boc+>B dup Bx. cr
dup "zerostate" +suffix +".boc" tuck B>file
."(Initial masterchain state saved to file " type .")" cr
Bhashu dup =: zerostate_fhash
."file hash= " dup X. space 256 u>B dup B>base64url type cr
"zerostate" +suffix +".fhash" B>file
hashu dup =: zerostate_rhash ."root hash= " dup X. space 256 u>B dup B>base64url type cr
"zerostate" +suffix +".rhash" B>file
basestate0_rhash ."Basestate0 root hash= " dup X. space 256 u>B B>base64url type cr
basestate0_fhash ."Basestate0 file hash= " dup X. space 256 u>B B>base64url type cr
zerostate_rhash ."Zerostate root hash= " dup X. space 256 u>B B>base64url type cr
zerostate_fhash ."Zerostate file hash= " dup X. space 256 u>B B>base64url type cr
