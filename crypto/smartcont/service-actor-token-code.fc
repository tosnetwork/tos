;; Copyright (C) 2025-2026  TOS Network.
;; Service Actor, token rail: a provider that sells per-call access priced in
;; one recognized TOS-network token, fixed at deploy.
;;
;; The request lifecycle, terms, attestor, SRP2 response domain and request
;; snapshot are those of the native Service Actor (service-actor-code.fc).
;; What changes is funding, payouts and accounting:
;;
;; * A call is funded by an ordinary token transfer to this actor whose
;;   transfer_notification carries a `token_call` payload. The notification
;;   handler never throws once the notification is authenticated (it came from
;;   this actor's own token wallet) and funded: an admission refusal returns
;;   the tokens to their sender as a payout.
;; * Every token payout is a reported transfer, whose outcome (delivered,
;;   refused at the recipient's wallet R, or bounced at this actor's wallet S)
;;   comes back to this actor authenticated, bound to the payout id and amount,
;;   and is accepted at most once. Ledger effects commit at the outcome.
;; * ConfigParam 84 is read at admission only. No payout path reads it.
;;
;; Gas rule. No handler calls accept_message, and the only set_gas_limit raises
;; the limit in the outcome handlers, after the sender, the payout id and the
;; amount (and, for a delivery, the recipient) have been matched against the
;; stored payout. From there the handler is paid from that payout's
;; outcome_fee_lock, which its requester funded, once, because the payout is
;; deleted in the same transaction. Every other handler runs on the gas its
;; own message bought.
;;
;; Persistent data:
;;   owner:MsgAddress active:uint1 next_request_id:uint64 pending_count:uint32
;;   live_count:uint32 next_payout_id:uint64
;;   ^Policy ^Accounting ^Requests ^Payouts
;; Policy:
;;   policy_version:uint32 price_per_call:Coins storage_fee:Coins
;;   cleanup_bounty:Coins response_sla:uint32 refund_claim_window:uint32
;;   open_access:uint1 has_authorized_caller:uint1 authorized_caller:MsgAddress
;;   rate_limit_per_day:uint32 max_token_liability:Coins
;;   ^[metadata_hash:uint256 proof_scheme_hash:uint256 has_attestor:uint1
;;     attestor_key_id:uint256 attestor_key:(Maybe ^StoredKey)]
;; Accounting (native ledger, nanoTOS):
;;   withdrawable_tos_revenue:Coins locked_storage_fees:Coins
;;   locked_outcome_fees:Coins call_day:uint32 calls_today:uint32
;;   revenue_payouts_in_flight:uint8 returned_count:uint32
;;   returns_in_flight:uint16 surplus_payouts_in_flight:uint8
;;   ^TokenLedger ^BalanceQuery ^AssetRoute
;; TokenLedger (token atomic units):
;;   pending_liability:Coins refundable_liability:Coins returned_liability:Coins
;;   in_flight:Coins withdrawable_token_revenue:Coins
;; BalanceQuery:
;;   active:uint1 query_id:uint64 purpose:uint1 created_at:uint32 floor:uint64
;;   delivered_since_floor:Coins recheck_target:uint64 amount:Coins
;;   requester:MsgAddress
;; AssetRoute:
;;   master:MsgAddressInt wallet_code_hash:uint256 wallet_code:^Cell
;; Requests:
;;   pending_requests:(HashmapE 64 ^PendingRequest) refunds:(HashmapE 64 ^Refund)
;;   caller_live_counts:(HashmapE 256 uint32)
;; Payouts:
;;   payouts:(HashmapE 64 ^Payout) returned:(HashmapE 64 ^Returned)
;;   caller_returned_counts:(HashmapE 256 uint32)
;;
;; PendingRequest and Refund keep the native layouts.
;; Payout:
;;   kind:uint3 request_id:uint64 recipient:MsgAddressInt requester:MsgAddressInt
;;   amount:Coins created_at:uint32
;;   ^[recipient_wallet:MsgAddressInt own_wallet:MsgAddressInt
;;     outcome_fee_lock:Coins ^LedgerUndo]
;;   kind: 1 refund, 2 sweep, 3 revenue withdrawal, 4 funding return,
;;         5 returned-entry claim, 6 surplus recovery, 7 returned-entry sweep.
;;   request_id is the request id for kinds 1 and 2, the returned entry's id
;;   for kinds 5 and 7, and 0 otherwise.
;; LedgerUndo: source:uint2 (0 none, 1 pending, 2 refunds) then, for kinds 1
;;   and 2, the request's entry cell by reference.
;; Returned:
;;   caller:MsgAddressInt amount:Coins paying:uint64 return_deadline:uint64
;;
;; Internal messages (op query_id ...):
;;   transfer_notification#7362d09c query_id:uint64 amount:Coins from:MsgAddress
;;     forward_payload:(Either Cell ^Cell)   -- from this actor's token wallet
;;     with forward_payload = token_call#53544301 request_hash:uint256
;;     expected_terms_hash:uint256
;;   respond#53544302 request_id:uint64 response_hash:uint256
;;     signature:(Maybe ^StoredSignature, present iff the request has an attestor)
;;   expire#53544303 request_id:uint64
;;   claim_refund#53544304 request_id:uint64 destination:MsgAddressInt
;;   sweep_expired_request#53544305 request_id:uint64
;;   update_policy#53544306 price_per_call:Coins storage_fee:Coins
;;     cleanup_bounty:Coins response_sla:uint32 refund_claim_window:uint32
;;     active:uint1 open_access:uint1 has_authorized_caller:uint1
;;     authorized_caller:MsgAddress rate_limit_per_day:uint32
;;     max_token_liability:Coins ^[metadata_hash:uint256 proof_scheme_hash:uint256]
;;   rotate_attestor_key#53544307 attestor_key:^StoredKey
;;   revoke_attestor#53544308
;;   withdraw_revenue#53544309 token_amount:Coins tos_amount:Coins
;;   claim_returned#5354430a id:uint64 destination:MsgAddressInt
;;   recover_surplus#5354430b amount:Coins
;;   abandon_payout#5354430c id:uint64
;;   sweep_returned#5354430d id:uint64
;;   recheck_payout#5354430f id:uint64
;;   and, from the token wallets: transfer_delivered, transfer_refused,
;;   transfer_rereported, take_balance, and the bounce of this actor's own
;;   reported_transfer and provide_balance.
;;
;; External out-messages:
;;   SAT1#53415431 request_id:uint64 caller:MsgAddressInt request_hash:uint256
;;     response_deadline:uint64 refund_claim_deadline:uint64 terms:^TokenTerms
;;   SAF1#53414631 query_id:uint64 from:MsgAddressInt amount:Coins reason:uint16
;;     payout_id:uint64
;;   SAO1#53414f31 payout_id:uint64 kind:uint3 request_id:uint64
;;     recipient:MsgAddressInt amount:Coins outcome:uint3
;;   SAB1#53414231 query_id:uint64 purpose:uint1 target:uint64 balance:Coins
;;     surplus:Coins result:uint16 payout_id:uint64

