;; TOS PredictionMarket V1. One immutable binary market per instance.
;; The contract is deliberately self-contained: OpenFox discovers and matches
;; orders, while this code remains the sole authority for collateral, fills,
;; resolution and payout ledgers.

int get_global_id() asm "GLOBALID";

