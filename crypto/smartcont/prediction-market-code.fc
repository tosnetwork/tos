const int max_trading_duration = 31536000;
const int max_resolution_delay = 2592000;
const int max_oracle_window = 2592000;
const int max_challenge_period = 604800;
const int max_appeal_period = 1209600;
const int max_claim_window = 15552000;
const int min_challenge_bond = 10000000;
const int max_challenge_bond = 1000000000000;
