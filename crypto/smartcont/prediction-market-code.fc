;; The heaviest bounded V1 path (appellate quorum finalization) currently uses
;; 62,131 gas in the production BOC sandbox. Basechain gas costs 400 nanotomi
;; per gas under the audited fee schedule. The attached operation budget below
;; is a funding floor, not a gas-price conversion or a promise about fees.
const int min_operation_budget = 1000000000;
const int min_first_deposit = 1000000;
const int min_entry_fee = 1000000;
const int min_cleanup_bounty = 1000000;
