;; Copyright 2026 TOS Blockchain Teams. SPDX-License-Identifier: LGPL-2.0-or-later
;;
;; Validator Controller v1: the root of a validator's authority, post-quantum by
;; construction.
;;
;; This account is the stable validator identity and controls its operational consensus
;; key. Root actions require ML-DSA-44 authorization. A separately bound consensus key
;; can relay a caller's stake without gaining arbitrary spending authority. There is no
;; classical authorization, no modes, no replaceable authorization module, no extension
;; authority, no code replacement, no classical recovery.
;;
;; The security property is carried by this code rather than by any field in its data,
;; because an account's address commits to the code it was deployed with and a
;; configuration parameter admits code hashes. What is admitted therefore cannot become
;; classical later.

#include "pq.fc";
#include "pq-bytes.fc";
#include "pq-validator.fc";
#include "stake-relay.fc";

global cell ctl::relay_meta;

;; ---------------------------------------------------------------------------
;; The frozen authorization wire. `test/pq-native/controller-auth-vectors.tsv`
;; holds these bytes, and the node and the tooling are held to the same file.
;; ---------------------------------------------------------------------------

const int ctl::op = 0x50516361;        ;; "PQca", the inbound operation
const int ctl::sign_tag = 0x50514341;  ;; "PQCA", the signed domain

const int ctl::kind::send = 1;
const int ctl::kind::rotate_root = 2;
;; Bind, or replace, the consensus key this controller acts through. The root authorises
;; it and the new key proves its own private half exists, exactly as a root rotation does.
;; Only the key's identity is kept here; the secret never leaves the validator host.
const int ctl::kind::bind_consensus = 3;

const int ctl::error::no_consensus_key = 100;
const int ctl::error::wrong_consensus_key = 101;
const int ctl::error::relay_underfunded = 102;
;; A stake owner is a masterchain account: the wire carries its 256 bits and nothing
;; else, and the elector answers `-1:owner`.
const int ctl::error::owner_not_masterchain = 103;

;; How far ahead an authorization may be valid. A request that never expires is a request
;; that can be held and replayed the moment its nonce comes round again.
const int ctl::max_ttl = 3600;

const int ctl::error::bad_operation = 90;
const int ctl::error::wrong_network = 91;
const int ctl::error::stale_epoch = 92;
const int ctl::error::bad_nonce = 93;
const int ctl::error::expired = 94;
const int ctl::error::bad_kind = 95;
const int ctl::error::bad_cosignature = 96;
const int ctl::error::bad_action = 97;
const int ctl::error::bad_signature = 98;
const int ctl::error::not_internal = 99;

cell ctl::context() inline {
  return begin_cell().store_slice("TOS-VALIDATOR-CONTROLLER-v1").end_cell();
}

;; Exactly 93 bytes. The controller identity is this account's own address and never a
;; field of the request; the payload is committed by its level-zero hash, so an
;; authorization binds an action without carrying it twice.
cell ctl::auth_preimage(int controller_id, int epoch, int nonce, int valid_until, int kind,
                        int payload_hash) inline {
  return begin_cell()
    .store_uint(ctl::sign_tag, 32)
    .store_int(pq::global_id(), 32)
    .store_uint(controller_id, 256)
    .store_uint(epoch, 64)
    .store_uint(nonce, 64)
    .store_uint(valid_until, 32)
    .store_uint(kind, 8)
    .store_uint(payload_hash, 256)
  .end_cell();
}

int ctl::hash_level0(cell c) asm "0 CHASHI";

;; ---------------------------------------------------------------------------
;; Storage: epoch uint64, nonce uint64, consensus algorithm uint16, consensus key identity
;; uint256, root public key as canonical PQBytes.
;;
;; The consensus key is here by identity only -- the algorithm it belongs to and the
;; identity derived from it. The secret stays on the validator host and the key itself
;; travels in the stake this controller relays, where the elector checks it. What this
;; account keeps is only enough to refuse a stake signed by some other key.
;; ---------------------------------------------------------------------------

(int, int, int, int, cell) ctl::load_data() impure inline {
  slice ds = get_data().begin_parse();
  var res = (ds~load_uint(64), ds~load_uint(64), ds~load_uint(16), ds~load_uint(256), ds~load_ref());
  ctl::relay_meta = ds.slice_empty?() ? null() : ds~load_maybe_ref();
  ds.end_parse();
  return res;
}

() ctl::save_data(int epoch, int nonce, int consensus_algorithm, int consensus_key_id,
                  cell root) impure inline {
  set_data(begin_cell()
    .store_uint(epoch, 64)
    .store_uint(nonce, 64)
    .store_uint(consensus_algorithm, 16)
    .store_uint(consensus_key_id, 256)
    .store_ref(root)
    .store_maybe_ref(ctl::relay_meta)
  .end_cell());
}

;; A send this account is allowed to make. No mode that could delete the account, and no
;; combination that empties it: redeploying the original state init would otherwise
;; restore a root that was rotated away.
() ctl::check_send_mode(int mode) impure inline {
  throw_if(ctl::error::bad_action, mode & 44);          ;; bits 2, 3 and 5 (+32 destroys)
  throw_if(ctl::error::bad_action, (mode & 192) == 192); ;; not both whole balance and value
}

;; The elector, as the configuration names it. A relay goes there and nowhere else.
slice ctl::elector_address() inline {
  int elector = config_param(1).begin_parse().preload_uint(256);
  return begin_cell().store_uint(4, 3).store_int(-1, 8).store_uint(elector, 256)
    .end_cell().begin_parse();
}

;; At most one unfinished third-party transfer. The authority prefix stays unchanged.
(int, cell) ctl::relay_state() impure inline_ref {
  ctl::load_data();
  if (ctl::relay_meta.null?()) { return (sr::domain, null()); }
  slice cs = ctl::relay_meta.begin_parse();
  var result = (cs~load_uint(64), cs~load_maybe_ref()); cs.end_parse(); return result;
}
() ctl::save_relay(int sequence, cell pending) impure inline_ref {
  var (epoch, nonce, algorithm, key, root) = ctl::load_data();
  ctl::relay_meta = begin_cell().store_uint(sequence, 64).store_maybe_ref(pending).end_cell();
  ctl::save_data(epoch, nonce, algorithm, key, root);
}
cell ctl::record(int owner, int elector, int hash, int forwarded, int capital,
                 int prefix, int phase, cell receipt) inline_ref {
  cell amounts = begin_cell().store_coins(sr::coins(forwarded)).store_coins(sr::coins(capital))
    .store_uint(prefix, 256).store_maybe_ref(receipt).end_cell();
  return begin_cell().store_uint(owner, 256).store_uint(elector, 256).store_uint(hash, 256)
    .store_uint(phase, 2).store_ref(amounts).end_cell();
}
(int, int, int, int, int, int, int, cell) ctl::unpack(cell pending) inline_ref {
  slice cs = pending.begin_parse();
  var (owner, elector, hash, phase) = (cs~load_uint(256), cs~load_uint(256), cs~load_uint(256), cs~load_uint(2));
  slice amounts = cs~load_ref().begin_parse(); cs.end_parse();
  var (forwarded, capital, prefix, receipt) = (amounts~load_coins(), amounts~load_coins(),
    amounts~load_uint(256), amounts~load_maybe_ref()); amounts.end_parse();
  return (owner, elector, hash, forwarded, capital, prefix, phase, receipt);
}
() ctl::kick(int query) impure inline_ref {
  send_raw_message(sr::message(my_address(), sr::add(sr::control_value(), sr::callback_value()),
    begin_cell().store_uint(sr::retry, 32).store_uint(query, 64).end_cell(), false), 3);
}
() ctl::relay_stake(slice sender, int msg_value, slice cs) impure inline_ref {
  int query = cs~load_uint(64);
  int commitment = cs~load_uint(160);
  int forwarded = cs~load_coins();
  int elector = cs~load_uint(256);
  cell terms = cs~load_ref(); cs.end_parse();
  var (wc, owner) = parse_std_addr(sender);
  throw_unless(ctl::error::owner_not_masterchain, (wc == -1) & owner);
  var (_, controller) = parse_std_addr(my_address());
  var (_, _, bound_algorithm, bound_key, _) = ctl::load_data();
  throw_unless(ctl::error::no_consensus_key, bound_key);
  var (at, factor, adnl, algorithm, key, signature, witness) = sr::terms(terms.begin_parse());
  throw_unless(ctl::error::wrong_consensus_key, algorithm == bound_algorithm);
  int key_id = pq::key_id(algorithm, key);
  throw_unless(ctl::error::wrong_consensus_key, key_id == bound_key);
  (_, cell key_chain) = pq::stored_key(algorithm, key);
  cell signature_chain = pq::stored_signature(algorithm, signature);
  cell canonical_signature = begin_cell().store_uint(pq::mldsa44_signature_bytes, 32).store_ref(signature_chain).end_cell();
  throw_unless(sr::error, cell_hash(canonical_signature) == cell_hash(signature));
  throw_unless(sr::error, elector == sr::elector());
  throw_unless(sr::error, commitment == sr::commitment(owner, elector, forwarded, terms));
  var (sequence, pending) = ctl::relay_state();
  throw_unless(sr::error, (sequence < ((1 << 64) - 1)) & (query == sequence + 1) & pending.null?());
  cell payload = sr::payload(terms, owner);
  cell body = sr::stake_body(query, payload);
  cell outgoing = sr::message(sr::address(elector), forwarded, body, true);
  throw_unless(ctl::error::relay_underfunded, forwarded > sr::confirmation);
  throw_unless(ctl::error::relay_underfunded, msg_value >= sr::add(forwarded, sr::relay_cost(outgoing)));
  set_gas_limit(sr::relay_gas);
  ;; Persistent space must not be occupied by an invalid public request.
  throw_unless(ctl::error::bad_signature, pq_check_mldsa44(
    pq::stake_preimage(at, factor, controller, owner, algorithm, key_id, adnl),
    pq::election_context(), signature_chain, key_chain));
  int capital = sr::sub(pair_first(get_balance()), msg_value);
  pending = ctl::record(owner, elector, sr::request_hash(controller, query, payload), forwarded,
    capital, body.begin_parse().preload_uint(256), 0, null());
  ctl::save_relay(query, pending);
  raw_reserve(capital, 0);
  send_raw_message(outgoing, 17);
}
() ctl::receive_result(slice sender, int msg_value, int op, slice cs) impure inline_ref {
  int query = cs~load_uint(64);
  int reason = cs~load_uint(32);
  int accepted = cs~load_coins();
  int received = cs~load_coins();
  int hash = cs~load_uint(256); cs.end_parse();
  var (sequence, pending) = ctl::relay_state();
  if (pending.null?() | (query != sequence)) { return (); }
  var (owner, elector, expected, forwarded, capital, prefix, phase, _) = ctl::unpack(pending);
  var (wc, address) = parse_std_addr(sender);
  if ((wc != -1) | (address != elector) | (phase != 0)) { return (); }
  throw_unless(sr::error, (hash == expected) & (received == forwarded));
  throw_unless(sr::error, accepted == ((op == sr::ok) ? sr::sub(forwarded, sr::confirmation) : 0));
  throw_unless(sr::error, ((op == sr::ok) & (reason == 0)) | ((op == sr::error_reply) & (accepted == 0)));
  set_gas_limit(sr::control_gas);
  cell receipt = begin_cell().store_uint(sr::result, 32).store_uint(query, 64)
    .store_uint(hash, 256).store_coins(forwarded).store_coins(accepted).store_uint(reason, 32).store_int(op == sr::ok, 1).end_cell();
  ctl::save_relay(sequence, ctl::record(owner, elector, expected, forwarded, capital, prefix, 1, receipt));
  raw_reserve(capital, 2);
  ctl::kick(query);
}
() ctl::record_bounce(slice sender, int msg_value, slice body) impure inline_ref {
  var (sequence, pending) = ctl::relay_state();
  if (pending.null?()) { return (); }
  var (owner, elector, hash, forwarded, capital, prefix, phase, _) = ctl::unpack(pending);
  var (wc, address) = parse_std_addr(sender);
  if ((wc != -1) | (address != elector) | (phase != 0)) { return (); }
  ifnot (sr::bounce_matches(body, prefix)) { return (); }
  throw_unless(sr::error, msg_value <= forwarded);
  cell receipt = begin_cell().store_uint(sr::result, 32).store_uint(sequence, 64)
    .store_uint(hash, 256).store_coins(forwarded).store_coins(0).store_uint(0xffffffff, 32).store_uint(0, 1).end_cell();
  ctl::save_relay(sequence, ctl::record(owner, elector, hash, forwarded, capital, prefix, 1, receipt));
  raw_reserve(capital, 2);
  ctl::kick(sequence);
}
() ctl::retry(int msg_value, slice cs) impure inline_ref {
  int query = cs~load_uint(64); cs.end_parse();
  var (sequence, pending) = ctl::relay_state();
  if (pending.null?() | (query != sequence)) { return (); }
  var (owner, elector, hash, forwarded, capital, prefix, phase, receipt) = ctl::unpack(pending);
  throw_unless(sr::error, phase > 0);
  throw_unless(sr::error, msg_value >= sr::add(sr::control_value(), sr::callback_value()));
  set_gas_limit(sr::control_gas);
  if (phase == 1) {
    ctl::save_relay(sequence, ctl::record(owner, elector, hash, forwarded, capital, prefix, 2, receipt));
    raw_reserve(capital, 0);
    ;; Non-bounce payment: recipient compute abort cannot return or strand its principal.
    ;; Action failure rolls back PAID, leaving the READY debt available for retry.
    send_raw_message(sr::message(sr::address(owner), 0, receipt, false), 128);
  } else {
    raw_reserve(sr::sub(pair_first(get_balance()), msg_value), 0);
    ;; A paid receipt retry carries only this invocation's value, never old principal.
    send_raw_message(sr::message(sr::address(owner), 0, receipt, false), 64);
  }
}
() ctl::acknowledge(slice sender, int msg_value, slice cs) impure inline_ref {
  int query = cs~load_uint(64); int hash = cs~load_uint(256); cs.end_parse();
  var (sequence, pending) = ctl::relay_state();
  if (pending.null?() | (query != sequence)) { return (); }
  var (owner, _, expected, _, _, _, phase, _) = ctl::unpack(pending);
  var (wc, address) = parse_std_addr(sender);
  throw_unless(sr::error, (wc == -1) & (address == owner) & (hash == expected) & (phase == 2));
  ctl::save_relay(sequence, null());
  raw_reserve(sr::sub(pair_first(get_balance()), msg_value), 0);
  send_raw_message(sr::message(sender, 0, begin_cell().store_uint(1, 32).store_uint(query, 64).end_cell(), false), 64);
}

() ctl::check_root_send(cell out) impure inline_ref {
  slice cs = out.begin_parse();
  int flags = cs~load_uint(4);
  throw_unless(ctl::error::bad_action, (flags == 4) | (flags == 6));
  slice source = cs~load_msg_addr();
  ;; The executor fills addr_none, or accepts this controller's own canonical
  ;; source. A root authorization cannot create a message from another account.
  throw_unless(ctl::error::bad_action, (source.preload_uint(2) == 0) | equal_slice_bits(source, my_address()));
  slice destination = cs~load_msg_addr();
  var (out_wc, out_id) = parse_std_addr(destination);
  slice canonical = begin_cell().store_uint(4, 3).store_int(out_wc, 8)
    .store_uint(out_id, 256).end_cell().begin_parse();
  throw_unless(ctl::error::bad_action, slice_hash(destination) == slice_hash(canonical));
  cs~load_coins();
  throw_unless(ctl::error::bad_action, cs~load_uint(1) == 0);  ;; no extra currencies
  cs~load_coins(); cs~load_coins();
  cs~skip_bits(64 + 32);
  if (cs~load_uint(1)) {
    if (cs~load_uint(1)) {
      cs~load_ref();
    } else {
      if (cs~load_uint(1)) { cs~skip_bits(5); }
      if (cs~load_uint(1)) { cs~skip_bits(2); }
      cs~load_maybe_ref(); cs~load_maybe_ref(); cs~load_dict();
    }
  }
  slice body = cs;
  if (cs~load_uint(1)) {
    body = cs~load_ref().begin_parse();
    cs.end_parse();
  } else {
    body = cs;
  }
  if (body.slice_bits() >= 32) {
    int op = body~load_uint(32);
    throw_if(ctl::error::bad_action, sr::reserved_op(op));
    if (body.slice_bits() >= 64) {
      int query = body~load_uint(64);
      throw_if(ctl::error::bad_action, (query >= sr::domain));
    }
  }
}

() recv_internal(int msg_value, cell in_msg_full, slice in_msg_body) impure {
  slice header = in_msg_full.begin_parse();
  int flags = header~load_uint(4);

  slice sender = header~load_msg_addr();
  if (flags & 1) { return ctl::record_bounce(sender, msg_value, in_msg_body); }
  if (in_msg_body.slice_empty?()) { return (); }
  int op = in_msg_body~load_uint(32);
  if (op == sr::relay) { return ctl::relay_stake(sender, msg_value, in_msg_body); }
  if ((op == sr::ok) | (op == sr::error_reply)) { return ctl::receive_result(sender, msg_value, op, in_msg_body); }
  if (op == sr::retry) { return ctl::retry(msg_value, in_msg_body); }
  if (op == sr::ack) { return ctl::acknowledge(sender, msg_value, in_msg_body); }
  if ((op == 0xf374484c) | (op == 0xee6f454c) | (op == 0xf96f7324) | (op == 0xfffffffe)) {
    var (wc, address) = parse_std_addr(sender);
    throw_unless(sr::error, (wc == -1) & (address == sr::elector()));
    throw_unless(sr::error, in_msg_body~load_uint(64) < sr::domain);
    return ();
  }
  throw_unless(ctl::error::bad_operation, op == ctl::op);
  in_msg_body~load_uint(64);  ;; query_id, echoed by nothing: this account answers no one

  ;; Everything decidable without the key is decided before the verification, which costs
  ;; about fifty thousand gas. An unauthorized request pays for the parse and nothing more.
  int global_id = in_msg_body~load_int(32);
  int epoch = in_msg_body~load_uint(64);
  int nonce = in_msg_body~load_uint(64);
  int valid_until = in_msg_body~load_uint(32);
  int kind = in_msg_body~load_uint(8);
  cell payload = in_msg_body~load_ref();
  cell signature = in_msg_body~load_ref();
  cell cosignature = in_msg_body~load_maybe_ref();
  in_msg_body.end_parse();

  throw_unless(ctl::error::wrong_network, global_id == pq::global_id());
  var (stored_epoch, stored_nonce, consensus_algorithm, consensus_key_id, root) = ctl::load_data();
  throw_unless(ctl::error::stale_epoch, epoch == stored_epoch);
  throw_unless(ctl::error::bad_nonce, nonce == stored_nonce);
  throw_unless(ctl::error::expired, valid_until > now());
  throw_unless(ctl::error::expired, valid_until <= now() + ctl::max_ttl);
  throw_unless(ctl::error::bad_kind, (kind == ctl::kind::send) | (kind == ctl::kind::rotate_root)
                                     | (kind == ctl::kind::bind_consensus));

  ;; A cosignature belongs to the two kinds that install a key: it is the new key's proof
  ;; that its private half exists. Without it a mistyped key would lock this account out
  ;; of its own root, or bind it to a consensus key nobody holds. A request that carries
  ;; one for any other kind is not the request it claims to be.
  int installs_a_key = (kind == ctl::kind::rotate_root) | (kind == ctl::kind::bind_consensus);
  if (installs_a_key) {
    throw_if(ctl::error::bad_cosignature, cell_null?(cosignature));
  } else {
    throw_unless(ctl::error::bad_cosignature, cell_null?(cosignature));
  }

  (int controller_wc, int controller_id) = parse_std_addr(my_address());
  cell message = ctl::auth_preimage(controller_id, epoch, nonce, valid_until, kind,
                                    ctl::hash_level0(payload));
  cell context = ctl::context();

  (_, cell root_chain) = pq::stored_key(pq::algorithm::mldsa44, root);
  ifnot (pq_check_mldsa44(message, context, pq::stored_signature(pq::algorithm::mldsa44, signature),
                          root_chain)) {
    throw(ctl::error::bad_signature);
  }

  if (kind == ctl::kind::send) {
    slice ps = payload.begin_parse();
    int mode = ps~load_uint(8);
    cell out = ps~load_ref();
    ps.end_parse();
    ctl::check_send_mode(mode);
    var (_, pending) = ctl::relay_state();
    throw_unless(ctl::error::bad_action, pending.null?());
    ctl::check_root_send(out);
    ;; The nonce is spent before the action, so a request cannot be replayed after one
    ;; that refused.
    ctl::save_data(stored_epoch, stored_nonce + 1, consensus_algorithm, consensus_key_id, root);
    send_raw_message(out, mode);
    return ();
  }

  if (kind == ctl::kind::bind_consensus) {
    slice ps = payload.begin_parse();
    int next_algorithm = ps~load_uint(16);
    cell next_key = ps~load_ref();
    ps.end_parse();
    throw_unless(ctl::error::wrong_consensus_key, pq::admitted_algorithm?(next_algorithm));
    (_, cell next_chain) = pq::stored_key(next_algorithm, next_key);
    ;; The key proves it exists. A consensus key that cannot sign is a validator that
    ;; cannot validate, and this account would have bound itself to it.
    ifnot (pq_check_mldsa44(message, context,
                            pq::stored_signature(next_algorithm, cosignature), next_chain)) {
      throw(ctl::error::bad_cosignature);
    }
    ;; The nonce is spent the way any other authorised action spends it. The epoch belongs
    ;; to the root and does not move: binding a consensus key replaces no root authority.
    ctl::save_data(stored_epoch, stored_nonce + 1, next_algorithm,
                   pq::key_id(next_algorithm, next_key), root);
    return ();
  }

  ;; A root rotation: the current root has authorized it above, and the successor proves
  ;; its private half exists over the very same commitment. Without that proof a mistyped
  ;; key would lock this account out of its own validator for good.
  slice ps = payload.begin_parse();
  cell next_root = ps~load_ref();
  ps.end_parse();
  (_, cell next_chain) = pq::stored_key(pq::algorithm::mldsa44, next_root);
  ifnot (pq_check_mldsa44(message, context,
                          pq::stored_signature(pq::algorithm::mldsa44, cosignature),
                          next_chain)) {
    throw(ctl::error::bad_cosignature);
  }
  ;; The epoch moves so authorizations made under the previous root cannot be replayed,
  ;; and the nonce restarts within it. The consensus binding is the root's to change and
  ;; survives its rotation: a new root inherits the validator, rather than silently
  ;; stopping it until it rebinds.
  ctl::save_data(stored_epoch + 1, 0, consensus_algorithm, consensus_key_id, next_root);
  return ();
}

() recv_external(slice in_msg) impure {
  ;; There is no external authorization path. An external message is admitted on credit
  ;; that cannot pay for a post-quantum verification, so accepting one would mean either
  ;; verifying nothing or spending this account's own balance to reject a stranger.
  throw(ctl::error::not_internal);
}

;; ---------------------------------------------------------------------------
;; Getters
;; ---------------------------------------------------------------------------

(int, int, int, int, cell) controller_state() method_id {
  return ctl::load_data();
}

int next_relay_query() method_id { var (sequence, _) = ctl::relay_state(); throw_unless(sr::error, sequence < ((1 << 64) - 1)); return sequence + 1; }
cell relay_pending() method_id { var (_, pending) = ctl::relay_state(); return pending; }
