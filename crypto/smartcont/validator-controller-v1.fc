;;
;; Validator Controller v1: the root of a validator's authority, post-quantum by
;; construction.
;;
;; This account owns the stake, is the stable validator identity, and is what replaces an
;; operational consensus key. Every action it takes is authorized by an ML-DSA-44
;; signature from the root key it holds, and there is deliberately no second way in: no
;; classical authorization, no modes, no replaceable authorization module, no extension
;; authority, no code replacement, no classical recovery.
;;
;; The security property is carried by this code rather than by any field in its data,
;; because an account's address commits to the code it was deployed with and a
;; configuration parameter admits code hashes. What is admitted therefore cannot become
;; classical later.

#include "pq.fc";
#include "pq-bytes.fc";

;; ---------------------------------------------------------------------------
;; The frozen authorization wire. `test/pq-native/n3-controller-auth-vectors.tsv`
;; holds these bytes, and the node and the tooling are held to the same file.
;; ---------------------------------------------------------------------------

const int ctl::op = 0x50516361;        ;; "PQca", the inbound operation
const int ctl::sign_tag = 0x50514341;  ;; "PQCA", the signed domain

const int ctl::kind::send = 1;
const int ctl::kind::rotate_root = 2;

;; How far ahead an authorization may be valid. A request that never expires is a request
;; that can be held and replayed the moment its nonce comes round again.
const int ctl::max_ttl = 3600;

const int ctl::error::bad_operation = 90;
const int ctl::error::wrong_network = 91;
const int ctl::error::stale_epoch = 92;
const int ctl::error::bad_nonce = 93;
const int ctl::error::expired = 94;
const int ctl::error::bad_kind = 95;
const int ctl::error::bad_cosignature = 96;
const int ctl::error::bad_action = 97;
const int ctl::error::bad_signature = 98;
const int ctl::error::not_internal = 99;

cell ctl::context() inline {
  return begin_cell().store_slice("TOS-VALIDATOR-CONTROLLER-v1").end_cell();
}

;; Exactly 93 bytes. The controller identity is this account's own address and never a
;; field of the request; the payload is committed by its level-zero hash, so an
;; authorization binds an action without carrying it twice.
cell ctl::auth_preimage(int controller_id, int epoch, int nonce, int valid_until, int kind,
                        int payload_hash) inline {
  return begin_cell()
    .store_uint(ctl::sign_tag, 32)
    .store_int(pq::global_id(), 32)
    .store_uint(controller_id, 256)
    .store_uint(epoch, 64)
    .store_uint(nonce, 64)
    .store_uint(valid_until, 32)
    .store_uint(kind, 8)
    .store_uint(payload_hash, 256)
  .end_cell();
}

int ctl::hash_level0(cell c) asm "0 CHASHI";

;; ---------------------------------------------------------------------------
;; Storage: epoch uint64, nonce uint64, root public key as canonical PQBytes.
;; ---------------------------------------------------------------------------

(int, int, cell) ctl::load_data() inline {
  slice ds = get_data().begin_parse();
  var res = (ds~load_uint(64), ds~load_uint(64), ds~load_ref());
  ds.end_parse();
  return res;
}

() ctl::save_data(int epoch, int nonce, cell root) impure inline {
  set_data(begin_cell()
    .store_uint(epoch, 64)
    .store_uint(nonce, 64)
    .store_ref(root)
  .end_cell());
}

;; A send this account is allowed to make. No mode that could delete the account, and no
;; combination that empties it: redeploying the original state init would otherwise
;; restore a root that was rotated away.
() ctl::check_send_mode(int mode) impure inline {
  throw_if(ctl::error::bad_action, mode & 44);          ;; bits 2, 3 and 5 (+32 destroys)
  throw_if(ctl::error::bad_action, (mode & 192) == 192); ;; not both whole balance and value
}

() recv_internal(int msg_value, cell in_msg_full, slice in_msg_body) impure {
  if (in_msg_body.slice_empty?()) {
    return ();  ;; plain value transfer, used to fund the account
  }
  int op = in_msg_body~load_uint(32);
  throw_unless(ctl::error::bad_operation, op == ctl::op);
  in_msg_body~load_uint(64);  ;; query_id, echoed by nothing: this account answers no one

  ;; Everything decidable without the key is decided before the verification, which costs
  ;; about fifty thousand gas. An unauthorized request pays for the parse and nothing more.
  int global_id = in_msg_body~load_int(32);
  int epoch = in_msg_body~load_uint(64);
  int nonce = in_msg_body~load_uint(64);
  int valid_until = in_msg_body~load_uint(32);
  int kind = in_msg_body~load_uint(8);
  cell payload = in_msg_body~load_ref();
  cell signature = in_msg_body~load_ref();
  cell cosignature = in_msg_body~load_maybe_ref();
  in_msg_body.end_parse();

  throw_unless(ctl::error::wrong_network, global_id == pq::global_id());
  var (stored_epoch, stored_nonce, root) = ctl::load_data();
  throw_unless(ctl::error::stale_epoch, epoch == stored_epoch);
  throw_unless(ctl::error::bad_nonce, nonce == stored_nonce);
  throw_unless(ctl::error::expired, valid_until > now());
  throw_unless(ctl::error::expired, valid_until <= now() + ctl::max_ttl);
  throw_unless(ctl::error::bad_kind, (kind == ctl::kind::send) | (kind == ctl::kind::rotate_root));

  ;; A cosignature belongs to a root rotation and to nothing else: it is the successor's
  ;; proof that its private half exists, and a request that carries one for any other kind
  ;; is not the request it claims to be.
  if (kind == ctl::kind::rotate_root) {
    throw_if(ctl::error::bad_cosignature, cell_null?(cosignature));
  } else {
    throw_unless(ctl::error::bad_cosignature, cell_null?(cosignature));
  }

  (int controller_wc, int controller_id) = parse_std_addr(my_address());
  cell message = ctl::auth_preimage(controller_id, epoch, nonce, valid_until, kind,
                                    ctl::hash_level0(payload));
  cell context = ctl::context();

  (_, cell root_chain) = pq::stored_key(pq::algorithm::mldsa44, root);
  ifnot (pq_check_mldsa44(message, context, pq::stored_signature(pq::algorithm::mldsa44, signature),
                          root_chain)) {
    throw(ctl::error::bad_signature);
  }

  if (kind == ctl::kind::send) {
    slice ps = payload.begin_parse();
    int mode = ps~load_uint(8);
    cell out = ps~load_ref();
    ps.end_parse();
    ctl::check_send_mode(mode);
    ;; The nonce is spent before the action, so a request cannot be replayed after one
    ;; that refused.
    ctl::save_data(stored_epoch, stored_nonce + 1, root);
    send_raw_message(out, mode);
    return ();
  }

  ;; A root rotation: the current root has authorized it above, and the successor proves
  ;; its private half exists over the very same commitment. Without that proof a mistyped
  ;; key would lock this account out of its own validator for good.
  slice ps = payload.begin_parse();
  cell next_root = ps~load_ref();
  ps.end_parse();
  (_, cell next_chain) = pq::stored_key(pq::algorithm::mldsa44, next_root);
  ifnot (pq_check_mldsa44(message, context,
                          pq::stored_signature(pq::algorithm::mldsa44, cosignature),
                          next_chain)) {
    throw(ctl::error::bad_cosignature);
  }
  ;; The epoch moves so authorizations made under the previous root cannot be replayed,
  ;; and the nonce restarts within it.
  ctl::save_data(stored_epoch + 1, 0, next_root);
  return ();
}

() recv_external(slice in_msg) impure {
  ;; There is no external authorization path. An external message is admitted on credit
  ;; that cannot pay for a post-quantum verification, so accepting one would mean either
  ;; verifying nothing or spending this account's own balance to reject a stranger.
  throw(ctl::error::not_internal);
}

;; ---------------------------------------------------------------------------
;; Getters
;; ---------------------------------------------------------------------------

(int, int, cell) controller_state() method_id {
  return ctl::load_data();
}
