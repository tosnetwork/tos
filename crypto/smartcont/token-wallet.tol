// =============================================================================
// Slice 2 Stage 8b — token-wallet Tol re-migration to high-level syntax.
//
// Policy reference: https://github.com/tosnetwork/doc/blob/main/tos-blockchain/tos-language-syntax-policy.md §3.1, §3.2
// (`@unknown_throw`), §3.5 (`get fun`), §6.1 (wire-bit-identity), and §7
// (migration path). Inherits Slice 1 Stage 3.2 wire commitments from
// https://github.com/tosnetwork/doc/blob/main/tos-blockchain/tos-message-policy.md v6 §3.1 (standard body layout), §5.2 (OP_ERROR
// body), §5.3 (error_class), and §8.1 (bit-for-bit compatibility for existing
// TOS Token V1 formats).
//
// Bytecode delta captured at write time:
//   FunC cells: 17
//   Tol cells:  10
//   ratio:      0.59
// After config-priced fees (Fift `totalcsize` of the compiled code BoCs,
// 2026-10-02): FunC 16 cells / 5969 bits, Tol 17 cells / 8314 bits
// (was 11 cells / 5535 bits); cell ratio 1.06, inside the 1.15 budget.
//
// §5.3 error-class assignment table:
//   FunC line          | FunC throw(N) | ErrorClass    | error_code | Slice 2 site
//   imports/params.fc:5 | throw(333)   | Protocol      | 1333
//   60                 | throw(705)    | Authorization | 1705
//   61                 | throw(706)    | Permanent     | 1706
//   68                 | throw(708)    | Protocol      | 1708
//   88                 | throw(709)    | BackPressure  | 1709
//   119                | throw(707)    | Authorization | 1707
//   175                | throw(705)    | Authorization | 1705
//   176                | throw(706)    | Permanent     | 1706
//   177                | throw(707)    | BackPressure  | 1710
//   203                | throw(709)    | Protocol      | 1711
//   245                | throw(0xffff) | Protocol      | 65535      | @unknown_throw(0xffff)
//
// Compatibility note: the FunC reference stores owner/master/response fields
// as MsgAddress slices and hand-packs all outbound messages. This migration
// keeps those fields as `any_address` and preserves raw message builders for
// internal_transfer, transfer_notification, excesses, and burn_notification.
// createMessage() would make the bodies easier to inspect, but it would also
// narrow several MsgAddress fields or choose inline/ref body placement for us.
//
// Slice 3 Stage 3 keeps the old file-scope helper names as compatibility
// wrappers because the Slice 1/2 tol-tester suites import them directly. Their
// raw outbound builders, address helpers, basechain guard, and error mapping
// now delegate to `@stdlib/token`. The receive-path helpers still accept the
// compiler-loaded `storage` value and return the next storage snapshot so the
// generated contract receiver remains the single c4 save site.
//
// Fee sufficiency is priced from the live fee configuration through
// `@stdlib/token-fees` instead of the fixed 0.01-coin constants the FunC
// reference uses, so the BoC is no longer byte-identical to the Stage 0
// baseline. Only configuration-independent quantities (gas units, bits and
// cells) live in `walletFeeProfile()`; the emulator fixture
// token-wallet-fee-profile-fixture.cpp measures them against this build and
// fails if a code change makes them stale.
// =============================================================================

import "@stdlib/common"
import "@stdlib/gas-payments"
import "@stdlib/token"
import "@stdlib/token-fees"
import "token-wallet-fee-profile"

const OP_TRANSFER: uint32 = TOKEN_OP_TRANSFER
const OP_TRANSFER_NOTIFICATION: uint32 = TOKEN_OP_TRANSFER_NOTIFICATION
const OP_INTERNAL_TRANSFER: uint32 = TOKEN_OP_INTERNAL_TRANSFER
const OP_EXCESSES: uint32 = TOKEN_OP_EXCESSES
const OP_BURN: uint32 = TOKEN_OP_BURN
const OP_BURN_NOTIFICATION: uint32 = TOKEN_OP_BURN_NOTIFICATION


const FUNC_THROW_WRONG_WORKCHAIN = TOKEN_WALLET_FUNC_THROW_WRONG_WORKCHAIN
const FUNC_THROW_OWNER_REQUIRED = TOKEN_WALLET_FUNC_THROW_OWNER_REQUIRED
const FUNC_THROW_INSUFFICIENT_BALANCE = TOKEN_WALLET_FUNC_THROW_INSUFFICIENT_BALANCE
const FUNC_THROW_INVALID_SENDER_OR_BURN_VALUE = TOKEN_WALLET_FUNC_THROW_INVALID_SENDER_OR_BURN_VALUE
const FUNC_THROW_MALFORMED_FORWARD_PAYLOAD = TOKEN_WALLET_FUNC_THROW_MALFORMED_FORWARD_PAYLOAD
const FUNC_THROW_INSUFFICIENT_VALUE_OR_BAD_BOUNCE = TOKEN_WALLET_FUNC_THROW_INSUFFICIENT_VALUE_OR_BAD_BOUNCE
const FUNC_THROW_UNKNOWN_OPCODE = TOKEN_FUNC_THROW_UNKNOWN_OPCODE

const TOKEN_WALLET_ERROR_WRONG_WORKCHAIN = TOKEN_STDLIB_WALLET_ERROR_WRONG_WORKCHAIN
const TOKEN_WALLET_ERROR_OWNER_REQUIRED = TOKEN_STDLIB_WALLET_ERROR_OWNER_REQUIRED
const TOKEN_WALLET_ERROR_INSUFFICIENT_BALANCE = TOKEN_STDLIB_WALLET_ERROR_INSUFFICIENT_BALANCE
const TOKEN_WALLET_ERROR_INVALID_TRANSFER_SENDER = TOKEN_STDLIB_WALLET_ERROR_INVALID_TRANSFER_SENDER
const TOKEN_WALLET_ERROR_MALFORMED_FORWARD_PAYLOAD = TOKEN_STDLIB_WALLET_ERROR_MALFORMED_FORWARD_PAYLOAD
const TOKEN_WALLET_ERROR_INSUFFICIENT_TRANSFER_VALUE = TOKEN_STDLIB_WALLET_ERROR_INSUFFICIENT_TRANSFER_VALUE
const TOKEN_WALLET_ERROR_INSUFFICIENT_BURN_VALUE = TOKEN_STDLIB_WALLET_ERROR_INSUFFICIENT_BURN_VALUE
const TOKEN_WALLET_ERROR_UNEXPECTED_BOUNCE = TOKEN_STDLIB_WALLET_ERROR_UNEXPECTED_BOUNCE
const TOKEN_WALLET_ERROR_UNKNOWN_OPCODE = TOKEN_STDLIB_WALLET_ERROR_UNKNOWN_OPCODE

@overflow1023_policy("suppress")
struct TokenWalletStorage {
    balance: coins;
    ownerAddress: any_address;
    tokenMasterAddress: any_address;
    tokenWalletCode: cell;
}

struct (OP_TRANSFER) TransferRequest {
    queryId: uint64;
    amount: coins;
    destination: any_address;
    responseDestination: any_address;
    customPayload: dict;
    forwardTosAmount: coins;
    forwardPayload: RemainingBitsAndRefs;
}

struct (OP_INTERNAL_TRANSFER) InternalTransferRequest {
    queryId: uint64;
    amount: coins;
    fromAddress: any_address;
    responseAddress: any_address;
    forwardTosAmount: coins;
    forwardPayload: RemainingBitsAndRefs;
}

struct (OP_BURN) BurnRequest {
    queryId: uint64;
    amount: coins;
    responseAddress: any_address;
    customPayload: RemainingBitsAndRefs;
}

struct (OP_TRANSFER_NOTIFICATION) TransferNotification {
    queryId: uint64;
    amount: coins;
    fromAddress: any_address;
    forwardPayload: RemainingBitsAndRefs;
}

struct (OP_EXCESSES) WalletExcesses {
    queryId: uint64;
}

/// Adds coins to the wallet's balance, e.g. to cover storage; carries no tokens.
struct (0xd372158c) TopUp {
    queryId: uint64;
}

struct (OP_BURN_NOTIFICATION) BurnNotification {
    queryId: uint64;
    amount: coins;
    ownerAddress: any_address;
    responseAddress: any_address;
}

@pure
fun currentData(): cell
    asm "c4 PUSH";

fun setCurrentData(data: cell): void
    asm "c4 POP";

@inline
fun loadWalletData(): TokenWalletStorage {
    return TokenWalletStorage.fromCell(currentData());
}

@inline
fun saveWalletData(storage: TokenWalletStorage): void {
    setCurrentData(storage.toCell());
}

@pure
fun sameInternalAndAnyAddressBits(a: address, b: any_address): bool {
    return tokenSameInternalAndAnyAddressBits(a, b);
}

fun forceBasechain(addr: any_address): void {
    tokenForceBasechain(addr);
}

@pure
fun packTokenWalletData(
    balance: coins,
    ownerAddress: any_address,
    tokenMasterAddress: any_address,
    tokenWalletCode: cell
): cell {
    return tokenWalletPackData(balance, ownerAddress, tokenMasterAddress, tokenWalletCode);
}

@pure
fun calculateTokenWalletStateInit(
    ownerAddress: any_address,
    tokenMasterAddress: any_address,
    tokenWalletCode: cell
): cell {
    return tokenWalletCalculateStateInit(ownerAddress, tokenMasterAddress, tokenWalletCode);
}

fun calculateTokenWalletAddress(stateInit: cell): address {
    return tokenCalculateWalletAddress(stateInit);
}

fun calculateUserTokenWalletAddress(
    ownerAddress: any_address,
    tokenMasterAddress: any_address,
    tokenWalletCode: cell
): address {
    return tokenWalletCalculateUserWalletAddress(ownerAddress, tokenMasterAddress, tokenWalletCode);
}

@pure
fun tokenWalletErrorForThrow(funcThrow: int, originalOp: uint32, queryId: uint64): Error {
    return tokenWalletErrorForFuncThrow(funcThrow, originalOp, queryId);
}

@pure
fun buildInternalTransferMessage(
    toWalletAddress: address,
    stateInit: cell,
    queryId: uint64,
    amount: coins,
    ownerAddress: any_address,
    responseAddress: any_address,
    forwardTosAmount: coins,
    forwardPayload: RemainingBitsAndRefs
): cell {
    return tokenBuildInternalTransferMessage(
        toWalletAddress,
        stateInit,
        queryId,
        amount,
        ownerAddress,
        responseAddress,
        forwardTosAmount,
        forwardPayload
    );
}

@pure
fun buildTransferNotificationMessage(
    ownerAddress: any_address,
    value: coins,
    queryId: uint64,
    amount: coins,
    fromAddress: any_address,
    forwardPayload: RemainingBitsAndRefs
): cell {
    return tokenBuildTransferNotificationMessage(ownerAddress, value, queryId, amount, fromAddress, forwardPayload);
}

@pure
fun buildWalletExcessesMessage(responseAddress: any_address, value: coins, queryId: uint64): cell {
    return tokenBuildWalletExcessesMessage(responseAddress, value, queryId);
}

@pure
fun buildBurnNotificationMessage(
    tokenMasterAddress: any_address,
    queryId: uint64,
    amount: coins,
    ownerAddress: any_address,
    responseAddress: any_address
): cell {
    return tokenBuildBurnNotificationMessage(tokenMasterAddress, queryId, amount, ownerAddress, responseAddress);
}

fun sendTokens(
    msg: TransferRequest,
    senderAddress: address,
    msgValue: coins,
    fwdFee: coins,
    storage: TokenWalletStorage
): TokenWalletStorage {
    forceBasechain(msg.destination);
    val nextBalance = storage.balance - msg.amount;

    if (!sameInternalAndAnyAddressBits(senderAddress, storage.ownerAddress)) {
        throw FUNC_THROW_OWNER_REQUIRED;
    }
    if (nextBalance < 0) {
        throw FUNC_THROW_INSUFFICIENT_BALANCE;
    }
    if (msg.forwardPayload.remainingBitsCount() < 1) {
        throw FUNC_THROW_MALFORMED_FORWARD_PAYLOAD;
    }

    val stateInit = calculateTokenWalletStateInit(
        msg.destination,
        storage.tokenMasterAddress,
        storage.tokenWalletCode
    );
    val toWalletAddress = calculateTokenWalletAddress(stateInit);
    val outbound = buildInternalTransferMessage(
        toWalletAddress,
        stateInit,
        msg.queryId,
        msg.amount,
        storage.ownerAddress,
        msg.responseDestination,
        msg.forwardTosAmount,
        msg.forwardPayload
    );
    walletFeeProfile().requireTransferValue(msgValue, msg.forwardTosAmount, fwdFee);

    // Bounce on action failure: the request is priced by the forward fee its
    // sender paid, so if message prices rose before this wallet runs, the
    // internal transfer can cost more than the request carries. It then bounces
    // the request with its value instead of keeping that value here.
    sendRawMessage(outbound, SEND_MODE_CARRY_ALL_REMAINING_MESSAGE_VALUE + SEND_MODE_BOUNCE_ON_ACTION_FAIL);
    return TokenWalletStorage {
        balance: nextBalance,
        ownerAddress: storage.ownerAddress,
        tokenMasterAddress: storage.tokenMasterAddress,
        tokenWalletCode: storage.tokenWalletCode,
    };
}

fun receiveTokens(
    msg: InternalTransferRequest,
    senderAddress: address,
    originalBalance: coins,
    fwdFee: coins,
    msgValue: coins,
    storage: TokenWalletStorage
): TokenWalletStorage {
    val nextBalance = storage.balance + msg.amount;
    val expectedWallet = calculateUserTokenWalletAddress(
        msg.fromAddress,
        storage.tokenMasterAddress,
        storage.tokenWalletCode
    );
    if (
        !sameInternalAndAnyAddressBits(senderAddress, storage.tokenMasterAddress)
        && senderAddress != expectedWallet
    ) {
        throw FUNC_THROW_INVALID_SENDER_OR_BURN_VALUE;
    }

    if (msg.forwardTosAmount != 0) {
        // Bounce on action failure: if the notification cannot be paid, the whole
        // internal transfer bounces back to the sending wallet, which restores the
        // amount, instead of the credit being rolled back and the tokens lost.
        sendRawMessage(
            buildTransferNotificationMessage(
                storage.ownerAddress,
                msg.forwardTosAmount,
                msg.queryId,
                msg.amount,
                msg.fromAddress,
                msg.forwardPayload
            ),
            SEND_MODE_PAY_FEES_SEPARATELY + SEND_MODE_BOUNCE_ON_ACTION_FAIL
        );
    }

    if (!msg.responseAddress.isNone()) {
        // Keep what the wallet held before this message plus any storage debt, and
        // at least its storage reserve; refund everything else, exactly.
        val toLeave = originalBalance - msgValue + contract.getStorageDuePayment();
        reserveToscoinsOnBalance(max(toLeave, walletFeeProfile().walletMinStorageFee()), RESERVE_MODE_AT_MOST);
        sendRawMessage(
            buildWalletExcessesMessage(msg.responseAddress, 0, msg.queryId),
            SEND_MODE_CARRY_ALL_BALANCE + SEND_MODE_IGNORE_ERRORS
        );
    }

    return TokenWalletStorage {
        balance: nextBalance,
        ownerAddress: storage.ownerAddress,
        tokenMasterAddress: storage.tokenMasterAddress,
        tokenWalletCode: storage.tokenWalletCode,
    };
}

fun burnTokens(
    msg: BurnRequest,
    senderAddress: address,
    msgValue: coins,
    fwdFee: coins,
    storage: TokenWalletStorage
): TokenWalletStorage {
    val nextBalance = storage.balance - msg.amount;

    if (!sameInternalAndAnyAddressBits(senderAddress, storage.ownerAddress)) {
        throw FUNC_THROW_OWNER_REQUIRED;
    }
    if (nextBalance < 0) {
        throw FUNC_THROW_INSUFFICIENT_BALANCE;
    }
    // Priced at the current prices for a notification of the largest size this
    // wallet sends, so the send below cannot run short.
    walletFeeProfile().requireBurnValue(msgValue);

    sendRawMessage(
        buildBurnNotificationMessage(
            storage.tokenMasterAddress,
            msg.queryId,
            msg.amount,
            storage.ownerAddress,
            msg.responseAddress
        ),
        SEND_MODE_CARRY_ALL_REMAINING_MESSAGE_VALUE
    );
    return TokenWalletStorage {
        balance: nextBalance,
        ownerAddress: storage.ownerAddress,
        tokenMasterAddress: storage.tokenMasterAddress,
        tokenWalletCode: storage.tokenWalletCode,
    };
}

fun onBouncedMessage(in: InMessageBounced) {
    var body = in.bouncedBody;
    body.skipBouncedPrefix();
    val storage = loadWalletData();
    val op = body.loadUint(32);
    if (op != OP_INTERNAL_TRANSFER && op != OP_BURN_NOTIFICATION) {
        throw FUNC_THROW_INSUFFICIENT_VALUE_OR_BAD_BOUNCE;
    }
    body.skipBits(64);
    val bouncedAmount = body.loadCoins();
    saveWalletData({
        balance: storage.balance + bouncedAmount,
        ownerAddress: storage.ownerAddress,
        tokenMasterAddress: storage.tokenMasterAddress,
        tokenWalletCode: storage.tokenWalletCode,
    });
}

contract TokenWallet {
    storage: TokenWalletStorage
    @unknown_throw(0xffff);

    @disclaim_query_id
    receive(msg: TopUp) {
    }

    @disclaim_query_id
    receive(msg: TransferRequest) {
        val nextStorage = sendTokens(
            msg,
            in.senderAddress,
            in.valueCoins,
            in.originalForwardFee,
            storage
        );
        save(nextStorage);
    }

    @disclaim_query_id
    receive(msg: InternalTransferRequest) {
        val nextStorage = receiveTokens(
            msg,
            in.senderAddress,
            contract.getOriginalBalance(),
            in.originalForwardFee,
            in.valueCoins,
            storage
        );
        save(nextStorage);
    }

    @disclaim_query_id
    receive(msg: BurnRequest) {
        val nextStorage = burnTokens(
            msg,
            in.senderAddress,
            in.valueCoins,
            in.originalForwardFee,
            storage
        );
        save(nextStorage);
    }

    /// Smallest attached value that is NOT enough for a transfer under the
    /// current fee configuration; attach strictly more.
    get fun get_transfer_fee(forwardTosAmount: coins, fwdFee: coins): coins {
        return walletFeeProfile().requiredTransferValue(forwardTosAmount, fwdFee);
    }

    /// Smallest attached value that is NOT enough for a burn under the
    /// current fee configuration; attach strictly more.
    get fun get_burn_fee(): coins {
        return walletFeeProfile().requiredBurnValue();
    }

    get fun get_fee_profile(): TokenFeeProfile {
        return walletFeeProfile();
    }

    get fun get_wallet_data(): (coins, any_address, any_address, cell) {
        return (
            storage.balance,
            storage.ownerAddress,
            storage.tokenMasterAddress,
            storage.tokenWalletCode,
        );
    }
}
