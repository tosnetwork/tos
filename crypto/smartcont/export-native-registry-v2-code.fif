#!/usr/bin/fift -s
"TosUtil.fif" include
"Asm.fif" include

{ ."usage: " @' $0 type ." <output-code.boc>" cr 1 halt } : usage
$# 1 <> ' usage if

"auto/native-registry-v2-code.fif" include
dup hashu ."Simplified Native Registry code hash: " x. cr
2 boc+>B $1 tuck B>file
."Saved simplified Native Registry code BOC to " type cr
