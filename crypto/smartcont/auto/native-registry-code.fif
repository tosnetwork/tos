            s0 s2 XCHG	//  action_hash generation object_kind object_id config sequence owner tombstone version_count versions
          }>
        }>ELSE<{	//  action_hash agent_authorized object_kind object_id config sequence owner tombstone=0 p generation version_count versions
          s3 POP
          s9 POP	//  action_hash version_count object_kind object_id config sequence owner tombstone=0 versions generation
          2203 PUSHINT	//  action_hash version_count object_kind object_id config sequence owner tombstone=0 versions generation _726=2203
          THROWANY
          s8 s8 XCHG2	//  action_hash generation object_kind object_id config sequence owner tombstone version_count versions
        }>
        s0 s8 XCHG2	//  action_hash version_count object_kind object_id config sequence owner tombstone versions generation
      }>
      s0 s8 XCHG	//  action_hash generation object_kind object_id config sequence owner tombstone versions version_count
    }>
    NEWC	//  action_hash generation object_kind object_id config sequence owner tombstone versions version_count _729
    16 STU	//  action_hash generation object_kind object_id config sequence owner tombstone versions _731
    STDICT	//  action_hash generation object_kind object_id config sequence owner tombstone _732
    ENDC	//  action_hash generation object_kind object_id config sequence owner tombstone collection
    s0 s7 XCHG
    s3 s4 s3 XCHG3
    s1 s8 XCHG
    1 PUSHINT
    s0 s8 XCHG	//  config _734=1 object_kind object_id tombstone generation sequence action_hash owner collection
    build_capability_state INLINECALLDICT	//  config _734=1 object_kind object_id _735
    s4 s3 s0 XCHG3	//  object_kind object_id config _734=1 _735
    save_object INLINECALLDICT
  }>
  get_native_state PROC:<{
    //
    load_object INLINECALLDICT	//  _6 _7 _8 _9 _10
    2 2 BLKDROP2
    s2 POP	//  state found
  }>
  get_native_config PROC:<{
    //
    load_object INLINECALLDICT	//  _30 _31 _32 _33 _34
    2DROP	//  object_kind object_id config
    CTOS	//  object_kind object_id cfg
    256 LDU	//  object_kind object_id root_hash cfg
