    128 LDU	//  workchain score_root total_score rec
    128 LDU	//  workchain score_root total_score organic_settled_value rec
    32 LDU	//  workchain score_root total_score organic_settled_value _86 _85
    DROP	//  workchain score_root total_score organic_settled_value registered_at
    1 PUSHINT	//  workchain score_root total_score organic_settled_value registered_at _59=1
    5 -ROLL	//  _59=1 workchain score_root total_score organic_settled_value registered_at
  }>
  get_distributor_address PROC:<{
    //  epoch winner_id pool
    load_state INLINECALLDICT	//  epoch winner_id pool _23 _24 _25 _26 _27 _28 _29 _30 _31 _32 _33 _34 _35
    s8 POP
    s8 POP
    2DROP
    s6 POP
    s6 POP
    s6 POP	//  epoch winner_id pool immediate_bps stream_epochs mat_epoch_seconds distributor_code registrations earner_workchain
    DUP
    s8 s9 XCHG
    s7 s9 XCHG
    s6 s9 XCHG
    s0 s5 XCHG
    s4 s9 XCHG
    s9 s3 s3 XCHG3
    s0 s9 XCHG	//  earner_workchain epoch winner_id pool earner_workchain immediate_bps stream_epochs mat_epoch_seconds distributor_code registrations
    resolve_distributor INLINECALLDICT	//  earner_workchain found state_init dist_hash
    NIP	//  earner_workchain found dist_hash
    s1 s2 XCHG	//  found earner_workchain dist_hash
  }>
}END>c
