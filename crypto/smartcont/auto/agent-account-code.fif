    load_agent_state INLINECALLDICT	//  _11 _12 _13 _14 _15 _16 _17 _18 _19 _20
    9 BLKDROP	//  owner
  }>
  get_controller_pubkey PROC:<{
    // 
    load_agent_state INLINECALLDICT	//  _11 _12 _13 _14 _15 _16 _17 _18 _19 _20
    s8 s9 XCHG
    9 BLKDROP	//  controller_pubkey
  }>
  get_agent_policy PROC:<{
    // 
    load_agent_state INLINECALLDICT	//  _11 _12 _13 _14 _15 _16 _17 _18 _19 _20
    3 BLKDROP
    2 5 BLKDROP2	//  max_per_tx daily_limit default_task_timeout metadata_hash service_endpoint_hash
  }>
}END>c
