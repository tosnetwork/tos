;; Copyright (C) 2025-2026  TOS Network.
;; AIPoW settlement account (Phase C, W4).
;;
;; The single governance-registered masterchain account named by
;; ConfigParam 93 (AipowRegistry.settlement_addr). It is the sole destination
;; of native AIPoW issuance: at masterchain settlement the protocol mints an
;; epoch "pool" to this account (a message from the masterchain minter
;; -1:00..00 carrying the winning commitment's account id), and this account
;; records it, advances the epoch cursor, and forwards the pool to the canonical
;; per-epoch distributor it deploys on the earner workchain. It owns the
;; cumulative supply cap and the epoch cursor so the once-per-epoch and 4.5B-cap
;; invariants live in one place.
;;
;; DARK until activation: nothing mints to this account until capAipow is set in
;; ConfigParam 8 and this address is registered. Built and tested in isolation.
;;
;; Registration model (candidate set — fixes the first-wins griefing, plan
;; D6/§8). A commitment nominates itself for an epoch by sending `register` with
;; sender == the committed commitment address, carrying its committed tuple AND its
;; own deploy data cell. The settlement cannot read another account's code/state,
;; but it AUTHENTICATES the nominator (H1): it holds the audited commitment code
;; (governance-set) and requires the sender's address to equal
;; hash(StateInit(commitment_code, presented_data)) -- i.e. the sender must be an
;; account genuinely deployed with the audited commitment code. Only real
;; commitments can register, so junk accounts with smaller addresses can no longer
;; evict a genuine nomination from the bounded set. It keeps a BOUNDED SET per epoch
;; keyed by the nominating account id, retaining the MAX_CANDIDATES smallest
;; addresses. The native settlement path (collator + validate-query) still resolves
;; each candidate against its real previous-state (code hash, canonical address,
;; status == final, tuple) and selects the min-address VALID finalized commitment,
;; naming that winner in the mint message. So a bogus nomination can neither ENTER
;; the set (authentication), EXCLUDE the genuine one, nor FREEZE the epoch (skip
;; advances past the grace deadline regardless of candidates).
;;
;; Persistent data layout:
;;   version:uint16                (D9 layout tag)
;;   next_epoch:uint32             (cursor: the next epoch to settle)
;;   epoch_seconds:uint32          (epoch length, for the skip deadline)
;;   register_grace:uint32         (seconds after an epoch ends before it may be
;;                                  skipped with zero mint)
;;   challenge_window:uint32       (seconds a candidate's challenge window must be
;;                                  open + elapsed before the native path mints it;
;;                                  stored here, read by the native derivation, not
;;                                  used by this contract. MUST be < register_grace
;;                                  so a valid candidate mints before its epoch is
;;                                  skippable — a governance/deploy-time invariant.)
;;   earner_workchain:int8         (workchain the distributor is deployed on and
;;                                  pays identities on)
;;   immediate_bps:uint16          (distributor maturation snapshot, frozen here)
;;   stream_epochs:uint16
;;   mat_epoch_seconds:uint32
;;   minted_total:Coins            (cumulative AIPoW minted; hard-cap tracking)
;;   total_cap:Coins               (the AIPoW supply cap, e.g. 4.5B TOS)
;;   ^distributor_code             (governance-set at deploy; the audited
;;                                  distributor code used to derive canonical
;;                                  distributor addresses in the settle path)
;;   ^commitment_code              (governance-set at deploy; the audited commitment
;;                                  code, used to authenticate a nominator's address
;;                                  at register: sender must be a canonical
;;                                  commitment == hash(StateInit(commitment_code, data)))
;;   ^registrations  (udict: epoch uint32 -> ^[ count:uint16
;;                    candidates:(udict 256 -> [ workchain:int8 score_root:uint256
;;                      total_score:uint128 organic_settled_value:uint128
;;                      registered_at:uint32 ]) ])
;;
;; Internal messages:
;;   register#41505301 query_id:uint64 epoch:uint32 score_root:uint256
;;                     total_score:uint128 organic_settled_value:uint128
;;                     ^nominator_data = InternalMsgBody;
;;       (nominator_data is the sender's deploy data cell, used to authenticate that
;;        sender == hash(StateInit(commitment_code, nominator_data)). The message must
;;        also carry >= MIN_REGISTRATION_BOND nanoTOS (the H1 economic-close bond).)
;;   skip#41505302 query_id:uint64 = InternalMsgBody;
;;   (settle) winner_id:uint256, from the minter -1:00..00.

const int op::register = 0x41505301;
const int op::skip = 0x41505302;

const int err::epoch_settled = 2301;        ;; nominated epoch is behind the cursor
const int err::already_registered = 2302;   ;; this commitment already nominated this epoch
const int err::zero_total_score = 2303;     ;; total_score must be > 0
const int err::skip_too_early = 2304;       ;; skip before the grace deadline
;; 2305 (skip_registered) retired: skip now advances past grace regardless of
;; candidates, so a bogus nomination cannot freeze the cursor.
const int err::settle_no_registration = 2306; ;; mint named a winner that is not a candidate
const int err::unknown_op = 2307;
const int err::cap_exceeded = 2308;         ;; minting this pool would breach the supply cap
const int err::candidate_set_full = 2309;   ;; the epoch's candidate set is full and this
                                            ;; address is not smaller than the current max
const int err::epoch_too_far = 2310;        ;; register targets an epoch beyond the horizon
const int err::cursor_exhausted = 2311;     ;; the uint32 epoch cursor cannot advance further
const int err::unauthorized_registration = 2312; ;; sender is not a canonical commitment
const int err::insufficient_bond = 2313;    ;; register carries less than the minimum bond
const int err::too_late_to_register = 2314; ;; the challenge window cannot elapse before skip
const int err::zero_score_root = 2315;      ;; a zero score root is reserved / unclaimable
const int err::wrong_workchain = 2316;      ;; nominator is not on the masterchain

;; The settlement version this code understands.
const int settlement_version = 1;
;; The distributor layout version this code deploys (must match the audited
;; distributor SDK's AIPOW_DISTRIBUTOR_VERSION).
const int distributor_version = 1;
;; Bounded candidate set per epoch: keeps the native selection O(1) and bounds
;; the cost of registration spam. The set retains the smallest-address candidates.
const int MAX_CANDIDATES = 8;
;; The furthest future epoch (relative to the cursor) a registration may target.
;; With settled/skipped buckets pruned as the cursor advances, this bounds the
;; live registrations state to at most REGISTER_HORIZON epoch buckets ahead of the
;; cursor, so registration spam for far-future epochs cannot grow it without bound.
;; Generous vs the cursor's real-time tracking (skip is permissionless) so a
;; legitimately lagging cursor never rejects a current-epoch nomination.
const int REGISTER_HORIZON = 1024;
;; The epoch cursor is a uint32 field; it cannot advance past this value.
const int MAX_EPOCH = 0xffffffff;
;; Minimum value a `register` must carry (H1 economic close). This floor is NOT a gas
;; check -- TOS already charges an underfunded message's compute from its own value (it
;; runs out of gas on its own). It exists because a `register` GROWS STATE: it inserts a
;; candidate entry into this epoch's bucket in the registrations dict, which this account
;; then carries (and pays storage rent on) until the epoch settles or is skipped. The
;; bond makes the nominator pay for the state its nomination creates instead of leaving
;; the settlement to subsidise it, and -- since the set is bounded and keyed by address
;; -- makes grinding out MAX_CANDIDATES small canonical addresses to evict a genuine
;; commitment cost at least MAX_CANDIDATES x this per epoch. Non-refundable: it accumulates
;; in this account, funding its own gas + the per-settle forward reserve + that storage.
;; A code constant: the audited settlement is governance-deployed, so this is a governed
;; protocol value (raise it, with the commitment's registration value and deploy funding,
;; for a stronger deterrent).
const int MIN_REGISTRATION_BOND = 500000000;  ;; 0.5 TOS

;; Storage rent this account keeps back so it can NEVER freeze. This is the consensus-facing
;; invariant made defensive at the contract layer: the native mint reads this account's live
;; ledger every masterchain block, and a frozen (inactive/unreadable) settlement forces the
;; mint to fail closed. The per-settle pool forward pays fees from balance, so the reserve is
;; taken first (mode 2, "at most", never fails) so forwarding a pool can never drain the
;; account into freezing. The reserve is PRICED from the live storage config via the TVM
;; storage-fee primitive (not a magic constant), so it tracks config changes. Masterchain
;; storage is ~1000x basechain, so a multi-year runway is impractical: STORAGE_RESERVE_SECONDS
;; is a bounded, governance-tunable runway, STORAGE_RESERVE_FLOOR backstops it, and the
;; reserve is max(priced, floor). Bits/cells are large: this account's data embeds the audited
;; distributor + commitment codes; the registrations dict growth is funded by register bonds.
const int STORAGE_RESERVE_SECONDS = 604800;      ;; 7-day runway (governance-tunable)
const int STORAGE_RESERVE_BITS = 48000;
const int STORAGE_RESERVE_CELLS = 96;
const int STORAGE_RESERVE_FLOOR = 100000000;     ;; 0.1 TOS backstop

;; The TOS to keep back so this masterchain account can pay its own storage rent for
;; STORAGE_RESERVE_SECONDS and never freeze. Priced from the live config; floored.
int storage_reserve() inline {
  int fee = get_storage_fee(-1, STORAGE_RESERVE_SECONDS, STORAGE_RESERVE_BITS, STORAGE_RESERVE_CELLS);
  return (fee > STORAGE_RESERVE_FLOOR) ? fee : STORAGE_RESERVE_FLOOR;
}

(int, int, int, int, int, int, int, int, int, int, int, cell, cell, cell) load_state() inline {
  slice ds = get_data().begin_parse();
  int version = ds~load_uint(16);
  int next_epoch = ds~load_uint(32);
  int epoch_seconds = ds~load_uint(32);
  int register_grace = ds~load_uint(32);
  int challenge_window = ds~load_uint(32);
  int earner_workchain = ds~load_int(8);
  int immediate_bps = ds~load_uint(16);
  int stream_epochs = ds~load_uint(16);
  int mat_epoch_seconds = ds~load_uint(32);
  int minted_total = ds~load_tomis();
  int total_cap = ds~load_tomis();
  cell distributor_code = ds~load_ref();
  cell commitment_code = ds~load_ref();
  cell registrations = ds~load_dict();
  ds.end_parse();
  return (version, next_epoch, epoch_seconds, register_grace, challenge_window, earner_workchain,
    immediate_bps, stream_epochs, mat_epoch_seconds, minted_total, total_cap, distributor_code,
    commitment_code, registrations);
}

() save_state(int version, int next_epoch, int epoch_seconds, int register_grace, int challenge_window,
             int earner_workchain, int immediate_bps, int stream_epochs, int mat_epoch_seconds,
             int minted_total, int total_cap, cell distributor_code, cell commitment_code,
             cell registrations) impure inline {
  set_data(begin_cell()
    .store_uint(version, 16)
    .store_uint(next_epoch, 32)
    .store_uint(epoch_seconds, 32)
    .store_uint(register_grace, 32)
    .store_uint(challenge_window, 32)
    .store_int(earner_workchain, 8)
    .store_uint(immediate_bps, 16)
    .store_uint(stream_epochs, 16)
    .store_uint(mat_epoch_seconds, 32)
    .store_tomis(minted_total)
    .store_tomis(total_cap)
    .store_ref(distributor_code)
    .store_ref(commitment_code)
    .store_dict(registrations)
  .end_cell());
}

;; A candidate record: the nominating commitment's workchain plus its committed
;; economic tuple and the registration time. The nominating account id is the
;; dict key, so it is not repeated here.
builder pack_candidate(int workchain, int score_root, int total_score,
                       int organic_settled_value, int registered_at) inline {
  return begin_cell()
    .store_int(workchain, 8)
    .store_uint(score_root, 256)
    .store_uint(total_score, 128)
    .store_uint(organic_settled_value, 128)
    .store_uint(registered_at, 32);
}

;; The (workchain, 256-bit account id) of a standard MsgAddress
;; (addr_std$10 anycast:nothing workchain:int8 address:bits256).
(int, int) addr_parts(slice addr) inline {
  addr~load_uint(3);   ;; addr_std$10 + anycast:nothing (100)
  int wc = addr~load_int(8);
  int id = addr~load_uint(256);
  return (wc, id);
}

;; The per-epoch candidate set: (count, candidates dict). Absent -> (0, null).
(int, cell) load_candidates(cell registrations, int epoch) inline {
  (cell rec_cell, int found) = registrations.udict_get_ref?(32, epoch);
  if (found == 0) {
    return (0, null());
  }
  slice cs = rec_cell.begin_parse();
  int count = cs~load_uint(16);
  cell candidates = cs~load_dict();
  return (count, candidates);
}

cell store_candidates(int count, cell candidates) inline {
  return begin_cell().store_uint(count, 16).store_dict(candidates).end_cell();
}

;; The canonical per-epoch distributor initial data. This MUST match the audited
;; distributor SDK's build_data byte for byte, or the derived address will not
;; equal a real deployment.
cell build_distributor_data(slice op_addr, int epoch, int earner_workchain, int total_score,
    int pool, int immediate_bps, int stream_epochs, int mat_epoch_seconds,
    int score_root, int commitment_ref) inline {
  return begin_cell()
    .store_uint(distributor_version, 16)
    .store_slice(op_addr)
    .store_uint(epoch, 64)
    .store_int(earner_workchain, 8)
    .store_uint(total_score, 128)
    .store_tomis(pool)
    .store_uint(0, 32)              ;; claimed_count
    .store_uint(0, 128)             ;; claimed_score
    .store_uint(immediate_bps, 16)
    .store_uint(stream_epochs, 16)
    .store_uint(mat_epoch_seconds, 32)
    .store_uint(0, 64)              ;; activated_at: 0 until the settlement funds it
    .store_ref(begin_cell()
      .store_uint(score_root, 256)
      .store_uint(commitment_ref, 256)
    .end_cell())
    .store_uint(0, 1)              ;; empty claims dictionary
  .end_cell();
}

;; StateInit{code,data} serialization matching block::StateInit::write_to:
;; fixed_prefix(0) special(0) code:(just ^) data:(just ^) library:(empty)
;; => data bits 0,0,1,1,0 with refs [code, data].
cell build_state_init(cell code, cell data) inline {
  return begin_cell()
    .store_uint(0, 1)              ;; fixed_prefix_length: nothing
    .store_uint(0, 1)              ;; special: nothing
    .store_uint(1, 1).store_ref(code)
    .store_uint(1, 1).store_ref(data)
    .store_uint(0, 1)              ;; library: empty HashmapE
  .end_cell();
}

;; Resolve the canonical distributor for the `winner_id` candidate of `epoch`,
;; funded with `pool`. Returns (found, state_init, address_hash). The distributor
;; operator is this settlement account, the maturation + earner workchain are the
;; settlement's snapshot, and the epoch tuple comes from the named candidate; the
;; commitment reference is the winner's account id.
(int, cell, int) resolve_distributor(int epoch, int winner_id, int pool, int earner_workchain,
    int immediate_bps, int stream_epochs, int mat_epoch_seconds, cell distributor_code,
    cell registrations) inline {
  (int count, cell candidates) = load_candidates(registrations, epoch);
  if (count == 0) {
    return (0, null(), 0);
  }
  (slice rec, int found) = candidates.udict_get?(256, winner_id);
  if (found == 0) {
    return (0, null(), 0);
  }
  rec~load_int(8);   ;; workchain (not part of the distributor derivation)
  int score_root = rec~load_uint(256);
  int total_score = rec~load_uint(128);
  cell data = build_distributor_data(my_address(), epoch, earner_workchain, total_score, pool,
    immediate_bps, stream_epochs, mat_epoch_seconds, score_root, winner_id);
  cell state_init = build_state_init(distributor_code, data);
  return (1, state_init, cell_hash(state_init));
}

;; Forward the epoch `pool` to the derived distributor on the earner workchain,
;; deploying it with `state_init`. Sends EXACTLY `pool` (the amount the distributor
;; records for its reward math) with the forward fees paid from this account's
;; balance (mode 1). Carrying the remaining inbound value instead (mode 64) would
;; deliver `pool` minus fees while the distributor still records `pool`, so the tail
;; claims could not be paid; sending the exact pool keeps the distributor's balance
;; equal to what it distributes. Non-bounceable (a deploy of deterministic code+data
;; cannot fail, and a reward must not bounce). The account must therefore hold a
;; reserve covering gas + forward fees per settle (a governance funding requirement);
;; an underfunded forward fails the action phase, reverting the settle so
;; minted_total does not advance -- the native atomicity guard then fails closed
;; rather than over-issuing.
() forward_to_distributor(int pool, int earner_workchain, int dist_hash, cell state_init) impure inline {
  slice dest = begin_cell()
    .store_uint(4, 3)              ;; addr_std$10, anycast:nothing
    .store_int(earner_workchain, 8)
    .store_uint(dist_hash, 256)
  .end_cell().begin_parse();
  cell msg = begin_cell()
    .store_uint(0x10, 6)           ;; non-bounceable internal message
    .store_slice(dest)
    .store_tomis(pool)             ;; nanoTOS: exactly the recorded pool
    .store_uint(0, 1 + 4 + 4 + 64 + 32) ;; other + ihr_fee + fwd_fee + created_lt + created_at
    .store_uint(1, 1)              ;; init present
    .store_uint(1, 1)              ;; init as ^StateInit (Either right)
    .store_ref(state_init)
    .store_uint(0, 1)              ;; body inline (empty)
  .end_cell();
  send_raw_message(msg, 1);        ;; mode 1: pay the forward fees from the balance
}

() recv_internal(int msg_value, cell in_msg_full, slice in_msg) impure {
  var full_msg = in_msg_full.begin_parse();
  int flags = full_msg~load_uint(4);
  if (flags & 1) { return (); }  ;; ignore bounced messages
  slice sender = full_msg~load_msg_addr();

  (int version, int next_epoch, int epoch_seconds, int register_grace, int challenge_window,
   int earner_workchain, int immediate_bps, int stream_epochs, int mat_epoch_seconds, int minted_total,
   int total_cap, cell distributor_code, cell commitment_code, cell registrations) = load_state();

  ;; The epoch mint arrives from the masterchain minter (-1:00..00) carrying the
  ;; native-selected winner's account id. Authenticate the sender first; any
  ;; other message (deploy, register, stray) is handled below.
  slice minter = begin_cell()
    .store_uint(4, 3).store_int(-1, 8).store_uint(0, 256)
  .end_cell().begin_parse();
  if (equal_slice_bits(sender, minter)) {
    ;; SETTLE the cursor epoch. The collator has already verified the winner is a
    ;; genuine finalized commitment (min-address valid); this account only checks
    ;; the winner is one of its recorded candidates for the cursor epoch.
    int winner_id = in_msg~load_uint(256);
    in_msg.end_parse();
    (int found, cell state_init, int dist_hash) = resolve_distributor(next_epoch, winner_id, msg_value,
      earner_workchain, immediate_bps, stream_epochs, mat_epoch_seconds, distributor_code, registrations);
    ;; If the named winner is not a candidate the (bounceable) mint returns and
    ;; the cursor is not advanced.
    throw_unless(err::settle_no_registration, found);
    throw_if(err::cursor_exhausted, next_epoch >= MAX_EPOCH);
    int new_minted = minted_total + msg_value;
    throw_if(err::cap_exceeded, new_minted > total_cap);
    ;; Prune the settled epoch's candidate bucket: the cursor never returns to it,
    ;; so retaining it only grows the state.
    registrations~udict_delete?(32, next_epoch);
    save_state(version, next_epoch + 1, epoch_seconds, register_grace, challenge_window, earner_workchain,
      immediate_bps, stream_epochs, mat_epoch_seconds, new_minted, total_cap, distributor_code,
      commitment_code, registrations);
    ;; Keep the storage floor before forwarding the pool, so the mandatory settle can
    ;; never run this account out of rent and freeze it. If the account cannot both keep
    ;; the floor and forward the pool, the forward's action fails and the whole settle
    ;; reverts (minted_total does not advance) -- the native atomicity guard then fails
    ;; closed, exactly as for any underfunded forward.
    raw_reserve(storage_reserve(), 2);
    forward_to_distributor(msg_value, earner_workchain, dist_hash, state_init);
    return ();
  }

  if (in_msg.slice_empty?()) {
    ;; An empty body from a non-minter (deploy, stray value) is a no-op.
    return ();
  }

  int op = in_msg~load_uint(32);
  int query_id = in_msg~load_uint(64);
  query_id~impure_touch();

  if (op == op::register) {
    ;; A commitment nominates itself as a candidate for its epoch. Multiple
    ;; commitments may nominate the same epoch (candidate set); a single
    ;; commitment may nominate an epoch at most once.
    int epoch = in_msg~load_uint(32);
    int score_root = in_msg~load_uint(256);
    int total_score = in_msg~load_uint(128);
    int organic_settled_value = in_msg~load_uint(128);
    ;; The nominator's own persistent data cell (its deploy data at announce time),
    ;; carried so this account can bind the nomination to a canonical commitment.
    cell nominator_data = in_msg~load_ref();
    in_msg.end_parse();
    ;; H1 economic close: a nomination must lock the minimum bond, so filling the
    ;; bounded candidate set with ground-out small addresses is costly per epoch.
    throw_unless(err::insufficient_bond, msg_value >= MIN_REGISTRATION_BOND);
    throw_unless(err::epoch_settled, epoch >= next_epoch);
    ;; Bound the future horizon so registration spam for far-future epochs cannot
    ;; grow the registrations state without bound (settled/skipped buckets prune as
    ;; the cursor advances, so live buckets stay <= REGISTER_HORIZON).
    throw_unless(err::epoch_too_far, epoch < next_epoch + REGISTER_HORIZON);
    ;; H2: the candidate's challenge window must be able to elapse before this epoch
    ;; becomes skippable, else a permissionless skip past grace could advance the
    ;; cursor while the candidate is still inside its (provenance) window and strand a
    ;; genuine but late nomination. Reject a registration too late to finish its
    ;; window in time; the window then always closes before the epoch is skippable, so
    ;; skip never preempts an in-window candidate (skip logic stays unchanged).
    throw_unless(err::too_late_to_register,
      now() + challenge_window <= (epoch + 1) * epoch_seconds + register_grace);
    throw_unless(err::zero_total_score, total_score > 0);
    ;; A zero score_root is reserved as "no commitment" and the SDK forbids it; a
    ;; distributor deployed over a zero root has no valid membership proof, so its pool
    ;; would strand while the cap is consumed. Keep it out of the candidate set.
    throw_unless(err::zero_score_root, score_root != 0);
    (int wc, int id) = addr_parts(sender);
    ;; The native derivation resolves commitments on the masterchain only, so a
    ;; non-masterchain nominator can never win -- but keyed by its account id it could
    ;; still evict a genuine masterchain candidate from the bounded set. Reject it here
    ;; to match the native resolvers (candidates are masterchain-only).
    throw_unless(err::wrong_workchain, wc == -1);
    ;; H1 (Sybil admission): the candidate set is keyed by -- and evicted by -- the
    ;; sender's address, so without authentication junk accounts with smaller
    ;; addresses can evict a genuine commitment from the bounded set and starve its
    ;; reward. Require the sender to be a CANONICAL commitment: its address must equal
    ;; the hash of the StateInit of the audited commitment code (governance-set here)
    ;; plus the data it presents. Only an account actually deployed with the audited
    ;; commitment code can satisfy this, so junk wallets can never occupy a slot.
    throw_unless(err::unauthorized_registration,
      cell_hash(build_state_init(commitment_code, nominator_data)) == id);
    (int count, cell candidates) = load_candidates(registrations, epoch);
    ;; A given commitment may nominate an epoch at most once.
    (slice existing, int self_found) = candidates.udict_get?(256, id);
    existing~impure_touch();
    throw_if(err::already_registered, self_found);
    builder record = pack_candidate(wc, score_root, total_score, organic_settled_value, now());
    if (count < MAX_CANDIDATES) {
      candidates~udict_set_builder(256, id, record);
      count += 1;
    } else {
      ;; Full. The cursor epoch (epoch == next_epoch) may be minted in THIS block from
      ;; pre-block state: the collator derives the winner from the pre-block candidate
      ;; set and the mandatory settle names it. Evicting that pre-state winner mid-block
      ;; (before the settle runs) would leave settle unable to resolve the named winner
      ;; (settle_no_registration), so the mint is emitted but never recorded and the
      ;; block is rejected (produce/check divergence). Freeze the cursor epoch's bucket
      ;; against eviction -- a nomination arriving this late cannot finalize in time to
      ;; win the current mint anyway. Future-epoch buckets still evict normally; any
      ;; eviction there lands in pre-block state and both sides derive it identically.
      throw_if(err::candidate_set_full, epoch == next_epoch);
      ;; Full: retain the smallest-address candidates. Admit this nomination only
      ;; if its address is smaller than the current maximum, evicting the maximum.
      (int max_id, slice max_val, int has_max) = candidates.udict_get_max?(256);
      max_val~impure_touch();
      throw_unless(err::candidate_set_full, has_max & (id < max_id));
      candidates~udict_delete?(256, max_id);
      candidates~udict_set_builder(256, id, record);
    }
    registrations~udict_set_ref(32, epoch, store_candidates(count, candidates));
    save_state(version, next_epoch, epoch_seconds, register_grace, challenge_window, earner_workchain,
      immediate_bps, stream_epochs, mat_epoch_seconds, minted_total, total_cap, distributor_code,
      commitment_code, registrations);
    return ();
  }

  if (op == op::skip) {
    ;; Permissionless: once an epoch's grace deadline has passed, advance the
    ;; cursor with zero mint -- REGARDLESS of candidates (D5). The collator mints
    ;; a valid candidate promptly (well before the grace deadline), so a skip only
    ;; ever advances an epoch with no valid candidate; a purely bogus candidate
    ;; set therefore cannot freeze the cursor. Only the epoch at the cursor may be
    ;; skipped, keeping the cursor strictly ordered.
    in_msg.end_parse();
    throw_if(err::cursor_exhausted, next_epoch >= MAX_EPOCH);
    int skippable_at = (next_epoch + 1) * epoch_seconds + register_grace;
    throw_unless(err::skip_too_early, now() >= skippable_at);
    ;; Prune the skipped epoch's candidate bucket (bogus nominations for an epoch
    ;; the cursor is leaving behind); the cursor never returns to it.
    registrations~udict_delete?(32, next_epoch);
    save_state(version, next_epoch + 1, epoch_seconds, register_grace, challenge_window, earner_workchain,
      immediate_bps, stream_epochs, mat_epoch_seconds, minted_total, total_cap, distributor_code,
      commitment_code, registrations);
    return ();
  }

  throw(err::unknown_op);
}

;; (version, next_epoch, epoch_seconds, register_grace, challenge_window, earner_workchain,
;;  immediate_bps, stream_epochs, mat_epoch_seconds, minted_total, total_cap)
(int, int, int, int, int, int, int, int, int, int, int) get_aipow_settlement_data() method_id {
  (int version, int next_epoch, int epoch_seconds, int register_grace, int challenge_window,
   int earner_workchain, int immediate_bps, int stream_epochs, int mat_epoch_seconds, int minted_total,
   int total_cap, cell distributor_code, cell commitment_code, cell registrations) = load_state();
  distributor_code~impure_touch();
  commitment_code~impure_touch();
  registrations~impure_touch();
  return (version, next_epoch, epoch_seconds, register_grace, challenge_window, earner_workchain,
    immediate_bps, stream_epochs, mat_epoch_seconds, minted_total, total_cap);
}

;; The number of candidates recorded for `epoch`.
int get_candidate_count(int epoch) method_id {
  (_, _, _, _, _, _, _, _, _, _, _, _, _, cell registrations) = load_state();
  (int count, cell candidates) = load_candidates(registrations, epoch);
  candidates~impure_touch();
  return count;
}

;; (found, min_id): the smallest candidate account id for `epoch`, or (0, 0) if
;; none. The native path iterates candidates in address order from here.
(int, int) get_min_candidate(int epoch) method_id {
  (_, _, _, _, _, _, _, _, _, _, _, _, _, cell registrations) = load_state();
  (int count, cell candidates) = load_candidates(registrations, epoch);
  if (count == 0) {
    return (0, 0);
  }
  (int min_id, slice val, int found) = candidates.udict_get_min?(256);
  val~impure_touch();
  return (found, min_id);
}

;; (found, next_id): the smallest candidate account id for `epoch` strictly
;; greater than `after_id`, or (0, 0) if none. Lets the native path enumerate the
;; bounded candidate set in ascending address order.
(int, int) get_next_candidate(int epoch, int after_id) method_id {
  (_, _, _, _, _, _, _, _, _, _, _, _, _, cell registrations) = load_state();
  (int count, cell candidates) = load_candidates(registrations, epoch);
  if (count == 0) {
    return (0, 0);
  }
  (int next_id, slice val, int found) = candidates.udict_get_next?(256, after_id);
  val~impure_touch();
  return (found, next_id);
}

;; (found, workchain, score_root, total_score, organic_settled_value,
;;  registered_at) for the `id` candidate of `epoch`.
(int, int, int, int, int, int) get_candidate(int epoch, int id) method_id {
  (_, _, _, _, _, _, _, _, _, _, _, _, _, cell registrations) = load_state();
  (int count, cell candidates) = load_candidates(registrations, epoch);
  if (count == 0) {
    return (0, 0, 0, 0, 0, 0);
  }
  (slice rec, int found) = candidates.udict_get?(256, id);
  if (found == 0) {
    return (0, 0, 0, 0, 0, 0);
  }
  int workchain = rec~load_int(8);
  int score_root = rec~load_uint(256);
  int total_score = rec~load_uint(128);
  int organic_settled_value = rec~load_uint(128);
  int registered_at = rec~load_uint(32);
  return (1, workchain, score_root, total_score, organic_settled_value, registered_at);
}

;; (found, workchain, address_hash) of the canonical distributor this account
;; would deploy for the `winner_id` candidate of `epoch` funded with `pool`. This
;; is the exact derivation the settle path uses; a real deployment of the audited
;; distributor SDK with the same inputs has this address.
(int, int, int) get_distributor_address(int epoch, int winner_id, int pool) method_id {
  (_, _, _, _, _, int earner_workchain, int immediate_bps, int stream_epochs, int mat_epoch_seconds,
   _, _, cell distributor_code, _, cell registrations) = load_state();
  (int found, cell state_init, int dist_hash) = resolve_distributor(epoch, winner_id, pool,
    earner_workchain, immediate_bps, stream_epochs, mat_epoch_seconds, distributor_code, registrations);
  state_init~impure_touch();
  return (found, earner_workchain, dist_hash);
}
