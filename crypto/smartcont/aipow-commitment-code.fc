;; Copyright (C) 2025-2026  TOS Network.
;; AIPoW epoch score-commitment actor with a bonded public challenge window.
;;
;; One instance per committed epoch score root (same actor-per-address
;; pattern as Agent Account, Task Escrow, Capability Registry, Service Actor
;; and Dispute). The committer deploys the instance carrying the epoch, the
;; score root, the methodology commitment, and a bond funded from the deploy
;; value. Anyone except the committer and the reviewer may challenge the root
;; with a matching bond before the window deadline; an unchallenged commitment
;; finalizes permissionlessly after the deadline and returns the committer's
;; bond. A challenged commitment is ruled by the reviewer: upholding the
;; challenge rejects the root and awards both bonds to the challenger;
;; dismissing it finalizes the root and awards both bonds to the committer. If
;; the reviewer never rules, anyone may fail the commitment safe after the
;; review deadline: the root is rejected and each party is returned its own
;; bond, so an absent reviewer can neither finalize nor freeze an epoch.
;;
;; The challenge bond is fixed at the committer's bond so the two sides are
;; symmetric; a challenger that overpays is refunded the excess in the same
;; transaction, and the deploy value must fund the bond plus a fee/storage
;; reserve so the contract can always pay for its own outgoing bond returns.
;;
;; This contract records and adjudicates commitments only. It does not
;; create, hold, or distribute AIPoW rewards. On finalization it sends an
;; authenticated registration (sender == this commitment) to the AIPoW
;; settlement account it was deployed against, carrying its epoch and committed
;; tuple; the native settlement path independently re-verifies the commitment's
;; real previous-state (code hash, version, status == final, tuple) before
;; minting, so the registration is only a hint, not a trust grant. A rejected
;; root never registers and is never consumed.
;;
;; Persistent data layout:
;;   version:uint16        (D9 layout tag)
;;   committer:MsgAddress
;;   reviewer:MsgAddress
;;   status:uint8          (0 = committed, 1 = challenged, 2 = final,
;;                          3 = rejected)
;;   epoch:uint64
;;   window_deadline:uint64 (unix; challenges strictly before, finalize at or
;;                           after)
;;   review_deadline:uint64 (unix; 0 until challenged, then challenge time plus
;;                           the review window; permissionless timeout at or
;;                           after)
;;   commit_bond:tomis
;;   challenge_bond:tomis
;;   ^[score_root:uint256 methodology_hash:uint256
;;     total_score:uint128 organic_settled_value:uint128
;;     ^[rate_card_hash:uint256]]   (nested: the inline fields fill 768 bits)
;;       The committer binds the full economic tuple, not just the root: the
;;       pro-rata denominator (total_score) and the epoch's organic settled
;;       value are committed and bonded here, so a distributor deployed over a
;;       finalized root can be checked against the denominator the committer
;;       staked on, and the phase C native path mints from a committed pool
;;       rather than an operator-chosen one.
;;   ^[challenger:MsgAddress challenge_evidence_hash:uint256]
;;   ^[settlement:MsgAddress]
;;       The AIPoW settlement account this commitment registers to on
;;       finalization (D6). A non-internal address (addr_none/addr_extern)
;;       disables registration (the root still finalizes, it is simply not
;;       advertised). For a valid settlement the registration is atomic with
;;       finalization (both or neither, retried with more value if underfunded);
;;       see send_registration for the full semantics.
;;
;; The deploy value must fund the committer bond plus a fee/storage reserve that
;; also covers the registration fee sent on finalization.
;;
;; Internal messages:
;;   challenge#41505701 query_id:uint64 challenge_evidence_hash:uint256
;;       = InternalMsgBody;
;;   finalize#41505702 query_id:uint64 = InternalMsgBody;
;;   rule#41505703 query_id:uint64 uphold:uint8 = InternalMsgBody;
;;   timeout#41505704 query_id:uint64 = InternalMsgBody;
;;   announce#41505705 query_id:uint64 = InternalMsgBody;
;; Outgoing on announcement:
;;   register#41505301 query_id:uint64 epoch:uint32 score_root:uint256
;;       total_score:uint128 organic_settled_value:uint128 ^data  -> settlement.
;;       (^data is this commitment's deploy data; the settlement authenticates
;;        sender == hash(StateInit(commitment_code, data)).)

const int op::challenge = 0x41505701;
const int op::finalize = 0x41505702;
const int op::rule = 0x41505703;
const int op::timeout = 0x41505704;
const int op::announce = 0x41505705;

;; The settlement account's register opcode this commitment emits on announce.
const int settlement_op::register = 0x41505301;

;; The commitment layout version this code understands (D9).
const int commitment_version = 1;

;; Value attached to the announce registration. Must be >= the settlement's
;; MIN_REGISTRATION_BOND (the H1 economic-close bond) with a small margin for the
;; register gas; the settlement rejects a nomination carrying less. Kept below the
;; deploy funding margin so a finalize can still return the commit_bond.
const int registration_value = 600000000;  ;; 0.6 TOS (>= settlement MIN_REGISTRATION_BOND 0.5)
;; Storage rent this account keeps back before every value-out so it can NEVER freeze.
;; Load-bearing, not hygiene: the native mint reads this commitment's live account
;; (status/tuple) at settle time, and a frozen (inactive) account is treated as
;; non-existent -- a FINAL commitment that ran itself out of rent while returning a bond
;; would silently lose its epoch's reward. The reserve is PRICED from the live storage
;; config via the TVM storage-fee primitive (not a magic constant), so it tracks config
;; changes. This account lives on the masterchain, whose storage is ~1000x basechain, so
;; a multi-year runway (as a basechain jetton reserves) is impractical here:
;; STORAGE_RESERVE_SECONDS is a bounded, governance-tunable runway. STORAGE_RESERVE_FLOOR
;; is a hard backstop (covers a zero/low-price config); the reserve is max(priced, floor),
;; taken (mode 2, "at most", never fails) before every value-out so a payout that would
;; breach it reverts instead of stranding the account. Bits/cells cover code + fixed data
;; generously (the growing state -- none here -- would be funded by per-entry floors).
const int STORAGE_RESERVE_SECONDS = 604800;      ;; 7-day runway (governance-tunable)
const int STORAGE_RESERVE_BITS = 16000;
const int STORAGE_RESERVE_CELLS = 32;
const int STORAGE_RESERVE_FLOOR = 50000000;      ;; 0.05 TOS backstop

const int status::committed = 0;
const int status::challenged = 1;
const int status::final = 2;
const int status::rejected = 3;

;; Reviewer must rule within this window after a challenge lands. Past it the
;; commitment can be failed safe permissionlessly. v0 draft constant; phase C
;; moves it to configuration governance alongside the other AIPoW parameters.
const int review_window = 604800;  ;; 7 days in seconds

const int err::not_committed = 2100;
const int err::window_closed = 2101;
const int err::insufficient_bond = 2102;
const int err::window_open = 2103;
const int err::not_challenged = 2104;
const int err::not_reviewer = 2105;
const int err::invalid_ruling = 2106;
const int err::unknown_op = 2107;
const int err::zero_evidence = 2108;
const int err::conflicted_challenger = 2109;
const int err::review_open = 2110;
const int err::review_closed = 2111;  ;; reviewer ruled after the review deadline
const int err::bond_not_escrowed = 2112;  ;; announce without the committer bond funded here

;; mode 1: send exactly `amount`, fees paid from the contract balance.
() send_value(slice destination, int amount, int mode) impure inline {
  send_raw_message(begin_cell()
    .store_uint(0x10, 6)
    .store_slice(destination)
    .store_tomis(amount)
    .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
  .end_cell(), mode);
}

;; The TON to keep back (raw_reserve mode 2) so this masterchain account can pay its own
;; storage rent for STORAGE_RESERVE_SECONDS and never freeze. Priced from the live config;
;; floored so it stays protective under a zero/low-price config.
int storage_reserve() inline {
  int fee = get_storage_fee(-1, STORAGE_RESERVE_SECONDS, STORAGE_RESERVE_BITS, STORAGE_RESERVE_CELLS);
  return (fee > STORAGE_RESERVE_FLOOR) ? fee : STORAGE_RESERVE_FLOOR;
}

;; load_state returns the original fields first, then `version` and the
;; `settlement` address appended, so the on-chain data getter's original stack
;; indices stay stable while the two new fields are exposed at the end.
(slice, slice, int, int, int, int, int, int, int, int, int, int, int, slice, int, int, slice) load_state() inline {
  slice ds = get_data().begin_parse();
  int version = ds~load_uint(16);
  slice committer = ds~load_msg_addr();
  slice reviewer = ds~load_msg_addr();
  int status = ds~load_uint(8);
  int epoch = ds~load_uint(64);
  int window_deadline = ds~load_uint(64);
  int review_deadline = ds~load_uint(64);
  int commit_bond = ds~load_tomis();
  int challenge_bond = ds~load_tomis();
  slice root = ds~load_ref().begin_parse();
  int score_root = root~load_uint(256);
  int methodology_hash = root~load_uint(256);
  int total_score = root~load_uint(128);
  int organic_settled_value = root~load_uint(128);
  ;; rate_card_hash lives in a nested ref: the four inline fields already fill 768
  ;; bits, and one more 256-bit field would exceed the 1023-bit cell limit.
  slice rc = root~load_ref().begin_parse();
  int rate_card_hash = rc~load_uint(256);
  rc.end_parse();
  root.end_parse();
  slice chal = ds~load_ref().begin_parse();
  slice challenger = chal~load_msg_addr();
  int challenge_evidence_hash = chal~load_uint(256);
  chal.end_parse();
  slice stl = ds~load_ref().begin_parse();
  slice settlement = stl~load_msg_addr();
  stl.end_parse();
  ds.end_parse();
  return (committer, reviewer, status, epoch, window_deadline, review_deadline,
    commit_bond, challenge_bond, score_root, methodology_hash, rate_card_hash, total_score,
    organic_settled_value, challenger, challenge_evidence_hash, version, settlement);
}

() save_state(slice committer, slice reviewer, int status, int epoch, int window_deadline,
             int review_deadline, int commit_bond, int challenge_bond, int score_root,
             int methodology_hash, int rate_card_hash, int total_score, int organic_settled_value,
             slice challenger, int challenge_evidence_hash, int version, slice settlement) impure inline {
  set_data(begin_cell()
    .store_uint(version, 16)
    .store_slice(committer)
    .store_slice(reviewer)
    .store_uint(status, 8)
    .store_uint(epoch, 64)
    .store_uint(window_deadline, 64)
    .store_uint(review_deadline, 64)
    .store_tomis(commit_bond)
    .store_tomis(challenge_bond)
    .store_ref(begin_cell()
      .store_uint(score_root, 256)
      .store_uint(methodology_hash, 256)
      .store_uint(total_score, 128)
      .store_uint(organic_settled_value, 128)
      .store_ref(begin_cell().store_uint(rate_card_hash, 256).end_cell())  ;; nested (cell-size)
    .end_cell())
    .store_ref(begin_cell()
      .store_slice(challenger)
      .store_uint(challenge_evidence_hash, 256)
    .end_cell())
    .store_ref(begin_cell()
      .store_slice(settlement)
    .end_cell())
  .end_cell());
}

;; Emit the authenticated registration to the settlement (sender == this
;; commitment). The register body is carried by reference (it exceeds a
;; comfortable inline budget). Bounceable so a rejected registration (e.g. an
;; epoch behind the settlement cursor) returns the fee.
;;
;; This is sent at ANNOUNCE (commit time), not finalization: the settlement
;; records the nomination's registered_at with its own clock at announce, and the
;; native derivation runs the challenge-window provenance floor from that trusted
;; time (window_deadline >= registered_at + challenge_window, and the window must
;; elapse before the mint). Registering at finalize would make registered_at the
;; late, post-window time, defeating the anchor -- so the commitment nominates
;; itself early, while still `committed`, and the native reads its live `final`
;; status independently at mint time.
;;
;; Registration semantics, deliberately chosen:
;;   * When the settlement is NOT a routable internal address (addr_none$00 /
;;     addr_extern$01 -- addr_none is the documented opt-out) or the epoch does
;;     not fit the settlement's uint32 register field, registration is
;;     structurally impossible and can never succeed on retry, so it is SKIPPED
;;     (a no-op) -- announce proceeds as a harmless no-op. This is what keeps a
;;     commitment deployed (bypassing the SDK) with a malformed settlement or an
;;     out-of-range epoch from aborting every announce.
;;   * Otherwise (a valid settlement + in-range epoch) registration is MANDATORY
;;     and ATOMIC with announce: the send uses mode 1 (NOT +2), so if it cannot
;;     be funded the whole announce action phase aborts and NOTHING is committed.
;;     Because announce is permissionless and the pre-abort status is preserved,
;;     anyone simply retries with more attached value. Best-effort (+2) is
;;     intentionally NOT used: a silently-skipped registration would leave valid
;;     work invisible to the settlement with no signal to retry.
() send_registration(slice settlement, int epoch, int score_root, int total_score,
                     int organic_settled_value) impure inline {
  ;; MsgAddress tag: 0=addr_none, 1=addr_extern, 2=addr_std, 3=addr_var. Only
  ;; the internal forms (>= 2) are valid message destinations.
  if (settlement.preload_uint(2) < 2) {
    return ();
  }
  ;; store_uint(epoch, 32) range-checks; an out-of-range epoch would throw.
  if (epoch > 0xFFFFFFFF) {
    return ();
  }
  ;; Carry this commitment's own persistent data cell. Announce runs while still
  ;; `committed`, so get_data() is exactly the deploy data, and the settlement
  ;; authenticates the nomination by checking sender ==
  ;; hash(StateInit(commitment_code, this data)) -- proving the sender is a canonical
  ;; commitment (H1 Sybil-admission defence). A non-commitment sender cannot produce
  ;; a data cell that makes this hold with the audited code.
  cell body = begin_cell()
    .store_uint(settlement_op::register, 32)
    .store_uint(0, 64)                ;; query_id (the settlement ignores it)
    .store_uint(epoch, 32)
    .store_uint(score_root, 256)
    .store_uint(total_score, 128)
    .store_uint(organic_settled_value, 128)
    .store_ref(get_data())            ;; ^nominator_data (the deploy data)
  .end_cell();
  ;; mode 1: pay fees separately, errors NOT ignored (see the semantics note
  ;; above) -- an unfundable registration aborts the finalize atomically and is
  ;; retried with more value, rather than being silently and permanently skipped.
  send_raw_message(begin_cell()
    .store_uint(0x18, 6)              ;; bounceable internal message
    .store_slice(settlement)
    .store_tomis(registration_value)
    .store_uint(0, 1 + 4 + 4 + 64 + 32) ;; other + ihr_fee + fwd_fee + created_lt + created_at
    .store_uint(0, 1)                 ;; init: nothing
    .store_uint(1, 1)                 ;; body: right (^X)
    .store_ref(body)
  .end_cell(), 1);
}

() recv_internal(int msg_value, cell in_msg_full, slice in_msg) impure {
  var full_msg = in_msg_full.begin_parse();
  int flags = full_msg~load_uint(4);
  if (flags & 1) { return (); }  ;; ignore bounced messages
  slice sender = full_msg~load_msg_addr();
  if (in_msg.slice_empty?()) { return (); }
  int op = in_msg~load_uint(32);
  int query_id = in_msg~load_uint(64);
  query_id~impure_touch();

  (slice committer, slice reviewer, int status, int epoch, int window_deadline,
   int review_deadline, int commit_bond, int challenge_bond, int score_root,
   int methodology_hash, int rate_card_hash, int total_score, int organic_settled_value,
   slice challenger, int challenge_evidence_hash, int version, slice settlement) = load_state();

  if (op == op::challenge) {
    throw_unless(err::not_committed, status == status::committed);
    throw_unless(err::window_closed, now() < window_deadline);
    ;; Neither the committer nor the reviewer may challenge: a conflicted
    ;; challenger could route the committer's bond to itself via the ruling.
    throw_if(err::conflicted_challenger,
      equal_slice_bits(sender, committer) | equal_slice_bits(sender, reviewer));
    ;; Symmetric skin in the game: the challenge bond is fixed at the
    ;; committer's bond. Overpayment is not a larger bond; the excess is
    ;; returned so both sides risk exactly commit_bond.
    throw_unless(err::insufficient_bond, msg_value >= commit_bond);
    int new_evidence_hash = in_msg~load_uint(256);
    in_msg.end_parse();
    ;; Zero is reserved for "no challenge" and is never a valid commitment.
    throw_unless(err::zero_evidence, new_evidence_hash != 0);
    save_state(committer, reviewer, status::challenged, epoch, window_deadline,
      now() + review_window, commit_bond, commit_bond, score_root, methodology_hash, rate_card_hash,
      total_score, organic_settled_value, sender, new_evidence_hash, version, settlement);
    int excess = msg_value - commit_bond;
    if (excess > 0) {
      send_value(sender, excess, 1);
    }
    return ();
  }

  if (op == op::announce) {
    ;; Permissionless: nominate this commitment to the settlement while it is
    ;; still `committed`, so the settlement records registered_at with its own
    ;; clock EARLY -- the native challenge-window provenance floor runs from that
    ;; trusted time (a late, post-finalize registration would defeat it). The
    ;; settlement dedups per commitment, so a repeat announce simply bounces; the
    ;; committer normally announces once, right after deploy.
    throw_unless(err::not_committed, status == status::committed);
    in_msg.end_parse();
    ;; Escrow the committer's bond. The whole challenge mechanism assumes commit_bond is
    ;; actually held here through the window -- finalize, rule and timeout all pay it out --
    ;; yet nothing verified the deploy funded it. announce is the mandatory gate before a
    ;; commitment can be nominated (hence minted), so require the bond funded now and reserve
    ;; it: the registration send below cannot dip into it, and because no other message spends
    ;; the balance while committed/challenged, it stays escrowed for every resolution path.
    ;; An unbonded commitment therefore can neither register nor be minted, and a challenged
    ;; one is always solvent enough to pay both bonds out (so challenging is never a trap).
    throw_unless(err::bond_not_escrowed,
      get_balance().pair_first() >= commit_bond + registration_value);
    raw_reserve(commit_bond, 0);
    send_registration(settlement, epoch, score_root, total_score, organic_settled_value);
    return ();
  }

  if (op == op::finalize) {
    ;; Permissionless: after an unchallenged window, anyone may finalize;
    ;; the bond always returns to the committer, whoever sends this. Finalize is
    ;; local (no settlement message): the nomination was already sent at announce,
    ;; and the native derivation reads this `final` status live at mint time.
    throw_unless(err::not_committed, status == status::committed);
    throw_unless(err::window_open, now() >= window_deadline);
    in_msg.end_parse();
    save_state(committer, reviewer, status::final, epoch, window_deadline,
      review_deadline, commit_bond, challenge_bond, score_root, methodology_hash, rate_card_hash,
      total_score, organic_settled_value, challenger, challenge_evidence_hash, version, settlement);
    ;; Keep the storage floor so this now-FINAL commitment stays active for the native
    ;; mint to read it; if the bond return would breach the floor, revert (retry funded).
    raw_reserve(storage_reserve(), 2);
    send_value(committer, commit_bond, 1);
    return ();
  }

  if (op == op::rule) {
    throw_unless(err::not_reviewer, equal_slice_bits(sender, reviewer));
    throw_unless(err::not_challenged, status == status::challenged);
    ;; M5: the reviewer must rule strictly BEFORE the review deadline. After it, only
    ;; the permissionless `timeout` (which rejects, failing safe) may resolve the
    ;; challenge -- otherwise a late reviewer ruling could finalize a root that should
    ;; have timed out.
    throw_unless(err::review_closed, now() < review_deadline);
    int uphold = in_msg~load_uint(8);
    in_msg.end_parse();
    throw_unless(err::invalid_ruling, (uphold == 0) | (uphold == 1));
    if (uphold) {
      ;; The challenge stands: the root is rejected and the challenger is
      ;; made whole plus the committer's bond.
      save_state(committer, reviewer, status::rejected, epoch, window_deadline,
        review_deadline, commit_bond, challenge_bond, score_root, methodology_hash, rate_card_hash,
        total_score, organic_settled_value, challenger, challenge_evidence_hash, version, settlement);
      raw_reserve(storage_reserve(), 2);  ;; never spend the storage floor on a payout
      send_value(challenger, commit_bond + challenge_bond, 1);
    } else {
      ;; H3: the challenge is dismissed as frivolous, but the root does NOT finalize.
      ;; Finalizing here would close the provenance window early: a throwaway early
      ;; challenge + immediate dismissal would make the root `final` (hence no longer
      ;; challengeable) for the rest of a nominal window it never actually stayed open
      ;; for. Instead the root returns to `committed`, remaining challengeable until its
      ;; window_deadline; only `finalize` (past the window, unchallenged) makes it
      ;; final. The frivolous challenger's bond compensates the committer now; the
      ;; committer's own commit_bond stays locked until finalize. Reset the review
      ;; fields so the next challenge starts clean.
      save_state(committer, reviewer, status::committed, epoch, window_deadline,
        0, commit_bond, 0, score_root, methodology_hash, rate_card_hash,
        total_score, organic_settled_value, challenger, 0, version, settlement);
      ;; Back to `committed` (still challengeable/mintable) -- keep the floor so it stays live.
      raw_reserve(storage_reserve(), 2);
      send_value(committer, challenge_bond, 1);
    }
    return ();
  }

  if (op == op::timeout) {
    ;; Permissionless fail-safe: if the reviewer never rules, the root is
    ;; rejected after the review deadline and each party recovers its own
    ;; bond. An absent reviewer thus can neither finalize an unadjudicated
    ;; root nor freeze the epoch's bonds indefinitely.
    throw_unless(err::not_challenged, status == status::challenged);
    throw_unless(err::review_open, now() >= review_deadline);
    in_msg.end_parse();
    save_state(committer, reviewer, status::rejected, epoch, window_deadline,
      review_deadline, commit_bond, challenge_bond, score_root, methodology_hash, rate_card_hash,
      total_score, organic_settled_value, challenger, challenge_evidence_hash, version, settlement);
    raw_reserve(storage_reserve(), 2);  ;; one reserve guards both refunds below
    send_value(committer, commit_bond, 1);
    send_value(challenger, challenge_bond, 1);
    return ();
  }

  throw(err::unknown_op);
}

;; Exposes the full persistent state. rate_card_hash (index 10) is inserted after
;; methodology_hash, shifting the later indices by one (the SDK decoder mirrors this).
(slice, slice, int, int, int, int, int, int, int, int, int, int, int, slice, int, int, slice) get_aipow_commitment_data() method_id {
  return load_state();
}
