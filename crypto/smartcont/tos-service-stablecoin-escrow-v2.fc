;; TOS Service Protocol Paid Demand stablecoin escrow v2.
;;
;; V2 is an additive successor. Deployment is not acceptance: deterministic
;; StateInit starts pending_acceptance and only the exact buyer wallet may
;; accept the Quote before accept_by. Funding is a distinct later transition.

const int op::release = 0x4e450001;
const int op::refund = 0x4e450002;
const int op::accept = 0x4e450003;
const int op::jetton_transfer = 0x0f8a7ea5;
const int op::transfer_notification = 0x7362d09c;
const int op::excesses = 0xd53276db;

const int magic::data = 0x4e455331;
const int magic::terms = 0x4e455431;
const int magic::authorization = 0x4e454131;
const int magic::runtime = 0x4e455231;
const int magic::route = 0x4e455031;
const int magic::quote = 0x4e415131;
const int magic::paid_demand = 0x4e504431;
const int magic::receipt = 0x4e575231;
const int magic::intent = 0x4e534931;
const int magic::transport = 0x4e544231;
const int magic::dispute = 0x4e445031;

const int status::pending_acceptance = 0;
const int status::awaiting_funding = 1;
const int status::funded = 2;
const int status::release_pending = 3;
const int status::refund_pending = 4;

const int err::bad_message = 2400;
const int err::bad_state = 2401;
const int err::wrong_wallet = 2402;
const int err::wrong_buyer = 2403;
const int err::wrong_amount = 2404;
const int err::deadline = 2405;
const int err::bad_receipt = 2406;
const int err::bad_signature = 2407;
const int err::bad_confirmation = 2408;
const int err::bad_acceptance = 2409;
const int err::insufficient_gas = 2410;

;; Fixed native-TON budget attached to a settlement's jetton transfer, sized
;; (per the vendored third-party DEX reference under crypto/smartcont/reference/)
;; to cover one external jetton-wallet
;; hop (~0.07 TOS) plus the recipient wallet's storage (~0.01 TOS) with margin.
;; A settlement pays this fixed amount from the escrow's own balance (mode 1),
;; so the amount the recipient wallet receives does not depend on the settlement
;; message's net-of-fees remainder — it never launches an underfunded second leg.
const int wallet_transfer_tos = 100000000;        ;; 0.1 TOS
;; Native balance the escrow always keeps for its own rent. A release/refund is
;; refused unless the escrow balance covers the payout budget, the current
;; config-derived compute/forward fees, and this floor, so a settlement is never
;; launched underfunded and never self-drains below rent (reserve-before-send
;; pattern from the vendored reference pool contract).
const int escrow_storage_floor = 50000000;        ;; 0.05 TOS
;; Upper bound for the escrow-side release/refund compute phase, used only to
;; size the settlement balance guard. Over-estimating is the safe direction: it
;; only requires the escrow to hold more native TOS before settling, and never
;; admits an underfunded settlement. It must exceed the WORST-CASE compute at
;; maximum valid state. The two attacker-sizeable pre-branch loops dominate:
;; validate_transport walks up to a 120-byte endpoint and parse_amount_text walks
;; up to a 37-digit (< 2^120) amount; at those maxima the release path reaches
;; roughly 75k-85k gas including the fee primitives (the short-fixture path is
;; only ~31k). 200,000 leaves more than 2x margin over that worst case. Sandbox
;; coverage at maximum valid state asserts the guard-admitted balance fully funds
;; release and refund with no action-phase no-funds gap.
const int settlement_compute_gas_units = 200000;
const int base_workchain = 0;

;; Reason code carried inline on a funding returned to its sender
;; (transfer_bounce reason-code pattern from the vendored reference router contract).
const int reason::invalid_request = 0xffffffa1;
;; Reason code for a notification from a wallet other than the derived own
;; wallet: those jettons sit in a wallet this escrow owns but never addresses,
;; so they must be sent back through the notifying wallet, never kept or thrown.
const int reason::wrong_wallet = 0xffffffa2;

(int, int, int, int, cell, cell, cell, cell) load_escrow() inline {
  slice ds = get_data().begin_parse();
  throw_unless(err::bad_state, ds~load_uint(32) == magic::data);
  throw_unless(err::bad_state, ds~load_uint(16) == 2);
  int status = ds~load_uint(8);
  int quote_hash = ds~load_uint(256);
  int terms_hash = ds~load_uint(256);
  int auth_hash = ds~load_uint(256);
  cell quote = ds~load_ref();
  cell terms = ds~load_ref();
  cell authorization = ds~load_ref();
  cell runtime = ds~load_ref();
  ds.end_parse();
  throw_unless(err::bad_state, (status <= status::refund_pending) &
    (cell_hash(quote) == quote_hash) & (cell_hash(terms) == terms_hash) &
    (cell_hash(authorization) == auth_hash));
  return (status, quote_hash, terms_hash, auth_hash, quote, terms, authorization, runtime);
}

() save_escrow(int status, int quote_hash, int terms_hash, int auth_hash,
    cell quote, cell terms, cell authorization, cell runtime) impure inline {
  set_data(begin_cell().store_uint(magic::data, 32).store_uint(2, 16)
    .store_uint(status, 8).store_uint(quote_hash, 256).store_uint(terms_hash, 256)
    .store_uint(auth_hash, 256).store_ref(quote).store_ref(terms)
    .store_ref(authorization).store_ref(runtime).end_cell());
}

(slice, slice, int, int) parse_terms(cell terms, int expected_hash) inline {
  throw_unless(err::bad_state, cell_hash(terms) == expected_hash);
  slice ts = terms.begin_parse();
  throw_unless(err::bad_state, ts~load_uint(32) == magic::terms);
  throw_unless(err::bad_state, ts~load_uint(16) == 1);
  slice buyer = ts~load_msg_addr();
  slice provider = ts~load_msg_addr();
  int funding_deadline = ts~load_uint(64);
  int refund_at = ts~load_uint(64);
  ts.end_parse();
  throw_unless(err::bad_state, (funding_deadline > 0) & (refund_at > funding_deadline));
  return (buyer, provider, funding_deadline, refund_at);
}

int parse_authorization(cell authorization, int expected_hash) inline {
  throw_unless(err::bad_state, cell_hash(authorization) == expected_hash);
  slice a = authorization.begin_parse();
  throw_unless(err::bad_state, a~load_uint(32) == magic::authorization);
  throw_unless(err::bad_state, a~load_uint(16) == 1);
  int public_key = a~load_uint(256);
  a.end_parse();
  throw_unless(err::bad_state, public_key != 0);
  return public_key;
}

(int, int, int) parse_amount_text(cell text) inline {
  slice s = text.begin_parse();
  throw_unless(err::bad_state, (s.slice_refs() == 0) & ((s.slice_bits() % 8) == 0));
  int bytes = s.slice_bits() / 8;
  throw_unless(err::bad_state, (bytes > 0) & (bytes <= 39));
  int amount = 0;
  int first = 1;
  repeat (bytes) {
    int digit = s~load_uint(8);
    throw_unless(err::bad_state, (digit >= 48) & (digit <= 57));
    throw_unless(err::bad_state, (first == 0) | (bytes == 1) | (digit != 48));
    amount = amount * 10 + digit - 48;
    first = 0;
  }
  s.end_parse();
  throw_unless(err::bad_state, (amount > 0) & (amount < (1 << 120)));
  return (amount, bytes, first);
}

;; Returns native terms plus Paid Demand acceptance commitments.
(int, int, int, int, int, int, int, int, int) parse_quote(cell quote,
    int expected_hash) inline_ref {
  throw_unless(err::bad_state, cell_hash(quote) == expected_hash);
  slice q = quote.begin_parse();
  throw_unless(err::bad_state, q~load_uint(32) == magic::quote);
  throw_unless(err::bad_state, q~load_uint(16) == 2);
  q~load_ref();
  cell identity = q~load_ref();
  cell economic = q~load_ref();
  cell authority = q~load_ref();
  q.end_parse();

  slice ids = identity.begin_parse();
  ids~load_uint(256);
  int provider_agent = ids~load_uint(256);
  cell version = ids~load_ref();
  ids.end_parse();
  throw_unless(err::bad_state, provider_agent != 0);
  slice version_data = version.begin_parse();
  version_data~skip_bits(256 + 256);
  int transport_hash = version_data~load_uint(256);
  int quote_expiry = version_data~load_uint(64);
  version_data~load_ref();
  version_data.end_parse();

  slice es = economic.begin_parse();
  int escrow_terms_hash = es~load_uint(256);
  int dispute_hash = es~load_uint(256);
  cell asset = es~load_ref();
  cell amount_text = es~load_ref();
  es.end_parse();
  (int amount, _, _) = parse_amount_text(amount_text);

  slice asset_data = asset.begin_parse();
  throw_unless(err::bad_state, asset_data~load_int(32) == 0);
  int master_account = asset_data~load_uint(256);
  asset_data~load_uint(256);
  int wallet_code_hash = asset_data~load_uint(256);
  int decimals = asset_data~load_uint(8);
  asset_data.end_parse();
  throw_unless(err::bad_state, (master_account != 0) & (wallet_code_hash != 0) &
    (decimals > 0) & (decimals <= 18));

  slice auth = authority.begin_parse();
  int authorization_hash = auth~load_uint(256);
  cell extension = auth~load_ref();
  auth.end_parse();
  throw_unless(err::bad_state, authorization_hash != 0);
  slice ext = extension.begin_parse();
  throw_unless(err::bad_state, ext~load_uint(32) == magic::paid_demand);
  throw_unless(err::bad_state, ext~load_uint(16) == 1);
  int binding_digest = ext~load_uint(256);
  int offer_digest = ext~load_uint(256);
  int accept_by = ext~load_uint(64);
  int execution_deadline = ext~load_uint(64);
  int offer_bytes = ext~load_uint(32);
  cell offer = ext~load_ref();
  ext.end_parse();
  throw_unless(err::bad_state, (binding_digest != 0) & (offer_digest != 0) &
    (accept_by == quote_expiry) & (execution_deadline > accept_by) &
    (offer_bytes > 0) & (offer_bytes <= 65536));
  ;; The exact bytes are committed through the Quote cell. Complete CBOR,
  ;; signature and generic Agreement verification is performed by the native
  ;; resolver/Gate before acceptance and execution.
  throw_unless(err::bad_state, cell_hash(offer) != 0);
  return (amount, provider_agent, escrow_terms_hash, authorization_hash,
    transport_hash, dispute_hash, accept_by, execution_deadline, offer_digest);
}

(int, int, int, int, int, cell, cell, cell) parse_runtime(cell runtime) inline {
  slice r = runtime.begin_parse();
  throw_unless(err::bad_state, r~load_uint(32) == magic::runtime);
  throw_unless(err::bad_state, r~load_uint(16) == 2);
  int funded = r~load_uint(128);
  int settled = r~load_uint(128);
  int receipt_hash = r~load_uint(256);
  int pending_query = r~load_uint(64);
  int accepted_at = r~load_uint(64);
  cell route = r~load_ref();
  cell transport = r~load_ref();
  cell dispute = r~load_ref();
  r.end_parse();
  return (funded, settled, receipt_hash, pending_query, accepted_at, route, transport, dispute);
}

cell make_runtime(int funded, int settled, int receipt_hash, int pending_query,
    int accepted_at, cell route, cell transport, cell dispute) inline {
  return begin_cell().store_uint(magic::runtime, 32).store_uint(2, 16)
    .store_uint(funded, 128).store_uint(settled, 128).store_uint(receipt_hash, 256)
    .store_uint(pending_query, 64).store_uint(accepted_at, 64).store_ref(route)
    .store_ref(transport).store_ref(dispute).end_cell();
}

() validate_transport(cell transport, int expected_hash) inline_ref {
  throw_unless(err::bad_state, cell_hash(transport) == expected_hash);
  slice t = transport.begin_parse();
  throw_unless(err::bad_state, t~load_uint(32) == magic::transport);
  throw_unless(err::bad_state, t~load_uint(16) == 1);
  int security_mode = t~load_uint(8);
  int max_request_bytes = t~load_uint(32);
  cell endpoint = t~load_ref();
  t.end_parse();
  slice e = endpoint.begin_parse();
  throw_unless(err::bad_state, (security_mode <= 1) & (max_request_bytes > 0) &
    (max_request_bytes <= 16777216) & (e.slice_refs() == 0) &
    ((e.slice_bits() % 8) == 0) & (e.slice_bits() > 0) & (e.slice_bits() <= 960));
  repeat (e.slice_bits() / 8) {
    int ch = e~load_uint(8);
    throw_unless(err::bad_state, (ch >= 0x21) & (ch <= 0x7e));
  }
  e.end_parse();
}

() validate_dispute(cell dispute, int expected_hash) inline_ref {
  throw_unless(err::bad_state, cell_hash(dispute) == expected_hash);
  slice d = dispute.begin_parse();
  throw_unless(err::bad_state, d~load_uint(32) == magic::dispute);
  throw_unless(err::bad_state, d~load_uint(16) == 1);
  throw_unless(err::bad_state, d~load_uint(8) == 0);
  throw_unless(err::bad_state, d~load_uint(8) == 1);
  throw_unless(err::bad_state, d~load_uint(8) == 1);
  d.end_parse();
}

(slice, cell) parse_route(cell route, int quote_master, int quote_wallet_hash) inline_ref {
  slice r = route.begin_parse();
  throw_unless(err::bad_state, r~load_uint(32) == magic::route);
  throw_unless(err::bad_state, r~load_uint(16) == 2);
  slice master = r~load_msg_addr();
  int wallet_hash = r~load_uint(256);
  cell wallet_code = r~load_ref();
  r.end_parse();
  (int master_wc, int master_account) = master.parse_std_addr();
  throw_unless(err::bad_state, (master_wc == 0) & (master_account == quote_master) &
    (wallet_hash == quote_wallet_hash) & (cell_hash(wallet_code) == wallet_hash));
  return (master, wallet_code);
}

slice wallet_address(slice owner, slice master, cell wallet_code) inline_ref {
  cell wallet_data = begin_cell().store_uint(0, 4).store_coins(0)
    .store_slice(owner).store_slice(master).end_cell();
  cell init = begin_cell().store_uint(0, 2).store_uint(1, 1).store_ref(wallet_code)
    .store_uint(1, 1).store_ref(wallet_data).store_uint(0, 1).end_cell();
  return begin_cell().store_uint(4, 3).store_int(0, 8)
    .store_uint(cell_hash(init), 256).end_cell().begin_parse();
}

;; Build a settlement payout and calculate its exact body forward fee from the
;; active workchain configuration. The root message cell is covered by the lump
;; price; the referenced body is what the action phase counts as cells/bits.
(cell, int) make_stablecoin_message(slice wallet, slice destination_owner,
    int amount, int query_id) impure inline_ref {
  ;; The forward/compute fee helpers below price at base_workchain (0). That is
  ;; only correct if this escrow itself lives on workchain 0, so assert it rather
  ;; than silently mis-quote fees on another workchain and reopen the balance-guard gap.
  (int self_wc, _) = parse_std_addr(my_address());
  throw_unless(err::bad_state, self_wc == base_workchain);
  cell body = begin_cell().store_uint(op::jetton_transfer, 32).store_uint(query_id, 64)
    .store_coins(amount).store_slice(destination_owner).store_slice(my_address())
    .store_uint(0, 1).store_coins(0).store_uint(0, 1).end_cell();
  (int body_cells, int body_bits, _) = compute_data_size(body, 4);
  int forward_fee = get_forward_fee(base_workchain, body_bits, body_cells);
  cell message = begin_cell().store_uint(0x18, 6).store_slice(wallet)
    .store_tomis(wallet_transfer_tos).store_uint(0, 1 + 4 + 4 + 64 + 32)
    .store_uint(0, 1).store_uint(1, 1).store_ref(body).end_cell();
  return (message, forward_fee);
}

int settlement_required_balance(int forward_fee) inline {
  return escrow_storage_floor + wallet_transfer_tos + forward_fee
    + get_compute_fee(base_workchain, settlement_compute_gas_units);
}

;; Settlement payout (release/refund). Pays a fixed, adequate wallet_transfer_tos
;; from the escrow's own balance (mode 1 = fees separate), so the value the
;; recipient wallet receives is a known constant and never the unbounded
;; net-of-fees remainder of the settlement message. The caller pre-checks the
;; escrow balance covers the full configured compute/forward fee budget plus the
;; storage floor. Settlement is terminal and happens once per escrow, so paying
;; from balance here is not a griefing vector (unlike the return path, which is
;; caller-triggered and stays inbound-financed). Bounceable so a first-leg failure
;; returns to the escrow and the bounce handler can restore funded state; query_id
;; is preserved for that match.
() send_stablecoin(cell message) impure inline_ref {
  ;; Reserve the escrow's storage floor first so the fixed payout below can never
  ;; drain the account below rent, regardless of inbound value or fees
  ;; (reserve-before-send pattern from the vendored reference pool contract).
  ;; Exact reservation, not just the
  ;; balance pre-check at the call site.
  raw_reserve(escrow_storage_floor, 0);
  send_raw_message(message, 1);
}

;; Return an unaccepted funding to its sender (refund-with-reason pattern from the
;; vendored reference router contract). Uses
;; query_id 0 so a bounce of this return can never equal a settlement's (always
;; nonzero) pending_query and roll release/refund back to funded. Mode 64 funds
;; it from the funder's own inbound value, never the escrow reserve. The reason
;; code is carried inline in the transfer body's forward payload.
() return_stablecoin(slice wallet, slice destination_owner, int amount,
    int reason) impure inline_ref {
  cell body = begin_cell().store_uint(op::jetton_transfer, 32).store_uint(0, 64)
    .store_coins(amount).store_slice(destination_owner).store_slice(my_address())
    .store_uint(0, 1).store_coins(0).store_uint(0, 1).store_uint(reason, 32).end_cell();
  cell message = begin_cell().store_uint(0x18, 6).store_slice(wallet)
    .store_tomis(0).store_uint(0, 1 + 4 + 4 + 64 + 32)
    .store_uint(0, 1).store_uint(1, 1).store_ref(body).end_cell();
  send_raw_message(message, 64);
}

(int, int, int) parse_receipt(cell receipt, int expected_quote,
    int expected_amount, int expected_provider, int execution_deadline) inline_ref {
  slice r = receipt.begin_parse();
  throw_unless(err::bad_receipt, r~load_uint(32) == magic::receipt);
  throw_unless(err::bad_receipt, r~load_uint(16) == 1);
  int completed_at = r~load_uint(64);
  int exit_code = r~load_int(32);
  cell binding = r~load_ref();
  cell outcome = r~load_ref();
  cell evidence = r~load_ref();
  cell economic = r~load_ref();
  r.end_parse();
  throw_unless(err::bad_receipt, (completed_at > 0) &
    (completed_at <= execution_deadline) & (exit_code == 0));
  slice b = binding.begin_parse();
  throw_unless(err::bad_receipt, b~load_uint(256) == expected_quote);
  throw_unless(err::bad_receipt, b~load_uint(256) != 0);
  throw_unless(err::bad_receipt, b~load_uint(256) != 0);
  b.end_parse();
  slice o = outcome.begin_parse();
  throw_unless(err::bad_receipt, o~load_uint(256) != 0);
  throw_unless(err::bad_receipt, o~load_uint(256) != 0);
  throw_unless(err::bad_receipt, o~load_uint(256) != 0);
  o.end_parse();
  slice e = evidence.begin_parse();
  throw_unless(err::bad_receipt, e~load_uint(256) != 0);
  throw_unless(err::bad_receipt, e~load_uint(256) != 0);
  throw_unless(err::bad_receipt, e~load_uint(256) != 0);
  e.end_parse();
  slice money = economic.begin_parse();
  int charged = money~load_uint(128);
  int provider = money~load_uint(256);
  money.end_parse();
  throw_unless(err::bad_receipt, (charged == expected_amount) &
    (provider == expected_provider));
  return (cell_hash(receipt), charged, completed_at);
}

cell settlement_intent(int query_id, int charged, int quote_hash,
    int receipt_hash) inline {
  return begin_cell().store_uint(magic::intent, 32).store_uint(1, 16)
    .store_uint(query_id, 64).store_uint(charged, 128).store_slice(my_address())
    .store_uint(quote_hash, 256).store_uint(receipt_hash, 256).end_cell();
}

() recv_internal(int msg_value, cell in_msg_full, slice body) impure {
  slice full = in_msg_full.begin_parse();
  int flags = full~load_uint(4);
  slice sender = full~load_msg_addr();
  if (body.slice_empty?()) { return (); }

  (int status, int quote_hash, int terms_hash, int auth_hash, cell quote,
    cell terms, cell authorization, cell runtime) = load_escrow();
  (slice buyer, slice provider, int funding_deadline, int refund_at) =
    parse_terms(terms, terms_hash);
  int public_key = parse_authorization(authorization, auth_hash);
  (int quote_amount, int provider_agent, int quote_terms_hash, int quote_auth_hash,
    int quote_transport_hash, int quote_dispute_hash, int accept_by,
    int execution_deadline, int offer_digest) = parse_quote(quote, quote_hash);
  throw_unless(err::bad_state, (quote_terms_hash == terms_hash) &
    (quote_auth_hash == auth_hash) & (execution_deadline < refund_at) &
    (accept_by <= funding_deadline) & (funding_deadline < execution_deadline));
  (int funded, int settled, int receipt_hash, int pending_query, int accepted_at,
    cell route, cell transport, cell dispute) = parse_runtime(runtime);
  validate_transport(transport, quote_transport_hash);
  validate_dispute(dispute, quote_dispute_hash);

  slice quote_asset = quote.begin_parse();
  quote_asset~skip_bits(48); quote_asset~load_ref(); quote_asset~load_ref();
  slice quote_economic = quote_asset~load_ref().begin_parse();
  quote_economic~skip_bits(512);
  slice quote_asset_cell = quote_economic~load_ref().begin_parse();
  quote_asset_cell~load_int(32);
  int quote_master = quote_asset_cell~load_uint(256);
  quote_asset_cell~load_uint(256);
  int quote_wallet_hash = quote_asset_cell~load_uint(256);
  (slice master, cell wallet_code) = parse_route(route, quote_master, quote_wallet_hash);
  slice own_wallet = wallet_address(my_address(), master, wallet_code);

  if (flags & 1) {
    throw_unless(err::bad_confirmation, equal_slice_bits(sender, own_wallet));
    body~skip_bits(32);
    throw_unless(err::bad_confirmation, body~load_uint(32) == op::jetton_transfer);
    int bounced_query = body~load_uint(64);
    throw_unless(err::bad_confirmation, ((status == status::release_pending) |
      (status == status::refund_pending)) & (bounced_query == pending_query));
    save_escrow(status::funded, quote_hash, terms_hash, auth_hash, quote, terms,
      authorization, make_runtime(funded, 0, 0, 0, accepted_at, route, transport, dispute));
    return ();
  }

  int op = body~load_uint(32);
  if (op == op::accept) {
    int query_id = body~load_uint(64);
    int supplied_quote = body~load_uint(256);
    int supplied_offer = body~load_uint(256);
    body.end_parse();
    throw_unless(err::bad_acceptance, (query_id != 0) & (supplied_quote == quote_hash) &
      (supplied_offer == offer_digest) & equal_slice_bits(sender, buyer));
    ;; An exact replay is an observation of the already-consumed semantic
    ;; acceptance action.  Keep it idempotent after funding and while either
    ;; terminal transfer is being resolved; a replay must never manufacture a
    ;; second transition or make crash recovery depend on timing.
    if (status >= status::awaiting_funding) {
      return ();
    }
    throw_unless(err::bad_state, status == status::pending_acceptance);
    throw_unless(err::deadline, now() < accept_by);
    save_escrow(status::awaiting_funding, quote_hash, terms_hash, auth_hash, quote,
      terms, authorization, make_runtime(0, 0, 0, 0, now(), route, transport, dispute));
    return ();
  }

  if (op == op::transfer_notification) {
    int query_id = body~load_uint(64);
    int amount = body~load_coins();
    slice from = body~load_msg_addr();
    ;; The jettons are already credited to some wallet the escrow owns before
    ;; this runs: a throw cannot un-credit them and would orphan them
    ;; permanently. Accept a valid funding; on any mismatch return the jettons
    ;; to the funder instead of throwing (refund-with-reason pattern from the
    ;; vendored reference router contract).
    ;; Return only to a real internal, non-anycast, workchain-0 owner the jetton
    ;; wallet can actually pay; a malformed previous-owner is left untouched
    ;; rather than emitting a doomed transfer.
    slice from_check = from;
    int returnable = 0;
    if (from_check~load_uint(2) == 2) {
      if (from_check~load_uint(1) == 0) {
        returnable = (from_check~load_int(8) == 0);
      }
    }
    ifnot (equal_slice_bits(sender, own_wallet)) {
      ;; A committed jetton whose wallet code uses a different data layout puts
      ;; the credit in a wallet the escrow owns but never derives an address
      ;; for; no op can move those funds later. Never credit state from such a
      ;; notification, and never throw: ask the notifying wallet (whatever it
      ;; is, the escrow is its owner if the credit was real) to send the amount
      ;; back to the funder. A forged notification from an arbitrary contract
      ;; only receives its own attached value back (mode 64, zero from our
      ;; balance), so this return path grants an attacker nothing.
      if (returnable) {
        return_stablecoin(sender, from, amount, reason::wrong_wallet);
      }
      return ();
    }
    if ((status == status::awaiting_funding) & equal_slice_bits(from, buyer) &
        (now() <= funding_deadline) & (amount == quote_amount)) {
      save_escrow(status::funded, quote_hash, terms_hash, auth_hash, quote, terms,
        authorization, make_runtime(amount, 0, 0, 0, accepted_at, route, transport, dispute));
      return ();
    }
    if (returnable) {
      return_stablecoin(own_wallet, from, amount, reason::invalid_request);
    }
    return ();
  }

  if (op == op::release) {
    int query_id = body~load_uint(64);
    throw_unless(err::bad_message, query_id != 0);
    slice signature = body~load_bits(512);
    cell receipt = body~load_ref();
    body.end_parse();
    (int new_receipt_hash, int charged, int completed_at) = parse_receipt(receipt,
      quote_hash, quote_amount, provider_agent, execution_deadline);
    throw_unless(err::bad_receipt, (completed_at <= now()) & (completed_at < refund_at));
    cell intent = settlement_intent(query_id, charged, quote_hash, new_receipt_hash);
    throw_unless(err::bad_signature, check_signature(cell_hash(intent), signature, public_key));
    if (status == status::release_pending) {
      throw_unless(err::bad_state, (query_id == pending_query) &
        (new_receipt_hash == receipt_hash) & (charged == settled));
      return ();
    }
    throw_unless(err::bad_state, status == status::funded);
    throw_unless(err::deadline, (now() <= execution_deadline) & (now() < refund_at));
    ;; Refuse to launch unless the balance covers the fixed payout, current
    ;; config-derived compute/forward fees, and storage floor. get_balance() is
    ;; observed before compute fees are finally debited, so omitting that budget
    ;; would admit a transaction that later fails action phase with no funds.
    (cell payout_message, int payout_forward_fee) = make_stablecoin_message(
      own_wallet, provider, charged, query_id);
    throw_unless(err::insufficient_gas,
      get_balance().pair_first() >= settlement_required_balance(payout_forward_fee));
    save_escrow(status::release_pending, quote_hash, terms_hash, auth_hash, quote,
      terms, authorization, make_runtime(funded, charged, new_receipt_hash,
        query_id, accepted_at, route, transport, dispute));
    send_stablecoin(payout_message);
    return ();
  }

  if (op == op::refund) {
    int query_id = body~load_uint(64);
    body.end_parse();
    throw_unless(err::bad_message, query_id != 0);
    if (status == status::refund_pending) {
      throw_unless(err::bad_state, query_id == pending_query);
      return ();
    }
    throw_unless(err::bad_state, status == status::funded);
    throw_unless(err::deadline, now() >= refund_at);
    ;; Same full fee-aware balance pre-check as release.
    (cell payout_message, int payout_forward_fee) = make_stablecoin_message(
      own_wallet, buyer, funded, query_id);
    throw_unless(err::insufficient_gas,
      get_balance().pair_first() >= settlement_required_balance(payout_forward_fee));
    save_escrow(status::refund_pending, quote_hash, terms_hash, auth_hash, quote,
      terms, authorization, make_runtime(funded, 0, 0, query_id, accepted_at,
        route, transport, dispute));
    send_stablecoin(payout_message);
    return ();
  }

  if (op == op::excesses) { return (); }
  throw(err::bad_message);
}

(int, int, int, int, int, int) get_escrow_state() method_id {
  (int status, int quote_hash, int terms_hash, int auth_hash, cell quote,
    cell terms, cell authorization, cell runtime) = load_escrow();
  (int funded, int settled, int receipt_hash, int pending_query, int accepted_at,
    cell route, cell transport, cell dispute) = parse_runtime(runtime);
  return (status, funded, settled, receipt_hash, pending_query, accepted_at);
}

(cell, cell, cell, cell) get_escrow_cells() method_id {
  (int status, int quote_hash, int terms_hash, int auth_hash, cell quote,
    cell terms, cell authorization, cell runtime) = load_escrow();
  return (quote, terms, authorization, runtime);
}

slice get_escrow_wallet() method_id {
  (int status, int quote_hash, int terms_hash, int auth_hash, cell quote,
    cell terms, cell authorization, cell runtime) = load_escrow();
  (int funded, int settled, int receipt_hash, int pending_query, int accepted_at,
    cell route, cell transport, cell dispute) = parse_runtime(runtime);
  slice quote_data = quote.begin_parse();
  quote_data~skip_bits(48); quote_data~load_ref(); quote_data~load_ref();
  slice economic = quote_data~load_ref().begin_parse();
  economic~skip_bits(512);
  slice asset = economic~load_ref().begin_parse();
  asset~load_int(32);
  int master_account = asset~load_uint(256);
  asset~load_uint(256);
  int wallet_hash = asset~load_uint(256);
  (slice master, cell wallet_code) = parse_route(route, master_account, wallet_hash);
  return wallet_address(my_address(), master, wallet_code);
}
