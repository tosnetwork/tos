#!/usr/bin/create-state -s
//
// jvm-testnet-rehearsal.fif
//
// Phase X — testnet genesis rehearsal.  Builds a complete wc=3
// ShardState with ONE seeded `java.lang.Deployer` + ONE seeded
// `java.lang.Wallet`, then prints the derived wc=3 addresses
// and ShardState hashes so the operator can verify their
// toolchain matches the published canonical values.
//
// Inputs (read from CWD; the wrapper `scripts/jvm-testnet-genesis-
// rehearsal.sh` puts them there):
//
//   ./stdlib_hash.bin    — 32 raw bytes = sha256(rt.jar)
//   ./Wallet.class       — extracted from rt.jar's java/lang/Wallet.class
//   ./Deployer.class     — extracted from rt.jar's java/lang/Deployer.class
//
// Outputs (written to CWD):
//
//   ./jvmstate3-rehearsal.boc          — the wc=3 ShardState BOC
//   ./jvmstate3-rehearsal.rhash        — its root hash
//   ./jvmstate3-rehearsal.fhash        — its file hash
//
// The owner pubkeys + salts below are DETERMINISTIC TEST FIXTURES
// — a real launch substitutes the chain's actual launch keypairs.

"Workchain.fif" include
"TosUtil.fif" include

1 setglobalid     // rehearsal global_id; real launch picks its own

// `mkShardStateWithAccounts` bakes the current unixtime into the
// ShardState (via `now` in Workchain.fif).  For the rehearsal to
// produce a reproducible ShardState hash across multiple runs we
// must override `now` with a fixed timestamp.  Real launches
// embed the actual genesis ceremony time and never re-build — but
// for the rehearsal a deterministic pin lets the operator
// cross-check their hashes against the published canonical
// values.
//
// 1234567890 is chosen as a memorable Unix timestamp
// (2009-02-13 23:31:30 UTC) far enough from any real activation
// date to never collide with one.
{ 1234567890 } : now

cr ."=== JVM testnet genesis rehearsal ===" cr cr

// ─── 1. Read pinned inputs ───────────────────────────────────────
"./stdlib_hash.bin" file>B dup Blen 32 <> abort"stdlib_hash.bin must be exactly 32 bytes"
constant stdlib-hash
."stdlib_hash:       " stdlib-hash Bx. cr

"./Wallet.class" file>B constant wallet-class-bytes
."Wallet.class size: " wallet-class-bytes Blen . ."bytes" cr

"./Deployer.class" file>B constant deployer-class-bytes
."Deployer.class:    " deployer-class-bytes Blen . ."bytes" cr
cr

// ─── 2. Deterministic test fixtures ──────────────────────────────
// Owner pubkeys are byte patterns 0x10..0x2f (deployer) and
// 0x20..0x3f (wallet) — choices that produce non-zero, non-
// symmetric bytes so any byte-order drift in the address
// derivation would surface as a non-zero diff against the
// canonical printed addresses below.
B{101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f}
  constant deployer-owner-pubkey
B{202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f}
  constant wallet-owner-pubkey

// Salts pinned to fixed values for the rehearsal.
B{deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef}
  constant deployer-salt
B{cafebabecafebabecafebabecafebabecafebabecafebabecafebabecafebabe}
  constant wallet-salt

// Initial balances (in nano-TOMIS).
500000000  constant deployer-initial-balance
1000000000 constant wallet-initial-balance

// ─── 3. Build allocation tuples ──────────────────────────────────
// Each entry: (owner_pubkey:32B, salt:32B, balance:int) 3-tuple.
// Outer: 1-tuple containing one entry (rehearsal has one of each).
deployer-owner-pubkey deployer-salt deployer-initial-balance 3 tuple
1 tuple constant deployers-alloc

wallet-owner-pubkey wallet-salt wallet-initial-balance 3 tuple
1 tuple constant wallets-alloc

// ─── 4. Build the wc=3 ShardAccounts cell ────────────────────────
wallets-alloc wallet-class-bytes
deployers-alloc deployer-class-bytes
stdlib-hash
  jvm-zerostate-with-deployers-from-alloc
  constant jvm-accounts-cell

// ─── 5. Wrap as a wc=3 ShardState ────────────────────────────────
jvm-accounts-cell 3 mkShardStateWithAccounts constant jvm-shard-state

// ─── 6. Save outputs + print verification hashes ────────────────
jvm-shard-state 31 boc+>B
dup "jvmstate3-rehearsal.boc" B>file
dup Bhashu dup =: state-fhash
   ."ShardState fhash:  " 64x. cr
drop

jvm-shard-state hashu dup =: state-rhash
   ."ShardState rhash:  " 64x. cr

// File-hash separately written so post-rehearsal scripts can diff
// just the hashes without parsing the BOC.
state-rhash 256 u>B "jvmstate3-rehearsal.rhash" B>file
state-fhash 256 u>B "jvmstate3-rehearsal.fhash" B>file

cr ."=== Rehearsal complete ===" cr
."  Reproduce these hashes on every operator's box to verify" cr
."  the canonical genesis state is consistent across hosts." cr
