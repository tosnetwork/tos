;; Canonical identity witnesses for the complete Quantum module/wallet path.
;; Expected code identities MUST come from compiled dependencies (or MYCODE for
;; a same-code module successor), never from the witness being checked.
#include "pq-bytes.fc";
const int quantumid::invalid = 1815;

(slice, int) quantumid_raw(cell c) asm "XCTOS";
int quantumid_level(cell c) asm "CLEVEL";

slice quantumid_ordinary(cell c) impure inline {
  (slice s, int special) = quantumid_raw(c);
  throw_unless(quantumid::invalid, (special == 0) & (quantumid_level(c) == 0));
  return s;
}

;; Bounded traversal counts reference visits, including repeated DAG references.
;; It never resolves an exotic/library cell. Limits are part of this profile.
int quantumid_check_dag(cell c, int remaining, int depth) impure {
  throw_unless(quantumid::invalid, (remaining > 0) & (depth <= 128));
  slice s = quantumid_ordinary(c);
  remaining -= 1;
  while (s.slice_refs()) {
    remaining = quantumid_check_dag(s~load_ref(), remaining, depth + 1);
  }
  return remaining;
}

cell quantumid_state_init(cell witness, int expected_code, int expected_address) impure inline_ref {
  slice s = quantumid_ordinary(witness);
  ;; split absent, special absent, code present, data present, libraries empty.
  throw_unless(quantumid::invalid, (s.slice_bits() == 5) & (s.slice_refs() == 2));
  throw_unless(quantumid::invalid, s~load_uint(5) == 6);
  cell code = s~load_ref();
  cell data = s~load_ref();
  s.end_parse();
  throw_unless(quantumid::invalid, cell_hash(code) == expected_code);
  throw_unless(quantumid::invalid, cell_hash(witness) == expected_address);
  quantumid_check_dag(witness, 1024, 0);
  return data;
}

;; Returns policy, canonical daily-key chain and fixed SLH public key. The whole
;; StateInit hash, not a code/data sub-hash, is the module's address commitment.
(int, cell, int) quantumid_module(cell witness, int expected_code, int expected_address,
    int global_id, int network) impure inline_ref {
  slice s = quantumid_state_init(witness, expected_code, expected_address).begin_parse();
  throw_unless(quantumid::invalid, s~load_uint(8) == 1);
  throw_unless(quantumid::invalid, s~load_int(32) == global_id);
  throw_unless(quantumid::invalid, s~load_uint(256) == network);
  throw_unless(quantumid::invalid, s~load_uint(8) == 1);
  cell primary_key = s~load_ref();
  int rescue_key = s~load_uint(256);
  int policy = s~load_uint(8);
  s.end_parse();
  throw_unless(quantumid::invalid, (policy == 1) | (policy == 2));
  pq::check_chain_bytes(primary_key, 1312);
  return (policy, primary_key, rescue_key);
}
