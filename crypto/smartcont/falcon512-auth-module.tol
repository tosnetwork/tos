// Wire-compatible immutable Falcon-512 padded root. See falcon512-auth-module.fc and docs.
import "@stdlib/common"
import "auth-extension"
import "pq"

const FALCON_AUTH_SUBMIT: uint32 = 0x46414c31

struct Falcon512AuthStorage {
    globalId: int32;
    profileVersion: uint16;
    publicKey: cell;
}

struct (FALCON_AUTH_SUBMIT) Falcon512AuthSubmission {
    queryId: uint64;
    envelope: cell;
    signature: cell;
}

fun falconAuthIsBounced(): bool asm "INMSG_BOUNCED";
fun falconAuthBalance(): int asm "BALANCE" "FIRST";
fun falconAuthReserve(amount: int, mode: int): void asm "RAWRESERVE";
fun falconAuthSend(message: cell, mode: int): void asm "SENDRAWMSG";

fun falconAuthRelay(body: slice, value: int): void {
    assert (body.loadUint(32) == FALCON_AUTH_SUBMIT) throw 1811;
    body.loadUint(64); // unsigned relayer query_id; no authorization semantics
    val envelope = body.loadRef();
    val signature = body.loadRef();
    body.assertEnd();
    var ds = contract.getData().beginParse();
    val network = ds.loadInt(32);
    assert (ds.loadUint(16) == 1) throw 1811;
    val publicKey = ds.loadRef();
    ds.assertEnd();
    assert (network == authGlobalId()) throw 1801;

    var auth = envelope.beginParse();
    assert (auth.loadUint(32) == AUTH_OPCODE) throw 1811;
    val request = auth.loadRef();
    val cosignature = auth.loadMaybeRef();
    auth.assertEnd();
    if (cosignature != null) {
        val co = cosignature!.beginParse();
        assert (co.remainingBitsCount() == 512 && co.remainingRefsCount() == 0) throw 1808;
    }
    var cs = request.beginParse();
    assert (cs.loadInt(32) == network) throw 1801;
    val account = cs.loadAddressAny();
    authModuleHash(account);  // rejects non-standard, cross-workchain and self targets
    cs.loadUint(64); // epoch is enforced by the account
    cs.loadUint(64); // nonce is enforced by the account
    val validUntil = cs.loadUint(32);
    assert (validUntil > blockchain.now() && validUntil <= blockchain.now() + 3600) throw 1805;
    assert (cs.loadUint(8) <= 2) throw 1811;
    cs.loadRef();
    cs.assertEnd();

    val (rootWc, rootHash) = contract.getAddress().getWorkchainAndHash();
    val message = beginCell()
        .storeUint(0x544f532d415554482d46414c434f4e3531322d5041444445442d7631, 224)
        .storeUint(0, 8).storeInt(rootWc, 32).storeUint(rootHash, 256)
        .storeUint(authRequestHash(request), 256).endCell();
    assert (pqCheckFalcon512Padded(message, signature, publicKey)) throw 1808;

    val oldBalance = falconAuthBalance() - value;
    falconAuthReserve(oldBalance > 0 ? oldBalance : 0, 2);
    val relay = beginCell().storeUint(0x18, 6).storeSlice(authAddressSlice(account))
        .storeCoins(0).storeUint(0, 1 + 4 + 4 + 64 + 32 + 1)
        .storeUint(1, 1).storeRef(envelope).endCell();
    falconAuthSend(relay, 64);
}

@on_bounced_policy("manual")
contract Falcon512AuthModule {
    storage: Falcon512AuthStorage
    @unknown_silent_drop;

    @disclaim_query_id
    receive(msg: Falcon512AuthSubmission) {
        if (falconAuthIsBounced()) { return; }
        falconAuthRelay(in.body, in.valueCoins);
    }

    receive_external(msg: UnknownOpcode) {
        throw 1900;
    }

    get fun get_falcon512_config(): (int, int, cell) {
        return (storage.globalId, storage.profileVersion, storage.publicKey);
    }
}
