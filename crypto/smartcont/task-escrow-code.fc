;; Minimal AI Agent task escrow actor.
;; The creator funds the actor at deployment, an agent accepts and submits a
;; result, and the creator settles or cancels the task.

const int op::accept = 0x54415301;
const int op::result = 0x54415302;
const int op::settle = 0x54415303;
const int op::cancel = 0x54415304;
const int op::timeout = 0x54415305;

const int status::open = 0;
const int status::accepted = 1;
const int status::result_submitted = 2;
const int status::settled = 3;
const int status::cancelled = 4;
const int status::expired = 5;

() send_value(slice destination, int amount) impure inline {
  send_raw_message(begin_cell()
    .store_uint(0x10, 6)
    .store_slice(destination)
    .store_tomis(amount)
    .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
  .end_cell(), 128);
}

() save_state(slice creator, slice agent, int has_agent, int budget, int deadline,
             int status, int result_hash, int evidence_hash, int policy_hash) impure inline {
  set_data(begin_cell()
    .store_slice(creator)
    .store_int(has_agent, 1)
    .store_slice(agent)
    .store_tomis(budget)
    .store_uint(deadline, 64)
    .store_uint(status, 8)
    .store_ref(begin_cell()
      .store_uint(result_hash, 256)
      .store_uint(evidence_hash, 256)
      .store_uint(policy_hash, 256)
    .end_cell())
  .end_cell());
}

() recv_internal(int msg_value, cell in_msg_full, slice in_msg) impure {
  if (in_msg.slice_empty?()) { return (); }
  var op = in_msg~load_uint(32);
  var query_id = in_msg~load_uint(64);
  var ds = get_data().begin_parse();
  var creator = ds~load_msg_addr();
  var has_agent = ds~load_uint(1);
  var agent = ds~load_msg_addr();
  var budget = ds~load_tomis();
  var deadline = ds~load_uint(64);
  var status = ds~load_uint(8);
  var hashes = ds~load_ref().begin_parse();
  var result_hash = hashes~load_uint(256);
  var evidence_hash = hashes~load_uint(256);
  var policy_hash = hashes~load_uint(256);
  ds.end_parse();
  var full_msg = in_msg_full.begin_parse();
  full_msg~skip_bits(4);
  var sender = full_msg~load_msg_addr();

  if (op == op::accept) {
    throw_unless(100, status == status::open);
    throw_unless(101, (has_agent == 0) | equal_slice_bits(sender, agent));
    agent = sender;
    has_agent = -1;
    save_state(creator, agent, has_agent, budget, deadline, status::accepted,
      result_hash, evidence_hash, policy_hash);
    return ();
  }
  if (op == op::result) {
    throw_unless(102, status == status::accepted);
    throw_unless(103, has_agent & equal_slice_bits(sender, agent));
    result_hash = in_msg~load_uint(256);
    evidence_hash = in_msg~load_uint(256);
    save_state(creator, agent, has_agent, budget, deadline, status::result_submitted,
      result_hash, evidence_hash, policy_hash);
    return ();
  }
  if (op == op::settle) {
    throw_unless(104, status == status::result_submitted);
    throw_unless(105, equal_slice_bits(sender, creator));
    var payout = in_msg~load_tomis();
    throw_unless(106, payout <= budget);
    send_value(agent, payout);
    send_value(creator, budget - payout);
    save_state(creator, agent, has_agent, 0, deadline, status::settled,
      result_hash, evidence_hash, policy_hash);
    return ();
  }
  if (op == op::cancel) {
    throw_unless(107, status == status::open);
    throw_unless(108, equal_slice_bits(sender, creator));
    send_value(creator, budget);
    save_state(creator, agent, has_agent, 0, deadline, status::cancelled,
      result_hash, evidence_hash, policy_hash);
    return ();
  }
  if (op == op::timeout) {
    throw_unless(109, deadline <= now());
    throw_unless(110, (status == status::open) | (status == status::accepted) |
      (status == status::result_submitted));
    send_value(creator, budget);
    save_state(creator, agent, has_agent, 0, deadline, status::expired,
      result_hash, evidence_hash, policy_hash);
    return ();
  }
  throw(111);
}

(slice, slice, int, int, int, int, int, int, int) get_task_data() method_id {
  var ds = get_data().begin_parse();
  var creator = ds~load_msg_addr();
  var agent = ds~load_msg_addr();
  var has_agent = ds~load_uint(1);
  var budget = ds~load_tomis();
  var deadline = ds~load_uint(64);
  var status = ds~load_uint(8);
  var hashes = ds~load_ref().begin_parse();
  return (creator, agent, has_agent, budget, deadline, status,
    hashes~load_uint(256), hashes~load_uint(256), hashes~load_uint(256));
}
