;; Copyright (C) 2025-2026  TOS Network.
;; Minimal AI Agent task escrow actor.
;; The creator funds the actor at deployment, an agent accepts and submits a
;; result, and the creator settles or cancels the task.

const int op::accept = 0x54415301;
const int op::result = 0x54415302;
const int op::settle = 0x54415303;
const int op::cancel = 0x54415304;
const int op::timeout = 0x54415305;
const int op::reject = 0x54415306;
const int op::claim = 0x54415307;
const int op::dispute = 0x54415308;
const int op::resolve = 0x54415309;
const int op::rotate_attestor_key = 0x5441530a;
const int op::revoke_attestor = 0x5441530b;

const int status::open = 0;
const int status::accepted = 1;
const int status::result_submitted = 2;
const int status::settled = 3;
const int status::cancelled = 4;
const int status::expired = 5;
const int status::rejected = 6;
const int status::disputed = 7;

;; mode 1: send exactly `amount`, fees paid from the contract balance.
;; mode 128: `amount` is ignored and the whole remaining balance is carried.
() send_value(slice destination, int amount, int mode) impure inline {
  send_raw_message(begin_cell()
    .store_uint(0x10, 6)
    .store_slice(destination)
    .store_tomis(amount)
    .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
  .end_cell(), mode);
}

() save_state(slice creator, slice agent, int has_agent, slice verifier, int has_verifier,
             int budget, int deadline, int status, int result_hash, int evidence_hash,
             int policy_hash, int review_period, int review_deadline,
             int permission_hash, int dispute_hash,
             int has_attestor, int attestor_pubkey) impure inline {
  set_data(begin_cell()
    .store_slice(creator)
    .store_uint(has_agent, 1)
    .store_slice(agent)
    .store_uint(has_verifier, 1)
    .store_slice(verifier)
    .store_tomis(budget)
    .store_uint(deadline, 64)
    .store_uint(status, 8)
    .store_ref(begin_cell()
      .store_uint(result_hash, 256)
      .store_uint(evidence_hash, 256)
      .store_uint(policy_hash, 256)
      .store_uint(review_period, 32)
      .store_uint(review_deadline, 64)
      .store_ref(begin_cell()
        .store_uint(permission_hash, 256)
        .store_uint(dispute_hash, 256)
      .end_cell())
      .store_ref(begin_cell()
        .store_uint(has_attestor, 1)
        .store_uint(attestor_pubkey, 256)
      .end_cell())
    .end_cell())
  .end_cell());
}

() recv_internal(int msg_value, cell in_msg_full, slice in_msg) impure {
  var full_msg = in_msg_full.begin_parse();
  int flags = full_msg~load_uint(4);
  if (flags & 1) { return (); }  ;; ignore bounced messages
  var sender = full_msg~load_msg_addr();
  if (in_msg.slice_empty?()) { return (); }
  var op = in_msg~load_uint(32);
  var query_id = in_msg~load_uint(64);
  var ds = get_data().begin_parse();
  var creator = ds~load_msg_addr();
  var has_agent = ds~load_uint(1);
  var agent = ds~load_msg_addr();
  var has_verifier = ds~load_uint(1);
  var verifier = ds~load_msg_addr();
  var budget = ds~load_tomis();
  var deadline = ds~load_uint(64);
  var status = ds~load_uint(8);
  var hashes = ds~load_ref().begin_parse();
  var result_hash = hashes~load_uint(256);
  var evidence_hash = hashes~load_uint(256);
  var policy_hash = hashes~load_uint(256);
  var review_period = hashes~load_uint(32);
  var review_deadline = hashes~load_uint(64);
  var permission_slice = hashes~load_ref().begin_parse();
  var permission_hash = permission_slice~load_uint(256);
  var dispute_hash = permission_slice~load_uint(256);
  var attestor_slice = hashes~load_ref().begin_parse();
  var has_attestor = attestor_slice~load_uint(1);
  var attestor_pubkey = attestor_slice~load_uint(256);
  ds.end_parse();

  if (op == op::claim) {
    throw_unless(115, status == status::open);
    throw_unless(116, has_agent == 0);
    in_msg.end_parse();
    agent = sender;
    has_agent = 1;
    save_state(creator, agent, has_agent, verifier, has_verifier, budget, deadline,
      status::accepted, result_hash, evidence_hash, policy_hash, review_period,
      review_deadline, permission_hash, dispute_hash, has_attestor, attestor_pubkey);
    return ();
  }
  if (op == op::accept) {
    throw_unless(100, status == status::open);
    throw_unless(101, has_agent & equal_slice_bits(sender, agent));
    in_msg.end_parse();
    save_state(creator, agent, has_agent, verifier, has_verifier, budget, deadline,
      status::accepted, result_hash, evidence_hash, policy_hash, review_period,
      review_deadline, permission_hash, dispute_hash, has_attestor, attestor_pubkey);
    return ();
  }
  if (op == op::result) {
    throw_unless(102, status == status::accepted);
    throw_unless(103, has_agent & equal_slice_bits(sender, agent));
    throw_unless(117, now() <= deadline);
    result_hash = in_msg~load_uint(256);
    evidence_hash = in_msg~load_uint(256);
    in_msg.end_parse();
    review_deadline = now() + review_period;
    save_state(creator, agent, has_agent, verifier, has_verifier, budget, deadline,
      status::result_submitted, result_hash, evidence_hash, policy_hash, review_period,
      review_deadline, permission_hash, dispute_hash, has_attestor, attestor_pubkey);
    return ();
  }
  if (op == op::settle) {
    throw_unless(104, status == status::result_submitted);
    ;; Settlement authority: the creator, or the designated verifier when set.
    throw_unless(105, equal_slice_bits(sender, creator) |
      (has_verifier & equal_slice_bits(sender, verifier)));
    throw_unless(118, now() <= review_deadline);
    var payout = in_msg~load_tomis();
    throw_unless(106, payout <= budget);
    throw_unless(112, payout <= get_balance().pair_first());
    if (has_attestor) {
      ;; Additional, independent check: the configured attestor key must have
      ;; signed the submitted result_hash, domain-bound to this contract's own
      ;; address so the signature can't be replayed against another instance
      ;; sharing the same attestor key and result_hash. This never replaces
      ;; the sender authorization above -- it is an extra requirement layered
      ;; on top.
      slice signature = in_msg~load_bits(512);
      (int wc, int addr) = my_address().parse_std_addr();
      int domain_hash = cell_hash(begin_cell()
        .store_int(wc, 8).store_uint(addr, 256).store_uint(result_hash, 256).end_cell());
      throw_unless(127, check_signature(domain_hash, signature, attestor_pubkey));
    }
    in_msg.end_parse();
    if (payout > 0) {
      send_value(agent, payout, 1);
    }
    send_value(creator, 0, 128);
    save_state(creator, agent, has_agent, verifier, has_verifier, 0, deadline,
      status::settled, result_hash, evidence_hash, policy_hash, review_period,
      review_deadline, permission_hash, dispute_hash, has_attestor, attestor_pubkey);
    return ();
  }
  if (op == op::cancel) {
    throw_unless(107, status == status::open);
    throw_unless(108, equal_slice_bits(sender, creator));
    in_msg.end_parse();
    send_value(creator, 0, 128);
    save_state(creator, agent, has_agent, verifier, has_verifier, 0, deadline,
      status::cancelled, result_hash, evidence_hash, policy_hash, review_period,
      review_deadline, permission_hash, dispute_hash, has_attestor, attestor_pubkey);
    return ();
  }
  if (op == op::reject) {
    throw_unless(113, status == status::open);
    throw_unless(114, has_agent & equal_slice_bits(sender, agent));
    in_msg.end_parse();
    send_value(creator, 0, 128);
    save_state(creator, agent, has_agent, verifier, has_verifier, 0, deadline,
      status::rejected, result_hash, evidence_hash, policy_hash, review_period,
      review_deadline, permission_hash, dispute_hash, has_attestor, attestor_pubkey);
    return ();
  }
  if (op == op::timeout) {
    throw_unless(110, (status == status::open) | (status == status::accepted) |
      (status == status::result_submitted));
    if (status == status::result_submitted) {
      throw_unless(109, review_deadline <= now());
    } else {
      throw_unless(109, deadline <= now());
    }
    in_msg.end_parse();
    send_value(creator, 0, 128);
    save_state(creator, agent, has_agent, verifier, has_verifier, 0, deadline,
      status::expired, result_hash, evidence_hash, policy_hash, review_period,
      review_deadline, permission_hash, dispute_hash, has_attestor, attestor_pubkey);
    return ();
  }
  if (op == op::dispute) {
    throw_unless(119, status == status::result_submitted);
    throw_unless(120, equal_slice_bits(sender, creator));
    throw_unless(121, has_verifier);
    throw_unless(122, now() <= review_deadline);
    dispute_hash = in_msg~load_uint(256);
    in_msg.end_parse();
    save_state(creator, agent, has_agent, verifier, has_verifier, budget, deadline,
      status::disputed, result_hash, evidence_hash, policy_hash, review_period,
      review_deadline, permission_hash, dispute_hash, has_attestor, attestor_pubkey);
    return ();
  }
  if (op == op::resolve) {
    throw_unless(123, status == status::disputed);
    throw_unless(124, has_verifier & equal_slice_bits(sender, verifier));
    var payout = in_msg~load_tomis();
    in_msg.end_parse();
    throw_unless(125, payout <= budget);
    throw_unless(126, payout <= get_balance().pair_first());
    if (payout > 0) {
      send_value(agent, payout, 1);
    }
    send_value(creator, 0, 128);
    save_state(creator, agent, has_agent, verifier, has_verifier, 0, deadline,
      status::settled, result_hash, evidence_hash, policy_hash, review_period,
      review_deadline, permission_hash, dispute_hash, has_attestor, attestor_pubkey);
    return ();
  }
  if (op == op::rotate_attestor_key) {
    ;; Creator-only: set or replace the attestor_pubkey settle checks against.
    ;; Purely local state -- no cross-contract messaging.
    throw_unless(128, equal_slice_bits(sender, creator));
    attestor_pubkey = in_msg~load_uint(256);
    in_msg.end_parse();
    has_attestor = 1;
    save_state(creator, agent, has_agent, verifier, has_verifier, budget, deadline,
      status, result_hash, evidence_hash, policy_hash, review_period,
      review_deadline, permission_hash, dispute_hash, has_attestor, attestor_pubkey);
    return ();
  }
  if (op == op::revoke_attestor) {
    ;; Creator-only: permanently (until rotated again) drop the attestation
    ;; requirement -- settle reverts to sender-authorization-only.
    throw_unless(129, equal_slice_bits(sender, creator));
    in_msg.end_parse();
    has_attestor = 0;
    save_state(creator, agent, has_agent, verifier, has_verifier, budget, deadline,
      status, result_hash, evidence_hash, policy_hash, review_period,
      review_deadline, permission_hash, dispute_hash, has_attestor, attestor_pubkey);
    return ();
  }
  throw(111);
}

(slice, slice, int, slice, int, int, int, int, int, int, int, int, int, int, int, int, int)
get_task_data() method_id {
  var ds = get_data().begin_parse();
  var creator = ds~load_msg_addr();
  var has_agent = ds~load_uint(1);
  var agent = ds~load_msg_addr();
  var has_verifier = ds~load_uint(1);
  var verifier = ds~load_msg_addr();
  var budget = ds~load_tomis();
  var deadline = ds~load_uint(64);
  var status = ds~load_uint(8);
  var hashes = ds~load_ref().begin_parse();
  var result_hash = hashes~load_uint(256);
  var evidence_hash = hashes~load_uint(256);
  var policy_hash = hashes~load_uint(256);
  var review_period = hashes~load_uint(32);
  var review_deadline = hashes~load_uint(64);
  var permission_slice = hashes~load_ref().begin_parse();
  var permission_hash = permission_slice~load_uint(256);
  var dispute_hash = permission_slice~load_uint(256);
  var attestor_slice = hashes~load_ref().begin_parse();
  var has_attestor = attestor_slice~load_uint(1);
  var attestor_pubkey = attestor_slice~load_uint(256);
  return (creator, agent, has_agent, verifier, has_verifier, budget, deadline, status,
    result_hash, evidence_hash, policy_hash, permission_hash, review_period, review_deadline,
    dispute_hash, has_attestor, attestor_pubkey);
}
