;; AIPoW epoch reward distributor (dry-run / zero-emission slice).
;;
;; One instance per finalized epoch score root. The operator deploys it
;; carrying the root, the epoch total score (the pro-rata denominator), the
;; epoch pool amount, and a reference to the finalized score-commitment
;; instance the root came from (for off-chain cross-checking). A beneficiary
;; then claims permissionlessly by presenting its own (identity, score) and
;; a merkle inclusion proof against the root; the contract recomputes the
;; root exactly as the AIPoW methodology defines (sha256 leaf/node hashing),
;; and on a match records a pro-rata amount for that identity, once.
;;
;; Each recorded claim matures over time per the methodology: an immediate
;; fraction plus a linear stream over a fixed number of epochs from the
;; claim time. The operator may forfeit a claim (registry-bond fraud
;; slashing); a forfeited claim's maturation freezes at the forfeit time,
;; so the unmatured remainder is permanently voided while what had already
;; matured is preserved.
;;
;; This slice is deliberately zero-emission: it records claims and their
;; maturation but neither holds nor moves reward funds. Reward creation is
;; the separate native minting path (phase C), which will read the matured
;; amount this contract computes. Maturation parameters are v0 draft
;; constants here; phase C moves them to configuration governance.
;;
;; Persistent data layout:
;;   operator:MsgAddress
;;   epoch:uint64
;;   total_score:uint128       (pro-rata denominator; must be > 0)
;;   pool:Coins                (nominal epoch pool this slice does not move)
;;   claimed_count:uint32
;;   claimed_score:uint128     (running sum of claimed scores; bounds the
;;                              aggregate recorded amount to <= pool even if
;;                              total_score is understated)
;;   ^[score_root:uint256 commitment_ref:uint256]
;;   ^claims  (udict: identity uint256 ->
;;             amount:Coins claimed_at:uint64 forfeited:uint1 forfeit_at:uint64)
;;
;; Internal messages:
;;   claim#41504401 query_id:uint64 identity:uint256 score:uint128
;;                  proof:^ProofChain = InternalMsgBody;
;;   forfeit#41504402 query_id:uint64 identity:uint256 = InternalMsgBody;
;;
;; ProofChain cell (canonical): a node is exactly sibling:uint256
;;   sibling_is_left:uint1 (257 data bits) with an optional single reference to
;;   the next node; the chain terminates either at a node with no reference or
;;   at an empty cell (the single-member tree, leaf == root). Any other cell
;;   shape is rejected as malformed.

const int op::claim = 0x41504401;
const int op::forfeit = 0x41504402;

const int err::invalid_total_score = 2200;
const int err::already_claimed = 2201;
const int err::bad_proof = 2202;
const int err::proof_too_deep = 2203;
const int err::unknown_op = 2204;
const int err::not_operator = 2205;
const int err::not_claimed = 2206;
const int err::already_forfeited = 2207;
const int err::score_exceeds_total = 2208;
const int err::zero_score = 2209;
const int err::insufficient_value = 2210;
const int err::malformed_proof = 2211;

;; Maturation (methodology v0 draft): 25% immediate, the remaining 75%
;; streamed linearly over 8 epochs of 65,536 seconds each from claim time.
const int mat::immediate_bps = 2500;
const int mat::stream_epochs = 8;
const int mat::epoch_seconds = 65536;

;; Bounds the proof walk: 2^60 members is far beyond any real epoch and
;; keeps gas bounded against a hostile deep proof chain.
const int max_proof_depth = 60;

;; A claim must carry at least this much value so a permissionless claim funds
;; its own gas and a share of the dict's ongoing storage rent rather than
;; draining the contract. v0 draft constant; phase C moves it to governance.
const int min_claim_value = 50000000;  ;; 0.05 TOS

int leaf_hash(int identity, int score) inline {
  return string_hash(begin_cell()
    .store_uint(0, 8)
    .store_uint(identity, 256)
    .store_uint(score, 128)
  .end_cell().begin_parse());
}

int node_hash(int left, int right) inline {
  return string_hash(begin_cell()
    .store_uint(1, 8)
    .store_uint(left, 256)
    .store_uint(right, 256)
  .end_cell().begin_parse());
}

;; Matured amount of a claim at `at_time`. A forfeited claim's maturation
;; freezes at forfeit_at.
int compute_matured(int amount, int claimed_at, int forfeited, int forfeit_at, int at_time) inline {
  int eff = at_time;
  if (forfeited) {
    if (forfeit_at < eff) { eff = forfeit_at; }
  }
  int immediate = muldiv(amount, mat::immediate_bps, 10000);
  if (eff <= claimed_at) {
    return immediate;
  }
  int elapsed = (eff - claimed_at) / mat::epoch_seconds;
  if (elapsed > mat::stream_epochs) { elapsed = mat::stream_epochs; }
  int streamed = muldiv(amount - immediate, elapsed, mat::stream_epochs);
  return immediate + streamed;
}

(slice, int, int, int, int, int, int, int, cell) load_state() inline {
  slice ds = get_data().begin_parse();
  slice op_addr = ds~load_msg_addr();
  int epoch = ds~load_uint(64);
  int total_score = ds~load_uint(128);
  int pool = ds~load_tomis();
  int claimed_count = ds~load_uint(32);
  int claimed_score = ds~load_uint(128);
  slice roots = ds~load_ref().begin_parse();
  int score_root = roots~load_uint(256);
  int commitment_ref = roots~load_uint(256);
  roots.end_parse();
  cell claims = ds~load_dict();
  ds.end_parse();
  return (op_addr, epoch, total_score, pool, claimed_count, claimed_score,
    score_root, commitment_ref, claims);
}

() save_state(slice op_addr, int epoch, int total_score, int pool, int claimed_count,
             int claimed_score, int score_root, int commitment_ref, cell claims) impure inline {
  set_data(begin_cell()
    .store_slice(op_addr)
    .store_uint(epoch, 64)
    .store_uint(total_score, 128)
    .store_tomis(pool)
    .store_uint(claimed_count, 32)
    .store_uint(claimed_score, 128)
    .store_ref(begin_cell()
      .store_uint(score_root, 256)
      .store_uint(commitment_ref, 256)
    .end_cell())
    .store_dict(claims)
  .end_cell());
}

;; Recompute the root from a leaf and a canonical proof chain. Each node is
;; exactly a 256-bit sibling plus a 1-bit side flag with an optional single
;; next reference; the chain ends at a node with no reference or at an empty
;; cell. Any other shape (short/overlong data, extra references, dangling bits
;; on the terminator) is rejected as malformed, so a proof has one canonical
;; encoding. Bounded by max_proof_depth to keep gas finite.
int fold_proof(int leaf, cell proof) inline_ref {
  int current = leaf;
  cell cur_cell = proof;
  int depth = 0;
  int done = 0;
  while (done == 0) {
    slice ps = cur_cell.begin_parse();
    int bits = ps.slice_bits();
    int refs = ps.slice_refs();
    if (bits == 0) {
      ;; Canonical terminator: an empty cell with no dangling references.
      throw_unless(err::malformed_proof, refs == 0);
      done = 1;
    } else {
      ;; A proof node is exactly a 256-bit sibling and a 1-bit side flag.
      throw_unless(err::malformed_proof, (bits == 257) & (refs <= 1));
      throw_if(err::proof_too_deep, depth >= max_proof_depth);
      int sibling = ps~load_uint(256);
      int is_left = ps~load_uint(1);
      if (is_left) {
        current = node_hash(sibling, current);
      } else {
        current = node_hash(current, sibling);
      }
      if (refs == 1) {
        cur_cell = ps~load_ref();
        depth += 1;
      } else {
        done = 1;
      }
    }
  }
  return current;
}

() recv_internal(int msg_value, cell in_msg_full, slice in_msg) impure {
  var full_msg = in_msg_full.begin_parse();
  int flags = full_msg~load_uint(4);
  if (flags & 1) { return (); }  ;; ignore bounced messages
  slice sender = full_msg~load_msg_addr();
  if (in_msg.slice_empty?()) { return (); }
  int op = in_msg~load_uint(32);
  int query_id = in_msg~load_uint(64);
  query_id~impure_touch();

  (slice op_addr, int epoch, int total_score, int pool, int claimed_count,
   int claimed_score, int score_root, int commitment_ref, cell claims) = load_state();

  if (op == op::claim) {
    ;; A permissionless claim must fund its own gas and storage rent so it
    ;; cannot drain the contract on behalf of the whole cohort.
    throw_unless(err::insufficient_value, msg_value >= min_claim_value);
    throw_unless(err::invalid_total_score, total_score > 0);
    int identity = in_msg~load_uint(256);
    int score = in_msg~load_uint(128);
    cell proof = in_msg~load_ref();
    in_msg.end_parse();
    ;; A zero score earns nothing and would only pollute the dict.
    throw_unless(err::zero_score, score > 0);
    ;; Defence in depth against an understated denominator: the running sum of
    ;; claimed scores may never exceed total_score, so the aggregate recorded
    ;; amount stays <= pool even if total_score is smaller than the true sum of
    ;; the committed leaves. (The authoritative fix binds total_score into the
    ;; finalized commitment; phase C verifies that before minting.)
    throw_unless(err::score_exceeds_total, claimed_score + score <= total_score);

    ;; Permissionless and idempotent: an identity may claim once. A repeat
    ;; is rejected rather than silently overwriting the recorded amount.
    (slice existing, int found) = claims.udict_get?(256, identity);
    existing~impure_touch();
    throw_if(err::already_claimed, found);

    int computed_root = fold_proof(leaf_hash(identity, score), proof);
    throw_unless(err::bad_proof, computed_root == score_root);

    ;; Deterministic pro-rata share of the nominal pool. Floor division
    ;; matches the methodology's integer allocation; the dust from flooring
    ;; is simply never allocated. Maturation is measured from now().
    int amount = muldiv(pool, score, total_score);
    claims~udict_set_builder(256, identity, begin_cell()
      .store_tomis(amount)
      .store_uint(now(), 64)
      .store_uint(0, 1)
      .store_uint(0, 64));
    claimed_count += 1;
    claimed_score += score;
    save_state(op_addr, epoch, total_score, pool, claimed_count, claimed_score,
      score_root, commitment_ref, claims);
    return ();
  }

  if (op == op::forfeit) {
    ;; Operator-only: void the unmatured remainder of a claim (registry-bond
    ;; fraud slashing). Maturation freezes at forfeit time; a claim may be
    ;; forfeited once.
    throw_unless(err::not_operator, equal_slice_bits(sender, op_addr));
    int identity = in_msg~load_uint(256);
    in_msg.end_parse();
    (slice entry, int found) = claims.udict_get?(256, identity);
    throw_unless(err::not_claimed, found);
    int amount = entry~load_tomis();
    int claimed_at = entry~load_uint(64);
    int forfeited = entry~load_uint(1);
    throw_if(err::already_forfeited, forfeited);
    claims~udict_set_builder(256, identity, begin_cell()
      .store_tomis(amount)
      .store_uint(claimed_at, 64)
      .store_uint(1, 1)
      .store_uint(now(), 64));
    save_state(op_addr, epoch, total_score, pool, claimed_count, claimed_score,
      score_root, commitment_ref, claims);
    return ();
  }

  throw(err::unknown_op);
}

(slice, int, int, int, int, int, int, int) get_aipow_distributor_data() method_id {
  (slice op_addr, int epoch, int total_score, int pool, int claimed_count,
   int claimed_score, int score_root, int commitment_ref, cell claims) = load_state();
  claims~impure_touch();
  return (op_addr, epoch, total_score, pool, claimed_count, claimed_score,
    score_root, commitment_ref);
}

;; (found, amount, claimed_at, forfeited, forfeit_at) for `identity`.
(int, int, int, int, int) get_claim(int identity) method_id {
  (_, _, _, _, _, _, _, _, cell claims) = load_state();
  (slice entry, int found) = claims.udict_get?(256, identity);
  if (found == 0) {
    return (0, 0, 0, 0, 0);
  }
  int amount = entry~load_tomis();
  int claimed_at = entry~load_uint(64);
  int forfeited = entry~load_uint(1);
  int forfeit_at = entry~load_uint(64);
  return (1, amount, claimed_at, forfeited, forfeit_at);
}

;; (found, matured) for `identity` at a caller-supplied `at_time`. This is for
;; off-chain simulation/inspection of the maturation curve; a value-bearing
;; consumer (the phase C native path) must use `get_matured_now`, never a
;; caller-controlled time.
(int, int) get_matured(int identity, int at_time) method_id {
  (_, _, _, _, _, _, _, _, cell claims) = load_state();
  (slice entry, int found) = claims.udict_get?(256, identity);
  if (found == 0) {
    return (0, 0);
  }
  int amount = entry~load_tomis();
  int claimed_at = entry~load_uint(64);
  int forfeited = entry~load_uint(1);
  int forfeit_at = entry~load_uint(64);
  return (1, compute_matured(amount, claimed_at, forfeited, forfeit_at, at_time));
}

;; (found, matured) for `identity` at chain time. This is the canonical getter
;; the native minting path reads: the maturation time is `now()` and cannot be
;; influenced by the caller.
(int, int) get_matured_now(int identity) method_id {
  (_, _, _, _, _, _, _, _, cell claims) = load_state();
  (slice entry, int found) = claims.udict_get?(256, identity);
  if (found == 0) {
    return (0, 0);
  }
  int amount = entry~load_tomis();
  int claimed_at = entry~load_uint(64);
  int forfeited = entry~load_uint(1);
  int forfeit_at = entry~load_uint(64);
  return (1, compute_matured(amount, claimed_at, forfeited, forfeit_at, now()));
}
