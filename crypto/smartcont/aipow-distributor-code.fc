;; Copyright (C) 2025-2026  TOS Network.
;; AIPoW epoch reward distributor (Phase C, W4.3: custody + payout).
;;
;; One instance per finalized epoch score root. The settlement account (or an
;; operator, while dark) deploys it carrying the root, the epoch total score
;; (the pro-rata denominator), the epoch pool amount, a reference to the
;; finalized score-commitment instance the root came from (for off-chain
;; cross-checking), the workchain the scored identities live on, and a snapshot
;; of the maturation parameters frozen at deploy. The settlement then forwards
;; the epoch pool (native issuance) to this instance, which holds it and pays
;; matured reward out to each beneficiary's own committed identity address.
;;
;; A beneficiary (or anyone on its behalf, permissionlessly) claims by
;; presenting the identity's (identity, score) and a merkle inclusion proof
;; against the root; the contract recomputes the root exactly as the AIPoW
;; methodology defines (sha256 leaf/node hashing), and on a match records a
;; pro-rata amount for that identity, once, and immediately pays the matured
;; (immediate) tranche to `addr_std(earner_workchain, identity)` -- the
;; committed identity itself, never the caller. The remaining stream is paid by
;; subsequent permissionless `payout` pokes as it matures.
;;
;; Each recorded claim matures over time per the snapshot: an immediate
;; fraction plus a linear stream over a fixed number of epochs from the claim
;; time. The operator may forfeit a claim (registry-bond fraud slashing); a
;; forfeited claim's maturation freezes at the forfeit time, so the unmatured
;; remainder is permanently voided (its funds stay in this instance) while what
;; had already matured is preserved and remains payable.
;;
;; Custody model: this instance holds the epoch pool as its balance and sends
;; exactly the matured delta to the identity on each payout (send mode 1, fees
;; from balance), so the identity receives exactly its matured amount. The
;; deployer/settlement funds it with the pool plus a small gas/fee reserve.
;;
;; Persistent data layout:
;;   version:uint16            (layout tag)
;;   operator:MsgAddress
;;   epoch:uint64
;;   earner_workchain:int8     (workchain the scored identities are paid on)
;;   total_score:uint128       (pro-rata denominator; must be > 0)
;;   pool:Coins                (nominal epoch pool; the pro-rata numerator base)
;;   claimed_count:uint32
;;   claimed_score:uint128     (running sum of claimed scores; bounds the
;;                              aggregate recorded amount to <= pool even if
;;                              total_score is understated)
;;   immediate_bps:uint16      (maturation snapshot, frozen at deploy)
;;   stream_epochs:uint16
;;   mat_epoch_seconds:uint32
;;   ^[score_root:uint256 commitment_ref:uint256]
;;   ^claims  (udict: identity uint256 ->
;;             amount:Coins claimed_at:uint64 forfeited:uint1 forfeit_at:uint64
;;             paid:Coins)
;;
;; Internal messages:
;;   claim#41504401 query_id:uint64 identity:uint256 score:uint128
;;                  proof:^ProofChain = InternalMsgBody;
;;   payout#41504403 query_id:uint64 identity:uint256 = InternalMsgBody;
;;   forfeit#41504402 query_id:uint64 identity:uint256 = InternalMsgBody;
;;
;; ProofChain cell (canonical): a node is exactly sibling:uint256
;;   sibling_is_left:uint1 (257 data bits) with an optional single reference to
;;   the next node; the chain terminates either at a node with no reference or
;;   at an empty cell (the single-member tree, leaf == root). Any other cell
;;   shape is rejected as malformed.

const int op::claim = 0x41504401;
const int op::forfeit = 0x41504402;
const int op::payout = 0x41504403;

const int err::invalid_total_score = 2200;
const int err::already_claimed = 2201;
const int err::bad_proof = 2202;
const int err::proof_too_deep = 2203;
const int err::unknown_op = 2204;
const int err::not_operator = 2205;
const int err::not_claimed = 2206;
const int err::already_forfeited = 2207;
const int err::score_exceeds_total = 2208;
const int err::zero_score = 2209;
const int err::insufficient_value = 2210;
const int err::malformed_proof = 2211;
const int err::nothing_to_pay = 2212;
const int err::not_activated = 2213;

;; The distributor layout version this code understands.
const int distributor_version = 1;

;; Bounds the proof walk: 2^60 members is far beyond any real epoch and
;; keeps gas bounded against a hostile deep proof chain.
const int max_proof_depth = 60;

;; Minimum value a `claim`/`payout` must carry. This floor is NOT a gas check -- TOS
;; already charges an underfunded message's compute from its own value. It exists because
;; a `claim` GROWS STATE: it inserts a per-identity record into the claims dict, which
;; this instance carries (and pays storage rent on) for the life of the distributor. The
;; floor makes each claimant pay for the permanent storage its own claim creates, so no
;; single claimant can grow the dict on the whole cohort's dime and drain the instance's
;; rent reserve. (`payout` only mutates an existing record, but shares the floor for
;; simplicity.) v0 draft constant; phase C moves it to governance.
const int min_claim_value = 50000000;  ;; 0.05 TOS

;; Storage rent this instance keeps back before each payout so it can NEVER freeze. A
;; frozen distributor is dead: the pool it still holds and every not-yet-matured claim
;; would be permanently stranded. The reserve is PRICED from the live storage config via
;; the TVM storage-fee primitive (not a magic constant) for the instance's earner
;; workchain, so it tracks config changes and the workchain it actually pays rent on.
;; STORAGE_RESERVE_SECONDS is a bounded, governance-tunable runway; STORAGE_RESERVE_FLOOR
;; backstops it (covers a zero/low-price config). The reserve is max(priced, floor), taken
;; (mode 2, "at most", never fails) before each payout, so a pay that would breach it
;; reverts instead of bricking the instance. The pool is far larger than the reserve, so
;; real payouts are unaffected; the claims dict growth is funded separately by
;; min_claim_value, so the bits/cells here cover code + base data only.
const int STORAGE_RESERVE_SECONDS = 604800;      ;; 7-day runway (governance-tunable)
const int STORAGE_RESERVE_BITS = 16000;
const int STORAGE_RESERVE_CELLS = 32;
const int STORAGE_RESERVE_FLOOR = 50000000;      ;; 0.05 TOS backstop

;; The TOS to keep back so this instance can pay its own storage rent on `workchain` (its
;; earner workchain) for STORAGE_RESERVE_SECONDS. Priced from the live config; floored.
int storage_reserve(int workchain) inline {
  int fee = get_storage_fee(workchain, STORAGE_RESERVE_SECONDS, STORAGE_RESERVE_BITS, STORAGE_RESERVE_CELLS);
  return (fee > STORAGE_RESERVE_FLOOR) ? fee : STORAGE_RESERVE_FLOOR;
}

int leaf_hash(int identity, int score) inline {
  return string_hash(begin_cell()
    .store_uint(0, 8)
    .store_uint(identity, 256)
    .store_uint(score, 128)
  .end_cell().begin_parse());
}

int node_hash(int left, int right) inline {
  return string_hash(begin_cell()
    .store_uint(1, 8)
    .store_uint(left, 256)
    .store_uint(right, 256)
  .end_cell().begin_parse());
}

;; Matured amount of a claim at `at_time`, per the deploy-snapshot maturation
;; parameters. A forfeited claim's maturation freezes at forfeit_at.
int compute_matured(int amount, int claimed_at, int forfeited, int forfeit_at, int at_time,
                    int immediate_bps, int stream_epochs, int mat_epoch_seconds) inline {
  int eff = at_time;
  if (forfeited) {
    if (forfeit_at < eff) { eff = forfeit_at; }
  }
  int immediate = muldiv(amount, immediate_bps, 10000);
  if (eff <= claimed_at) {
    return immediate;
  }
  int elapsed = (eff - claimed_at) / mat_epoch_seconds;
  if (elapsed > stream_epochs) { elapsed = stream_epochs; }
  int streamed = muldiv(amount - immediate, elapsed, stream_epochs);
  return immediate + streamed;
}

;; Pay `amount` to the committed identity on its workchain. mode 1: send exactly
;; `amount`, fees from the contract balance, non-bounceable (a reward to an
;; as-yet-uninitialized wallet must not bounce back). A non-positive amount is a
;; no-op.
() pay_identity(int workchain, int identity, int amount) impure inline {
  if (amount <= 0) { return (); }
  slice dest = begin_cell()
    .store_uint(4, 3)              ;; addr_std$10, anycast:nothing
    .store_int(workchain, 8)
    .store_uint(identity, 256)
  .end_cell().begin_parse();
  send_raw_message(begin_cell()
    .store_uint(0x10, 6)           ;; non-bounceable internal message
    .store_slice(dest)
    .store_tomis(amount)
    .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
  .end_cell(), 1);
}

(int, slice, int, int, int, int, int, int, int, int, int, int, int, int, cell) load_state() inline {
  slice ds = get_data().begin_parse();
  int version = ds~load_uint(16);
  slice op_addr = ds~load_msg_addr();
  int epoch = ds~load_uint(64);
  int earner_workchain = ds~load_int(8);
  int total_score = ds~load_uint(128);
  int pool = ds~load_tomis();
  int claimed_count = ds~load_uint(32);
  int claimed_score = ds~load_uint(128);
  int immediate_bps = ds~load_uint(16);
  int stream_epochs = ds~load_uint(16);
  int mat_epoch_seconds = ds~load_uint(32);
  ;; The wall-clock time the operator (settlement) funded this instance, 0 until
  ;; then. Every maturation clock is anchored at or after this, and claims are
  ;; refused before it, so a permissionless pre-deploy cannot start vesting early.
  int activated_at = ds~load_uint(64);
  slice roots = ds~load_ref().begin_parse();
  int score_root = roots~load_uint(256);
  int commitment_ref = roots~load_uint(256);
  roots.end_parse();
  cell claims = ds~load_dict();
  ds.end_parse();
  return (version, op_addr, epoch, earner_workchain, total_score, pool, claimed_count,
    claimed_score, immediate_bps, stream_epochs, mat_epoch_seconds, activated_at, score_root,
    commitment_ref, claims);
}

() save_state(int version, slice op_addr, int epoch, int earner_workchain, int total_score,
             int pool, int claimed_count, int claimed_score, int immediate_bps, int stream_epochs,
             int mat_epoch_seconds, int activated_at, int score_root, int commitment_ref,
             cell claims) impure inline {
  set_data(begin_cell()
    .store_uint(version, 16)
    .store_slice(op_addr)
    .store_uint(epoch, 64)
    .store_int(earner_workchain, 8)
    .store_uint(total_score, 128)
    .store_tomis(pool)
    .store_uint(claimed_count, 32)
    .store_uint(claimed_score, 128)
    .store_uint(immediate_bps, 16)
    .store_uint(stream_epochs, 16)
    .store_uint(mat_epoch_seconds, 32)
    .store_uint(activated_at, 64)
    .store_ref(begin_cell()
      .store_uint(score_root, 256)
      .store_uint(commitment_ref, 256)
    .end_cell())
    .store_dict(claims)
  .end_cell());
}

;; Pack a claim record. `paid` is the cumulative amount already sent to the
;; identity, so a payout only ever sends newly-matured value.
builder pack_claim(int amount, int claimed_at, int forfeited, int forfeit_at, int paid) inline {
  return begin_cell()
    .store_tomis(amount)
    .store_uint(claimed_at, 64)
    .store_uint(forfeited, 1)
    .store_uint(forfeit_at, 64)
    .store_tomis(paid);
}

(int, int, int, int, int) unpack_claim(slice entry) inline {
  int amount = entry~load_tomis();
  int claimed_at = entry~load_uint(64);
  int forfeited = entry~load_uint(1);
  int forfeit_at = entry~load_uint(64);
  int paid = entry~load_tomis();
  return (amount, claimed_at, forfeited, forfeit_at, paid);
}

;; Recompute the root from a leaf and a canonical proof chain. Each node is
;; exactly a 256-bit sibling plus a 1-bit side flag with an optional single
;; next reference; the chain ends at a node with no reference or at an empty
;; cell. Any other shape (short/overlong data, extra references, dangling bits
;; on the terminator) is rejected as malformed, so a proof has one canonical
;; encoding. Bounded by max_proof_depth to keep gas finite.
int fold_proof(int leaf, cell proof) inline_ref {
  int current = leaf;
  cell cur_cell = proof;
  int depth = 0;
  int done = 0;
  while (done == 0) {
    slice ps = cur_cell.begin_parse();
    int bits = ps.slice_bits();
    int refs = ps.slice_refs();
    if (bits == 0) {
      ;; Canonical terminator: an empty cell with no dangling references.
      throw_unless(err::malformed_proof, refs == 0);
      done = 1;
    } else {
      ;; A proof node is exactly a 256-bit sibling and a 1-bit side flag.
      throw_unless(err::malformed_proof, (bits == 257) & (refs <= 1));
      throw_if(err::proof_too_deep, depth >= max_proof_depth);
      int sibling = ps~load_uint(256);
      int is_left = ps~load_uint(1);
      if (is_left) {
        current = node_hash(sibling, current);
      } else {
        current = node_hash(current, sibling);
      }
      if (refs == 1) {
        cur_cell = ps~load_ref();
        depth += 1;
      } else {
        done = 1;
      }
    }
  }
  return current;
}

() recv_internal(int msg_value, cell in_msg_full, slice in_msg) impure {
  var full_msg = in_msg_full.begin_parse();
  int flags = full_msg~load_uint(4);
  if (flags & 1) { return (); }  ;; ignore bounced messages
  slice sender = full_msg~load_msg_addr();
  if (in_msg.slice_empty?()) {
    ;; Empty body: a plain value transfer. The settlement's pool-forwarding message
    ;; comes from the operator and ACTIVATES this instance -- it stamps the funding
    ;; time that anchors every maturation clock and unlocks claims. Activation is
    ;; once (the first operator funding); later operator top-ups and any empty
    ;; message from anyone else (a pre-deploy, a stray transfer) are no-ops. Without
    ;; this, an earner could pre-deploy this instance at its deterministic address
    ;; and claim before issuance, starting its own vesting clock early and maturing
    ;; out of the operator's forfeiture window before the pool is even minted.
    (int version, slice op_addr, int epoch, int earner_workchain, int total_score, int pool,
     int claimed_count, int claimed_score, int immediate_bps, int stream_epochs,
     int mat_epoch_seconds, int activated_at, int score_root, int commitment_ref,
     cell claims) = load_state();
    if (equal_slice_bits(sender, op_addr) & (activated_at == 0)) {
      save_state(version, op_addr, epoch, earner_workchain, total_score, pool, claimed_count,
        claimed_score, immediate_bps, stream_epochs, mat_epoch_seconds, now(), score_root,
        commitment_ref, claims);
    }
    return ();
  }
  int op = in_msg~load_uint(32);
  int query_id = in_msg~load_uint(64);
  query_id~impure_touch();

  (int version, slice op_addr, int epoch, int earner_workchain, int total_score, int pool,
   int claimed_count, int claimed_score, int immediate_bps, int stream_epochs,
   int mat_epoch_seconds, int activated_at, int score_root, int commitment_ref,
   cell claims) = load_state();

  if (op == op::claim) {
    ;; No claim before the operator has funded the pool: else a pre-deployed instance
    ;; could record a claim (and start its maturation clock) ahead of issuance.
    throw_unless(err::not_activated, activated_at > 0);
    ;; A permissionless claim must fund its own gas and storage rent so it
    ;; cannot drain the contract on behalf of the whole cohort.
    throw_unless(err::insufficient_value, msg_value >= min_claim_value);
    throw_unless(err::invalid_total_score, total_score > 0);
    int identity = in_msg~load_uint(256);
    int score = in_msg~load_uint(128);
    cell proof = in_msg~load_ref();
    in_msg.end_parse();
    ;; A zero score earns nothing and would only pollute the dict.
    throw_unless(err::zero_score, score > 0);
    ;; Defence in depth against an understated denominator: the running sum of
    ;; claimed scores may never exceed total_score, so the aggregate recorded
    ;; amount stays <= pool even if total_score is smaller than the true sum of
    ;; the committed leaves. (The authoritative fix binds total_score into the
    ;; finalized commitment; phase C verifies that before minting.)
    throw_unless(err::score_exceeds_total, claimed_score + score <= total_score);

    ;; Permissionless and idempotent: an identity may claim once. A repeat
    ;; is rejected rather than silently overwriting the recorded amount.
    (slice existing, int found) = claims.udict_get?(256, identity);
    existing~impure_touch();
    throw_if(err::already_claimed, found);

    int computed_root = fold_proof(leaf_hash(identity, score), proof);
    throw_unless(err::bad_proof, computed_root == score_root);

    ;; Deterministic pro-rata share of the nominal pool. Floor division
    ;; matches the methodology's integer allocation; the dust from flooring
    ;; is simply never allocated. Maturation is measured from now().
    int amount = muldiv(pool, score, total_score);
    ;; The immediate tranche is matured at claim time; pay it to the identity
    ;; now and record it as paid so the stream never double-pays.
    int matured = compute_matured(amount, now(), 0, 0, now(),
      immediate_bps, stream_epochs, mat_epoch_seconds);
    claims~udict_set_builder(256, identity,
      pack_claim(amount, now(), 0, 0, matured));
    claimed_count += 1;
    claimed_score += score;
    save_state(version, op_addr, epoch, earner_workchain, total_score, pool, claimed_count,
      claimed_score, immediate_bps, stream_epochs, mat_epoch_seconds, activated_at, score_root,
      commitment_ref, claims);
    raw_reserve(storage_reserve(earner_workchain), 2);  ;; never spend the storage floor paying a claim
    pay_identity(earner_workchain, identity, matured);
    return ();
  }

  if (op == op::payout) {
    ;; Permissionless: pay the newly-matured delta of an already-claimed
    ;; identity to that identity's address. Must fund its own gas. A claim can only
    ;; exist after activation, so this is implicitly post-activation; assert it too.
    throw_unless(err::not_activated, activated_at > 0);
    throw_unless(err::insufficient_value, msg_value >= min_claim_value);
    int identity = in_msg~load_uint(256);
    in_msg.end_parse();
    (slice entry, int found) = claims.udict_get?(256, identity);
    throw_unless(err::not_claimed, found);
    (int amount, int claimed_at, int forfeited, int forfeit_at, int paid) = unpack_claim(entry);
    int matured = compute_matured(amount, claimed_at, forfeited, forfeit_at, now(),
      immediate_bps, stream_epochs, mat_epoch_seconds);
    int delta = matured - paid;
    throw_unless(err::nothing_to_pay, delta > 0);
    claims~udict_set_builder(256, identity,
      pack_claim(amount, claimed_at, forfeited, forfeit_at, paid + delta));
    save_state(version, op_addr, epoch, earner_workchain, total_score, pool, claimed_count,
      claimed_score, immediate_bps, stream_epochs, mat_epoch_seconds, activated_at, score_root,
      commitment_ref, claims);
    raw_reserve(storage_reserve(earner_workchain), 2);  ;; never spend the storage floor paying a stream delta
    pay_identity(earner_workchain, identity, delta);
    return ();
  }

  if (op == op::forfeit) {
    ;; Operator-only: void the unmatured remainder of a claim (registry-bond
    ;; fraud slashing). Maturation freezes at forfeit time; a claim may be
    ;; forfeited once. Already-paid value stays with the identity; the frozen
    ;; unmatured remainder is never sent.
    throw_unless(err::not_operator, equal_slice_bits(sender, op_addr));
    int identity = in_msg~load_uint(256);
    in_msg.end_parse();
    (slice entry, int found) = claims.udict_get?(256, identity);
    throw_unless(err::not_claimed, found);
    (int amount, int claimed_at, int forfeited, int forfeit_at, int paid) = unpack_claim(entry);
    throw_if(err::already_forfeited, forfeited);
    claims~udict_set_builder(256, identity,
      pack_claim(amount, claimed_at, 1, now(), paid));
    save_state(version, op_addr, epoch, earner_workchain, total_score, pool, claimed_count,
      claimed_score, immediate_bps, stream_epochs, mat_epoch_seconds, activated_at, score_root,
      commitment_ref, claims);
    return ();
  }

  throw(err::unknown_op);
}

(int, slice, int, int, int, int, int, int, int, int, int, int, int, int) get_aipow_distributor_data() method_id {
  (int version, slice op_addr, int epoch, int earner_workchain, int total_score, int pool,
   int claimed_count, int claimed_score, int immediate_bps, int stream_epochs,
   int mat_epoch_seconds, int activated_at, int score_root, int commitment_ref,
   cell claims) = load_state();
  claims~impure_touch();
  return (version, op_addr, epoch, earner_workchain, total_score, pool, claimed_count,
    claimed_score, immediate_bps, stream_epochs, mat_epoch_seconds, activated_at, score_root,
    commitment_ref);
}

;; (found, amount, claimed_at, forfeited, forfeit_at, paid) for `identity`.
(int, int, int, int, int, int) get_claim(int identity) method_id {
  (_, _, _, _, _, _, _, _, _, _, _, _, _, _, cell claims) = load_state();
  (slice entry, int found) = claims.udict_get?(256, identity);
  if (found == 0) {
    return (0, 0, 0, 0, 0, 0);
  }
  (int amount, int claimed_at, int forfeited, int forfeit_at, int paid) = unpack_claim(entry);
  return (1, amount, claimed_at, forfeited, forfeit_at, paid);
}

;; (found, matured) for `identity` at a caller-supplied `at_time`. This is for
;; off-chain simulation/inspection of the maturation curve; a value-bearing
;; consumer must use `get_matured_now`, never a caller-controlled time.
(int, int) get_matured(int identity, int at_time) method_id {
  (_, _, _, _, _, _, _, _, int immediate_bps, int stream_epochs, int mat_epoch_seconds,
   _, _, _, cell claims) = load_state();
  (slice entry, int found) = claims.udict_get?(256, identity);
  if (found == 0) {
    return (0, 0);
  }
  (int amount, int claimed_at, int forfeited, int forfeit_at, _) = unpack_claim(entry);
  return (1, compute_matured(amount, claimed_at, forfeited, forfeit_at, at_time,
    immediate_bps, stream_epochs, mat_epoch_seconds));
}

;; (found, matured) for `identity` at chain time. The maturation time is `now()`
;; and cannot be influenced by the caller.
(int, int) get_matured_now(int identity) method_id {
  (_, _, _, _, _, _, _, _, int immediate_bps, int stream_epochs, int mat_epoch_seconds,
   _, _, _, cell claims) = load_state();
  (slice entry, int found) = claims.udict_get?(256, identity);
  if (found == 0) {
    return (0, 0);
  }
  (int amount, int claimed_at, int forfeited, int forfeit_at, _) = unpack_claim(entry);
  return (1, compute_matured(amount, claimed_at, forfeited, forfeit_at, now(),
    immediate_bps, stream_epochs, mat_epoch_seconds));
}
