;; TOS Agent Account MVP.
;;
;; Persistent data layout:
;;   owner:MsgAddress
;;   controller_pubkey:uint256
;;   seqno:uint32
;;   spend_day:uint32
;;   spent_today:coins
;;   policy:^Cell
;;
;; Policy cell layout:
;;   max_per_tx:coins
;;   daily_limit:coins
;;   default_task_timeout:uint64
;;   metadata_hash:(Maybe uint256)
;;   service_endpoint_hash:(Maybe uint256)
;;
;; Internal owner-only messages:
;;   update_policy#41475001 query_id:uint64 max_per_tx:coins daily_limit:coins
;;                         default_task_timeout:uint64 metadata_hash:(Maybe uint256)
;;                         service_endpoint_hash:(Maybe uint256) = InternalMsgBody;
;;   rotate_controller#41475002 query_id:uint64 controller_pubkey:uint256 = InternalMsgBody;
;;   task_send#41475003 seqno:uint32 valid_until:uint32 target:MsgAddressInt
;;             value:coins body:^Cell = SignedExternalBody;

const int op::agent_update_policy = 0x41475001;      ;; "AGP\1"
const int op::agent_rotate_controller = 0x41475002;  ;; "AGP\2"
const int op::agent_task_send = 0x41475003;          ;; "AGP\3"

const int err::invalid_policy = 1701;
const int err::not_owner = 1702;
const int err::unknown_op = 1703;
const int err::bad_signature = 1704;
const int err::bad_seqno = 1705;
const int err::expired = 1706;
const int err::policy_exceeded = 1707;

(slice, int, int, int, int, int, int, int, int, int) load_agent_state() inline {
  slice ds = get_data().begin_parse();
  slice owner = ds~load_msg_addr();
  int controller_pubkey = ds~load_uint(256);
  int seqno = ds~load_uint(32);
  int spend_day = ds~load_uint(32);
  int spent_today = ds~load_coins();
  cell policy_cell = ds~load_ref();
  ds.end_parse();

  slice ps = policy_cell.begin_parse();
  int max_per_tx = ps~load_coins();
  int daily_limit = ps~load_coins();
  int default_task_timeout = ps~load_uint(64);

  int metadata_hash = -1;
  if (ps~load_uint(1)) {
    metadata_hash = ps~load_uint(256);
  }

  int service_endpoint_hash = -1;
  if (ps~load_uint(1)) {
    service_endpoint_hash = ps~load_uint(256);
  }
  ps.end_parse();

  return (
    owner,
    controller_pubkey,
    max_per_tx,
    daily_limit,
    default_task_timeout,
    metadata_hash,
    service_endpoint_hash,
    seqno,
    spend_day,
    spent_today
  );
}

cell pack_agent_state(
  slice owner,
  int controller_pubkey,
  int seqno,
  int spend_day,
  int spent_today,
  int max_per_tx,
  int daily_limit,
  int default_task_timeout,
  int metadata_hash,
  int service_endpoint_hash
) inline {
  throw_if(err::invalid_policy, max_per_tx < 0);
  throw_if(err::invalid_policy, daily_limit < max_per_tx);
  throw_if(err::invalid_policy, default_task_timeout <= 0);

  builder policy = begin_cell()
    .store_coins(max_per_tx)
    .store_coins(daily_limit)
    .store_uint(default_task_timeout, 64);

  if (metadata_hash < 0) {
    policy = policy.store_uint(0, 1);
  } else {
    policy = policy.store_uint(1, 1).store_uint(metadata_hash, 256);
  }

  if (service_endpoint_hash < 0) {
    policy = policy.store_uint(0, 1);
  } else {
    policy = policy.store_uint(1, 1).store_uint(service_endpoint_hash, 256);
  }

  return begin_cell()
    .store_slice(owner)
    .store_uint(controller_pubkey, 256)
    .store_uint(seqno, 32)
    .store_uint(spend_day, 32)
    .store_coins(spent_today)
    .store_ref(policy.end_cell())
    .end_cell();
}

() require_owner(slice sender, slice owner) impure inline {
  throw_unless(err::not_owner, equal_slice_bits(sender, owner));
}

;; Bug fix: this must be called as `in_msg_body~load_maybe_hash()`, not
;; `load_maybe_hash(in_msg_body)` -- FunC passes plain (non-`~`) call
;; arguments by value, so a version of this helper returning only `int`
;; would silently never advance the caller's slice, leaving unconsumed
;; bits that make a later `end_parse()` throw a cell-underflow exception
;; instead of the update actually taking effect.
(slice, int) load_maybe_hash(slice body) inline {
  if (body~load_uint(1)) {
    int hash = body~load_uint(256);
    return (body, hash);
  }
  return (body, -1);
}

() recv_internal(int msg_value, cell in_msg_full, slice in_msg_body) impure {
  msg_value~impure_touch();

  slice cs = in_msg_full.begin_parse();
  int flags = cs~load_uint(4);
  if (flags & 1) {
    return ();  ;; ignore bounced messages
  }
  slice sender = cs~load_msg_addr();

  if (in_msg_body.slice_empty?()) {
    return ();
  }

  (
    slice owner,
    int controller_pubkey,
    int max_per_tx,
    int daily_limit,
    int default_task_timeout,
    int metadata_hash,
    int service_endpoint_hash,
    int seqno,
    int spend_day,
    int spent_today
  ) = load_agent_state();

  int op = in_msg_body~load_uint(32);
  int query_id = in_msg_body~load_uint(64);
  query_id~impure_touch();

  if (op == op::agent_update_policy) {
    require_owner(sender, owner);
    int new_max_per_tx = in_msg_body~load_coins();
    int new_daily_limit = in_msg_body~load_coins();
    int new_default_task_timeout = in_msg_body~load_uint(64);
    int new_metadata_hash = in_msg_body~load_maybe_hash();
    int new_service_endpoint_hash = in_msg_body~load_maybe_hash();
    in_msg_body.end_parse();

    accept_message();
    set_data(pack_agent_state(
      owner,
      controller_pubkey,
      seqno,
      spend_day,
      spent_today,
      new_max_per_tx,
      new_daily_limit,
      new_default_task_timeout,
      new_metadata_hash,
      new_service_endpoint_hash
    ));
    return ();
  }

  if (op == op::agent_rotate_controller) {
    require_owner(sender, owner);
    int new_controller_pubkey = in_msg_body~load_uint(256);
    in_msg_body.end_parse();

    accept_message();
    set_data(pack_agent_state(
      owner,
      new_controller_pubkey,
      seqno,
      spend_day,
      spent_today,
      max_per_tx,
      daily_limit,
      default_task_timeout,
      metadata_hash,
      service_endpoint_hash
    ));
    return ();
  }

  throw(err::unknown_op);
}

() recv_external(slice in_msg) impure {
  slice signature = in_msg~load_bits(512);
  slice signed_body = in_msg;
  (
    slice owner,
    int controller_pubkey,
    int max_per_tx,
    int daily_limit,
    int default_task_timeout,
    int metadata_hash,
    int service_endpoint_hash,
    int seqno,
    int spend_day,
    int spent_today
  ) = load_agent_state();

  ;; Domain-bind the signed payload to this Agent Account's own address so
  ;; a signature cannot be replayed against a different Agent Account that
  ;; happens to share the same controller key (e.g. an operator reusing key
  ;; material across several agent identities) and a coincidentally-valid
  ;; seqno -- the bare slice_hash used previously had no such binding. Hash
  ;; the payload first, then domain-bind that hash: the same two-step
  ;; pattern (and the same `contracts::domain_bound_hash` helper) as Task
  ;; Escrow/Dispute/Service Actor's attestation signatures.
  int payload_hash = slice_hash(signed_body);
  (int wc, int addr) = my_address().parse_std_addr();
  int domain_hash = cell_hash(begin_cell()
    .store_int(wc, 8).store_uint(addr, 256).store_uint(payload_hash, 256).end_cell());
  throw_unless(err::bad_signature, check_signature(domain_hash, signature, controller_pubkey));

  int op = signed_body~load_uint(32);
  throw_unless(err::unknown_op, op == op::agent_task_send);
  int request_seqno = signed_body~load_uint(32);
  int valid_until = signed_body~load_uint(32);
  throw_unless(err::bad_seqno, request_seqno == seqno);
  throw_unless(err::expired, valid_until > now());
  slice target = signed_body~load_msg_addr();
  int value = signed_body~load_coins();
  cell body = signed_body~load_ref();
  signed_body.end_parse();
  throw_unless(err::policy_exceeded, value <= max_per_tx);
  int current_day = now() / 86400;
  if (current_day != spend_day) {
    spend_day = current_day;
    spent_today = 0;
  }
  throw_unless(err::policy_exceeded, spent_today + value <= daily_limit);

  accept_message();
  send_raw_message(begin_cell()
    .store_uint(0x10, 6)
    .store_slice(target)
    .store_tomis(value)
    .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1)
    .store_uint(1, 1)
    .store_ref(body)
  .end_cell(), 1);
  set_data(pack_agent_state(
    owner,
    controller_pubkey,
    seqno + 1,
    spend_day,
    spent_today + value,
    max_per_tx,
    daily_limit,
    default_task_timeout,
    metadata_hash,
    service_endpoint_hash
  ));
}

(slice, int, int, int, int, int, int, int, int, int) get_agent_account_data() method_id {
  return load_agent_state();
}

slice get_owner() method_id {
  var (owner, _, _, _, _, _, _, _, _, _) = load_agent_state();
  return owner;
}

int get_controller_pubkey() method_id {
  var (_, controller_pubkey, _, _, _, _, _, _, _, _) = load_agent_state();
  return controller_pubkey;
}

(int, int, int, int, int) get_agent_policy() method_id {
  var (_, _, max_per_tx, daily_limit, default_task_timeout, metadata_hash, service_endpoint_hash, _, _, _) =
    load_agent_state();
  return (max_per_tx, daily_limit, default_task_timeout, metadata_hash, service_endpoint_hash);
}
