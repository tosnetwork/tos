// PROPOSAL (R0a interface freeze candidate), not a deployed schema.
// Wallet V5R2 with a dual-root (ML-DSA-44 daily, SLH-DSA-SHA2-128s rescue) AUTH module and a
// per-wallet fee vault. Basechain only: every MsgAddressInt below must be addr_std, no anycast,
// workchain 0, and every contract refuses anything else. Trailing bits or references after any
// constructor are rejected. Tags are ASCII where possible.
// Owner v6: PQ-only. Mode 3 and classical cosignatures are not supported.
// Checked with: tlbc -q crypto/block/block.tlb crypto/smartcont/wallet-v5r2-rescue.tlb

// ---- Enumerations (exact values; unknown values are rejected, never defaulted)

auth_role_primary#01 = AuthRole;
auth_role_rescue#02 = AuthRole;

auth_kind_execute#00 = AuthKind;
auth_kind_configure#01 = AuthKind;
auth_kind_lock_primary#03 = AuthKind;
auth_kind_recover_migrate#04 = AuthKind;
// 0x02 (V5R1 "manage") is not admitted in V5R2.

policy_rescue_ready#01 = RescuePolicy;
policy_slh_required#02 = RescuePolicy;

// Daily-suite numbers follow PQCHECKSIG_SUITE; only suite 1 (ML-DSA-44) is admitted initially.
daily_suite_mldsa44#01 = DailySuite;

fee_class_rescue_submit#01 = FeeClass;
fee_class_pop#02 = FeeClass;
fee_class_prepare#03 = FeeClass;

// ---- AUTH v2 request, signed by exactly one root
// Digest: D = cell_hash(uint64("TOS-AUTH") ++ ^AuthRequestV2), 32 bytes, signed as the Pure
// message. Contexts: PRIMARY "TOS-AUTH-V2-ML-DSA-44-v1" (24 bytes), RESCUE
// "TOS-AUTH-SLH-DSA-SHA2-128S-v1" (29 bytes). The v2 tag keeps v1 and v2 bytes disjoint; the new
// PRIMARY context keeps a V5R1 module signature from verifying as v2 even if bytes coincided.

auth_request_v2#41553252
  global_id:int32 network_tag:bits256
  account:MsgAddressInt
  root:bits256                  // installed module address hash
  role:AuthRole epoch:uint64 nonce:uint64 valid_until:uint32
  kind:AuthKind payload:^Cell
  = AuthRequestV2;

// Payloads, selected by kind; the module and the account both check the match.
auth_execute_v2#45584543 actions:^Cell = AuthPayload;          // "EXEC": V5 action list
auth_configure_v2#434f4e46 new_mode:(## 2) fee_replacement:(Maybe ^FeeReplacement)
  = AuthPayload;                                                // "CONF": mode 2 only
auth_lock_primary#4c4f434b suite:DailySuite = AuthPayload;     // "LOCK": no successor, no value
// Full signed witnesses commit to both whole StateInit hashes and all fields.
// Policy, daily suite and addresses are derived, not duplicated assertions.
fee_replacement$_ metadata:^FeeMetadata vault_init:^StateInit = FeeReplacement;
auth_recover_migrate#4d494752
  module_init:^StateInit metadata:^FeeMetadata vault_init:^StateInit
  = AuthPayload;                                                // "MIGR": no value

// ---- Messages
// Vault -> module: the fee-funded submission. The module verifies `signature` with the root
// named by request.role and never ACCEPTs external input.
rescue_submit_v1#53554231 request:^AuthRequestV2 signature:^Cell = InternalMsgBody;   // "SUB1"
// Complete PQ-only module uses SUB3. SUB1 remains a historical probe constructor.
rescue_submit_v3#53554233 request:^AuthRequestV2 signature:^Cell = InternalMsgBody;
// No Maybe cosignature field. SUB1/SUB2 are refused by the complete module.
// Module -> account: relays a verified request with the funded remainder (mode 64).
// funded_by is the module's view of who paid; the account refuses PRIMARY funded by its own
// fee vault, keeping that route RESCUE-only without spending the vault's external credit.
auth_relay_v3#41553342 request:^AuthRequestV2 funded_by:MsgAddressInt
  = InternalMsgBody; // "AU3B": PQ-only; old AU2B refused

// ---- Module (immutable StateInit data; no admin, no withdrawal of earlier balance)
// Module code pins the fee-vault code hash; there is no editable code list.
module_data_v1#01 global_id:int32 network_tag:bits256
  daily:DailySuite primary_key:^Cell           // canonical 1,312-byte ML-DSA-44 chain
  rescue_key:bits256                           // SLH-DSA-SHA2-128s public key
  policy:RescuePolicy
  = ModuleData;

// ---- Account AUTH state (trailing reference of V5R2 data; absent is refused, never legacy)
fee_route_v1#01
  vault:bits256                                 // validated cache of the paired vault address
  fee_profile:uint8                             // suite-4 profile id frozen with the HSS bytes
  fee_tree_id:bits256 fee_public_key:^Cell     // one-level HSS key, 60-byte chain
  slot_seconds:uint32 per_slot:uint16 epoch0:uint32   // time-slot leaves; per_slot = 0 means counter mode
  = FeeRoute;

// Complete receiver storage candidate, superseding the circular v2 init tuple.
// Module StateInit binds network/global id, code, keys and policy once. The wallet
// validates it against its compiled dependency. Fee metadata has no vault address.
// A runtime FeeRoute cache must be derived and checked, never a genesis input.
fee_metadata_v1#01 fee_profile:uint8 fee_tree_id:bits256 epoch0:uint32 slot_seconds:uint32 per_slot:uint16
  fee_public_key:^Cell = FeeMetadata;
// Admitted profile: 1, slot_seconds=3600, per_slot=4, canonical HSS L1/H20/W4 key.
auth_state_v4#04 mode:(## 2) local_retired:uint16
  epoch:uint64 primary_nonce:uint64 rescue_nonce:uint64
  module_init:^StateInit fee_metadata:^FeeMetadata = AuthStateV4;
wallet_v5r2_data$_ signature_allowed:Bool seqno:uint32 wallet_id:uint32
  public_key:bits256 extensions:(HashmapE 256 int1) auth:^AuthStateV4 = WalletV5R2Data;
// signature_allowed must be false, extensions empty, and mode exactly 2.
// public_key is canonically zero and grants no authority.
// No missing-state fallback. Stored local_retired bits survive every transition.

// Canonical paired-vault storage candidate, separate from the historical fee
// admission probe below. No self address in data. Code fixes admission/budget
// policy; current account balance is not a genesis identity input.
paired_vault_config_v1#01 global_id:int32 network_tag:bits256
  wallet:MsgAddressInt module:MsgAddressInt metadata:^FeeMetadata = PairedVaultConfig;
// v3 caches are derived from PairedVaultConfig, never independently supplied.
// config_hash binds the full config; auth_prefix is canonical AU2R through role=RESCUE.
// POP parties hash binds account/module. Profile fixes 3600-second slots and k=4.
paired_vault_data_v3#03 next_leaf:uint32 config_hash:bits256 epoch0:uint32
  module:MsgAddressInt pop_parties_hash:bits256 public_key:^Cell auth_prefix:^Cell
  = PairedVaultData;
// Fee-vault candidate only: admission currently exceeds the 10,000-gas credit.
// The domain is the 136-bit ASCII string "TOS-RESCUE-FEE-v1".
paired_fee_intent_v4#46454534 domain:bits136 class:FeeClass vault:MsgAddressInt
  config_hash:bits256 leaf:uint32 valid_until:uint32 value:Tomis payload:^Cell
  = PairedFeeIntent;
paired_fee_external$_ intent:^PairedFeeIntent signature:^Cell = PairedFeeExternal;
// Canonical deployment requires next_leaf=0; wallet/module are standard wc0.

// ---- Fee vault (immutable code; data mutates only in next_leaf, budget and diagnostics)
// header_hash = cell_hash(FeeHeader) of this vault: one comparison binds network, vault, wallet,
// module, profile and tree without loading any of them before ACCEPT.
fee_parties_v1$_ vault:MsgAddressInt wallet:MsgAddressInt module:MsgAddressInt = FeeParties;
fee_header_v1#46454548 global_id:int32 network_tag:bits256
  fee_profile:uint8 fee_tree_id:bits256 parties:^FeeParties
  = FeeHeader;                                                  // "FEEH"

fee_caps_v1$_ max_submit:Tomis max_pop:Tomis max_prepare:Tomis = FeeCaps;
fee_vault_data_v1#01 header_hash:bits256
  module:MsgAddressInt                          // pinned payment target
  epoch0:uint32 slot_seconds:uint32 per_slot:uint16
  next_leaf:uint32 budget:Tomis
  caps:^FeeCaps public_key:^Cell gas_at_accept:uint32
  = FeeVaultData;

// Signed by the fee key: suite 4 verifies the HSS signature of digest = cell_hash(FeeIntent).
fee_intent_v1#46454531 header:^FeeHeader
  leaf:uint32 valid_until:uint32 class:FeeClass value:Tomis body:^Cell
  = FeeIntent;                                                  // "FEE1"

fee_external_v1#56455854 intent:^FeeIntent digest:^Cell context:^Cell signature:^Cell
  = ExternalMsgBody;                                            // "VEXT"

// ---- Possession proof (non-executable; separate transaction)
pop_keys_v1$_ primary_key_hash:bits256 rescue_key:bits256 policy:RescuePolicy = PopKeys;
pop_challenge_v1#504f5031 global_id:int32 network_tag:bits256
  account:MsgAddressInt module:bits256
  challenge:bits256 valid_until:uint32 keys:^PopKeys
  = PopChallenge;                                               // "POP1"
pop_submit_v1#504f5053 challenge:^PopChallenge signature:^Cell = InternalMsgBody; // "POPS"

// Complete PQ-only module: independently signed proofs for both roles. This
// framing splits parties and keys into cells so every cell fits the 1023-bit cap.
// Digest = cell_hash(uint64("TOS-POP1") ++ ^PopChallengeV3); Pure context for both
// suites is "TOS-RESCUE-POP-v1". Role selects exactly ML-DSA-44 or SLH-DSA-SHA2-128s.
pop_parties_v3$_ account:MsgAddressInt module:bits256 = PopPartiesV3;
pop_keys_v3$_ daily:DailySuite primary_key_hash:bits256 rescue_key:bits256
  policy:RescuePolicy = PopKeysV3;
pop_challenge_v3#504f5033 global_id:int32 network_tag:bits256 role:AuthRole
  challenge:bits256 valid_until:uint32 parties:^PopPartiesV3 keys:^PopKeysV3
  = PopChallengeV3;
pop_submit_v3#50505333 challenge:^PopChallengeV3 signature:^Cell = InternalMsgBody;
// POP creates no authorization, state change or outgoing messages. Clients require
// a fresh CSPRNG challenge and authenticated successful execution for each key.

// ---- Successor fee preparation (SLH-authorized at the current module; spends only its own
// incoming amount; no wallet AUTH meaning)
prepare_targets_v1$_ module_init_hash:bits256 vault_init_hash:bits256 fee_tree_id:bits256
  module_amount:Tomis vault_amount:Tomis
  = PrepareTargets;
fee_prepare_v1#50524550 global_id:int32 network_tag:bits256
  wallet:MsgAddressInt source_module:bits256 valid_until:uint32
  targets:^PrepareTargets
  = FeePrepare;                                                 // "PREP"
fee_prepare_submit_v1#50524553 prepare:^FeePrepare signature:^Cell = InternalMsgBody; // "PREPS"

// ---- Global AUTH retirement policy (mandatory, monotonic)
// AuthPolicy and ConfigParam 48 are defined in crypto/block/block.tlb.
// See doc/auth-policy-v1.md for the frozen profile and monotonic rules.

// ---- Separate experimental version-17 contextual vault; not the layouts above.
// Header bytes are the fixed 17-byte domain "TOS-RESCUE-FEE-v1", then these fields.
// The actual vault address is bound by the signed intent to avoid an init-hash fixed point.
context_fee_parties$_ wallet:MsgAddressInt module:MsgAddressInt = ContextFeeParties;
context_fee_header$_ domain:bits136 global_id:int32 network_tag:bits256
  fee_profile:uint8 public_key_digest:bits256 parties:^ContextFeeParties
  = ContextFeeHeader;
context_fee_intent#46454533 class:uint8 vault:MsgAddressInt
  leaf:uint32 valid_until:uint32 value:Tomis payload:^Cell header:^ContextFeeHeader
  = ContextFeeIntent;  // class must be 1; payload is canonical rescue SUB1
context_fee_external$_ intent:^ContextFeeIntent signature:^Cell = ContextFeeExternal;
context_fee_data$_ next_leaf:uint32 gas_at_accept:uint32 epoch0:uint32
  fixed_value:Tomis header_hash:bits256 target:MsgAddressInt
  public_key:^Cell auth_prefix:^Cell = ContextFeeData;

// Complete receiver candidate preparation: exact canonical witnesses are signed.
// Pure SLH context TOS-RESCUE-FEE-PREP-v1, digest = cell_hash(FeePrepareV3).
prepare_plan_v3$_ module_amount:Tomis vault_amount:Tomis
  module_init:^Cell metadata:^Cell vault_init:^Cell = PreparePlanV3;
fee_prepare_v3#50525033 global_id:int32 network_tag:bits256
  wallet:MsgAddressInt source_module:bits256 valid_until:uint32
  plan:^PreparePlanV3 = FeePrepareV3;
fee_prepare_submit_v3#46505233 prepare:^FeePrepareV3 signature:^Cell = InternalMsgBody;
