// pow-giver-helpers.fif
// Helper words for deploying PoW Giver smart contracts at genesis.
//
// Included by gen-zerostate.fif and gen-zerostate-test.fif.
//
// Public word:
//   ( giver_id amount interval min_cpl init_cpl max_cpl -- )
//   deploy-pow-giver
//
//   Registers one PoW Giver contract on the current workchain (masterchain
//   in the genesis context) with a deterministic address
//   AllOnes * (7 + giver_id) and pre-funds it with `amount` nano-tomis.
//   Saves keypair to pow-giver-{N}.pk and address to pow-giver-{N}.addr.

"auto/pow-testgiver-code.fif" include =: PowGiverCode

// ( log_cpl -- )  Store (256 - log_cpl) as an 8-bit unsigned integer.
// This is the "cpl exponent" field used by pow-testgiver-code to reconstruct
// the actual 256-bit complexity value.
{ 256 swap - 8 u, } : cpl,

// Module-level mutable cells — declared at top level so references inside
// word bodies { } are resolved at compile time.
variable _pg-id
variable _pg-amt
variable _pg-itvl
variable _pg-mincpl
variable _pg-initcpl
variable _pg-maxcpl
variable _pg-fname
variable _pg-pubkey
variable _pg-privkey
variable _pg-data
variable _pg-addr

// ( giver_id amount interval min_cpl init_cpl max_cpl -- )
{
  // Store parameters (popped in reverse stack order).
  _pg-maxcpl !
  _pg-initcpl !
  _pg-mincpl !
  _pg-itvl !
  _pg-amt !
  _pg-id !

  // Build filename base string: "pow-giver-" ++ str(giver_id)
  "pow-giver-" _pg-id @ (.) $+ _pg-fname !

  cr ."=== PoW Giver #" _pg-id @ . ."===" cr
  ."  amount   = " _pg-amt @ .TM cr
  ."  interval = " _pg-itvl @ . ."s" cr
  ."  cpl: min=" _pg-mincpl @ . ."  init=" _pg-initcpl @ . ."  max=" _pg-maxcpl @ . cr

  // Load or generate the Giver's ed25519 keypair.
  // Creates pow-giver-{N}.pk if it does not exist, loads it otherwise.
  // Result: ( pubkey privkey ) — privkey on top, pubkey below.
  _pg-fname @ +".pk" load-generate-keypair
  _pg-privkey !
  _pg-pubkey !

  // Build the persistent data cell (layout from pow-testgiver-code.fc):
  //
  //   seqno:          uint32   = 0
  //   wallet_id:      uint32   = giver_id  (unique identifier per giver)
  //   public_key:     uint256  = ed25519 public key
  //   seed:           uint128  = deterministic seed (giver_id in upper 32 bits)
  //   pow_complexity: uint256  = 2^(256 - init_cpl)
  //   last_success:   int32    = -1  (never solved)
  //   xdata:          ^Cell    = { amount target_delta max_cpl min_cpl }
  //
  <b 0 32 u,                              // seqno = 0
     _pg-id @ 32 u,                       // wallet-id (giver identifier)
     _pg-pubkey @ B,                      // 256-bit ed25519 public key
     _pg-id @ 32 u,                       // seed: upper 32 bits = giver_id
     0 96 u,                              // seed: lower 96 bits = 0
     256 _pg-initcpl @ - 1<< 256 u,       // pow_complexity = 2^(256 - init_cpl)
     -1 32 i,                             // last_success = -1 (never solved)
     <b _pg-amt @ Tomi,                   // xdata: amount (in Tomis)
        _pg-itvl @ 32 u,                  // xdata: target_delta (seconds)
        _pg-maxcpl @ cpl,                 // xdata: max complexity exponent
        _pg-mincpl @ cpl, b> ref,         // xdata: min complexity exponent
  b> _pg-data !

  // Deterministic address: AllOnes * (5 + giver_id)
  //   Giver 1  → AllOnes*6  = -1:6666...666
  //   Giver 2  → AllOnes*7  = -1:7777...777
  //   ...
  //   Giver 10 → AllOnes*15 = -1:FFFF...FFF
  //
  // AllOnes = (2^256-1)/15; AllOnes*N is valid for N in [1..15].
  // N in [6..15] avoids collisions with existing genesis contracts:
  //   AllOnes*1 = main-wallet, *3 = elector, *5 = config.
  AllOnes 5 _pg-id @ + * _pg-addr !

  // Register the smart contract in the genesis masterchain state.
  // register_smc signature: code data library balance split_depth ticktock [addr] mode -> addr
  PowGiverCode   // code cell
  _pg-data @     // data cell
  empty_cell     // no libraries
  _pg-amt @      // initial balance (nano-tomis)
  0              // split_depth = 0
  0              // ticktock = 0 (not a tick/tock contract)
  _pg-addr @     // deterministic address
  6              // mode: 2 (create complete) | 4 (with specified address)
  register_smc drop

  // Print and persist the Giver's address.
  Masterchain _pg-addr @
  2dup ."  address = " .addr cr
  2dup 6 .Addr cr
  _pg-fname @ +".addr" save-address-verbose

  // Private key is already persisted in the .pk file; drop here.
  _pg-privkey @ drop
} : deploy-pow-giver
