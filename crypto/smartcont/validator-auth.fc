;; Pure C0 verification over the raw bytes of a canonical AuthBytes cell.
;; Requires node-provided VM version >= 16 and capValidatorAuth. Callers must
;; separately establish the expected statement, authority and replay rules.
int p0_check_signature(cell message, slice signature, int public_key) asm "P0CHKSIGN";

;; Only native configuration transaction execution supplies these operations.
cell p0_registry_checkpoint() impure asm "P0STATE";
cell p0_apply_update(cell update, cell evidence) impure asm "P0APPLY";
