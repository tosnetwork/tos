library Validator  // Validator request, vote, and signed body codecs
"Addr.fif" include
"Currency.fif" include
"Key.fif" include   // Transitive: not used here, re-exported for historical
                    // test-only fixtures that need PK' / parse-val-pubkey.
"Msg.fif" include

// ( S -- B )
{ base64>B dup Blen 64 <> abort"validator Ed25519 signature must be exactly 64 bytes long"
} : parse-val-signature

// ( to-sign signature pubkey -- )
{ ed25519_chksign not abort"Ed25519 signature is invalid"
} : check-val-signature

// ( elect-utime max-factor src-addr adnl-addr -- B )
{ 4 0 reverse B{654c5074} swap 32 u>B B+ swap 32 u>B B+ swap 256 u>B B+ swap 256 u>B B+
} : validator-elect-req>B

// ( query-id pubkey elect-utime max-factor adnl-addr signature -- c )
// Defensive: pubkey is appended raw via `B,` (no length tag), so a
// wrong-size pubkey would silently produce a malformed cell. Honest
// callers route pubkey through parse-val-pubkey/PK' (Key.fif) which
// already enforces 32 bytes; the check below catches direct callers.
{ 4 pick Blen 32 <> abort"validator Ed25519 pubkey must be exactly 32 bytes long"
  <b x{4e73744b} s, 6 roll 64 u, 5 roll B, 4 roll 32 u, 3 roll 32 u, rot 256 u,
  swap <b swap B, b> ref, b>
} : validator-elect-body

// ( query-id amount pubkey elect-utime max-factor adnl-addr signature -- c )
{ 4 pick Blen 32 <> abort"validator Ed25519 pubkey must be exactly 32 bytes long"
  <b x{4e73744b} s, 7 roll 64 u, 6 roll Tomi, 5 roll B, 4 roll 32 u, 3 roll 32 u, rot 256 u,
  swap <b swap B, b> ref, b>
} : validator-elect-body+stake

// A validator's vote on a configuration proposal or on a complaint is not built here.
// It is signed with the validator's post-quantum consensus key over a preimage that
// names the validator set counting it, which a script has no way to know, and the node
// builds the message itself.
