library Workchain  // Workchain descriptor builders
"State.fif" include

variable workchain-dict
// root-hash file-hash enable-utime actual-min-split min-split max-split
// workchain-id routing-flags vm-version -- descriptor-cell
// routing-flags includes basic/active/accept_msgs and thirteen reserved bits;
// native descriptor validation enforces reserved bits and the basic format.
{ <b x{a6} s, 7 roll 32 u, 6 roll 8 u, 5 roll 8 u, 4 roll 8 u,
  2 roll 16 u, 4 roll 256 u, 3 roll 256 u, 0 32 u, x{1} s,
  swap 32 i, 0 64 u, b>
  dup isWorkchainDescr? not abort"invalid WorkchainDescr created"
  dup <s rot workchain-dict @ 32 idict!+ 0= abort"cannot add workchain"
  workchain-dict !
} : add-basic-workchain
// Same inputs, extended descriptor with the existing split/merge timings.
{ <b x{a7} s, 7 roll 32 u, 6 roll 8 u, 5 roll 8 u, 4 roll 8 u,
  2 roll 16 u, 4 roll 256 u, 3 roll 256 u, 0 32 u, x{1} s,
  swap 32 i, 0 64 u, x{0} s, 20 32 u, 20 32 u, 10 32 u, 1000 32 u, 0 8 u, b>
  dup isWorkchainDescr? not abort"invalid WorkchainDescr created"
  dup <s rot workchain-dict @ 32 idict!+ 0= abort"cannot add workchain"
  workchain-dict !
} : add-basic-workchain-v2
// Compatibility convenience for an active, receiving native workchain.
// All wire construction remains in add-basic-workchain.
{ 0xe000 -1 add-basic-workchain drop } : add-std-workchain
// --
{ workchain-dict @ dict>s s>c 12 config! } : config.workchains!

// workchain-id -- wc-zero-state
{ <b x{9023afe2} s, globalid@ 32 i, 0 8 i, swap 32 i, 1 63 << 64 u,
  0 64 i, now 32 u, 0 64 i, -1 32 i, <b 0 67 u, b> ref, 0 1 u,
  <b 0 11 u, b> ref,
  <b 0 128 10 + 1+ 1+ u, b> ref, 0 1 u, b>
  dup isShardState? not abort"invalid ShardState created"
} : mkemptyShardState

// accounts_cell workchain-id -- wc-zero-state
// Variant of `mkemptyShardState` that injects a caller-supplied
// `ShardAccounts` cell instead of the canonical empty 11-bit placeholder.
{ <b x{9023afe2} s, globalid@ 32 i, 0 8 i,
  swap 32 i, 1 63 << 64 u, 0 64 i, now 32 u, 0 64 i, -1 32 i,
  <b 0 67 u, b> ref, 0 1 u,
  swap ref,
  <b 0 128 10 + 1+ 1+ u, b> ref, 0 1 u, b>
  dup isShardState? not abort"invalid ShardState created with accounts"
} : mkShardStateWithAccounts
