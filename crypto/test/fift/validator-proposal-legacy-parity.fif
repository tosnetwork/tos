"Test.fif" include
"Addr.fif" include
"Currency.fif" include
"Key.fif" include
"Msg.fif" include
"Proposal.fif" include

// Test-only frozen Ed25519 codec, copied from Validator.fif before retirement.
// These words intentionally cannot be reached by an operator script or an
// installed Fift library. The values below assert the historical bytes.
{ base64>B dup Blen 64 <> abort"validator Ed25519 signature must be exactly 64 bytes long"
} : legacy-parse-val-signature

{ 4 0 reverse B{654c5074} swap 32 u>B B+ swap 32 u>B B+ swap 256 u>B B+ swap 256 u>B B+
} : legacy-validator-elect-req>B

{ 4 pick Blen 32 <> abort"validator Ed25519 pubkey must be exactly 32 bytes long"
  <b x{4e73744b} s, 6 roll 64 u, 5 roll B, 4 roll 32 u, 3 roll 32 u, rot 256 u,
  swap <b swap B, b> ref, b>
} : legacy-validator-elect-body

{ 4 pick Blen 32 <> abort"validator Ed25519 pubkey must be exactly 32 bytes long"
  <b x{4e73744b} s, 7 roll 64 u, 6 roll Tomi, 5 roll B, 4 roll 32 u, 3 roll 32 u, rot 256 u,
  swap <b swap B, b> ref, b>
} : legacy-validator-elect-body+stake

."validator/proposal legacy parity" cr
test-reset

"xrQTSAABAgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4f" parse-val-pubkey constant val-pubkey
"AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8gISIjJCUmJygpKissLS4vMDEyMzQ1Njc4OTo7PD0+Pw==" legacy-parse-val-signature constant val-signature

val-pubkey B{000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F}
  "parse validator pubkey" test-bytes-eq
val-signature B{000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F202122232425262728292A2B2C2D2E2F303132333435363738393A3B3C3D3E3F}
  "parse validator signature" test-bytes-eq

0x11223344 constant elect-time
0x55667788 constant max-factor
0xA0A1A2A3A4A5A6A7A8A9AAABACADAEAFB0B1B2B3B4B5B6B7B8B9BABBBCBDBEBF constant addr256
0xC0C1C2C3C4C5C6C7C8C9CACBCCCDCECFD0D1D2D3D4D5D6D7D8D9DADBDCDDDEDF constant adnl-addr
0x8899AABBCCDDEEFF constant query-id
0x10203040 constant proposal-hash
0x20304050 constant complaint-hash
0x12345678 constant expire-at
321987654321 constant amount
17 constant param-idx
-1000 constant upgrade-param-idx
0x89ABCDEF constant elect-id
<b 0xCAFE 16 u, b> constant param-value
<b 0xbc 8 u, 0x1234 16 u, b> constant complaint

elect-time max-factor addr256 adnl-addr legacy-validator-elect-req>B
  B{654c5074} elect-time 32 u>B B+ max-factor 32 u>B B+ addr256 256 u>B B+ adnl-addr 256 u>B B+
  "validator elect request matches pre-extraction inline bytes" test-bytes-eq

query-id val-pubkey elect-time max-factor adnl-addr val-signature legacy-validator-elect-body
  <b x{4e73744b} s, query-id 64 u, val-pubkey B, elect-time 32 u, max-factor 32 u, adnl-addr 256 u,
    <b val-signature B, b> ref, b>
  "validator elect body matches pre-extraction inline cell" test-cell-eq

query-id amount val-pubkey elect-time max-factor adnl-addr val-signature legacy-validator-elect-body+stake
  <b x{4e73744b} s, query-id 64 u, amount Tomi, val-pubkey B, elect-time 32 u, max-factor 32 u, adnl-addr 256 u,
    <b val-signature B, b> ref, b>
  "validator elect body with stake matches pre-extraction inline cell" test-cell-eq

55 param-idx proposal-query-id
  55 32 << param-idx +
  "proposal query id matches pre-extraction inline formula" test-eq

param-idx param-value -1 proposal-param-ref
  <b x{f3} s, param-idx 32 i, param-value dict, 0 1 i, b>
  "proposal param ref without old hash matches pre-extraction inline cell" test-cell-eq

upgrade-param-idx param-value proposal-hash proposal-param-ref
  <b x{f3} s, upgrade-param-idx 32 i, param-value dict, true 1 i, proposal-hash 256 u, b>
  "proposal param ref with old hash matches pre-extraction inline cell" test-cell-eq

query-id expire-at upgrade-param-idx param-value proposal-hash proposal-param-ref true proposal-body
  <b x{6e565052} s, query-id 64 u, expire-at 32 u,
    <b x{f3} s, upgrade-param-idx 32 i, param-value dict, true 1 i, proposal-hash 256 u, b> ref,
    true 1 i, b>
  "proposal body matches pre-extraction inline cell" test-cell-eq

80 complaint-hash complaint-envelope-query-id
  80 32 << complaint-hash 32 1<< mod +
  "complaint envelope query id matches pre-extraction inline formula" test-eq

query-id elect-id complaint complaint-envelope-body
  <b x{52674370} s, query-id 64 u, elect-id 32 u, complaint <s s, b>
  "complaint envelope body matches pre-extraction inline cell" test-cell-eq

test-summary
