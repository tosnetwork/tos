"Test.fif" include
"Asm.fif" include
"Proposal.fif" include

."proposal/complaint helper smoke (no validator stake body)" cr
test-reset

0x8899AABBCCDDEEFF constant query-id
0x10203040 constant proposal-hash
0x20304050 constant complaint-hash
0x12345678 constant expire-at
17 constant param-idx
-1000 constant upgrade-param-idx

55 param-idx proposal-query-id
  55 32 << param-idx +
  "proposal query id" test-eq

<b 0xCAFE 16 u, b> =: param-value
param-idx param-value -1 proposal-param-ref
  <b x{f3} s, param-idx 32 i, param-value dict, 0 1 i, b>
  "proposal param ref without old hash" test-cell-eq

upgrade-param-idx param-value proposal-hash proposal-param-ref
  <b x{f3} s, upgrade-param-idx 32 i, param-value dict, true 1 i, proposal-hash 256 u, b>
  "proposal param ref with old hash" test-cell-eq

query-id expire-at upgrade-param-idx param-value proposal-hash proposal-param-ref true proposal-body
  <b x{6e565052} s, query-id 64 u, expire-at 32 u,
    <b x{f3} s, upgrade-param-idx 32 i, param-value dict, true 1 i, proposal-hash 256 u, b> ref,
    true 1 i, b>
  "proposal body" test-cell-eq

80 complaint-hash complaint-envelope-query-id
  80 32 << complaint-hash 32 1<< mod +
  "complaint envelope query id" test-eq

<b 0xbc 8 u, 0x1234 16 u, b> =: complaint
query-id 0x12345678 complaint complaint-envelope-body
  <b x{52674370} s, query-id 64 u, 0x12345678 32 u, complaint <s s, b>
  "complaint envelope body" test-cell-eq

"null" load-proposal-value-or-null null "load null proposal value" test-eq

param-value 2 boc+>B "proposal-value.boc" B>file
"proposal-value.boc" load-proposal-value-or-null param-value "load proposal value from file" test-cell-eq

complaint 2 boc+>B "complaint.boc" B>file
"complaint.boc" load-validator-complaint
=: loaded-hash
=: loaded-complaint
loaded-complaint complaint "load validator complaint cell" test-cell-eq
loaded-hash complaint hash "load validator complaint hash" test-eq

"wallet-v3-code.fif" load-upgrade-code-param-value
<b "wallet-v3-code.fif" include dup <s 12 u@ 0xFF0 <> abort"not valid smart contract code" ref, b>
  "load upgrade code param value" test-cell-eq

test-summary
