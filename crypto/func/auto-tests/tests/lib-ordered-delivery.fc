#include "../../../smartcont/stdlib.fc";
#include "../../../smartcont/ordered-delivery.fc";

;; Same vector matrix as tol-tester/tests/stdlib-ordered-delivery-positive.tol: identical
;; method ids, inputs, expected values and failure codes.

() expect_throw(int code, int expected, int fail_code) impure inline {
  throw_unless(fail_code, code == expected);
}

int main() {
  return 0;
}

int test_in_order_completion_advances_head() method_id(101) {
  var w = nonce_window::new(1);
  w~nonce_window::complete(1);
  w~nonce_window::complete(2);
  w~nonce_window::complete(3);
  [int next_pending, int completed] = w;
  throw_unless(101, next_pending == 4);
  throw_unless(102, completed == 0);
  throw_unless(103, nonce_window::completed?(w, 3));
  throw_if(104, nonce_window::completed?(w, 4));
  return 1;
}

int test_out_of_order_completion_folds_contiguous_run() method_id(102) {
  var w = nonce_window::new(10);
  w~nonce_window::complete(12);
  w~nonce_window::complete(13);
  w~nonce_window::complete(15);
  [int next_pending, _] = w;
  throw_unless(111, next_pending == 10);
  throw_unless(112, nonce_window::completed?(w, 13) & (~ nonce_window::completed?(w, 14)));
  w~nonce_window::complete(11);
  [next_pending, _] = w;
  throw_unless(113, next_pending == 10);
  ;; completing the head folds 10..13 and stops at the gap at 14
  w~nonce_window::complete(10);
  [next_pending, int completed] = w;
  throw_unless(114, next_pending == 14);
  throw_unless(115, completed == 2);
  w~nonce_window::complete(14);
  [next_pending, completed] = w;
  throw_unless(116, next_pending == 16);
  throw_unless(117, completed == 0);
  return 2;
}

int test_window_edges() method_id(103) {
  var w = nonce_window::new(0);
  throw_unless(121, nonce_window::last_acceptable(w) == 255);
  w~nonce_window::complete(255);
  int thrown = false;
  try {
    w~nonce_window::complete(256);
  } catch (_, code) {
    expect_throw(code, ordered_delivery::error::outside_window, 122);
    thrown = true;
  }
  throw_unless(123, thrown);
  throw_if(124, nonce_window::completed?(w, 256));
  ;; completing 0..254 folds the whole window including 255
  int n = 0;
  while (n < 255) {
    w~nonce_window::complete(n);
    n += 1;
  }
  [int next_pending, int completed] = w;
  throw_unless(125, next_pending == 256);
  throw_unless(126, completed == 0);
  w~nonce_window::complete(256 + 255);
  return 3;
}

int test_duplicate_and_stale_completions_rejected() method_id(104) {
  var w = nonce_window::new(5);
  w~nonce_window::complete(7);
  int rejected = 0;
  try { w~nonce_window::complete(7); } catch (_, code) { expect_throw(code, ordered_delivery::error::already_completed, 131); rejected += 1; }
  try { w~nonce_window::complete(4); } catch (_, code) { expect_throw(code, ordered_delivery::error::already_completed, 132); rejected += 1; }
  try { w~nonce_window::complete(-1); } catch (_, code) { expect_throw(code, ordered_delivery::error::invalid_nonce, 133); rejected += 1; }
  try { w~nonce_window::complete(ordered_delivery::max_nonce + 1); } catch (_, code) { expect_throw(code, ordered_delivery::error::invalid_nonce, 134); rejected += 1; }
  throw_unless(135, rejected == 4);
  throw_unless(136, nonce_window::completed?(w, 4));
  return 4;
}

int test_top_of_nonce_space() method_id(105) {
  var w = nonce_window::new(ordered_delivery::max_nonce - 1);
  w~nonce_window::complete(ordered_delivery::max_nonce);
  w~nonce_window::complete(ordered_delivery::max_nonce - 1);
  ;; the head may reach 2^64 - 1 and still be stored
  [int next_pending, _] = w;
  throw_unless(141, next_pending == ordered_delivery::max_nonce + 1);
  [int restored_next, _] = nonce_window::unpack(nonce_window::pack(w));
  throw_unless(142, restored_next == next_pending);
  return 5;
}

int test_pending_slots_key_checked() method_id(106) {
  cell p = new_dict();
  cell payload = begin_cell().store_uint(0xabc, 12).end_cell();
  p~pending_slots::put(3, 1, payload);
  (int found, int status, cell body) = pending_slots::get(p, 3);
  throw_unless(151, found & (status == 1));
  throw_unless(152, body.cell_hash() == payload.cell_hash());
  ;; same slot index, different nonce: never visible, never writable
  (int alias, _, _) = pending_slots::get(p, 3 + 256);
  throw_if(153, alias);
  int thrown = false;
  try {
    p~pending_slots::put(3 + 256, 2, payload);
  } catch (_, code) {
    expect_throw(code, ordered_delivery::error::slot_occupied, 154);
    thrown = true;
  }
  throw_unless(155, thrown);
  throw_if(156, p~pending_slots::remove(3 + 256));
  (int still, _, _) = pending_slots::get(p, 3);
  throw_unless(157, still);
  return 6;
}

int test_pending_slots_update_remove_reuse() method_id(107) {
  cell p = new_dict();
  cell a = begin_cell().store_uint(1, 8).end_cell();
  cell b = begin_cell().store_uint(2, 8).end_cell();
  p~pending_slots::put(9, 1, a);
  p~pending_slots::put(9, 2, b);
  (_, int status, cell body) = pending_slots::get(p, 9);
  throw_unless(161, (status == 2) & (body.cell_hash() == b.cell_hash()));
  throw_unless(162, p~pending_slots::remove(9));
  throw_if(163, p~pending_slots::remove(9));
  ;; the freed slot can now carry the nonce one window later
  p~pending_slots::put(9 + 256, 0, a);
  (int found, _, _) = pending_slots::get(p, 9 + 256);
  throw_unless(164, found);
  int thrown = false;
  try {
    p~pending_slots::put(10, 256, a);
  } catch (_, code) {
    expect_throw(code, ordered_delivery::error::invalid_status, 165);
    thrown = true;
  }
  throw_unless(166, thrown);
  return 7;
}

int test_layout_matches_tol() method_id(108) {
  ;; The packed window must be the very cell the Tol NonceWindow.toCell() produces; the
  ;; Tol suite pins the same hash for the same state.
  var w = nonce_window::new(10);
  w~nonce_window::complete(12);
  w~nonce_window::complete(15);
  return nonce_window::pack(w).cell_hash();
}

int test_fixed_slots_key_checked() method_id(109) {
  cell p = fixed_slots::new();
  cell payload = begin_cell().store_uint(0xabc, 12).end_cell();
  p~fixed_slots::put(3, 1, payload);
  (int found, int status, cell body) = fixed_slots::get(p, 3);
  throw_unless(181, found & (status == 1));
  throw_unless(182, body.cell_hash() == payload.cell_hash());
  (int alias, _, _) = fixed_slots::get(p, 3 + 256);
  throw_if(183, alias);
  int thrown = false;
  try {
    p~fixed_slots::put(3 + 256, 2, payload);
  } catch (_, code) {
    expect_throw(code, ordered_delivery::error::slot_occupied, 184);
    thrown = true;
  }
  throw_unless(185, thrown);
  throw_if(186, p~fixed_slots::remove(3 + 256));
  (int still, _, _) = fixed_slots::get(p, 3);
  throw_unless(187, still);
  return 9;
}

int test_fixed_slots_update_remove_reuse() method_id(110) {
  cell p = fixed_slots::new();
  cell a = begin_cell().store_uint(1, 8).end_cell();
  cell b = begin_cell().store_uint(2, 8).end_cell();
  p~fixed_slots::put(9, 1, a);
  p~fixed_slots::put(9, 2, b);
  (_, int status, cell body) = fixed_slots::get(p, 9);
  throw_unless(191, (status == 2) & (body.cell_hash() == b.cell_hash()));
  throw_unless(192, p~fixed_slots::remove(9));
  throw_if(193, p~fixed_slots::remove(9));
  p~fixed_slots::put(9 + 256, 0, a);
  (int found, _, _) = fixed_slots::get(p, 9 + 256);
  throw_unless(194, found);
  int thrown = false;
  try {
    p~fixed_slots::put(10, 256, a);
  } catch (_, code) {
    expect_throw(code, ordered_delivery::error::invalid_status, 195);
    thrown = true;
  }
  throw_unless(196, thrown);
  ;; a removed slot is back to the empty tree, cell for cell
  cell q = fixed_slots::new();
  q~fixed_slots::put(77, 3, a);
  q~fixed_slots::remove(77);
  throw_unless(197, q.cell_hash() == fixed_slots::new().cell_hash());
  ;; an empty leaf stores nonce 0: only the occupied flag tells it apart from a real entry
  ;; for nonce 0
  (int ghost, _, _) = fixed_slots::get(fixed_slots::new(), 0);
  throw_if(198, ghost);
  cell r = fixed_slots::new();
  r~fixed_slots::put(256, 1, a);
  r~fixed_slots::remove(256);
  (int still_ghost, _, _) = fixed_slots::get(r, 0);
  throw_if(199, still_ghost);
  throw_if(200, r~fixed_slots::remove(0));
  return 10;
}

int gas_consumed() asm "GASCONSUMED";

;; TVM charges 100 gas for the first load of a cell in a run (code cells included) and 25
;; for each reload, so measurements taken one after another in a single run see different
;; caches. Each measurement therefore repeats the identical put on a copy first: every data
;; and code cell it touches is then cached, and what is compared is the instruction path
;; alone. The number of cell loads per put is fixed by the tree depth. The library inlines
;; put, so both runs go through one non-inlined wrapper: two inlined copies would sit in
;; different code cells, and the warm-up would not warm the copy being measured.
cell put_once(cell p, int nonce, cell payload) impure method_id {
  p~fixed_slots::put(nonce, 1, payload);
  return p;
}

int put_gas(cell p, int nonce) impure method_id {
  cell payload = begin_cell().store_uint(nonce, 16).end_cell();
  put_once(p, nonce, payload);
  int before = gas_consumed();
  put_once(p, nonce, payload);
  return gas_consumed() - before;
}

int test_fixed_slots_gas_is_constant() method_id(111) {
  cell empty = fixed_slots::new();
  cell crowded = fixed_slots::new();
  int n = 0;
  while (n < 200) {
    crowded~fixed_slots::put(n + 20, 0, begin_cell().end_cell());
    n += 1;
  }
  ;; inserting: independent of how many slots are occupied and of which slot is written
  ;; (crowded holds nonces 20..219)
  int insert = put_gas(empty, 5);
  throw_unless(201, put_gas(crowded, 5) == insert);
  throw_unless(202, put_gas(empty, 0) == insert);
  throw_unless(203, put_gas(empty, 255) == insert);
  throw_unless(204, put_gas(crowded, 240) == insert);
  ;; updating a nonce's own slot compares the stored nonce too, at a cost that is again the
  ;; same everywhere
  int update = put_gas(crowded, 130);
  throw_if(205, update == insert);
  throw_unless(206, put_gas(crowded, 20) == update);
  throw_unless(207, put_gas(crowded, 219) == update);
  return 11;
}

int test_fixed_slots_layout_matches_tol() method_id(112) {
  ;; The tree must be the very cell the Tol FixedSlots builds; the Tol suite pins the same
  ;; hash for the same state.
  cell p = fixed_slots::new();
  p~fixed_slots::put(3, 1, begin_cell().store_uint(0xabc, 12).end_cell());
  p~fixed_slots::put(200, 2, begin_cell().end_cell());
  return p.cell_hash();
}

int test_full_window_folds_completely() method_id(113) {
  ;; Every nonce above the head completes first, so completing the head must fold all 256
  ;; at once: the bitmap is all ones at that moment.
  var w = nonce_window::new(0);
  int n = 1;
  while (n < 256) {
    w~nonce_window::complete(n);
    n += 1;
  }
  [_, int before] = w;
  throw_unless(211, before == ordered_delivery::full_mask - 1);
  w~nonce_window::complete(0);
  [int next_pending, int completed] = w;
  throw_unless(212, next_pending == 256);
  throw_unless(213, completed == 0);
  w~nonce_window::complete(256 + 255);
  return 13;
}

int test_complete_range() method_id(114) {
  var w = nonce_window::new(10);
  w~nonce_window::complete_range(12, 14);
  [int head, _] = w;
  throw_unless(221, (head == 10) & nonce_window::completed?(w, 13) & (~ nonce_window::completed?(w, 11)));
  w~nonce_window::complete_range(10, 11);
  [head, int completed] = w;
  throw_unless(222, (head == 15) & (completed == 0));
  w~nonce_window::complete(17);
  int rejected = 0;
  try { w~nonce_window::complete_range(20, 19); } catch (_, code) { expect_throw(code, ordered_delivery::error::invalid_nonce, 223); rejected += 1; }
  try { w~nonce_window::complete_range(14, 16); } catch (_, code) { expect_throw(code, ordered_delivery::error::already_completed, 224); rejected += 1; }
  try { w~nonce_window::complete_range(16, 15 + 256); } catch (_, code) { expect_throw(code, ordered_delivery::error::outside_window, 225); rejected += 1; }
  ;; overlapping an already completed nonce changes nothing
  try { w~nonce_window::complete_range(16, 18); } catch (_, code) { expect_throw(code, ordered_delivery::error::already_completed, 226); rejected += 1; }
  throw_unless(227, rejected == 4);
  [head, _] = w;
  throw_unless(228, (head == 15) & (~ nonce_window::completed?(w, 16)));
  ;; the whole window at once
  var full = nonce_window::new(0);
  full~nonce_window::complete_range(0, 255);
  [int full_head, int full_bits] = full;
  throw_unless(229, (full_head == 256) & (full_bits == 0));
  return 14;
}

int test_pending_slots_bound_to_window() method_id(115) {
  var w = nonce_window::new(0);
  cell p = new_dict();
  cell a = begin_cell().store_uint(1, 8).end_cell();
  p~pending_slots::put_in_window(w, 3, 1, a);
  (int held, int holder) = pending_slots::occupant(p, 3 + 256);
  throw_unless(231, held & (holder == 3));
  int rejected = 0;
  ;; the nonce one window later is not in the window yet
  try { p~pending_slots::put_in_window(w, 3 + 256, 1, a); } catch (_, code) { expect_throw(code, ordered_delivery::error::outside_window, 232); rejected += 1; }
  ;; once 0..3 complete, nonce 3's never-removed entry is stale and is reclaimed
  w~nonce_window::complete_range(0, 3);
  p~pending_slots::put_in_window(w, 3 + 256, 2, a);
  (int now, _, _) = pending_slots::get(p, 3 + 256);
  (int old, _, _) = pending_slots::get(p, 3);
  throw_unless(233, now & (~ old));
  try { p~pending_slots::put_in_window(w, 2, 1, a); } catch (_, code) { expect_throw(code, ordered_delivery::error::already_completed, 234); rejected += 1; }
  ;; a holder that is not below the head is never displaced
  p~pending_slots::put(5 + 512, 1, a);
  try { p~pending_slots::put_in_window(w, 5, 1, a); } catch (_, code) { expect_throw(code, ordered_delivery::error::slot_occupied, 235); rejected += 1; }
  throw_unless(236, rejected == 3);
  (int empty, _) = pending_slots::occupant(new_dict(), 9);
  throw_if(237, empty);
  return 15;
}

int test_fixed_slots_bound_to_window() method_id(116) {
  var w = nonce_window::new(0);
  cell p = fixed_slots::new();
  cell a = begin_cell().store_uint(1, 8).end_cell();
  p~fixed_slots::put_in_window(w, 3, 1, a);
  (int held, int holder) = fixed_slots::occupant(p, 3 + 256);
  throw_unless(241, held & (holder == 3));
  int rejected = 0;
  try { p~fixed_slots::put_in_window(w, 3 + 256, 1, a); } catch (_, code) { expect_throw(code, ordered_delivery::error::outside_window, 242); rejected += 1; }
  w~nonce_window::complete_range(0, 3);
  p~fixed_slots::put_in_window(w, 3 + 256, 2, a);
  (int now, _, _) = fixed_slots::get(p, 3 + 256);
  (int old, _, _) = fixed_slots::get(p, 3);
  throw_unless(243, now & (~ old));
  try { p~fixed_slots::put_in_window(w, 2, 1, a); } catch (_, code) { expect_throw(code, ordered_delivery::error::already_completed, 244); rejected += 1; }
  p~fixed_slots::put(5 + 512, 1, a);
  try { p~fixed_slots::put_in_window(w, 5, 1, a); } catch (_, code) { expect_throw(code, ordered_delivery::error::slot_occupied, 245); rejected += 1; }
  throw_unless(246, rejected == 3);
  (int empty, _) = fixed_slots::occupant(fixed_slots::new(), 0);
  throw_if(247, empty);
  return 16;
}

