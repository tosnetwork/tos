#include "../../../smartcont/stdlib.fc";
#include "../../../smartcont/multisig-wallet-code.fc";

;; PR #124 regression: fee accounting must include every signer AND proposer
;; visited by validate_actions, without adding proposers to the approval quorum.
;; Import the production wallet so these tests exercise its real validator.

() audit_set_c7(tuple c7) impure asm "c7 POP";

slice audit_address(int hash) inline {
  return begin_cell().store_uint(4, 3).store_int(0, 8).store_uint(hash, 256).end_cell().begin_parse();
}

() audit_install_workchain(int workchain) impure {
  tuple params = empty_tuple();
  int i = 0;
  while (i < 17) {
    if (i == 8) {
      params~tpush(begin_cell().store_uint(4, 3).store_int(workchain, 8)
          .store_uint(0xabc, 256).end_cell().begin_parse()); ;; MYADDR
    } else {
      params~tpush(i == 3 ? 1000 : null());
    }
    i += 1;
  }
  tuple c7 = empty_tuple();
  c7~tpush(params);
  audit_set_c7(c7);
}

() audit_install_context() impure {
  audit_install_workchain(0);
}

cell audit_members(int count, int base) inline {
  cell members = new_dict();
  int i = 0;
  while (i < count) {
    members~udict_set(multisig_order::signer_index_bits, i, audit_address(base + i));
    i += 1;
  }
  return members;
}

cell audit_update(int threshold, cell signers, cell proposers, cell next) inline {
  return begin_cell()
      .store_uint(action::update, 32)
      .store_uint(threshold, 8)
      .store_ref(signers)
      .store_dict(proposers)
      .store_maybe_ref(next)
      .end_cell();
}

int audit_many_proposers_are_priced() method_id(101) {
  audit_install_context();
  cell chain = audit_update(1, audit_members(1, 0x1000), audit_members(255, 0x2000), null());
  (int actions, int visited, int threshold, int signers) = validate_actions(chain, 2, 3);
  throw_unless(101, (actions == 1) & (visited == 256) & (threshold == 1) & (signers == 1));
  return 1;
}

int audit_empty_proposers_preserve_signer_pricing() method_id(102) {
  audit_install_context();
  cell chain = audit_update(2, audit_members(3, 0x1000), null(), null());
  (int actions, int visited, int threshold, int signers) = validate_actions(chain, 1, 1);
  throw_unless(102, (actions == 1) & (visited == 3) & (threshold == 2) & (signers == 3));
  return 2;
}

int audit_every_update_is_priced() method_id(103) {
  audit_install_context();
  cell tail = audit_update(2, audit_members(3, 0x3000), audit_members(2, 0x4000), null());
  cell chain = audit_update(1, audit_members(1, 0x1000), audit_members(255, 0x2000), tail);
  (int actions, int visited, int threshold, int signers) = validate_actions(chain, 2, 3);
  throw_unless(103, (actions == 2) & (visited == 261) & (threshold == 2) & (signers == 3));
  return 3;
}

int audit_shared_dictionaries_are_not_free_to_revisit() method_id(104) {
  audit_install_context();
  cell signers = audit_members(2, 0x1000);
  cell proposers = audit_members(7, 0x2000);
  cell tail = audit_update(1, signers, proposers, null());
  cell chain = audit_update(2, signers, proposers, tail);
  (int actions, int visited, int threshold, int signer_count) = validate_actions(chain, 2, 3);
  throw_unless(104, (actions == 2) & (visited == 18) & (threshold == 1) & (signer_count == 2));
  return 4;
}

int audit_both_maximum_sets_are_priced() method_id(105) {
  audit_install_context();
  cell chain = audit_update(255, audit_members(255, 0x1000), audit_members(255, 0x2000), null());
  (int actions, int visited, int threshold, int signers) = validate_actions(chain, 2, 3);
  throw_unless(105, (actions == 1) & (visited == 510) & (threshold == 255) & (signers == 255));
  return 5;
}

int audit_proposers_cannot_satisfy_threshold() method_id(106) {
  audit_install_context();
  cell chain = audit_update(2, audit_members(1, 0x1000), audit_members(255, 0x2000), null());
  int rejected = false;
  try {
    validate_actions(chain, 2, 3);
  } catch (_, code) {
    throw_unless(106, code == multisig_order::error::invalid_config);
    rejected = true;
  }
  throw_unless(107, rejected);
  return 6;
}

cell audit_pair(slice first, slice second) inline {
  cell members = new_dict();
  members~udict_set(multisig_order::signer_index_bits, 0, first);
  members~udict_set(multisig_order::signer_index_bits, 1, second);
  return members;
}

int audit_installed_signers_are_ordered_and_distinct() method_id(107) {
  audit_install_context();
  int rejected = 0;
  ;; one address at two indices
  try { validate_actions(audit_update(1, audit_pair(audit_address(0x1000), audit_address(0x1000)), null(), null()), 2, 3); } catch (_, code) { throw_unless(108, code == multisig_order::error::invalid_config); rejected += 1; }
  ;; addresses out of order
  try { validate_actions(audit_update(1, audit_pair(audit_address(0x1001), audit_address(0x1000)), null(), null()), 2, 3); } catch (_, code) { throw_unless(109, code == multisig_order::error::invalid_config); rejected += 1; }
  ;; also when a later update in the chain installs it
  cell tail = audit_update(1, audit_pair(audit_address(0x1000), audit_address(0x1000)), null(), null());
  try { validate_actions(audit_update(1, audit_members(3, 0x2000), null(), tail), 2, 3); } catch (_, code) { throw_unless(110, code == multisig_order::error::invalid_config); rejected += 1; }
  throw_unless(111, rejected == 3);
  return 7;
}

int audit_proposer_sets_need_no_order() method_id(108) {
  audit_install_context();
  ;; proposers open orders but never vote, so their set keeps the plain rules
  cell chain = audit_update(1, audit_members(1, 0x1000), audit_pair(audit_address(0x2001), audit_address(0x2001)), null());
  (int actions, int visited, int threshold, int signers) = validate_actions(chain, 2, 3);
  throw_unless(121, (actions == 1) & (visited == 3) & (threshold == 1) & (signers == 1));
  return 8;
}

() audit_store(cell signers) impure inline {
  set_data(begin_cell()
      .store_uint(0, 64).store_uint(1, 8).store_uint(2, 8)
      .store_ref(signers).store_dict(null()).store_ref(begin_cell().end_cell())
      .end_cell());
}

int audit_checked_signer_count_getter() method_id(109) {
  audit_install_context();
  audit_store(audit_members(2, 0x1000));
  throw_unless(131, get_checked_signer_count() == 2);
  ;; a deployed set that breaks the rule is reported, not counted
  audit_store(audit_pair(audit_address(0x1000), audit_address(0x1000)));
  int rejected = false;
  try {
    ;; use the result: a getter is not impure, and an unused call would be dropped
    throw_unless(134, get_checked_signer_count() < 0);
  } catch (_, code) {
    throw_unless(132, code == multisig_order::error::invalid_config);
    rejected = true;
  }
  throw_unless(133, rejected);
  return 9;
}

;; The preflight getter must validate the scalar fields actually passed to order init,
;; not just the dictionary. Do not introduce main(): the imported receiver is method 0.
() audit_reject_stored_config(int threshold, int stored_count) impure inline {
  save_data(0, threshold, stored_count, audit_members(2, 0x1000), null(), begin_cell().end_cell());
  int rejected = false;
  try {
    throw_unless(141, get_checked_signer_count() < 0);
  } catch (_, code) {
    throw_unless(142, code == multisig_order::error::invalid_config);
    rejected = true;
  }
  throw_unless(143, rejected);
}

int audit_checked_config_rejects_bad_scalars() method_id(110) {
  audit_install_context();
  audit_reject_stored_config(1, 0);
  audit_reject_stored_config(1, 1);
  audit_reject_stored_config(1, 3);
  audit_reject_stored_config(0, 2);
  audit_reject_stored_config(3, 2);
  ;; A forged count can make a threshold look valid even though it is unreachable.
  audit_reject_stored_config(3, 3);
  save_data(0, 2, 2, audit_members(2, 0x1000), null(), begin_cell().end_cell());
  throw_unless(144, get_checked_signer_count() == 2);
  return 10;
}

int audit_parent_workchain_policy() method_id(111) {
  audit_install_context();
  require_supported_workchain();
  int workchain = -128;
  int rejected = 0;
  while (workchain < 128) {
    if (workchain != 0) {
      audit_install_workchain(workchain);
      try {
        require_supported_workchain();
      } catch (_, code) {
        throw_unless(151, code == error::unsupported_workchain);
        rejected += 1;
      }
    }
    workchain += 1;
  }
  throw_unless(152, rejected == 255);
  return 11;
}

int audit_masterchain_quote_and_proposal_are_refused() method_id(112) {
  audit_install_workchain(-1);
  cell members = audit_members(2, 0x1000);
  save_data(0, 1, 2, members, null(), begin_cell().end_cell());
  cell before = get_data();
  cell actions = audit_update(1, members, null(), null());
  int rejected = 0;
  try {
    throw_unless(161, get_order_estimate(actions, 2000) < 0);
  } catch (_, code) {
    throw_unless(162, code == error::unsupported_workchain);
    rejected += 1;
  }
  cell envelope = begin_cell().store_uint(6, 4).store_slice(audit_address(0x1000)).end_cell();
  slice body = begin_cell().store_uint(op::new_order, 32).store_uint(7, 64)
      .store_uint(0, 64).store_int(true, 1).store_uint(0, 8)
      .store_uint(2000, 32).store_ref(actions).end_cell().begin_parse();
  try {
    recv_internal(1000000000, 100000000, envelope, body);
  } catch (_, code) {
    throw_unless(163, code == error::unsupported_workchain);
    rejected += 1;
  }
  throw_unless(164, rejected == 2);
  throw_unless(165, get_data().cell_hash() == before.cell_hash());
  return 12;
}

